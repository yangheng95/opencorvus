{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "customConditions": ["browser"],
    "paths": {
      "@/*": ["./src/*"],
      // Built-in Expert Squad packages, so their behavior tests name what they
      // import instead of counting `../` segments up out of this workspace.
      "@squads/*": ["../../expert-squads/builtin/*"]
    }
  },
  "exclude": ["script/**/*", "test/**/*", "src/skill/builtin/**/*"]
}
