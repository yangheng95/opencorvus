{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "advanced",
  "name": "Advanced",
  "label": "Advanced",
  "description": "Built-in advanced software delivery team with capability-matched Requirements-to-Architect traceability, execution, testing, interface, and independent-review frontiers.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for advanced software delivery that requires capability-matched Requirements-to-Architect traceability, execution evidence, and independent review without a narrower installed expert contract.",
    "selection_guidance": "Select advanced when the delivery materially requires the full Requirements, architecture, implementation, testing, interface, investigation, and independent-review contract; choose the researched workflow only when external web evidence must precede Requirements.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 2 projections.",
      "member_refs": [
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fcheck",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fclick",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fdiagnostics_get",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fhover",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fnavigate",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fobserve",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fpress_key",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscreenshot",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscroll",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fselect_option",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_create",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_destroy",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Ftype",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Funcheck",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fviewport_set",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_load",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_selector",
        "capability:skill:package:advanced:advanced%2Fshared%2Fmethod"
      ]
    },
    "shared-capabilities-2": {
      "description": "Shared capabilities used by 2 projections.",
      "member_refs": [
        "capability:skill:package:advanced:advanced%2Fshared%2Fmethod",
        "capability:skill:platform:skill-manager:default%2Fskill%2Fgrill-me"
      ]
    },
    "shared-capabilities-3": {
      "description": "Shared capabilities used by 10 projections.",
      "member_refs": [
        "capability:skill:package:advanced:advanced%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:package:advanced:shared-capabilities-2",
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "request-interpreter": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:intent-analysis-base"
        ],
        "label": "Request Interpreter",
        "description": "Clarifies intent, missing inputs, scope boundaries, and operator decisions.",
        "base_role": "intent-analysis",
        "prompt": "agents/request-interpreter/system.md"
      },
      "requirement-engineer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-2",
          "capability:capability_set:platform:tool-registry:requirements-base"
        ],
        "label": "Requirement Engineer",
        "description": "Registers falsifiable requirements and foundational decisions from current evidence.",
        "base_role": "requirements",
        "prompt": "agents/requirement-engineer/system.md"
      },
      "solution-architect": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:architect-base"
        ],
        "label": "Solution Architect",
        "description": "Creates traceable interface contracts, independently revisioned Delivery Slices, and assembly ownership.",
        "base_role": "architect",
        "prompt": "agents/solution-architect/system.md"
      },
      "workload-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:goal-workload-analyst-base"
        ],
        "label": "Workload Reviewer",
        "description": "Assesses Delivery Slice size, coupling, omitted work, acceptance coverage, and verification cost without acting as an architecture authority.",
        "base_role": "goal-workload-analyst",
        "prompt": "agents/workload-reviewer/system.md"
      },
      "source-investigator": {
        "capability_refs": [
          "capability:skill:package:advanced:advanced%2Fshared%2Fmethod",
          "capability:tool:platform:tool-registry:bash",
          "capability:tool:platform:tool-registry:glob",
          "capability:tool:platform:tool-registry:read",
          "capability:tool:platform:tool-registry:search_code",
          "capability:tool:platform:tool-registry:skill"
        ],
        "label": "Source Investigator",
        "description": "Performs read-only repository and projected-client authority investigation and records source-grounded evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/source-investigator/system.md"
      },
      "research-investigator": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Research Investigator",
        "description": "Collects durable multi-source external evidence and separates fact from inference.",
        "base_role": "deep-research",
        "prompt": "agents/research-investigator/system.md"
      },
      "interface-investigator": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:frontend-research-base"
        ],
        "label": "Interface Investigator",
        "description": "Captures interface structure, behavior, states, assets, and reference evidence.",
        "base_role": "frontend-research",
        "prompt": "agents/interface-investigator/system.md"
      },
      "interface-designer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:frontend-design-base"
        ],
        "label": "Interface Designer",
        "description": "Produces a traceable interface design and implementation contract from approved evidence.",
        "base_role": "frontend-design",
        "prompt": "agents/interface-designer/system.md"
      },
      "implementation-engineer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Implementation Engineer",
        "description": "Implements the Architect contract and produces repository, command, and runtime evidence without taking review ownership.",
        "base_role": "build",
        "prompt": "agents/implementation-engineer/system.md"
      },
      "test-engineer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Test Engineer",
        "description": "Independently executes applicable non-UI tests and runtime checks against implementation evidence and reports exact results.",
        "base_role": "delegated-worker",
        "prompt": "agents/test-engineer/system.md"
      },
      "visual-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:visual-qa-base"
        ],
        "label": "Visual Reviewer",
        "description": "Reviews real rendered evidence, interaction states, and visual acceptance coverage.",
        "base_role": "visual-qa",
        "prompt": "agents/visual-reviewer/system.md"
      },
      "system-integrity-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:integrity-base"
        ],
        "label": "System Integrity Reviewer",
        "description": "Produces non-transferable independent system review across requirements, contracts, implementation, and evidence once implementation proof is ready.",
        "base_role": "integrity",
        "execution_contract": "platform_integrity_review",
        "prompt": "agents/system-integrity-reviewer/system.md"
      },
      "interface-integrity-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Interface Integrity Reviewer",
        "description": "Performs an independent Task-scoped review of implemented interface behavior and rendered evidence without requiring a Delivery Slice planning graph.",
        "base_role": "delegated-worker",
        "prompt": "agents/interface-integrity-reviewer/system.md"
      },
      "claim-verifier": {
        "capability_refs": [
          "capability:capability_set:package:advanced:shared-capabilities-3",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Claim Verifier",
        "description": "Verifies material factual claims against traceable evidence and reports uncertainty.",
        "base_role": "fact-check",
        "prompt": "agents/claim-verifier/system.md"
      }
    },
    "virtual_workflows": {
      "planned-delivery": {
        "label": "Planned Delivery",
        "description": "Complete a planned non-interface delivery with parallel intent, Requirements, and repository investigation; an exact Requirements-to-Architect join; parallel workload review and implementation; then parallel testing and independent system review.",
        "nodes": {
          "request-interpreter": {
            "agent_id": "request-interpreter",
            "description": "Confirms intent, inputs, and scope, explicitly recording when no clarification gap remains.",
            "depends_on": []
          },
          "requirement-engineer": {
            "agent_id": "requirement-engineer",
            "description": "Inventories every Task element and registers complete falsifiable requirements and foundational decisions from current evidence.",
            "depends_on": []
          },
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Investigates repository structure and, when projected, current external authority through read-only Skills or clients in parallel with intent and Requirements work.",
            "depends_on": []
          },
          "solution-architect": {
            "agent_id": "solution-architect",
            "description": "Joins exact intent, RequirementSet, and repository evidence into traceable contracts, individually observable acceptance specs, immutable Delivery Slice revisions, and assembly ownership.",
            "depends_on": [
              "request-interpreter",
              "requirement-engineer",
              "source-investigator"
            ]
          },
          "workload-reviewer": {
            "agent_id": "workload-reviewer",
            "description": "Assesses Slice size, coupling, omitted work, acceptance coverage, and verification cost without architecture authority.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "implementation-engineer": {
            "agent_id": "implementation-engineer",
            "description": "Implements the exact Architect contract in parallel with workload review and records concrete repository and verification evidence.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "test-engineer": {
            "agent_id": "test-engineer",
            "description": "Executes applicable non-UI tests and runtime checks independently after implementation evidence exists.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "system-integrity-reviewer": {
            "agent_id": "system-integrity-reviewer",
            "description": "Performs independent adversarial review after implementation, workload, and executable test evidence exist.",
            "depends_on": [
              "implementation-engineer",
              "test-engineer",
              "workload-reviewer"
            ]
          }
        }
      },
      "researched-planned-delivery": {
        "label": "Externally Researched Planned Delivery",
        "description": "Resolve one load-bearing external evidence gap before Requirements and architecture, then implement, independently test, and review a non-interface delivery with capability-matched owners.",
        "nodes": {
          "request-interpreter": {
            "agent_id": "request-interpreter",
            "description": "Confirms intent, inputs, and scope, explicitly recording when no clarification gap remains.",
            "depends_on": []
          },
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Investigates repository structure and projected current-authority sources with read-only repository, Skill, and client operations.",
            "depends_on": []
          },
          "research-investigator": {
            "agent_id": "research-investigator",
            "description": "Resolves the selected coherent multi-source external fact gap with its projected web research capabilities.",
            "depends_on": []
          },
          "requirement-engineer": {
            "agent_id": "requirement-engineer",
            "description": "Registers complete falsifiable requirements after exact intent, repository, and external evidence settle.",
            "depends_on": [
              "request-interpreter",
              "research-investigator",
              "source-investigator"
            ]
          },
          "solution-architect": {
            "agent_id": "solution-architect",
            "description": "Binds the settled RequirementSet and selected evidence into traceable contracts, observable acceptance specs, Delivery Slice revisions, and assembly ownership.",
            "depends_on": [
              "requirement-engineer"
            ]
          },
          "workload-reviewer": {
            "agent_id": "workload-reviewer",
            "description": "Assesses Slice size, coupling, omitted work, acceptance coverage, and verification cost without architecture authority.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "implementation-engineer": {
            "agent_id": "implementation-engineer",
            "description": "Uses executable projected capabilities to settle remaining dynamic values and implement the exact Architect contract.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "test-engineer": {
            "agent_id": "test-engineer",
            "description": "Independently rereads authoritative sources and executes applicable non-UI and runtime checks after implementation settles.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "system-integrity-reviewer": {
            "agent_id": "system-integrity-reviewer",
            "description": "Audits requirement coverage, source mapping, implementation, workload, and executable Test evidence after all settle.",
            "depends_on": [
              "implementation-engineer",
              "test-engineer",
              "workload-reviewer"
            ]
          }
        }
      },
      "evidence-investigation": {
        "label": "Evidence Investigation",
        "description": "Complete repository and external investigation followed by claim verification when investigation itself is the Task delivery or blocks a non-delivery decision; do not combine this graph as an auxiliary phase of a delivery workflow, whose scheduler may dispatch individual investigators for concrete evidence gaps.",
        "nodes": {
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Performs read-oriented repository investigation and records source-grounded evidence.",
            "depends_on": []
          },
          "research-investigator": {
            "agent_id": "research-investigator",
            "description": "Collects durable multi-source external evidence and separates fact from inference.",
            "depends_on": []
          },
          "claim-verifier": {
            "agent_id": "claim-verifier",
            "description": "Verifies material factual claims against the collected evidence and reports uncertainty.",
            "depends_on": [
              "research-investigator",
              "source-investigator"
            ]
          }
        }
      },
      "greenfield-interface-delivery": {
        "label": "Greenfield Interface Delivery",
        "description": "Deliver a new interface without a source URL through parallel intent, Requirements, and repository investigation; an exact Requirements-to-Architect join; parallel interface design and workload review; implementation-owned real-page inspection; then parallel testing and independent interface/system reviews.",
        "nodes": {
          "request-interpreter": {
            "agent_id": "request-interpreter",
            "description": "Confirms the greenfield interface intent, inputs, and scope without inventing a source-interface dependency.",
            "depends_on": []
          },
          "requirement-engineer": {
            "agent_id": "requirement-engineer",
            "description": "Registers falsifiable product, data, interaction, and visual requirements for the original interface.",
            "depends_on": []
          },
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Investigates the target repository, design-system implementation surface, and ownership boundaries in parallel with intent and Requirements work.",
            "depends_on": []
          },
          "solution-architect": {
            "agent_id": "solution-architect",
            "description": "Joins exact intent, RequirementSet, and repository evidence into traceable interface contracts, immutable Delivery Slice revisions, and assembly ownership.",
            "depends_on": [
              "request-interpreter",
              "requirement-engineer",
              "source-investigator"
            ]
          },
          "interface-designer": {
            "agent_id": "interface-designer",
            "description": "Produces an original, traceable interface design and implementation contract from the approved requirements and architecture evidence.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "workload-reviewer": {
            "agent_id": "workload-reviewer",
            "description": "Challenges Slice size, ownership, and verification workload in parallel with interface design after the Architect contract exists.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "implementation-engineer": {
            "agent_id": "implementation-engineer",
            "description": "Implements the approved interface contract after design evidence exists while preserving the Architect ownership boundaries.",
            "depends_on": [
              "interface-designer"
            ]
          },
          "test-engineer": {
            "agent_id": "test-engineer",
            "description": "Executes applicable non-UI tests and runtime checks independently after implementation evidence exists.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "interface-integrity-reviewer": {
            "agent_id": "interface-integrity-reviewer",
            "description": "Independently reviews implemented interface behavior and rendered evidence.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "system-integrity-reviewer": {
            "agent_id": "system-integrity-reviewer",
            "description": "Reviews requirement, contract, implementation, workload, and executable test evidence independently of interface review.",
            "depends_on": [
              "implementation-engineer",
              "test-engineer",
              "workload-reviewer"
            ]
          }
        }
      },
      "greenfield-interface-visual-delivery": {
        "label": "Greenfield Interface Delivery With Independent Visual Review",
        "description": "Deliver a new interface without a source URL when the operator or repository explicitly requires a separate Visual Reviewer judgment, using the complete greenfield interface graph plus independent rendered review.",
        "nodes": {
          "request-interpreter": {
            "agent_id": "request-interpreter",
            "description": "Confirms the greenfield interface intent, inputs, and scope without inventing a source-interface dependency.",
            "depends_on": []
          },
          "requirement-engineer": {
            "agent_id": "requirement-engineer",
            "description": "Registers falsifiable product, data, interaction, and visual requirements for the original interface.",
            "depends_on": []
          },
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Investigates the target repository, design-system implementation surface, and ownership boundaries in parallel with intent and Requirements work.",
            "depends_on": []
          },
          "solution-architect": {
            "agent_id": "solution-architect",
            "description": "Joins exact intent, RequirementSet, and repository evidence into traceable interface contracts, immutable Delivery Slice revisions, and assembly ownership.",
            "depends_on": [
              "request-interpreter",
              "requirement-engineer",
              "source-investigator"
            ]
          },
          "interface-designer": {
            "agent_id": "interface-designer",
            "description": "Produces an original, traceable interface design and implementation contract from the approved requirements and architecture evidence.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "workload-reviewer": {
            "agent_id": "workload-reviewer",
            "description": "Challenges Slice size, ownership, and verification workload in parallel with interface design after the Architect contract exists.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "implementation-engineer": {
            "agent_id": "implementation-engineer",
            "description": "Implements the approved interface contract after design evidence exists while preserving the Architect ownership boundaries.",
            "depends_on": [
              "interface-designer"
            ]
          },
          "test-engineer": {
            "agent_id": "test-engineer",
            "description": "Executes applicable non-UI tests and runtime checks independently after implementation evidence exists.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "visual-reviewer": {
            "agent_id": "visual-reviewer",
            "description": "Reviews the real rendered implementation and interaction states in parallel with testing and independent integrity review.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "interface-integrity-reviewer": {
            "agent_id": "interface-integrity-reviewer",
            "description": "Independently reviews implemented interface behavior and rendered evidence without consuming the Visual Reviewer's verdict.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "system-integrity-reviewer": {
            "agent_id": "system-integrity-reviewer",
            "description": "Reviews requirement, contract, implementation, workload, and executable test evidence independently of visual and interface review.",
            "depends_on": [
              "implementation-engineer",
              "test-engineer",
              "workload-reviewer"
            ]
          }
        }
      },
      "reference-interface-delivery": {
        "label": "Supplied-Reference Interface Delivery",
        "description": "Deliver from exactly one operator-supplied interface URL through parallel interface observation, intent, Requirements, and repository investigation; an exact Requirements-to-Architect join; parallel design and workload review; implementation; then parallel testing, visual review, and independent reviews.",
        "nodes": {
          "interface-investigator": {
            "agent_id": "interface-investigator",
            "description": "Captures structure, behavior, states, assets, and reference evidence from exactly one operator-supplied source interface URL.",
            "depends_on": []
          },
          "request-interpreter": {
            "agent_id": "request-interpreter",
            "description": "Confirms intent, inputs, and scope in parallel with Requirements and direct interface observation.",
            "depends_on": []
          },
          "requirement-engineer": {
            "agent_id": "requirement-engineer",
            "description": "Registers falsifiable product, interaction, fidelity, and acceptance requirements from the complete request.",
            "depends_on": []
          },
          "source-investigator": {
            "agent_id": "source-investigator",
            "description": "Investigates the target repository and ownership boundaries in parallel with source-interface observation and Requirements work.",
            "depends_on": []
          },
          "solution-architect": {
            "agent_id": "solution-architect",
            "description": "Joins direct interface, intent, RequirementSet, and repository evidence into traceable contracts and immutable Delivery Slice revisions.",
            "depends_on": [
              "interface-investigator",
              "request-interpreter",
              "requirement-engineer",
              "source-investigator"
            ]
          },
          "interface-designer": {
            "agent_id": "interface-designer",
            "description": "Produces a traceable interface design and implementation contract from the supplied-reference and Architect evidence.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "workload-reviewer": {
            "agent_id": "workload-reviewer",
            "description": "Challenges Slice size, ownership, and visual verification workload in parallel with interface design.",
            "depends_on": [
              "solution-architect"
            ]
          },
          "implementation-engineer": {
            "agent_id": "implementation-engineer",
            "description": "Implements the supplied-reference interface contract after design evidence exists.",
            "depends_on": [
              "interface-designer"
            ]
          },
          "test-engineer": {
            "agent_id": "test-engineer",
            "description": "Executes applicable non-UI tests and runtime checks independently after implementation evidence exists.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "visual-reviewer": {
            "agent_id": "visual-reviewer",
            "description": "Reviews the real rendered result, interactions, and reference fidelity in parallel with testing and independent review.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "interface-integrity-reviewer": {
            "agent_id": "interface-integrity-reviewer",
            "description": "Independently reviews implemented interface behavior and rendered evidence without consuming the Visual Reviewer's verdict.",
            "depends_on": [
              "implementation-engineer"
            ]
          },
          "system-integrity-reviewer": {
            "agent_id": "system-integrity-reviewer",
            "description": "Reviews requirement, contract, implementation, workload, and executable test evidence independently of visual and interface review.",
            "depends_on": [
              "implementation-engineer",
              "test-engineer",
              "workload-reviewer"
            ]
          }
        }
      }
    }
  }
}
