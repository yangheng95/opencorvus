  "id": "advanced",
  "name": "Advanced",
  "label": "Advanced",
  "description": "Built-in advanced software delivery team with retained Requirements-to-Architect traceability and parallel investigation, implementation, testing, interface, and independent-review frontiers.",
  "version": "2026.08.06.1",
  "product_pillars": ["code", "work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for advanced software delivery that requires Requirements-to-Architect traceability, parallel investigation and implementation evidence, and independent review without a narrower installed expert contract.",
    "selection_guidance": "Select advanced when the delivery materially requires the full Requirements, architecture, implementation, testing, interface, investigation, and independent-review contract.",
    "instructions": "selector.md",
  },
