{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "base",
  "name": "Base",
  "label": "Base",
  "description": "Built-in Planner-first Expert Squad for compact capability-matched delivery and independent verification of the settled result.",
  "version": "2026.08.22.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use Base for one compact Task planned once, executed by capability-matched owners, then independently verified against the settled result.",
    "selection_guidance": "Select Base when one Planner can partition the complete Task into capability-matched implementation and acceptance ownership. Use the research workflow only for a complete independent read/web partition; use the execution workflow when source discovery requires a project Skill, command, client, or mutating browser. Select Advanced or a domain Squad when evidence dependencies require a richer graph.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "base/shared/method"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "base-researcher": {
        "label": "Base Researcher",
        "description": "Performs read-oriented repository and relevant external research and publishes the canonical Base research report.",
        "base_role": "explore",
        "prompt": "agents/base-researcher/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [
          "webfetch",
          "websearch",
          "external_code_search"
        ],
        "default_skill_refs": [],
        "package_skill_refs": [
          "base/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "base-planner": {
        "label": "Base Planner",
        "description": "Publishes one capability-matched Task implementation plan without executing clients, editing product files, or creating Goal-derived planning facts.",
        "base_role": "delegated-worker",
        "prompt": "agents/base-planner/system.md",
        "inherit_base_tools": false,
        "built_in_tool_ids": [
          "capability_search",
          "read",
          "glob",
          "search_code",
          "webfetch",
          "websearch",
          "external_code_search",
          "skill"
        ],
        "default_skill_refs": [],
        "package_skill_refs": [
          "base/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "base-developer": {
        "label": "Base Developer",
        "description": "Consumes the selected Base implementation plan, changes the repository, performs implementation-owned checks, and publishes the development report.",
        "base_role": "build",
        "prompt": "agents/base-developer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "base/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [
          "default/mcp/browser/tool/session_create",
          "default/mcp/browser/tool/session_destroy",
          "default/mcp/browser/tool/viewport_set",
          "default/mcp/browser/tool/navigate",
          "default/mcp/browser/tool/diagnostics_get",
          "default/mcp/browser/tool/screenshot",
          "default/mcp/browser/tool/observe",
          "default/mcp/browser/tool/click",
          "default/mcp/browser/tool/hover",
          "default/mcp/browser/tool/type",
          "default/mcp/browser/tool/press_key",
          "default/mcp/browser/tool/select_option",
          "default/mcp/browser/tool/check",
          "default/mcp/browser/tool/uncheck",
          "default/mcp/browser/tool/scroll",
          "default/mcp/browser/tool/wait_for_selector",
          "default/mcp/browser/tool/wait_for_load"
        ],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "base-tester": {
        "label": "Base Tester",
        "description": "Independently verifies the settled implementation against the original request and the plan's acceptance criteria through the final diff, executable checks, and rendered evidence, and publishes the canonical test report.",
        "base_role": "delegated-worker",
        "prompt": "agents/base-tester/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "base/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [
          "default/mcp/browser/tool/session_create",
          "default/mcp/browser/tool/session_destroy",
          "default/mcp/browser/tool/viewport_set",
          "default/mcp/browser/tool/navigate",
          "default/mcp/browser/tool/diagnostics_get",
          "default/mcp/browser/tool/screenshot",
          "default/mcp/browser/tool/observe",
          "default/mcp/browser/tool/click",
          "default/mcp/browser/tool/hover",
          "default/mcp/browser/tool/type",
          "default/mcp/browser/tool/press_key",
          "default/mcp/browser/tool/select_option",
          "default/mcp/browser/tool/check",
          "default/mcp/browser/tool/uncheck",
          "default/mcp/browser/tool/scroll",
          "default/mcp/browser/tool/wait_for_selector",
          "default/mcp/browser/tool/wait_for_load"
        ],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      }
    },
    "virtual_workflows": {
      "planner-execution-verification": {
        "label": "Planner, Execution, and Verification",
        "description": "Plan once, execute source discovery and delivery with a command-capable owner, then independently verify the settled result.",
        "nodes": {
          "base-planner": {
            "agent_id": "base-planner",
            "description": "Publishes the complete Task-element inventory, discovery obligations, capability allocation, and acceptance contract.",
            "depends_on": []
          },
          "base-developer": {
            "agent_id": "base-developer",
            "description": "Uses projected Skills and executable tools to discover dynamic sources and complete the requested delivery.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-tester": {
            "agent_id": "base-tester",
            "description": "Independently rereads dynamic sources and verifies the settled result criterion by criterion.",
            "depends_on": [
              "base-developer"
            ]
          }
        }
      },
      "planner-parallel-delivery": {
        "label": "Planner, Parallel Workers, and Verification",
        "description": "Publish one bounded Task plan, run the research and implementation partitions in the same dependency-ready frontier, then verify the settled result.",
        "nodes": {
          "base-planner": {
            "agent_id": "base-planner",
            "description": "Publishes the complete Task-element inventory, stable acceptance criteria, shared inputs, owned paths, and acceptance allocation.",
            "depends_on": []
          },
          "base-researcher": {
            "agent_id": "base-researcher",
            "description": "Executes the plan's evidence and repository research partition.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-developer": {
            "agent_id": "base-developer",
            "description": "Executes the plan's implementation partition and its implementation-owned checks.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-tester": {
            "agent_id": "base-tester",
            "description": "Executes every planned acceptance criterion against the settled result and records criterion-by-criterion evidence.",
            "depends_on": [
              "base-developer"
            ]
          }
        }
      }
    }
  }
}
