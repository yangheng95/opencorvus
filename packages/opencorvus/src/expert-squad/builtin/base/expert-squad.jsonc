{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "base",
  "name": "Base",
  "label": "Base",
  "description": "Built-in Planner-first Expert Squad for compact capability-matched delivery and independent verification of the settled result.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use Base for one compact Task planned once, executed by capability-matched owners, then independently verified against the settled result.",
    "selection_guidance": "Select Base when one Planner can partition the complete Task into capability-matched implementation and acceptance ownership. Use the research workflow only for a complete independent read/web partition; use the execution workflow when source discovery requires a project Skill, command, client, or mutating browser. Select Advanced or a domain Squad when evidence dependencies require a richer graph.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 2 projections.",
      "member_refs": [
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fcheck",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fclick",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fdiagnostics_get",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fhover",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fnavigate",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fobserve",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fpress_key",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscreenshot",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscroll",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fselect_option",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_create",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_destroy",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Ftype",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Funcheck",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fviewport_set",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_load",
        "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_selector",
        "capability:skill:package:base:base%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:base:base%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "base-researcher": {
        "capability_refs": [
          "capability:capability_set:platform:tool-registry:explore-base",
          "capability:skill:package:base:base%2Fshared%2Fmethod",
          "capability:tool:platform:tool-registry:external_code_search",
          "capability:tool:platform:tool-registry:webfetch",
          "capability:tool:platform:tool-registry:websearch"
        ],
        "label": "Base Researcher",
        "description": "Performs read-oriented repository and relevant external research and publishes the canonical Base research report.",
        "base_role": "explore",
        "prompt": "agents/base-researcher/system.md"
      },
      "base-planner": {
        "capability_refs": [
          "capability:skill:package:base:base%2Fshared%2Fmethod",
          "capability:tool:platform:tool-registry:bash",
          "capability:tool:platform:tool-registry:capability_search",
          "capability:tool:platform:tool-registry:external_code_search",
          "capability:tool:platform:tool-registry:glob",
          "capability:tool:platform:tool-registry:read",
          "capability:tool:platform:tool-registry:search_code",
          "capability:tool:platform:tool-registry:skill",
          "capability:tool:platform:tool-registry:webfetch",
          "capability:tool:platform:tool-registry:websearch"
        ],
        "label": "Base Planner",
        "description": "Publishes one capability-matched Task implementation plan after read-only current-authority discovery, without mutating external state, editing product files, or creating Goal-derived planning facts.",
        "base_role": "delegated-worker",
        "prompt": "agents/base-planner/system.md"
      },
      "base-developer": {
        "capability_refs": [
          "capability:capability_set:package:base:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Base Developer",
        "description": "Consumes the selected Base implementation plan, changes the repository, performs implementation-owned checks, and publishes the development report.",
        "base_role": "build",
        "prompt": "agents/base-developer/system.md"
      },
      "base-tester": {
        "capability_refs": [
          "capability:capability_set:package:base:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Base Tester",
        "description": "Independently verifies the settled implementation against the original request and the plan's acceptance criteria through the final diff, executable checks, and rendered evidence, and publishes the canonical test report.",
        "base_role": "delegated-worker",
        "prompt": "agents/base-tester/system.md"
      }
    },
    "virtual_workflows": {
      "planner-execution-verification": {
        "label": "Planner, Execution, and Verification",
        "description": "Plan once, execute source discovery and delivery with a command-capable owner, then independently verify the settled result.",
        "nodes": {
          "base-planner": {
            "agent_id": "base-planner",
            "description": "Publishes the complete Task-element inventory, discovery obligations, capability allocation, and acceptance contract.",
            "depends_on": []
          },
          "base-developer": {
            "agent_id": "base-developer",
            "description": "Uses projected Skills and executable tools to discover dynamic sources and complete the requested delivery.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-tester": {
            "agent_id": "base-tester",
            "description": "Independently rereads dynamic sources and verifies the settled result criterion by criterion.",
            "depends_on": [
              "base-developer"
            ]
          }
        }
      },
      "planner-parallel-delivery": {
        "label": "Planner, Parallel Workers, and Verification",
        "description": "Publish one bounded Task plan, run the research and implementation partitions in the same dependency-ready frontier, then verify the settled result.",
        "nodes": {
          "base-planner": {
            "agent_id": "base-planner",
            "description": "Publishes the complete Task-element inventory, stable acceptance criteria, shared inputs, owned paths, and acceptance allocation.",
            "depends_on": []
          },
          "base-researcher": {
            "agent_id": "base-researcher",
            "description": "Executes the plan's evidence and repository research partition.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-developer": {
            "agent_id": "base-developer",
            "description": "Executes the plan's implementation partition and its implementation-owned checks.",
            "depends_on": [
              "base-planner"
            ]
          },
          "base-tester": {
            "agent_id": "base-tester",
            "description": "Executes every planned acceptance criterion against the settled result and records criterion-by-criterion evidence.",
            "depends_on": [
              "base-developer"
            ]
          }
        }
      }
    }
  }
}
