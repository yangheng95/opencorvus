{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "base",
  "name": "Base",
  "label": "Base",
  "description": "Advanced's convenient composite Expert Squad for non-Goal delivery: Researcher, Planner, Developer, and Tester provide the compact path, with package-owned Integrity and Visual Reviewers available through fixed verified-delivery workflows.",
  "version": "2026.08.09.1",
  "product_pillars": ["code", "work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use Base, Advanced's convenient composite version, for one complete non-Goal Task delivery through research, planning, implementation, testing, and the selected verified-review closure.",
    "selection_guidance": "Select Base when its compact chain or fixed integrity-verified or visual-verified variant owns the complete Task outcome. Workload size, deliverable count, directories, reports, audits, and internal evidence handoffs stay inside that one Task; select Advanced or a more specific installed Squad only when its different specialist contract is materially required.",
    "instructions": "selector.md",
  },
