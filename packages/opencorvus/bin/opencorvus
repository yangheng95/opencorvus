#!/usr/bin/env node
import { spawn } from "node:child_process"
import path from "node:path"
import { fileURLToPath } from "node:url"
import { resolveInstalledBinaryPath } from "../script/published-package-bin.mjs"

const binDir = path.dirname(fileURLToPath(import.meta.url))
const wrapperRoot = path.dirname(binDir)
const binaryPath = resolveInstalledBinaryPath(wrapperRoot)

const child = spawn(binaryPath, process.argv.slice(2), {
  stdio: "inherit",
  windowsHide: false,
})

child.on("error", (error) => {
  console.error(`Failed to launch opencorvus binary: ${error.message}`)
  process.exit(1)
})

child.on("exit", (code, signal) => {
  if (signal) {
    process.kill(process.pid, signal)
    return
  }
  process.exit(code ?? 1)
})
