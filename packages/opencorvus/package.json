{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.26",
  "name": "opencorvus",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit",
    "test": "bun script/run-tests.ts",
    "prepare:test-runtime": "bun script/prepare-test-process-supervisor.ts",
    "build": "bun run script/build.ts",
    "precheck:permission-modes": "bun script/prepare-test-process-supervisor.ts",
    "check:permission-modes": "bun run script/run-with-inactivity.ts --inactivity-ms 120000 -- bun run script/permission-modes-check-worker.ts",
    "check:work-artifact-profile": "bun run script/generate-work-artifact-qualification-matrix.ts --check && bun run script/check-work-artifact-profile.ts --profile office.presentation@1",
    "check:scheduled-automations-e2e": "bun run script/scheduled-automations-e2e.ts",
    "check:mission-task-duplex-e2e": "bun run script/check-mission-task-duplex-e2e.ts",
    "check:evolution-e2e": "bun run script/expert-squad-evolution-e2e.ts",
    "check:dynamic-e2e": "bun run script/dynamic-expert-squad-e2e.ts",
    "check:control-state-redundancy": "bun run script/control-state-redundancy-check.ts",
    "check:compaction-stress": "bun run script/compaction-stress.ts",
    "check:compaction-crash": "bun run script/compaction-crash-check.ts",
    "dev": "bun ./src/index.ts",
    "check:control-lease-owners": "bun run script/check/control-lease-owners.ts"
  },
  "bin": {
    "opencorvus": "./bin/opencorvus"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "devDependencies": {
