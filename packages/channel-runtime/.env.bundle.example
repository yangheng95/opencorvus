# Optional bundled trial config for redistribution.
# This file is loaded by OPENCORVUS_CHANNEL_BUNDLED_ENV_FILE (default: .env.bundle).
# Lifetime starts at first use and expires after 24 hours by default.
# User/system env vars have higher priority and can reconfigure at any time.

# Example:
# SLACK_BOT_TOKEN=<slack-bot-token>
# SLACK_APP_TOKEN=<slack-app-token>
# SLACK_SIGNING_SECRET=<slack-signing-secret>
# OPENCORVUS_VISION_MODEL=qwen3.5-plus
