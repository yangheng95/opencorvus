{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "OpenCorvus",
  "version": "0.0.53-beta",
  "identifier": "ai.opencorvus.overlay",
  "build": {
    "frontendDist": "../dist-vite",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev:vite",
    "beforeBuildCommand": "bun run build:vite"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "OpenCorvus",
        "width": 1280,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 10,
          "y": 16
        },
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": false,
        "backgroundColor": "#f4f4f4",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; base-uri 'self'; object-src 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' asset: http: https: data: blob:; media-src 'self' asset: http: https: data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; worker-src 'self' blob:; frame-src 'self' http: https:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "opencorvus": {
      "initialWorkAreaRatio": 0.8
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "opencorvus"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0QUIwNTE1MjY3MTZBRTIKUldUaWFuRW1GUVdybExYQmhlUDlUQzY2TGs5cG8zUk5TZ3lnenQ3Q3M4eHhoNHl0dm0rREl0SzAK",
      "endpoints": [
        "https://github.com/yangheng95/opencorvus/releases/download/desktop-update-beta/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.0.53.0"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
