{
  "name": "@opencorvus-ai/overlay",
  "version": "0.0.58-beta",
  "private": true,
  "type": "module",
  "scripts": {
    "icons:generate": "bun run script/generate-app-icons.ts",
    "dev": "tauri dev",
    "dev:vite": "vite --config vite.config.ts",
    "build": "bun run build:vite && bun run check:renderer-surface",
    "build:vite": "node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --config vite.config.ts",
    "build:overlay": "bun run script/build-overlay.ts",
    "build:docker": "bun run script/build-docker.ts",
    "typecheck": "tsc --noEmit",
    "check:i18n": "bun run script/check-i18n.ts",
    "check:css-tokens": "bun run script/check-css-token-usage.ts",
    "pretest": "bun ../opencorvus/script/prepare-test-process-supervisor.ts",
    "test": "bun run test:unit",
    "pretest:unit": "bun ../opencorvus/script/prepare-test-process-supervisor.ts",
    "test:unit": "bun run script/run-unit-tests.ts",
    "tauri": "tauri",
    "check:renderer-surface": "bun run script/check-renderer-public-surface.ts"
  },
  "devDependencies": {
    "@opencorvus-ai/util": "workspace:*",
    "@tauri-apps/cli": "^2",
    "jsonc-parser": "3.3.1",
    "vite": "^6",
    "vite-plugin-solid": "^2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@fontsource-variable/geist": "5.2.9",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource-variable/noto-sans-sc": "5.2.10",
    "@google/model-viewer": "^4.3.1",
    "@kobalte/core": "catalog:",
