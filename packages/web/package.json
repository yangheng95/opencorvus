{
  "name": "@opencorvus/web",
  "type": "module",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "brand:assets": "bun run ./script/generate-brand-assets.ts",
    "market:data": "bun run ./script/generate-public-market.ts",
    "predev": "bun run brand:assets && bun run market:data && bun run registry:prepare",
    "dev": "astro dev",
    "prestart": "bun run brand:assets && bun run market:data && bun run registry:prepare",
    "start": "astro dev",
    "prebuild": "bun run brand:assets && bun run market:data",
    "build": "astro build && bun run ./script/copy-landing-downloads.ts && bun run ./script/package-website-runtime.ts",
    "precheck": "bun run brand:assets && bun run market:data",
    "check": "astro check",
    "registry:prepare": "bun run ./script/prepare-website-registry.ts",
    "registry:control": "bun run ./script/website-registry-control.ts",
    "runtime:smoke": "bun run ./test/website-runtime-smoke.ts",
    "pretest:registry": "bun run market:data",
    "test:registry": "bun test ./test/website-registry.test.ts",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/node": "11.1.1",
    "@astrojs/solid-js": "7.0.2",
    "@astrojs/starlight": "0.41.7",
    "@zip.js/zip.js": "2.7.62",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.2.0",
    "rehype-autolink-headings": "7.1.0",
    "solid-js": "catalog:",
    "toolbeam-docs-theme": "0.4.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
