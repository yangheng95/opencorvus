{
  "name": "@opencorvus/web",
  "type": "module",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "brand:assets": "bun run ./script/generate-brand-assets.ts",
    "market:data": "bun run ./script/generate-public-market.ts",
    "facts:data": "bun run ./script/generate-platform-facts.ts",
    "predev": "bun run brand:assets && bun run market:data && bun run facts:data && bun run registry:prepare",
    "dev": "astro dev",
    "prestart": "bun run brand:assets && bun run market:data && bun run facts:data && bun run registry:prepare",
    "start": "astro dev",
    "prebuild": "bun run brand:assets && bun run market:data && bun run facts:data",
    "build": "astro build && bun run ./script/copy-landing-downloads.ts && bun run ./script/package-website-runtime.ts",
    "precheck": "bun run brand:assets && bun run market:data && bun run facts:data",
    "check": "astro check",
    "registry:prepare": "bun run ./script/prepare-website-registry.ts",
    "registry:control": "bun run ./script/website-registry-control.ts",
    "runtime:smoke": "bun run ./test/website-runtime-smoke.ts",
    "pretest:registry": "bun run market:data",
    "test:registry": "bun test ./test/website-registry.test.ts",
    "test:tokens": "bun test ./test/tokens.parity.test.ts",
    "pretest:facts": "bun run facts:data",
    "test:facts": "bun test ./test/platform-facts.test.ts",
    "preview": "astro preview",
    "astro": "astro",
    "qa:shots": "bun run ./qa/restyle/shoot.ts",
    "test:compositions": "bun test ./test/squad-compositions.test.ts",
    "test:benchmark": "bun test ./test/landing-benchmark.test.ts",
    "test:web": "bun test ./test/tokens.parity.test.ts ./test/platform-facts.test.ts ./test/squad-compositions.test.ts ./test/landing-benchmark.test.ts ./test/brand-assets.test.ts ./test/lander-assets.test.ts",
    "test:style": "bun test ./test/style-discipline.test.ts",
    "test:assets": "bun test ./test/brand-assets.test.ts ./test/lander-assets.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/node": "11.1.1",
    "@astrojs/solid-js": "7.0.2",
    "@astrojs/starlight": "0.41.7",
    "@zip.js/zip.js": "2.7.62",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "astro": "7.2.0",
    "rehype-autolink-headings": "7.1.0",
    "solid-js": "catalog:",
    "toolbeam-docs-theme": "0.4.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "playwright": "1.61.1"
  }
}
