---
import EnterpriseArchitectureExplorer from "../../components/EnterpriseArchitectureExplorer.astro"
import config from "../../../config.mjs"

const englishUrl = new URL("/architecture-explorer/", config.url).href
const chineseUrl = new URL("/zh-cn/architecture-explorer/", config.url).href
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="zh-CN" href={chineseUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <title>OpenCorvus 企业级架构工作台</title>
    <meta
      name="description"
      content="当前 OpenCorvus runtime、data、A2A、overlay 与 governance surfaces 的源码可追溯企业级架构工作台。"
    />
  </head>
  <body>
    <EnterpriseArchitectureExplorer locale="zh" standalone={true} />
  </body>
</html>

<style is:global>
  html,
  body {
    min-height: 100%;
    margin: 0;
    background: #f6f3ec;
  }

  body {
    overflow-x: hidden;
  }
</style>
