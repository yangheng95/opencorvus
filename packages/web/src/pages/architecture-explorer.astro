---
import EnterpriseArchitectureExplorer from "../components/EnterpriseArchitectureExplorer.astro"
import Favicon from "../components/Favicon.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Favicon />
    <title>OpenCorvus Enterprise Architecture Workbench</title>
    <meta
      name="description"
      content="Source-traceable OpenCorvus enterprise architecture workbench for runtime, data, A2A, overlay, and governance surfaces."
    />
  </head>
  <body>
    <EnterpriseArchitectureExplorer locale="en" standalone={true} />
  </body>
</html>

<style is:global>
  html,
  body {
    min-height: 100%;
    margin: 0;
    background: #f6f3ec;
  }

  body {
    overflow-x: hidden;
  }
</style>
