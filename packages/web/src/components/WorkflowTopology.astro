---
import { segmentPublicMarketText, type PublicLocale, type PublicSquadRecord } from "../content/public-market"

type Props = {
  record: PublicSquadRecord
  locale: PublicLocale
  expanded?: boolean
}

const { record, locale, expanded = false } = Astro.props
const nodeCount = record.workflows.reduce((total, workflow) => total + workflow.nodes.length, 0)
const copy =
  locale === "zh-cn"
    ? {
        caption: `固定 revision · ${record.workflows.length} 条工作流 · ${nodeCount} 个节点 · ${record.agents.length} 个 Agent`,
        revision: "固定 revision",
        output: "证据输出",
        root: "起点",
        nodes: "个节点",
      }
    : {
        caption: `Bound revision · ${record.workflows.length} workflows · ${nodeCount} nodes · ${record.agents.length} Agents`,
        revision: "Bound revision",
        output: "Evidence output",
        root: "root",
        nodes: "nodes",
      }
---

<figure class:list={["workflow-topology", { "workflow-topology-expanded": expanded }]}>
  <figcaption>{copy.caption}</figcaption>
  <div class="topology-graph">
    <div class="topology-seal" title={`${record.identity.namespace}/${record.identity.id}@${record.identity.version}`}>
      <span>{copy.revision}</span>
      <code lang="en">{record.identity.digest.slice(0, 8)}</code>
    </div>
    <div class="topology-workflows">
      {record.workflows.map((workflow, workflowIndex) => (
        <section class="topology-workflow" aria-labelledby={`topology-${record.identity.id}-${workflow.id}`}>
          <header>
            <span>{String(workflowIndex + 1).padStart(2, "0")}</span>
            <strong id={`topology-${record.identity.id}-${workflow.id}`}>
              {segmentPublicMarketText(locale, workflow.displayLabel[locale]).map((segment) => <span lang={segment.lang}>{segment.text}</span>)}
            </strong>
            <code>{workflow.nodes.length} {copy.nodes}</code>
          </header>
          <ol>
            {workflow.nodes.map((node, nodeIndex) => (
              <li>
                <span class="topology-node-index">{String(nodeIndex + 1).padStart(2, "0")}</span>
                <span class="topology-node-mark" aria-hidden="true"></span>
                <span class="topology-node-copy">
                  <strong lang="en">{node.agentID}</strong>
                  {expanded && <small>{segmentPublicMarketText(locale, node.localizedDescription[locale]).map((segment) => <span lang={segment.lang}>{segment.text}</span>)}</small>}
                  <code lang={node.dependsOn.length === 0 ? undefined : "en"}>{node.dependsOn.length === 0 ? copy.root : `← ${node.dependsOn.join(" + ")}`}</code>
                </span>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
    <div class="topology-output">
      <span>{copy.output}</span>
      <b>{record.workflows.length}</b>
    </div>
  </div>
</figure>

<style>
  /* Self-contained since public-site.css retired. Tokens only — no bare spacing or radius values. */
  .workflow-topology {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--oc-space-2);
  }

  .workflow-topology figcaption {
    font-family: var(--oc-font-mono);
    font-size: 11px;
    color: var(--oc-color-text-description);
  }

  .topology-graph {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--oc-space-3);
    align-items: stretch;
    padding: var(--oc-space-3);
    border: 1px solid var(--oc-color-border-subtle);
    border-radius: var(--oc-radius-panel);
    background: var(--oc-color-bg-surface-4);
  }

  .topology-seal,
  .topology-output {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--oc-space-1);
    padding: var(--oc-space-2);
    border-radius: var(--oc-radius-sm);
    background: var(--oc-color-bg-surface-5);
    font-size: 10px;
    line-height: 1.3;
    text-align: center;
    color: var(--oc-color-text-description);
    min-width: 62px;
  }

  .topology-seal code {
    font-family: var(--oc-font-mono);
    font-size: 10px;
    color: var(--oc-color-text-secondary);
  }

  .topology-output b {
    font-family: var(--oc-font-display);
    font-size: 18px;
    font-weight: 500;
    color: var(--oc-color-text-primary);
  }

  .topology-workflows {
    display: flex;
    flex-direction: column;
    gap: var(--oc-space-3);
    min-width: 0;
  }

  .topology-workflow header {
    display: flex;
    align-items: baseline;
    gap: var(--oc-space-2);
    font-size: 12px;
  }

  .topology-workflow header > span {
    font-family: var(--oc-font-mono);
    font-size: 10px;
    color: var(--oc-color-brand);
  }

  .topology-workflow header strong {
    font-weight: 500;
    color: var(--oc-color-text-primary);
    min-width: 0;
  }

  .topology-workflow header code {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--oc-font-mono);
    font-size: 10px;
    color: var(--oc-color-text-description);
  }

  .topology-workflow ol {
    list-style: none;
    margin: var(--oc-space-2) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--oc-space-2);
  }

  .topology-workflow li {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: var(--oc-space-1);
    align-items: center;
    padding: var(--oc-space-1) var(--oc-space-2);
    border: 1px solid var(--oc-color-border-subtle);
    border-radius: var(--oc-radius-sm);
    background: var(--oc-color-bg-surface-3);
  }

  .topology-node-index {
    font-family: var(--oc-font-mono);
    font-size: 9px;
    color: var(--oc-color-text-placeholder);
  }

  /* The dependency dot. Purely decorative, hence aria-hidden at the markup level. */
  .topology-node-mark {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--oc-color-brand);
    opacity: 0.65;
  }

  .topology-node-copy {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .topology-node-copy strong {
    font-family: var(--oc-font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--oc-color-text-secondary);
  }

  .topology-node-copy small {
    font-size: 11px;
    line-height: 1.45;
    color: var(--oc-color-text-description);
  }

  .topology-node-copy code {
    font-family: var(--oc-font-mono);
    font-size: 9px;
    color: var(--oc-color-text-placeholder);
  }

  /* Expanded is the detail page: node descriptions appear, so rows go full width to stay readable. */
  .workflow-topology-expanded .topology-workflow ol {
    flex-direction: column;
    flex-wrap: nowrap;
  }

  .workflow-topology-expanded .topology-workflow li {
    width: 100%;
    align-items: start;
    padding: var(--oc-space-2) var(--oc-space-3);
  }

  @media (max-width: 640px) {
    .topology-graph {
      grid-template-columns: minmax(0, 1fr);
    }

    .topology-seal,
    .topology-output {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }
  }
</style>
