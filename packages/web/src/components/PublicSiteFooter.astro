---
import { publicPath, type PublicLocale } from "../content/public-market"
import VisitorCount from "./VisitorCount.astro"

const { locale } = Astro.props as { locale: PublicLocale }
const copy =
  locale === "zh-cn"
    ? { statement: "定制 Agent 工作台、配置专家团，与社区一起拓展 Agent 长程工作的可能。", docs: "文档", source: "源代码", discuss: "讨论" }
    : {
        statement: "Customize your Agent Workbench, configure Expert Squads, and help grow an open community for long-horizon Agent work.",
        docs: "Documentation",
        source: "Source",
        discuss: "Discussions",
      }
---

<footer class="public-footer">
  <p class="footer-mark">OpenCorvus</p>
  <p>{copy.statement}</p>
  <VisitorCount {locale} />
  <nav aria-label={locale === "zh-cn" ? "页脚" : "Footer"}>
    <a href={publicPath(locale, "/start/quickstart/")}>{copy.docs}</a>
    <a href="https://github.com/yangheng95/opencorvus">{copy.source}</a>
    <a href="https://github.com/yangheng95/opencorvus/discussions">{copy.discuss}</a>
  </nav>
</footer>
