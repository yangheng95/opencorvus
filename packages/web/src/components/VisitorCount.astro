---
type Props = { locale: "root" | "zh-cn"; surface?: "public" | "docs" }
const { locale, surface = "public" } = Astro.props
const copy = locale === "zh-cn"
  ? {
      label: "近 30 天估算参与浏览器数",
      loading: "正在读取统计…",
      unavailable: "访问统计暂不可用",
      note: "自愿加入的第一方浏览器令牌 · 不存储 IP 或浏览器指纹",
      join: "将此浏览器计入",
      leave: "不再统计此浏览器",
    }
  : {
      label: "30-day estimated participating browsers",
      loading: "Reading count…",
      unavailable: "Visitor count unavailable",
      note: "Opt-in first-party browser tokens · no IP or fingerprint stored",
      join: "Count this browser",
      leave: "Don't count this browser",
    }
---

<aside
  class:list={["visitor-count", `visitor-count--${surface}`]}
  data-visitor-count
  data-loading={copy.loading}
  data-unavailable={copy.unavailable}
  data-join={copy.join}
  data-leave={copy.leave}
>
  <p class="visitor-count__label">{copy.label}</p>
  <p class="visitor-count__value" data-visitor-value aria-live="polite">—</p>
  <p class="visitor-count__note">{copy.note}</p>
  <button class="visitor-count__control" type="button" data-visitor-control disabled>{copy.loading}</button>
  <noscript><p class="visitor-count__noscript">{copy.unavailable}</p></noscript>
</aside>

<script>
  type VisitorPayload = {
    estimatedParticipatingBrowsers: number
    participating: boolean
    renewalDue: boolean
    counted?: boolean
  }

  const renderVisitorCount = (root: HTMLElement, payload: VisitorPayload) => {
    const value = root.querySelector<HTMLElement>("[data-visitor-value]")
    const control = root.querySelector<HTMLButtonElement>("[data-visitor-control]")
    if (!value || !control) return
    value.textContent = new Intl.NumberFormat(document.documentElement.lang).format(payload.estimatedParticipatingBrowsers)
    control.textContent = payload.participating ? root.dataset.leave! : root.dataset.join!
    control.dataset.participating = String(payload.participating)
    control.disabled = false
  }

  const readVisitorCount = async () => {
    const response = await fetch("/api/site/v1/visitors", { credentials: "same-origin", cache: "no-store" })
    if (!response.ok) throw new Error("visitor count unavailable")
    return await response.json() as VisitorPayload
  }

  document.querySelectorAll<HTMLElement>("[data-visitor-count]").forEach(async (root) => {
    const value = root.querySelector<HTMLElement>("[data-visitor-value]")
    const control = root.querySelector<HTMLButtonElement>("[data-visitor-control]")
    if (!value || !control) return
    try {
      const payload = await readVisitorCount()
      renderVisitorCount(root, payload)
      if (payload.participating && payload.renewalDue) {
        const renewed = await fetch("/api/site/v1/visitors", {
          method: "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ purpose: "footer-count" }),
        })
        if (renewed.ok) renderVisitorCount(root, await readVisitorCount())
      }
    } catch {
      value.textContent = root.dataset.unavailable!
      control.hidden = true
      return
    }
    control.addEventListener("click", async () => {
      control.disabled = true
      const participating = control.dataset.participating === "true"
      try {
        const response = await fetch(participating ? "/api/site/v1/visitors/current" : "/api/site/v1/visitors", {
          method: participating ? "DELETE" : "POST",
          credentials: "same-origin",
          headers: { "content-type": "application/json" },
          body: participating ? undefined : JSON.stringify({ purpose: "footer-count" }),
        })
        if (!response.ok) throw new Error("visitor preference unavailable")
        await response.json()
        renderVisitorCount(root, await readVisitorCount())
      } catch {
        value.textContent = root.dataset.unavailable!
        control.disabled = false
      }
    })
  })
</script>

<style>
  .visitor-count {
    min-width: 0;
  }

  .visitor-count p {
    margin: 0;
  }

  .visitor-count__label {
    color: inherit;
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.055em;
    text-transform: uppercase;
  }

  .visitor-count__value {
    margin-top: 0.35rem !important;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
  }

  .visitor-count__note,
  .visitor-count__noscript {
    margin-top: 0.55rem !important;
    max-width: 19rem;
    font-size: 0.72rem;
    line-height: 1.45;
    opacity: 0.72;
  }

  .visitor-count__control {
    min-height: 44px;
    margin-top: 0.65rem;
    padding: 0 0.8rem;
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    cursor: pointer;
  }

  .visitor-count__control:focus-visible {
    outline: 3px solid #3d55cc;
    outline-offset: 3px;
  }

  .visitor-count__control:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .visitor-count--public {
    padding-left: 1.25rem;
    border-left: 2px solid currentColor;
  }

  .visitor-count--docs {
    margin-top: 1.25rem;
    padding: 1rem;
    border: 1px solid var(--sl-color-border);
    background: var(--sl-color-bg-nav);
  }
</style>
