---
import "../styles/public-site.css"
import Favicon from "./Favicon.astro"
import PublicSiteHeader from "./PublicSiteHeader.astro"
import PublicSiteFooter from "./PublicSiteFooter.astro"
import config from "../../config.mjs"
import type { PublicLocale } from "../content/public-market"

type Props = {
  locale: PublicLocale
  current: "home" | "mission" | "use-with-agents" | "market" | "publish" | "trust" | "download"
  title: string
  description: string
  languageHref: string
  socialImage?: string
}

const { locale, current, title, description, languageHref, socialImage } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, config.url).href
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const ogImage = new URL(socialImage ?? `${publicBase}/og.png`, config.url).href
---

<!doctype html>
<html
  lang={locale === "zh-cn" ? "zh-CN" : "en"}
  data-public-locale={locale}
  data-public-surface={current}
  data-public-language-href={languageHref}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e8" />
    <Favicon />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const root = document.documentElement
        const locale = root.dataset.publicLocale
        const surface = root.dataset.publicSurface
        const languageHref = root.dataset.publicLanguageHref
        const preferenceKey = "opencorvus.public-locale"
        const readPreference = () => {
          try {
            const value = localStorage.getItem(preferenceKey)
            return value === "root" || value === "zh-cn" ? value : null
          } catch {
            return null
          }
        }
        const writePreference = (value) => {
          try {
            localStorage.setItem(preferenceKey, value)
          } catch {
            // The URL locale remains authoritative when storage is unavailable.
          }
        }

        document.addEventListener(
          "click",
          (event) => {
            const target = event.target instanceof Element ? event.target.closest("[data-public-locale-switch]") : null
            const targetLocale = target?.dataset.targetLocale
            if (targetLocale === "root" || targetLocale === "zh-cn") writePreference(targetLocale)
          },
          { capture: true },
        )

        if (locale === "zh-cn") {
          writePreference("zh-cn")
          return
        }
        if (surface !== "home") {
          writePreference("root")
          return
        }

        const preference = readPreference()
        const preferredSupportedLanguage = (
          navigator.languages?.length ? navigator.languages : [navigator.language]
        ).find((language) => /^(?:en|zh)(?:-|$)/i.test(language))
        const browserPrefersChinese = /^zh(?:-|$)/i.test(preferredSupportedLanguage ?? "")
        if ((preference === "zh-cn" || (preference === null && browserPrefersChinese)) && languageHref) {
          const target = new URL(languageHref, window.location.href)
          if (target.pathname !== window.location.pathname) window.location.replace(target.href)
        }
      })()
    </script>
  </head>
  <body class:list={["public-site-body", current === "use-with-agents" && "public-agent-hosts-body"]}>
    <PublicSiteHeader {locale} {current} {languageHref} />
    <slot />
    <PublicSiteFooter {locale} />
  </body>
</html>
