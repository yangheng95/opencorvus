---
import "../styles/public-site.css"
import PublicSiteHeader from "./PublicSiteHeader.astro"
import PublicSiteFooter from "./PublicSiteFooter.astro"
import config from "../../config.mjs"
import type { PublicLocale } from "../content/public-market"

type Props = {
  locale: PublicLocale
  current: "use-with-agents" | "market" | "publish" | "trust" | "download"
  title: string
  description: string
  languageHref: string
}

const { locale, current, title, description, languageHref } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, config.url).href
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const ogImage = new URL(`${publicBase}/og.png`, config.url).href
---

<!doctype html>
<html lang={locale === "zh-cn" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f1e8" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class:list={["public-site-body", current === "use-with-agents" && "public-agent-hosts-body"]}>
    <PublicSiteHeader {locale} {current} {languageHref} />
    <slot />
    <PublicSiteFooter {locale} />
  </body>
</html>
