---
import type { LandingLocale } from "../content/landing"

type Props = {
  locale: LandingLocale
  description: string
}

type FlowNode = {
  id: string
  x: number
  y: number
  width: number
  title: string
  subtitle: string
  kind: "direction" | "work" | "review" | "outcome"
  phase: number
}

type FlowEdge = {
  id: string
  path: string
  phase: number
  feedback?: boolean
}

const { locale, description } = Astro.props
const isChinese = locale === "zh-cn"

const copy = isChinese
  ? {
      title: "Mission 自动交付流程",
      lanes: ["成果流 A", "成果流 B"],
      sections: ["并行推进", "独立把关", "统一交付"],
      nodes: {
        goal: ["目标", "结果 · 边界"],
        mission: ["Mission", "对结果负责"],
        discover: ["识别", "事实 · 风险"],
        plan: ["规划", "路径 · 验收"],
        execute: ["执行", "并行协同"],
        review: ["把关", "质量 · 体验"],
        handoff: ["交接", "结论 · 风险"],
        merge: ["整合", "解决冲突缺口"],
        decision: ["决策", "结果 · 风险 · 选项"],
      },
      steps: [
        "明确经营结果、边界和成功标准，不进入执行细节。",
        "Mission 对最终结果负责，把目标拆成可独立推进的成果流。",
        "两条成果流并行识别事实、依赖和关键风险。",
        "每条成果流先明确实现路径与验收标准，再投入执行。",
        "资源围绕成果并行展开，缩短关键路径并减少等待。",
        "质量和体验由独立角色把关，避免执行团队自验自收。",
        "阶段成果以结论、风险和建议完成交接，不上抛内部过程。",
        "Mission 处理跨成果流的冲突、依赖与缺口，形成单一结果。",
        "决策者收到可执行结果、关键风险和下一步选项。",
        "经营决策和市场反馈回到 Mission，驱动下一轮目标迭代。",
      ],
    }
  : {
      title: "Mission autonomous delivery flow",
      lanes: ["Outcome stream A", "Outcome stream B"],
      sections: ["Parallel delivery", "Independent review", "Unified outcome"],
      nodes: {
        goal: ["Goal", "Outcome · scope"],
        mission: ["Mission", "Owns final result"],
        discover: ["Discover", "Facts · risks"],
        plan: ["Plan", "Path · acceptance"],
        execute: ["Execute", "Parallel specialists"],
        review: ["Review", "Quality · experience"],
        handoff: ["Handoff", "Conclusion · risk"],
        merge: ["Integrate", "Resolve gaps"],
        decision: ["Decision", "Result · risk · options"],
      },
      steps: [
        "Define the intended outcome, boundaries, and success standard without prescribing execution details.",
        "Mission owns the final result and divides the goal into independently deliverable outcome streams.",
        "Parallel streams identify facts, dependencies, and material risks.",
        "Each stream defines its delivery path and acceptance standard before execution begins.",
        "Specialists work around outcomes in parallel to shorten the critical path and reduce waiting.",
        "Independent roles review quality and experience instead of asking delivery teams to approve themselves.",
        "Each stream hands off conclusions, risks, and recommendations rather than internal process detail.",
        "Mission resolves cross-stream conflicts, dependencies, and gaps into one coherent result.",
        "Decision-makers receive an actionable result, material risks, and clear next-step options.",
        "Decisions and market feedback return to Mission and start the next goal cycle.",
      ],
    }

const nodes: FlowNode[] = [
  { id: "goal", x: 24, y: 72, width: 140, title: copy.nodes.goal[0], subtitle: copy.nodes.goal[1], kind: "direction", phase: 0 },
  { id: "mission", x: 24, y: 230, width: 140, title: copy.nodes.mission[0], subtitle: copy.nodes.mission[1], kind: "direction", phase: 1 },
  { id: "discover-a", x: 190, y: 100, width: 135, title: copy.nodes.discover[0], subtitle: copy.nodes.discover[1], kind: "work", phase: 2 },
  { id: "plan-a", x: 345, y: 100, width: 135, title: copy.nodes.plan[0], subtitle: copy.nodes.plan[1], kind: "work", phase: 3 },
  { id: "execute-a", x: 500, y: 100, width: 150, title: copy.nodes.execute[0], subtitle: copy.nodes.execute[1], kind: "work", phase: 4 },
  { id: "review-a", x: 670, y: 100, width: 150, title: copy.nodes.review[0], subtitle: copy.nodes.review[1], kind: "review", phase: 5 },
  { id: "handoff-a", x: 840, y: 100, width: 135, title: copy.nodes.handoff[0], subtitle: copy.nodes.handoff[1], kind: "outcome", phase: 6 },
  { id: "discover-b", x: 190, y: 350, width: 135, title: copy.nodes.discover[0], subtitle: copy.nodes.discover[1], kind: "work", phase: 2 },
  { id: "plan-b", x: 345, y: 350, width: 135, title: copy.nodes.plan[0], subtitle: copy.nodes.plan[1], kind: "work", phase: 3 },
  { id: "execute-b", x: 500, y: 350, width: 150, title: copy.nodes.execute[0], subtitle: copy.nodes.execute[1], kind: "work", phase: 4 },
  { id: "review-b", x: 670, y: 350, width: 150, title: copy.nodes.review[0], subtitle: copy.nodes.review[1], kind: "review", phase: 5 },
  { id: "handoff-b", x: 840, y: 350, width: 135, title: copy.nodes.handoff[0], subtitle: copy.nodes.handoff[1], kind: "outcome", phase: 6 },
  { id: "merge", x: 982, y: 230, width: 124, title: copy.nodes.merge[0], subtitle: copy.nodes.merge[1], kind: "outcome", phase: 7 },
  { id: "decision", x: 982, y: 432, width: 124, title: copy.nodes.decision[0], subtitle: copy.nodes.decision[1], kind: "direction", phase: 8 },
]

const edges: FlowEdge[] = [
  { id: "goal-mission", path: "M 94 130 L 94 230", phase: 1 },
  { id: "mission-discover-a", path: "M 164 259 C 220 173, 140 185, 190 129", phase: 2 },
  { id: "mission-discover-b", path: "M 164 259 C 220 345, 140 323, 190 379", phase: 2 },
  { id: "discover-plan-a", path: "M 325 129 L 345 129", phase: 3 },
  { id: "discover-plan-b", path: "M 325 379 L 345 379", phase: 3 },
  { id: "plan-execute-a", path: "M 480 129 L 500 129", phase: 4 },
  { id: "plan-execute-b", path: "M 480 379 L 500 379", phase: 4 },
  { id: "execute-review-a", path: "M 650 129 L 670 129", phase: 5 },
  { id: "execute-review-b", path: "M 650 379 L 670 379", phase: 5 },
  { id: "review-handoff-a", path: "M 820 129 L 840 129", phase: 6 },
  { id: "review-handoff-b", path: "M 820 379 L 840 379", phase: 6 },
  { id: "handoff-merge-a", path: "M 975 129 C 1028 129, 1044 176, 1044 230", phase: 7 },
  { id: "handoff-merge-b", path: "M 975 379 C 1028 379, 1044 342, 1044 288", phase: 7 },
  { id: "merge-decision", path: "M 1044 288 L 1044 432", phase: 8 },
  { id: "decision-mission", path: "M 1044 490 C 964 514, 210 514, 94 288", phase: 9, feedback: true },
]
---

<div class="mission-flow">
  <svg viewBox="0 0 1120 520" role="img" aria-labelledby="mission-flow-title mission-flow-description">
    <title id="mission-flow-title">{copy.title}</title>
    <desc id="mission-flow-description">{description}</desc>
    <defs>
      <marker id="mission-flow-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z"></path>
      </marker>
    </defs>

    <text class="lane-label" x="190" y="82">{copy.lanes[0]}</text>
    <text class="lane-label" x="190" y="332">{copy.lanes[1]}</text>
    <text class="section-label" x="575" y="32">{copy.sections[0]}</text>
    <text class="section-label" x="745" y="32">{copy.sections[1]}</text>
    <text class="section-label" x="1018" y="32">{copy.sections[2]}</text>

    <g aria-hidden="true">
      {edges.map((edge) => (
        <g>
          <path class:list={["flow-edge-base", { feedback: edge.feedback }]} d={edge.path}></path>
          <path class="flow-edge-active" d={edge.path} style={`--phase: ${edge.phase};`}></path>
        </g>
      ))}
    </g>

    <g aria-hidden="true">
      {nodes.map((node) => (
        <g class="flow-node" data-kind={node.kind} style={`--phase: ${node.phase};`}>
          <rect x={node.x} y={node.y} width={node.width} height="58" rx="10"></rect>
          <text x={node.x + node.width / 2} y={node.y + 24}>{node.title}</text>
          <text class="node-subtitle" x={node.x + node.width / 2} y={node.y + 44}>{node.subtitle}</text>
        </g>
      ))}
      <rect class="feedback-highlight" x="24" y="230" width="140" height="58" rx="10"></rect>
      <rect class="feedback-highlight" x="982" y="432" width="124" height="58" rx="10"></rect>
    </g>
  </svg>

  <div class="flow-status" aria-hidden="true">
    {copy.steps.map((step, index) => (
      <div class="flow-status-item" style={`--phase: ${index};`}>
        <span>{index + 1} / {copy.steps.length}</span>
        <p>{step}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .mission-flow {
    --cycle: 15s;
    --stage: 1.5s;
    background: #0b0b0b;
    color: #f5f5f2;
    padding: 0.8rem 0.8rem 0.9rem;
  }

  svg {
    display: block;
    height: auto;
    overflow: visible;
    width: 100%;
  }

  .section-label,
  .lane-label {
    fill: #7d7d7d;
    font-family: inherit;
    font-size: 17px;
    font-weight: 560;
    letter-spacing: 0.04em;
  }

  .section-label { text-anchor: middle; }

  marker path { fill: #8c8c8c; }

  .flow-edge-base,
  .flow-edge-active {
    fill: none;
    marker-end: url(#mission-flow-arrow);
    vector-effect: non-scaling-stroke;
  }

  .flow-edge-base {
    stroke: #505050;
    stroke-width: 1.35;
  }

  .flow-edge-base.feedback { stroke-dasharray: 5 5; }

  .flow-edge-active {
    animation: edge-progress var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--stage));
    marker-end: none;
    opacity: 0;
    stroke: #f5f5f2;
    stroke-dasharray: 8 6;
    stroke-width: 2.4;
  }

  .flow-node {
    animation: node-progress var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--stage));
    opacity: 0.42;
    transform-box: fill-box;
    transform-origin: center;
  }

  .flow-node rect {
    stroke: #8a8a8a;
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }

  .flow-node[data-kind="direction"] rect { fill: #f5f5f2; }
  .flow-node[data-kind="work"] rect { fill: #d9d9d4; }
  .flow-node[data-kind="review"] rect { fill: #bdbdb7; }
  .flow-node[data-kind="outcome"] rect { fill: #ecece7; }

  .flow-node text {
    fill: #0b0b0b;
    font-family: inherit;
    font-size: 17px;
    font-weight: 720;
    pointer-events: none;
    text-anchor: middle;
  }

  .flow-node .node-subtitle {
    fill: #555555;
    font-size: 13.5px;
    font-weight: 520;
  }

  .feedback-highlight {
    animation: feedback-progress var(--cycle) linear infinite;
    animation-delay: calc(9 * var(--stage));
    fill: none;
    opacity: 0;
    stroke: #f5f5f2;
    stroke-width: 2.3;
    vector-effect: non-scaling-stroke;
  }

  .flow-status {
    border-top: 1px solid #2d2d2d;
    height: 3.5rem;
    margin-top: 0.25rem;
    position: relative;
  }

  .flow-status-item {
    align-items: center;
    animation: status-progress var(--cycle) linear infinite;
    animation-delay: calc(var(--phase) * var(--stage));
    display: grid;
    gap: 0.65rem;
    grid-template-columns: auto 1fr;
    inset: 0;
    opacity: 0;
    position: absolute;
  }

  .flow-status-item span {
    border: 1px solid #505050;
    border-radius: 999px;
    color: #d4d4d4;
    font: 600 0.6rem ui-monospace, "SFMono-Regular", Consolas, monospace;
    padding: 0.28rem 0.42rem;
    white-space: nowrap;
  }

  .flow-status-item p {
    color: #c8c8c8;
    font-size: 0.66rem;
    line-height: 1.45;
    margin: 0;
  }

  @keyframes node-progress {
    0%, 9.7% { opacity: 1; transform: translateY(-2px); }
    10%, 100% { opacity: 0.42; transform: translateY(0); }
  }

  @keyframes edge-progress {
    0% { opacity: 1; stroke-dashoffset: 0; }
    9.7% { opacity: 1; stroke-dashoffset: -42; }
    10%, 100% { opacity: 0; stroke-dashoffset: -42; }
  }

  @keyframes feedback-progress {
    0%, 9.7% { opacity: 1; }
    10%, 100% { opacity: 0; }
  }

  @keyframes status-progress {
    0%, 9.7% { opacity: 1; }
    10%, 100% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-edge-active { stroke-dashoffset: 0; }
    .flow-node { transform: none; }
  }
</style>
