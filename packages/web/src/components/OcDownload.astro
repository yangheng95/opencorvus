---
import { readDownloadManifest, formatBytes } from "../lib/landing-downloads"
import { landingCopy } from "../content/landing-copy"
import type { PublicLocale } from "../content/public-market"
import config from "../../config.mjs"
const { locale } = Astro.props as { locale: PublicLocale }
const copy = landingCopy[locale]
const downloads = readDownloadManifest()
---
          <div
            class="oc-download"
            data-oc-download
            data-download-verb={copy.hero.download.verb}
            data-download-version={downloads?.version ?? ""}
          >
            <a
              class="oc-btn oc-btn-primary oc-btn-m oc-download-primary"
              href={downloads?.releaseUrl ?? config.github}
              data-oc-download-primary
            >
              <span data-oc-download-label>
                {copy.hero.download.label}
              </span>
            </a>

            {
              downloads && (
                <details class="oc-download-menu" data-oc-download-menu>
                  <summary
                    class="oc-btn oc-btn-primary oc-btn-m oc-download-toggle"
                    aria-label={copy.hero.download.menuLabel}
                    title={copy.hero.download.menuLabel}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </summary>

                  <div class="oc-glass-dropdown oc-download-panel">
                    <p class="oc-eyebrow oc-download-panel-title">{copy.hero.download.allPlatforms}</p>
                    {
                      downloads.groups.map((group) => (
                        <section class="oc-download-group">
                          <p class="oc-download-group-name">{group.label}</p>
                          <ul>
                            {group.assets.map((asset) => (
                              <li>
                                <a
                                  href={asset.url}
                                  download={asset.fileName}
                                  title={asset.fileName}
                                  data-oc-download-asset
                                  data-oc-download-platform={asset.platform}
                                  data-oc-download-architecture={asset.architecture}
                                  data-oc-download-format={asset.format}
                                  data-oc-download-file={asset.fileName}
                                  data-oc-download-version={downloads.version}
                                >
                                  <span class="oc-download-asset-meta">
                                    <span>{asset.architecture} · {asset.format} · {downloads.version}</span>
                                    <span class="oc-download-file">{asset.fileName}</span>
                                  </span>
                                  <span class="oc-download-size">{formatBytes(asset.bytes)}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))
                    }
                    <p class="oc-text-xs oc-text-description oc-download-note">
                      {copy.hero.download.releaseNote}
                      {downloads.version && ` · ${downloads.version}`}
                    </p>
                  </div>
                </details>
              )
            }
          </div>
<style>
  .oc-download {
    position: relative;
    display: inline-flex;
    align-items: stretch;
  }

  .oc-download-primary {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    padding-right: var(--oc-space-4);
  }

  /* Flush against the primary, with the divider drawn inside the pill. The previous 1px margin let
     the page background through and read as a crack across the button rather than a seam between
     two halves of one control. */
  .oc-download-toggle {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding-inline: var(--oc-space-3);
    border-left: 1px solid var(--oc-btn-primary-divider);
    list-style: none;
  }

  .oc-download-toggle::-webkit-details-marker {
    display: none;
  }

  .oc-download-toggle svg {
    transition: transform 0.2s ease;
  }

  /* The <details> is the flex item that stretches, but the <summary> inside it does not inherit
     that height — which left the caret half 5px shorter than the button it is joined to. Making
     the disclosure a flex container passes the stretch through to its summary. */
  .oc-download-menu {
    display: flex;
    align-items: stretch;
  }

  .oc-download-menu[open] .oc-download-toggle svg {
    transform: rotate(180deg);
  }

  .oc-download-panel {
    position: absolute;
    z-index: 20;
    bottom: calc(100% + var(--oc-space-2));
    left: 0;
    width: max(100%, 390px);
    /* Bounded twice: never taller than the viewport allows, and never so tall that it dominates
       the hero on a big screen. Anything beyond that scrolls inside the panel. */
    max-height: min(60vh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--oc-space-4);
  }

  .oc-download-panel-title {
    margin-bottom: var(--oc-space-3);
  }

  .oc-download-group + .oc-download-group {
    margin-top: var(--oc-space-4);
  }

  .oc-download-group-name {
    margin: 0 0 var(--oc-space-2);
    font-size: 13px;
    font-weight: 500;
    color: var(--oc-color-text-primary);
  }

  .oc-download-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .oc-download-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--oc-space-3);
    padding: var(--oc-space-2) var(--oc-space-3);
    border-radius: var(--oc-radius-sm);
    font-size: 14px;
    color: var(--oc-color-text-secondary);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .oc-download-group a:hover {
    color: var(--oc-color-text-primary);
    background: var(--oc-color-bg-hover);
  }

  /* The detected build is marked in the list too, so opening the menu confirms rather than
     contradicts what the button already says. */
  .oc-download-group a[data-detected="true"] {
    color: var(--oc-color-text-primary);
    background: var(--oc-color-bg-surface-5);
  }

  .oc-download-asset-meta {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .oc-download-file {
    overflow-wrap: anywhere;
    font-family: var(--oc-font-mono);
    font-size: 10px;
    line-height: 1.35;
    color: var(--oc-color-text-description);
  }

  .oc-download-size {
    font-family: var(--oc-font-mono);
    font-size: 12px;
    color: var(--oc-color-text-description);
    white-space: nowrap;
  }

  .oc-download-note {
    margin-top: var(--oc-space-4);
    padding-top: var(--oc-space-3);
    border-top: 1px solid var(--oc-color-border-subtle);
  }

  @media (max-width: 448px) {
    /* The CTA group goes full-width single-column here; the split control has to follow or the
       disclosure ends up on its own row. */
    .oc-download {
      width: 100%;
    }

    .oc-download-primary {
      flex: 1;
    }

    .oc-download-panel {
      width: 100%;
    }
  }

</style>
<script>
  const downloadRoot = document.querySelector<HTMLElement>("[data-oc-download]")
  if (downloadRoot) {
    const primary = downloadRoot.querySelector<HTMLAnchorElement>("[data-oc-download-primary]")
    const label = downloadRoot.querySelector<HTMLElement>("[data-oc-download-label]")
    const menu = downloadRoot.querySelector<HTMLDetailsElement>("[data-oc-download-menu]")

    const PLATFORM_LABEL: Record<string, string> = { windows: "Windows", macos: "macOS", linux: "Linux" }

    type DetectedDownloadTarget = { platform: string; architecture?: string }

    const namedPlatform = (value: string | undefined) => {
      const text = (value ?? "").toLowerCase()
      if (text.includes("win")) return "windows"
      if (text.includes("mac")) return "macos"
      if (text.includes("linux") || text.includes("x11") || text.includes("cros")) return "linux"
      return null
    }

    async function detect(): Promise<DetectedDownloadTarget | null> {
      const uaData = (
        navigator as Navigator & {
          userAgentData?: {
            platform?: string
            getHighEntropyValues?: (hints: string[]) => Promise<{ platform?: string; architecture?: string; bitness?: string }>
          }
        }
      ).userAgentData
      const coarsePlatform =
        namedPlatform(uaData?.platform) ?? namedPlatform(navigator.platform) ?? namedPlatform(navigator.userAgent)
      if (!uaData?.getHighEntropyValues) return coarsePlatform ? { platform: coarsePlatform } : null

      try {
        const hints = await uaData.getHighEntropyValues(["platform", "architecture", "bitness"])
        const platform = namedPlatform(hints.platform ?? uaData.platform) ?? coarsePlatform
        if (!platform) return null
        if (hints.architecture === "arm") return { platform, architecture: "arm64" }
        if (hints.architecture === "x86" && hints.bitness === "64") return { platform, architecture: "x64" }
        return { platform }
      } catch {
        return coarsePlatform ? { platform: coarsePlatform } : null
      }
    }

    if (primary && menu) {
      primary.addEventListener("click", (event) => {
        if (primary.dataset.ocDownloadReady === "true") return
        event.preventDefault()
        menu.open = true
        menu.querySelector("summary")?.focus()
      })
    }

    void (async () => {
      const target = await detect()
      if (!target || !primary || !label) return

      const platformAssets = Array.from(
        downloadRoot.querySelectorAll<HTMLAnchorElement>(
          `[data-oc-download-asset][data-oc-download-platform="${target.platform}"]`,
        ),
      )
      const architectures = new Set(platformAssets.map((asset) => asset.dataset.ocDownloadArchitecture))
      const architecture = target.architecture ?? (architectures.size === 1 ? [...architectures][0] : undefined)
      if (!architecture) return

      // The manifest orders the normal installer before alternatives, so the first match is the
      // platform's preferred current asset (EXE before MSI on Windows).
      const match = platformAssets.find((asset) => asset.dataset.ocDownloadArchitecture === architecture)
      if (!match) return

      const verb = downloadRoot.dataset.downloadVerb ?? ""
      const fileName = match.dataset.ocDownloadFile ?? ""
      primary.href = match.href
      primary.download = fileName
      primary.title = fileName
      primary.dataset.ocDownloadReady = "true"
      label.textContent = `${verb} ${PLATFORM_LABEL[target.platform] ?? target.platform}`.trim()
      match.dataset.detected = "true"
    })()

    // A disclosure stays open until it is clicked again, which is wrong for a menu.
    if (menu) {
      const panel = menu.querySelector<HTMLElement>(".oc-download-panel")
      const placeMenu = () => {
        if (!menu.open || !panel) return
        const bounds = downloadRoot.getBoundingClientRect()
        const above = Math.max(0, bounds.top - 80)
        const below = Math.max(0, window.innerHeight - bounds.bottom - 16)
        const upward = above >= below
        panel.style.maxHeight = `${Math.min(420, upward ? above : below)}px`
        panel.style.top = upward ? "auto" : "calc(100% + 8px)"
        panel.style.bottom = upward ? "calc(100% + 8px)" : "auto"
      }
      menu.addEventListener("toggle", placeMenu)
      window.addEventListener("resize", placeMenu)
      window.addEventListener("scroll", placeMenu, { passive: true })
      document.addEventListener("click", (event) => {
        if (menu.open && event.target instanceof Node && !downloadRoot.contains(event.target)) menu.open = false
      })
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false
          menu.querySelector("summary")?.focus()
        }
      })
    }
  }
</script>
