---
import { Image } from "astro:assets"
import ExpertSquadCatalog from "../assets/lander/expert-squad-catalog.png"
import ExpertSquadInstalled from "../assets/lander/expert-squad-installed.png"
import CodeHarness from "../assets/lander/harness-gallery/code-harness.png"
import ExpertSquadsHarness from "../assets/lander/harness-gallery/expert-squads.png"
import MissionHarness from "../assets/lander/harness-gallery/mission-composer.png"
import WorkHarness from "../assets/lander/harness-gallery/work-harness.png"
import RuntimeDesktopContinuity from "../assets/lander/runtime-desktop-continuity-agent-v2.png"
import PublicSiteLayout from "./PublicSiteLayout.astro"
import { landingContent, type LandingLocale } from "../content/landing"
import { publicPath } from "../content/public-market"
import "../styles/public-site.css"

type Props = {
  locale: LandingLocale
}

const { locale } = Astro.props
const content = landingContent[locale]
const languageHref = publicPath(locale === "zh-cn" ? "root" : "zh-cn")
const galleryImages = {
  work: WorkHarness,
  code: CodeHarness,
  mission: MissionHarness,
  squads: ExpertSquadsHarness,
} as const
const metadata =
  locale === "zh-cn"
    ? {
        title: "OpenCorvus | 面向编码智能体的工程基础设施",
        description: "定制你的 Agent 工作台，配置专家团，让长程任务从首次指令走到可审查交付。",
      }
    : {
        title: "OpenCorvus | Engineering infrastructure for coding agents",
        description: "Customize your Agent Workbench, configure Expert Squads, and carry long-horizon work from first instruction to reviewable delivery.",
      }
---

<PublicSiteLayout
  {locale}
  current="home"
  title={metadata.title}
  description={metadata.description}
  {languageHref}
  socialImage="/social-share.png"
>
  <div class="public-landing">
  <main id="main-content" class="public-main" tabindex="-1">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="landing-title" aria-label={content.hero.titleLines.join(locale === "zh-cn" ? "" : " ")}>
          {content.hero.titleLines.map((line) => <span class="hero-title-line" aria-hidden="true">{line}</span>)}
        </h1>
        <p>{content.hero.description}</p>
        <div class="hero-actions">
          <a class="primary-action" href={publicPath(locale, "/start/quickstart/")}>{content.hero.primary}</a>
          <a class="secondary-action" href={publicPath(locale, "/market/")}>{content.hero.secondary}</a>
        </div>
        <aside class="harness-memory" aria-label={content.hero.harness.label}>
          <strong>{content.hero.harness.label}</strong>
          <p>{content.hero.harness.description}</p>
        </aside>
        <p class="hero-boundary">{content.hero.boundary}</p>
      </div>

      <figure
        class="harness-gallery"
        data-harness-gallery
      >
        <div class="harness-gallery-heading">
          <span>{content.hero.gallery.label}</span>
          <span aria-hidden="true">UI / INTERACTION</span>
        </div>
        <div class="harness-gallery-tabs" role="tablist" aria-label={content.hero.gallery.ariaLabel}>
          {content.hero.gallery.items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`harness-tab-${item.id}`}
              aria-controls={`harness-panel-${item.id}`}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
              data-gallery-tab={item.id}
            >
              <span>0{index + 1}</span>{item.label}
            </button>
          ))}
        </div>
        {content.hero.gallery.items.map((item, index) => (
          <div
            class="harness-gallery-panel"
            role="tabpanel"
            id={`harness-panel-${item.id}`}
            aria-labelledby={`harness-tab-${item.id}`}
            data-gallery-panel={item.id}
            data-media-kind={item.kind}
            hidden={index !== 0}
          >
            <Image
              src={galleryImages[item.id]}
              width={1280}
              alt={item.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              fetchpriority={index === 0 ? "high" : "auto"}
            />
            <div class="harness-gallery-caption"><strong>{item.title}</strong><span>{item.description}</span></div>
          </div>
        ))}
      </figure>
    </section>

    <section class="proof-strip" aria-label={locale === "zh-cn" ? "产品原则" : "Product principles"}>
      {content.proof.map(([title, description]) => (
        <article><strong>{title}</strong><p>{description}</p></article>
      ))}
    </section>

    <section class="landing-band" aria-labelledby="workbench-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.workbench.eyebrow}</p>
          <h2 id="workbench-title" class="section-heading">{content.workbench.title}</h2>
        </div>
        <p class="section-lead">{content.workbench.description}</p>
      </div>
      <div class="work-mode-grid">
        {content.workbench.items.map((item) => (
          <article>
            <span class="mode-index">{item.index}</span>
            <p class="mode-use">{item.use}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <strong>{item.output}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="landing-band" aria-labelledby="expert-squads-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.squads.eyebrow}</p>
          <h2 id="expert-squads-title" class="section-heading">{content.squads.title}</h2>
        </div>
        <div>
          <p class="section-lead">{content.squads.description}</p>
          <div class="hero-actions">
            <a class="primary-action" href={publicPath(locale, "/market/")}>{content.squads.action}</a>
            <a class="secondary-action" href={publicPath(locale, "/publish/")}>{content.squads.buildAction}</a>
          </div>
        </div>
      </div>

      <div class="squad-story-grid">
        <div class="squad-capabilities">
          {content.squads.capabilities.map(([title, description], index) => (
            <article>
              <span>0{index + 1}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
        <div class="squad-image-stack">
          <figure>
            <Image src={ExpertSquadCatalog} width={900} alt={content.squads.catalogAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "先比较用途、角色与工作流" : "Compare purpose, roles, and workflow first"}</figcaption>
          </figure>
          <figure>
            <Image src={ExpertSquadInstalled} width={900} alt={content.squads.installedAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "安装后仍由你明确选择与激活" : "Selection and activation remain explicit after install"}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="landing-band runtime-boundary" aria-labelledby="mission-title">
      <div>
        <p class="eyebrow">{content.mission.eyebrow}</p>
        <h2 id="mission-title" class="section-heading">{content.mission.title}</h2>
        <p class="section-lead">{content.mission.description}</p>
        <figure class="runtime-image">
          <Image src={RuntimeDesktopContinuity} width={900} alt={content.mission.imageAlt} loading="lazy" decoding="async" />
        </figure>
      </div>
      <div class="runtime-facts">
        {content.mission.facts.map(([title, description]) => (
          <article><b>{title}</b><p>{description}</p></article>
        ))}
      </div>
    </section>

    <section class="landing-band start-section" aria-labelledby="community-title">
      <div>
        <p class="eyebrow">{content.community.eyebrow}</p>
        <h2 id="community-title" class="section-heading">{content.community.title}</h2>
        <p class="section-lead">{content.community.description}</p>
      </div>
      <div class="start-actions">
        {content.community.cards.map((card) => (
          <a
            class:list={["start-card", { "start-card-primary": card.primary }]}
            href={card.href.startsWith("https://") ? card.href : publicPath(locale, card.href)}
          >
            <span>{card.label}</span>
            <strong>{card.title}</strong>
            <small>{card.note}</small>
          </a>
        ))}
      </div>
    </section>
  </main>
  </div>
</PublicSiteLayout>

<script>
  for (const gallery of document.querySelectorAll<HTMLElement>("[data-harness-gallery]")) {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-tab]")]
    const panels = [...gallery.querySelectorAll<HTMLElement>("[data-gallery-panel]")]
    const select = (next: HTMLButtonElement) => {
      for (const tab of tabs) {
        const selected = tab === next
        tab.setAttribute("aria-selected", String(selected))
        tab.tabIndex = selected ? 0 : -1
      }
      for (const panel of panels) panel.hidden = panel.dataset.galleryPanel !== next.dataset.galleryTab
    }
    for (const [index, tab] of tabs.entries()) {
      tab.addEventListener("click", () => select(tab))
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return
        event.preventDefault()
        const nextIndex = event.key === "Home"
          ? 0
          : event.key === "End"
            ? tabs.length - 1
            : (index + (event.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length
        const next = tabs[nextIndex]
        select(next)
        next.focus()
      })
    }
  }
</script>

<style>
  .public-landing {
    min-width: 1100px;
    overflow: hidden;
  }

  .landing-hero {
    align-items: center;
  }

  .hero-title-line {
    display: block;
    white-space: nowrap;
  }

  .harness-memory {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    align-items: start;
    margin-top: 28px;
    padding: 14px 16px;
    border-left: 4px solid var(--cobalt);
    background: var(--cobalt-wash);
  }

  .harness-memory strong {
    color: var(--cobalt-deep);
    font: 700 11px/1.4 var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .harness-memory p {
    margin: 0;
    color: #353b56;
    font-size: 13px;
    line-height: 1.48;
  }

  .harness-gallery {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--ink);
    box-shadow: 14px 14px 0 var(--cobalt-wash);
    overflow: hidden;
  }

  .harness-gallery-heading {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 10px 14px;
    color: #d9d9d2;
    font: 700 10px/1.2 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .harness-gallery-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #393a3f;
    border-bottom: 1px solid #393a3f;
  }

  .harness-gallery-tabs button {
    min-height: 44px;
    padding: 10px 8px;
    border: 0;
    border-right: 1px solid #393a3f;
    background: transparent;
    color: #d9d9d2;
    font: 700 11px/1.2 var(--mono);
    cursor: pointer;
  }

  .harness-gallery-tabs button:last-child {
    border-right: 0;
  }

  .harness-gallery-tabs button span {
    margin-right: 7px;
    color: #788cff;
    font-size: 9px;
  }

  .harness-gallery-tabs button:hover {
    background: #20243a;
    color: white;
  }

  .harness-gallery-tabs button[aria-selected="true"] {
    background: var(--cobalt);
    color: white;
  }

  .harness-gallery-tabs button[aria-selected="true"] span {
    color: white;
  }

  .harness-gallery-panel {
    background: #0d0e12;
  }

  .harness-gallery-panel[hidden] {
    display: none;
  }

  .harness-gallery-panel img,
  .runtime-image img,
  .squad-image-stack img {
    display: block;
    width: 100%;
    height: auto;
  }

  .harness-gallery-caption {
    display: grid;
    grid-template-columns: minmax(150px, 0.7fr) minmax(0, 1.3fr);
    gap: 18px;
    min-height: 72px;
    padding: 13px 16px;
    border-top: 1px solid #393a3f;
    color: #d9d9d2;
  }

  .harness-gallery-caption strong {
    color: white;
    font: 700 11px/1.4 var(--mono);
  }

  .harness-gallery-caption span,
  .squad-image-stack figcaption {
    color: #b9b9b2;
    font: 400 11px/1.45 var(--mono);
  }

  .work-mode-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .work-mode-grid article {
    min-height: 330px;
    padding: 26px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--paper-raised);
  }

  .work-mode-grid article:nth-child(2) {
    background: var(--cobalt-wash);
  }

  .mode-index,
  .mode-use {
    font-family: var(--mono);
    font-size: 11px;
  }

  .mode-index {
    color: var(--cobalt);
  }

  .mode-use {
    min-height: 36px;
    margin: 36px 0 0;
    color: var(--muted);
    text-transform: uppercase;
  }

  .public-landing .work-mode-grid h3 {
    margin: 8px 0 18px;
    font-family: var(--display);
    color: var(--ink) !important;
    font-size: 42px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    letter-spacing: -0.055em;
  }

  .work-mode-grid article > p:not(.mode-use) {
    min-height: 92px;
    margin: 0 0 24px;
    color: var(--muted);
  }

  .work-mode-grid strong {
    display: block;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
  }

  .squad-story-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 56px;
    align-items: start;
  }

  .squad-capabilities {
    border-top: 2px solid var(--ink);
  }

  .squad-capabilities article {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink);
  }

  .squad-capabilities span {
    color: var(--cobalt);
    font-family: var(--mono);
    font-size: 11px;
  }

  .public-landing .squad-capabilities h3 {
    margin: 0 0 7px;
    color: var(--ink) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.6 !important;
  }

  .squad-capabilities p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .squad-image-stack {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    align-items: end;
  }

  .squad-image-stack figure,
  .runtime-image {
    margin: 0;
    border: 2px solid var(--ink);
    background: #0d0e12;
  }

  .squad-image-stack figure:last-child {
    transform: translateY(32px);
  }

  .squad-image-stack figcaption {
    padding: 12px 16px;
    border-top: 1px solid #393a3f;
  }

  .runtime-image {
    margin-top: 38px;
  }

  .start-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: start;
  }

  .start-actions {
    border-top: 2px solid var(--ink);
  }

  .start-card {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: 10px 24px;
    padding: 24px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
    text-decoration: none;
  }

  .start-card:hover {
    background: var(--cobalt-wash);
  }

  .start-card-primary {
    background: var(--cobalt);
    color: white;
  }

  .start-card-primary:hover {
    background: var(--cobalt-deep);
  }

  .start-card span {
    grid-row: 1 / span 2;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .start-card strong {
    line-height: 1.35;
  }

  .start-card small {
    color: currentColor;
    opacity: 0.72;
  }

  @media (max-width: 1099px) {
    .public-landing {
      min-width: 0;
      overflow: visible;
    }

    .public-landing .landing-hero,
    .public-landing .squad-story-grid,
    .public-landing .squad-image-stack,
    .public-landing .runtime-boundary,
    .public-landing .start-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-landing .landing-hero {
      gap: 40px;
      min-height: 0;
      padding: 48px 0 56px;
    }

    .hero-title-line {
      white-space: normal;
    }

    .public-landing .proof-strip,
    .public-landing .work-mode-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-landing .proof-strip article,
    .public-landing .proof-strip article:last-child {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }

    .work-mode-grid article {
      min-height: 0;
    }

    .work-mode-grid article > p:not(.mode-use),
    .mode-use {
      min-height: 0;
    }

    .mode-use {
      margin-top: 24px;
    }

    .public-landing .squad-story-grid,
    .public-landing .squad-image-stack,
    .public-landing .start-section {
      gap: 32px;
    }

    .squad-image-stack figure:last-child {
      transform: none;
    }

    .public-landing .runtime-boundary {
      gap: 38px;
    }

    .public-landing .runtime-facts article {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .start-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .start-card span {
      grid-row: auto;
    }
  }

  @media (max-width: 720px) {
    .public-landing .hero-actions {
      grid-template-columns: minmax(0, 1fr);
    }

    .harness-memory,
    .harness-gallery-caption {
      grid-template-columns: minmax(0, 1fr);
    }

    .harness-memory strong {
      white-space: normal;
    }

    .public-landing .hero-actions {
      display: grid;
    }

    .public-landing .hero-actions a {
      width: 100%;
    }
  }
</style>
