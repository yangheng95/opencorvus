---
import { Image } from "astro:assets"
import { Icon } from "@astrojs/starlight/components"
import BrandMark from "../../../overlay/src-tauri/icons/icon.png"
import ClientAgentWorkspace from "../assets/lander/client-agent-workspace.png"
import ClientEnvironmentEvidence from "../assets/lander/client-environment-evidence.png"
import ClientTaskEvidence from "../assets/lander/client-task-evidence.png"
import ExpertSquadCatalog from "../assets/lander/expert-squad-catalog.png"
import ExpertSquadInstalled from "../assets/lander/expert-squad-installed.png"
import RuntimeChannelReach from "../assets/lander/runtime-channel-reach-agent-v2.png"
import RuntimeDesktopContinuity from "../assets/lander/runtime-desktop-continuity-agent-v2.png"
import RuntimeHeadless from "../assets/lander/runtime-headless-agent-v2.png"
import RuntimeRepositoryAutomation from "../assets/lander/runtime-repository-automation-agent-v2.png"
import LandingMissionFlow from "./LandingMissionFlow.astro"
import { landingContent, landingProductName, type LandingLocale } from "../content/landing"
import { discoverLandingBinaryDownloads, landingWebApplication } from "../lib/landing-download"

const { lang } = Astro.locals.starlightRoute
const locale: LandingLocale = lang === "zh-CN" ? "zh-cn" : "root"
const content = landingContent[locale]
const storyImages = [ClientAgentWorkspace, ClientEnvironmentEvidence, ClientTaskEvidence]
const expertSquadImages = [ExpertSquadCatalog, ExpertSquadInstalled]
const expertSquadMediaItems = content.expertSquads.media.map((item, index) => ({ item, image: expertSquadImages[index] }))
const expertSquadMediaOrder = expertSquadMediaItems
const runtimeImages = [RuntimeDesktopContinuity, RuntimeHeadless, RuntimeChannelReach, RuntimeRepositoryAutomation]
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const landingBinaryDownloads = discoverLandingBinaryDownloads()
const homeHref = locale === "zh-cn" ? `${publicBase}/zh-cn/` : `${publicBase}/`
const demoSource = `${publicBase}/media/opencorvus-client-demo.webm`
const downloadCards = landingBinaryDownloads.map((download) => ({
  ...download,
  href: `${publicBase}/${download.publicRelativePath}`,
  action: content.download.actions[download.platform],
}))
const webApplicationCard = {
  ...landingWebApplication,
  platformName: content.download.web.platformName,
  action: content.download.web.action,
  system: content.download.web.system,
  architecture: content.download.web.architecture,
  packageType: content.download.web.packageType,
}
---

<div class="landing-shell">
  <div class="hero-canvas">
    <header class="landing-header" aria-label={landingProductName}>
      <a class="brand" href={homeHref} aria-label={`${landingProductName} home`}>
        <Image src={BrandMark} width={42} height={42} alt="" loading="eager" decoding="async" />
        <span>{landingProductName}</span>
      </a>
      <nav aria-label="Primary navigation">
        <a href={locale === "zh-cn" ? `${publicBase}/zh-cn/market/` : `${publicBase}/market/`}>{content.nav.market}</a>
        <a href={locale === "zh-cn" ? `${publicBase}/zh-cn/publish/` : `${publicBase}/publish/`}>{content.nav.publish}</a>
        <a href={locale === "zh-cn" ? `${publicBase}/zh-cn/trust/` : `${publicBase}/trust/`}>{content.nav.trust}</a>
        <a href="#download">{content.nav.download}</a>
        <a href="#features">{content.nav.features}</a>
        <a href="#expert-squads">{content.nav.expertSquads}</a>
      </nav>
      <div class="header-actions">
        <a class="language-link" href={content.language.href}>{content.language.label}</a>
      </div>
    </header>

    <section class="hero-section" aria-labelledby="landing-title">
      <div class="hero-copy">
        <h1 id="landing-title">{content.hero.title}</h1>
        <p class="hero-description">{content.hero.description}</p>
      </div>

      <div class="hero-product">
        <div class="hero-video-frame">
          <video controls muted playsinline preload="metadata" poster={ClientAgentWorkspace.src} aria-label={content.hero.videoLabel}>
            <source src={demoSource} type="video/webm" />
            <a href={demoSource}>{content.hero.videoLabel}</a>
          </video>
          <p>{content.hero.videoCaption}</p>
        </div>
      </div>
    </section>
  </div>

  <div class="landing-main">
    <section id="download" class="download-section" aria-labelledby="landing-download-title">
      <div class="section-wrap download-layout">
        <div class="download-copy">
          <p class="section-kicker">{content.download.eyebrow}</p>
          <h2 id="landing-download-title">{content.download.title}</h2>
          <p>{content.download.description}</p>
        </div>
        <div class="download-card-grid">
          {downloadCards.map((download) => (
            <article class="download-card">
              <div class="download-card-heading">
                <span class="download-platform">{download.platformName}</span>
              </div>
              <dl class="download-facts">
                <div><dt>{content.download.systemLabel}</dt><dd>{download.system}</dd></div>
                <div><dt>{content.download.architectureLabel}</dt><dd>{download.architecture}</dd></div>
                <div><dt>{content.download.packageLabel}</dt><dd>{download.packageType}</dd></div>
              </dl>
              <a class="download-button" href={download.href} download>
                <span>{download.action}</span><Icon name="download" size="1rem" />
              </a>
            </article>
          ))}
          <article class="download-card download-card-web">
            <div class="download-card-heading">
              <span class="download-platform">{webApplicationCard.platformName}</span>
            </div>
            <dl class="download-facts">
              <div><dt>{content.download.systemLabel}</dt><dd>{webApplicationCard.system}</dd></div>
              <div><dt>{content.download.architectureLabel}</dt><dd>{webApplicationCard.architecture}</dd></div>
              <div><dt>{content.download.packageLabel}</dt><dd>{webApplicationCard.packageType}</dd></div>
            </dl>
            <a
              class="download-button"
              href={webApplicationCard.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{webApplicationCard.action}</span><Icon name="rocket" size="1rem" />
            </a>
          </article>
        </div>
      </div>
    </section>

    <section id="features" class="features-section" aria-labelledby="features-title">
      <div class="section-wrap">
        <div class="features-heading">
          <p class="section-kicker">{content.features.eyebrow}</p>
          <h2 id="features-title">{content.features.title}</h2>
          <p>{content.features.description}</p>
        </div>
        <div class="feature-stories">
          {content.features.items.map((item, index) => (
            <article class:list={{ reverse: index % 2 === 1 }}>
              <div class="story-copy">
                <span class="story-index">{String(index + 1).padStart(2, "0")} / {item.label}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <ul>
                  {item.bullets.map((bullet) => (
                    <li><span aria-hidden="true">✓</span>{bullet}</li>
                  ))}
                </ul>
              </div>
              <div class="story-media">
                <div class="story-window-chrome" aria-hidden="true"><span></span><span></span><span></span></div>
                <button
                  class="image-preview-trigger"
                  type="button"
                  aria-label={`${content.imageViewer.open}: ${item.title}`}
                  aria-haspopup="dialog"
                  aria-controls="landing-image-preview"
                  data-image-preview-trigger
                  data-preview-src={storyImages[index].src}
                  data-preview-alt={item.title}
                >
                  <Image
                    src={storyImages[index]}
                    width={1600}
                    height={Math.round(1600 * storyImages[index].height / storyImages[index].width)}
                    alt={item.title}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="expert-squads" class="squad-section" aria-labelledby="squad-title">
      <div class="section-wrap squad-layout">
        <div class="squad-copy">
          <h2 id="squad-title">{content.expertSquads.title}</h2>
          <p>{content.expertSquads.description}</p>
        </div>

        <div class="squad-proof">
          <div class="squad-capability-list">
            {content.expertSquads.capabilities.map((item, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{item.label}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="squad-media-grid">
          {expertSquadMediaOrder.map(({ item, image }) => (
            <button
              class="squad-media-card image-preview-trigger"
              type="button"
              aria-label={`${content.imageViewer.open}: ${item.alt}`}
              aria-haspopup="dialog"
              aria-controls="landing-image-preview"
              data-image-preview-trigger
              data-preview-src={image.src}
              data-preview-alt={item.alt}
            >
              <Image
                src={image}
                width={720}
                height={Math.round(720 * image.height / image.width)}
                alt={item.alt}
                loading="lazy"
                decoding="async"
              />
            </button>
          ))}
        </div>
        <div class="squad-flow">
          <div class="window-chrome" aria-hidden="true">
            <span></span><span></span><span></span>
            <p>{content.expertSquads.flowLabel}</p>
          </div>
          <LandingMissionFlow locale={locale} description={content.expertSquads.flowAlt} />
        </div>
      </div>
    </section>

    <section class="surfaces-section" aria-labelledby="surfaces-title">
      <div class="section-wrap">
        <div class="surfaces-heading">
          <div>
            <p class="section-kicker">{content.surfaces.eyebrow}</p>
            <h2 id="surfaces-title">{content.surfaces.title}</h2>
          </div>
          <p>{content.surfaces.description}</p>
        </div>
        <div class="surface-grid">
          {content.surfaces.items.map((item, index) => (
            <article class="surface-card">
              <div class="surface-media">
                <Image
                  src={runtimeImages[index]}
                  width={768}
                  height={512}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="surface-number">{String(index + 1).padStart(2, "0")}</span>
              <div class="surface-copy">
                <strong>{item.title}</strong>
                <span class="surface-description">{item.description}</span>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section section-wrap" aria-labelledby="cta-title">
      <div class="cta-mark" aria-hidden="true">
        <Image src={BrandMark} width={148} height={148} alt="" loading="lazy" decoding="async" />
      </div>
      <div class="cta-copy">
        <h2 id="cta-title">{content.cta.title}</h2>
        <p>{content.cta.description}</p>
      </div>
    </section>
  </div>

  <dialog
    id="landing-image-preview"
    class="image-preview-dialog"
    aria-label={content.imageViewer.dialog}
    data-landing-image-dialog
  >
    <div class="image-preview-surface">
      <img src="" alt="" data-landing-image-preview />
      <form method="dialog">
        <button type="submit" class="image-preview-close" aria-label={content.imageViewer.close}>
          <span aria-hidden="true">×</span>
        </button>
      </form>
    </div>
  </dialog>

</div>

<script>
  const previewDialog = document.querySelector<HTMLDialogElement>("[data-landing-image-dialog]")!
  const previewImage = previewDialog.querySelector<HTMLImageElement>("[data-landing-image-preview]")!
  let previewRequest = 0

  document.querySelectorAll<HTMLButtonElement>("[data-image-preview-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", async () => {
      const request = ++previewRequest
      const source = trigger.getAttribute("data-preview-src")!
      const alternativeText = trigger.getAttribute("data-preview-alt")!
      previewImage.removeAttribute("src")
      previewImage.alt = ""

      const candidate = new Image()
      candidate.decoding = "async"
      candidate.src = source
      try {
        await candidate.decode()
      } catch {
        return
      }
      if (request !== previewRequest) return

      previewImage.src = source
      previewImage.alt = alternativeText
      previewDialog.showModal()
    })
  })

  previewDialog.addEventListener("click", (event) => {
    if (event.target === previewDialog) previewDialog.close()
  })

  previewDialog.addEventListener("close", () => {
    previewRequest += 1
    previewImage.removeAttribute("src")
    previewImage.alt = ""
  })
</script>

<style>
  .landing-shell {
    --ink: #0a0a0a;
    --ink-soft: #1f1f1f;
    --paper: #f5f5f5;
    --paper-bright: #ffffff;
    --muted: #737373;
    --line: #d4d4d4;
    --web-card: #eaf7ee;
    --web-card-border: #9ecfaf;
    --web-card-line: #b9ddc5;
    --web-action: #14532d;
    --web-action-hover: #1f6b3d;
    background: var(--paper);
    color: var(--ink);
    font-family: Inter, "Noto Sans SC", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    min-width: 70rem;
    overflow: hidden;
  }

  .hero-canvas {
    background: var(--ink);
    color: white !important;
    min-height: 52rem;
    overflow: hidden;
    position: relative;
  }

  .landing-header,
  .hero-section,
  .section-wrap {
    margin-inline: auto;
    max-width: 78rem;
  }

  .landing-header {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    grid-template-columns: auto 1fr auto;
    min-height: 5.6rem;
    position: relative;
    z-index: 5;
  }

  .brand,
  .landing-header nav,
  .header-actions,
  .story-copy li {
    align-items: center;
    display: flex;
  }

  .brand {
    color: white !important;
    font-size: 1.06rem;
    font-weight: 780;
    gap: 0.72rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand img,
  .cta-mark img {
    border-radius: 23%;
  }

  .landing-header nav {
    gap: 2.2rem;
    justify-self: center;
  }

  .landing-header a {
    text-decoration: none;
  }

  .landing-header nav a,
  .language-link {
    font-size: 0.78rem;
    font-weight: 700;
  }

  .landing-header nav a,
  .language-link {
    color: #a3a3a3 !important;
  }

  .hero-section {
    display: grid;
    gap: 3.75rem;
    grid-template-columns: minmax(0, 1fr);
    min-height: 46rem;
    padding: 6.5rem 0 8rem;
    position: relative;
    z-index: 1;
  }

  .section-kicker {
    color: var(--ink);
    font-size: 0.7rem;
    font-weight: 840;
    letter-spacing: 0.16em;
    margin: 0;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    color: white !important;
    font-size: 4.65rem !important;
    font-weight: 800 !important;
    letter-spacing: -0.075em !important;
    line-height: 1.04 !important;
    margin: 0 0 2rem !important;
    text-wrap: wrap;
  }

  :global(html[lang="zh-CN"]) .hero-copy h1 {
    font-size: 3.75rem !important;
    letter-spacing: -0.045em !important;
    line-height: 1.1 !important;
  }

  .hero-description {
    color: #a3a3a3;
    font-size: 1.02rem;
    line-height: 1.72;
    margin: 0;
  }

  .hero-product {
    position: relative;
  }

  .story-media {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.14);
    overflow: hidden;
  }

  .window-chrome,
  .story-window-chrome {
    align-items: center;
    background: #1f1f1f;
    display: flex;
    gap: 0.38rem;
    height: 2.3rem;
    padding-inline: 0.8rem;
  }

  .window-chrome > span,
  .story-window-chrome > span {
    background: #737373;
    border-radius: 50%;
    height: 0.45rem;
    width: 0.45rem;
  }

  .window-chrome p {
    color: var(--muted);
    font: 0.58rem ui-monospace, "SFMono-Regular", Consolas, monospace;
    margin: 0 0 0 0.5rem;
  }

  .hero-video-frame {
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 1.25rem;
    overflow: hidden;
  }

  .hero-video-frame video {
    aspect-ratio: 16 / 9;
    background: #050505;
    display: block;
    object-fit: cover;
    width: 100%;
  }

  .hero-video-frame > p {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: #8f8f8f;
    font: 0.62rem ui-monospace, "SFMono-Regular", Consolas, monospace;
    letter-spacing: 0.02em;
    margin: 0;
    padding: 0.9rem 1.15rem;
  }

  .image-preview-trigger {
    background: transparent;
    border: 0;
    color: inherit;
    cursor: zoom-in;
    display: block;
    overflow: hidden;
    padding: 0;
    position: relative;
    width: 100%;
  }

  .image-preview-trigger::after {
    background: rgba(255, 255, 255, 0.1);
    content: "";
    inset: 0;
    opacity: 0;
    pointer-events: none;
    position: absolute;
    transition: opacity 160ms ease;
  }

  .image-preview-trigger:hover::after,
  .image-preview-trigger:focus-visible::after {
    opacity: 1;
  }

  .image-preview-dialog {
    background: transparent;
    border: 0;
    height: calc(100vh - 4rem);
    inset: 0;
    margin: auto;
    max-height: calc(100vh - 4rem);
    max-width: calc(100vw - 4rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 0;
    position: fixed;
    scrollbar-gutter: stable;
    width: calc(100vw - 4rem);
  }

  .image-preview-dialog::backdrop {
    background: rgba(0, 0, 0, 0.88);
    backdrop-filter: blur(0.5rem);
  }

  .image-preview-surface {
    box-sizing: border-box;
    display: flex;
    min-height: 100%;
    padding: 1rem;
    position: relative;
    width: 100%;
  }

  .image-preview-surface > img {
    background: var(--ink);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 1rem;
    display: block;
    height: auto;
    margin: auto;
    max-width: 100%;
    object-fit: contain;
    width: auto;
  }

  .image-preview-close {
    align-items: center;
    background: rgba(10, 10, 10, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    color: white;
    cursor: pointer;
    display: flex;
    font-size: 1.5rem;
    height: 2.75rem;
    justify-content: center;
    line-height: 1;
    padding: 0 0 0.12rem;
    position: fixed;
    right: 2.9rem;
    top: 2.9rem;
    width: 2.75rem;
    z-index: 1;
  }

  .image-preview-close:hover {
    background: var(--ink-soft);
  }

  .download-section {
    background: var(--ink);
    border-top: 1px solid rgba(255, 255, 255, 0.09);
    color: white;
    padding-block: 8rem;
  }

  .download-layout {
    align-items: center;
    display: grid;
    gap: 5rem;
    grid-template-columns: minmax(0, 0.72fr) minmax(42rem, 1.28fr);
  }

  .download-copy h2 {
    color: white !important;
    font-size: 3.05rem !important;
    letter-spacing: -0.058em !important;
    line-height: 1.08 !important;
    margin: 1.15rem 0 0 !important;
    max-width: 100%;
  }

  .download-copy > p:last-child {
    color: #a3a3a3;
    font-size: 0.95rem;
    line-height: 1.75;
    margin: 1.6rem 0 0;
    max-width: 35rem;
  }

  .download-card-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .download-card {
    background: var(--paper-bright);
    border: 1px solid var(--line);
    border-radius: 1.45rem;
    color: var(--ink);
    display: grid;
    grid-template-rows: auto 1fr auto;
    overflow: hidden;
    min-height: 18.5rem;
    padding: 1.65rem;
  }

  .download-card-web {
    background: var(--web-card);
    border-color: var(--web-card-border);
  }

  .download-card-web .download-platform {
    color: var(--web-action);
  }

  .download-card-web .download-facts,
  .download-card-web .download-facts > div {
    border-color: var(--web-card-line);
  }

  .download-card-web .download-button {
    background: var(--web-action);
  }

  .download-card-web .download-button:hover {
    background: var(--web-action-hover);
  }

  .download-card-heading {
    align-items: center;
    display: flex;
  }

  .download-platform {
    font-size: 1.5rem;
    font-weight: 820;
    letter-spacing: -0.04em;
    line-height: 1.2;
  }

  .download-facts {
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr;
    margin: 1.35rem 0;
  }

  .download-facts > div {
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 0.85rem 0;
  }

  .download-facts > div:last-child {
    border-bottom: 0;
  }

  .download-facts dt {
    color: var(--muted);
    font-size: 0.63rem;
    font-weight: 760;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .download-facts dd {
    color: var(--ink);
    font-size: 0.84rem;
    font-weight: 750;
    margin: 0;
    text-align: right;
  }

  .download-button {
    align-items: center;
    background: var(--ink);
    border-radius: 0.8rem;
    color: white !important;
    display: flex;
    font-size: 0.84rem;
    font-weight: 780;
    justify-content: space-between;
    min-height: 3.4rem;
    padding: 0.95rem 1.15rem;
    text-decoration: none;
    transition: background-color 160ms ease, transform 160ms ease;
  }

  .download-button:hover {
    background: var(--ink-soft);
  }

  .features-heading {
    margin-inline: auto;
    max-width: 56rem;
    text-align: center;
  }

  .features-heading h2,
  .surfaces-heading h2,
  .cta-copy h2 {
    color: var(--ink) !important;
    font-size: 3.7rem !important;
    font-weight: 790 !important;
    letter-spacing: -0.065em !important;
    line-height: 1.1 !important;
    margin: 1rem 0 0 !important;
    text-wrap: balance;
  }

  .features-heading > p:last-child,
  .surfaces-heading > p,
  .cta-copy > p:last-child {
    color: var(--muted);
    line-height: 1.72;
    margin: 1.35rem auto 0;
    max-width: 47rem;
  }

  .story-index,
  .surface-number {
    color: var(--muted);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.66rem;
  }

  .features-section {
    background: var(--paper-bright);
    padding-block: 9rem;
  }

  .feature-stories {
    display: grid;
