---
import { Image } from "astro:assets"
import ClientAgentWorkspace from "../assets/lander/client-agent-workspace.png"
import ExpertSquadCatalog from "../assets/lander/expert-squad-catalog.png"
import ExpertSquadInstalled from "../assets/lander/expert-squad-installed.png"
import RuntimeDesktopContinuity from "../assets/lander/runtime-desktop-continuity-agent-v2.png"
import PublicSiteHeader from "./PublicSiteHeader.astro"
import PublicSiteFooter from "./PublicSiteFooter.astro"
import { landingContent, type LandingLocale } from "../content/landing"
import { publicPath } from "../content/public-market"
import { discoverLandingBinaryDownloads } from "../lib/landing-download"
import "../styles/public-site.css"

const { lang } = Astro.locals.starlightRoute
const locale: LandingLocale = lang === "zh-CN" ? "zh-cn" : "root"
const content = landingContent[locale]
const languageHref = publicPath(locale === "zh-cn" ? "root" : "zh-cn")
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const demoSource = `${publicBase}/media/opencorvus-client-demo.webm`
const downloads = discoverLandingBinaryDownloads().map((download) => ({
  ...download,
  href: `${publicBase}/${download.publicRelativePath}`,
}))
---

<div class="public-landing">
  <PublicSiteHeader {locale} current="home" {languageHref} />

  <main id="main-content" class="public-main">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="landing-title">{content.hero.title}</h1>
        <p>{content.hero.description}</p>
        <div class="hero-actions">
          <a class="primary-action" href={publicPath(locale, "/market/")}>{content.hero.primary}</a>
          <a class="secondary-action" href={publicPath(locale, "/start/quickstart/")}>{content.hero.secondary}</a>
        </div>
        <p class="hero-boundary">
          {locale === "zh-cn"
            ? "OpenCorvus 负责组织工作与证据；你始终决定任务范围、外部写入和最终接受。"
            : "OpenCorvus organizes the work and its evidence. You retain control of scope, external writes, and final acceptance."}
        </p>
      </div>

      <figure class="landing-video">
        <video controls muted playsinline preload="metadata" poster={ClientAgentWorkspace.src} aria-label={content.hero.videoLabel}>
          <source src={demoSource} type="video/webm" />
          <a href={demoSource}>{content.hero.videoLabel}</a>
        </video>
        <figcaption>{content.hero.videoCaption}</figcaption>
      </figure>
    </section>

    <section class="proof-strip" aria-label={locale === "zh-cn" ? "产品原则" : "Product principles"}>
      {content.proof.map(([title, description]) => (
        <article><strong>{title}</strong><p>{description}</p></article>
      ))}
    </section>

    <section class="landing-band" aria-labelledby="work-modes-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.modes.eyebrow}</p>
          <h2 id="work-modes-title" class="section-heading">{content.modes.title}</h2>
        </div>
        <p class="section-lead">{content.modes.description}</p>
      </div>
      <div class="work-mode-grid">
        {content.modes.items.map((item) => (
          <article>
            <span class="mode-index">{item.index}</span>
            <p class="mode-use">{item.use}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <strong>{item.output}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="landing-band" aria-labelledby="expert-squads-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.squads.eyebrow}</p>
          <h2 id="expert-squads-title" class="section-heading">{content.squads.title}</h2>
        </div>
        <div>
          <p class="section-lead">{content.squads.description}</p>
          <div class="hero-actions">
            <a class="primary-action" href={publicPath(locale, "/market/")}>{content.squads.action}</a>
            <a class="secondary-action" href={publicPath(locale, "/publish/")}>{content.squads.buildAction}</a>
          </div>
        </div>
      </div>

      <div class="squad-story-grid">
        <div class="squad-capabilities">
          {content.squads.capabilities.map(([title, description], index) => (
            <article>
              <span>0{index + 1}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
        <div class="squad-image-stack">
          <figure>
            <Image src={ExpertSquadCatalog} width={900} alt={content.squads.catalogAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "先比较用途、角色与工作流" : "Compare purpose, roles, and workflow first"}</figcaption>
          </figure>
          <figure>
            <Image src={ExpertSquadInstalled} width={900} alt={content.squads.installedAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "安装后仍由你明确选择与激活" : "Selection and activation remain explicit after install"}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="landing-band runtime-boundary" aria-labelledby="runtime-title">
      <div>
        <p class="eyebrow">{content.continuity.eyebrow}</p>
        <h2 id="runtime-title" class="section-heading">{content.continuity.title}</h2>
        <p class="section-lead">{content.continuity.description}</p>
        <figure class="runtime-image">
          <Image src={RuntimeDesktopContinuity} width={900} alt={content.continuity.imageAlt} loading="lazy" decoding="async" />
        </figure>
      </div>
      <div class="runtime-facts">
        {content.continuity.facts.map(([title, description]) => (
          <article><b>{title}</b><p>{description}</p></article>
        ))}
      </div>
    </section>

    <section class="landing-band start-section" aria-labelledby="start-title">
      <div>
        <p class="eyebrow">{content.start.eyebrow}</p>
        <h2 id="start-title" class="section-heading">{content.start.title}</h2>
        <p class="section-lead">{content.start.description}</p>
      </div>
      <div class="start-actions">
        {downloads.map((download) => (
          <a class="start-card" href={download.href} download>
            <span>{content.start.installer} {download.platformName}</span>
            <strong>{download.packageType} · {download.architecture}</strong>
            <small>{content.start.installerNote}</small>
          </a>
        ))}
        <a class="start-card start-card-primary" href={publicPath(locale, "/start/quickstart/")}>
          <span>{content.start.quickstart}</span>
          <strong>{locale === "zh-cn" ? "安装、连接工作区并开始第一个任务" : "Install, connect a workspace, and begin the first task"}</strong>
          <small>OpenCorvus documentation →</small>
        </a>
        <a class="start-card" href="https://github.com/yangheng95/opencorvus">
          <span>{content.start.source}</span>
          <strong>{locale === "zh-cn" ? "审查实现与构建流程" : "Review the implementation and build path"}</strong>
          <small>github.com/yangheng95/opencorvus →</small>
        </a>
        <a class="start-card" href="https://github.com/yangheng95/opencorvus/releases">
          <span>{content.start.releases}</span>
          <strong>{locale === "zh-cn" ? "获取已发布的原生安装包" : "Get published native installers"}</strong>
          <small>GitHub Releases →</small>
        </a>
      </div>
    </section>
  </main>

  <PublicSiteFooter {locale} />
</div>

<style>
  .public-landing {
    min-width: 1100px;
    overflow: hidden;
  }

  .landing-hero {
    align-items: center;
  }

  .landing-video {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--ink);
    box-shadow: 14px 14px 0 var(--cobalt-wash);
    overflow: hidden;
  }

  .landing-video video,
  .runtime-image img,
  .squad-image-stack img {
    display: block;
    width: 100%;
    height: auto;
  }

  .landing-video figcaption,
  .squad-image-stack figcaption {
    padding: 12px 16px;
    border-top: 1px solid #393a3f;
    color: #d9d9d2;
    font-family: var(--mono);
    font-size: 11px;
  }

  .work-mode-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .work-mode-grid article {
    min-height: 330px;
    padding: 26px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--paper-raised);
  }

  .work-mode-grid article:nth-child(2) {
    background: var(--cobalt-wash);
  }

  .mode-index,
  .mode-use {
    font-family: var(--mono);
    font-size: 11px;
  }

  .mode-index {
    color: var(--cobalt);
  }

  .mode-use {
    min-height: 36px;
    margin: 36px 0 0;
    color: var(--muted);
    text-transform: uppercase;
  }

  .public-landing .work-mode-grid h3 {
    margin: 8px 0 18px;
    font-family: var(--display);
    color: var(--ink) !important;
    font-size: 42px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    letter-spacing: -0.055em;
  }

  .work-mode-grid article > p:not(.mode-use) {
    min-height: 92px;
    margin: 0 0 24px;
    color: var(--muted);
  }

  .work-mode-grid strong {
    display: block;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
  }

  .squad-story-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 56px;
    align-items: start;
  }

  .squad-capabilities {
    border-top: 2px solid var(--ink);
  }

  .squad-capabilities article {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink);
  }

  .squad-capabilities span {
    color: var(--cobalt);
    font-family: var(--mono);
    font-size: 11px;
  }

  .public-landing .squad-capabilities h3 {
    margin: 0 0 7px;
    color: var(--ink) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.6 !important;
  }

  .squad-capabilities p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .squad-image-stack {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    align-items: end;
  }

  .squad-image-stack figure,
  .runtime-image {
    margin: 0;
    border: 2px solid var(--ink);
    background: #0d0e12;
  }

  .squad-image-stack figure:last-child {
    transform: translateY(32px);
  }

  .runtime-image {
    margin-top: 38px;
  }

  .start-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: start;
  }

  .start-actions {
    border-top: 2px solid var(--ink);
  }

  .start-card {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: 10px 24px;
    padding: 24px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
    text-decoration: none;
  }

  .start-card:hover {
    background: var(--cobalt-wash);
  }

  .start-card-primary {
    background: var(--cobalt);
    color: white;
  }

  .start-card-primary:hover {
    background: var(--cobalt-deep);
  }

  .start-card span {
    grid-row: 1 / span 2;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .start-card strong {
    line-height: 1.35;
  }

  .start-card small {
    color: currentColor;
    opacity: 0.72;
  }
</style>

<style is:global>
  :root[data-has-hero] header.header {
    display: none;
  }

  :root[data-has-hero] .main-frame,
  :root[data-has-hero] .main-pane,
  :root[data-has-hero] .main-pane > main {
    padding: 0;
  }

  :root[data-has-hero] .content-panel,
  :root[data-has-hero] .content-panel > .sl-container {
    border: 0;
    margin: 0;
    max-width: none;
    padding: 0 !important;
  }

  :root[data-has-hero] .content-panel .sl-markdown-content {
    display: none;
  }

  :root[data-has-hero] body {
    margin: 0;
    background: var(--paper);
  }

  :root[data-has-hero] .public-landing .landing-video video {
    display: block;
    width: 100% !important;
    height: 470px !important;
    object-fit: cover;
    object-position: left top;
  }

</style>
