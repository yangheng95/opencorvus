---
import { Image } from "astro:assets"
import ConceptFlowEn from "../assets/lander/opencorvus-concept-flow-en.gif"
import ConceptFlowMobileEn from "../assets/lander/opencorvus-concept-flow-mobile-en.gif"
import ConceptFlowMobileZh from "../assets/lander/opencorvus-concept-flow-mobile-zh.gif"
import ConceptFlowZh from "../assets/lander/opencorvus-concept-flow-zh.gif"
import ConceptMap from "../assets/lander/opencorvus-concept-map.png"
import ConceptMobile from "../assets/lander/opencorvus-concept-mobile.png"
import ExpertSquadCatalog from "../assets/lander/expert-squad-catalog.png"
import ExpertSquadInstalled from "../assets/lander/expert-squad-installed.png"
import RuntimeDesktopContinuity from "../assets/lander/runtime-desktop-continuity-agent-v2.png"
import PublicSiteHeader from "./PublicSiteHeader.astro"
import PublicSiteFooter from "./PublicSiteFooter.astro"
import { landingContent, type LandingLocale } from "../content/landing"
import { publicPath } from "../content/public-market"
import "../styles/public-site.css"

const { lang } = Astro.locals.starlightRoute
const locale: LandingLocale = lang === "zh-CN" ? "zh-cn" : "root"
const content = landingContent[locale]
const languageHref = publicPath(locale === "zh-cn" ? "root" : "zh-cn")
const conceptAnimation = locale === "zh-cn" ? ConceptFlowZh.src : ConceptFlowEn.src
const conceptMobileAnimation = locale === "zh-cn" ? ConceptFlowMobileZh.src : ConceptFlowMobileEn.src
---

<div class="public-landing">
  <PublicSiteHeader {locale} current="home" {languageHref} />

  <div id="main-content" class="public-main">
    <section class="landing-hero" aria-labelledby="landing-title">
      <div class="hero-copy">
        <p class="eyebrow">{content.hero.eyebrow}</p>
        <h1 id="landing-title" aria-label={content.hero.titleLines.join(locale === "zh-cn" ? "" : " ")}>
          {content.hero.titleLines.map((line) => <span class="hero-title-line" aria-hidden="true">{line}</span>)}
        </h1>
        <p>{content.hero.description}</p>
        <div class="hero-actions">
          <a class="primary-action" href={publicPath(locale, "/start/quickstart/")}>{content.hero.primary}</a>
          <a class="secondary-action" href={publicPath(locale, "/market/")}>{content.hero.secondary}</a>
        </div>
        <p class="hero-boundary">{content.hero.boundary}</p>
      </div>

      <figure
        class="concept-flow"
        data-concept-flow
        data-static-src={ConceptMap.src}
        data-animation-src={conceptAnimation}
        data-mobile-static-src={ConceptMobile.src}
        data-mobile-animation-src={conceptMobileAnimation}
        data-play-label={content.hero.playAnimation}
        data-stop-label={content.hero.stopAnimation}
      >
        <div class="concept-flow-frame">
          <picture>
            <source data-concept-flow-source media="(max-width: 720px)" srcset={ConceptMobile.src} />
            <img
              src={ConceptMap.src}
              width="960"
              height="540"
              alt={content.hero.mediaAlt}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </picture>
        </div>
        <div class="concept-flow-meta">
          <figcaption>{content.hero.mediaCaption}</figcaption>
          <button type="button" class="concept-flow-toggle" aria-pressed="false">{content.hero.playAnimation}</button>
        </div>
      </figure>
    </section>

    <section class="proof-strip" aria-label={locale === "zh-cn" ? "产品原则" : "Product principles"}>
      {content.proof.map(([title, description]) => (
        <article><strong>{title}</strong><p>{description}</p></article>
      ))}
    </section>

    <section class="landing-band" aria-labelledby="workbench-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.workbench.eyebrow}</p>
          <h2 id="workbench-title" class="section-heading">{content.workbench.title}</h2>
        </div>
        <p class="section-lead">{content.workbench.description}</p>
      </div>
      <div class="work-mode-grid">
        {content.workbench.items.map((item) => (
          <article>
            <span class="mode-index">{item.index}</span>
            <p class="mode-use">{item.use}</p>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
            <strong>{item.output}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="landing-band" aria-labelledby="expert-squads-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{content.squads.eyebrow}</p>
          <h2 id="expert-squads-title" class="section-heading">{content.squads.title}</h2>
        </div>
        <div>
          <p class="section-lead">{content.squads.description}</p>
          <div class="hero-actions">
            <a class="primary-action" href={publicPath(locale, "/market/")}>{content.squads.action}</a>
            <a class="secondary-action" href={publicPath(locale, "/publish/")}>{content.squads.buildAction}</a>
          </div>
        </div>
      </div>

      <div class="squad-story-grid">
        <div class="squad-capabilities">
          {content.squads.capabilities.map(([title, description], index) => (
            <article>
              <span>0{index + 1}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
        <div class="squad-image-stack">
          <figure>
            <Image src={ExpertSquadCatalog} width={900} alt={content.squads.catalogAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "先比较用途、角色与工作流" : "Compare purpose, roles, and workflow first"}</figcaption>
          </figure>
          <figure>
            <Image src={ExpertSquadInstalled} width={900} alt={content.squads.installedAlt} loading="lazy" decoding="async" />
            <figcaption>{locale === "zh-cn" ? "安装后仍由你明确选择与激活" : "Selection and activation remain explicit after install"}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="landing-band runtime-boundary" aria-labelledby="mission-title">
      <div>
        <p class="eyebrow">{content.mission.eyebrow}</p>
        <h2 id="mission-title" class="section-heading">{content.mission.title}</h2>
        <p class="section-lead">{content.mission.description}</p>
        <figure class="runtime-image">
          <Image src={RuntimeDesktopContinuity} width={900} alt={content.mission.imageAlt} loading="lazy" decoding="async" />
        </figure>
      </div>
      <div class="runtime-facts">
        {content.mission.facts.map(([title, description]) => (
          <article><b>{title}</b><p>{description}</p></article>
        ))}
      </div>
    </section>

    <section class="landing-band start-section" aria-labelledby="community-title">
      <div>
        <p class="eyebrow">{content.community.eyebrow}</p>
        <h2 id="community-title" class="section-heading">{content.community.title}</h2>
        <p class="section-lead">{content.community.description}</p>
      </div>
      <div class="start-actions">
        {content.community.cards.map((card) => (
          <a
            class:list={["start-card", { "start-card-primary": card.primary }]}
            href={card.href.startsWith("https://") ? card.href : publicPath(locale, card.href)}
          >
            <span>{card.label}</span>
            <strong>{card.title}</strong>
            <small>{card.note}</small>
          </a>
        ))}
      </div>
    </section>
  </div>

  <PublicSiteFooter {locale} />
</div>

<script>
  for (const figure of document.querySelectorAll<HTMLElement>("[data-concept-flow]")) {
    const image = figure.querySelector<HTMLImageElement>("img")
    const mobileSource = figure.querySelector<HTMLSourceElement>("[data-concept-flow-source]")
    const button = figure.querySelector<HTMLButtonElement>("button")
    const staticSrc = figure.dataset.staticSrc
    const animationSrc = figure.dataset.animationSrc
    const mobileStaticSrc = figure.dataset.mobileStaticSrc
    const mobileAnimationSrc = figure.dataset.mobileAnimationSrc
    const playLabel = figure.dataset.playLabel
    const stopLabel = figure.dataset.stopLabel

    if (!image || !mobileSource || !button || !staticSrc || !animationSrc || !mobileStaticSrc || !mobileAnimationSrc || !playLabel || !stopLabel) continue

    button.addEventListener("click", () => {
      const playing = button.getAttribute("aria-pressed") === "true"
      image.src = playing ? staticSrc : animationSrc
      mobileSource.srcset = playing ? mobileStaticSrc : mobileAnimationSrc
      button.setAttribute("aria-pressed", String(!playing))
      button.textContent = playing ? playLabel : stopLabel
    })
  }
</script>

<style>
  .public-landing {
    min-width: 1100px;
    overflow: hidden;
  }

  .landing-hero {
    align-items: center;
  }

  .hero-title-line {
    display: block;
    white-space: nowrap;
  }

  .concept-flow {
    margin: 0;
    border: 2px solid var(--ink);
    background: var(--ink);
    box-shadow: 14px 14px 0 var(--cobalt-wash);
    overflow: hidden;
  }

  .concept-flow-frame {
    aspect-ratio: 16 / 9;
    background: var(--paper);
  }

  .concept-flow-frame picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  .concept-flow img,
  .runtime-image img,
  .squad-image-stack img {
    display: block;
    width: 100%;
    height: auto;
  }

  .concept-flow-meta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px;
    padding: 10px 12px 10px 16px;
    border-top: 1px solid #393a3f;
  }

  .concept-flow figcaption,
  .squad-image-stack figcaption {
    color: #d9d9d2;
    font-family: var(--mono);
    font-size: 11px;
  }

  .concept-flow-toggle {
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid #d9d9d2;
    background: transparent;
    color: white;
    font: 700 11px/1.2 var(--mono);
    cursor: pointer;
  }

  .concept-flow-toggle:hover,
  .concept-flow-toggle[aria-pressed="true"] {
    background: var(--cobalt);
  }

  .work-mode-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .work-mode-grid article {
    min-height: 330px;
    padding: 26px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--paper-raised);
  }

  .work-mode-grid article:nth-child(2) {
    background: var(--cobalt-wash);
  }

  .mode-index,
  .mode-use {
    font-family: var(--mono);
    font-size: 11px;
  }

  .mode-index {
    color: var(--cobalt);
  }

  .mode-use {
    min-height: 36px;
    margin: 36px 0 0;
    color: var(--muted);
    text-transform: uppercase;
  }

  .public-landing .work-mode-grid h3 {
    margin: 8px 0 18px;
    font-family: var(--display);
    color: var(--ink) !important;
    font-size: 42px !important;
    font-weight: 700 !important;
    line-height: 1 !important;
    letter-spacing: -0.055em;
  }

  .work-mode-grid article > p:not(.mode-use) {
    min-height: 92px;
    margin: 0 0 24px;
    color: var(--muted);
  }

  .work-mode-grid strong {
    display: block;
    padding-top: 16px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
  }

  .squad-story-grid {
    display: grid;
    grid-template-columns: 0.72fr 1.28fr;
    gap: 56px;
    align-items: start;
  }

  .squad-capabilities {
    border-top: 2px solid var(--ink);
  }

  .squad-capabilities article {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 18px;
    padding: 24px 0;
    border-bottom: 1px solid var(--ink);
  }

  .squad-capabilities span {
    color: var(--cobalt);
    font-family: var(--mono);
    font-size: 11px;
  }

  .public-landing .squad-capabilities h3 {
    margin: 0 0 7px;
    color: var(--ink) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.6 !important;
  }

  .squad-capabilities p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .squad-image-stack {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 18px;
    align-items: end;
  }

  .squad-image-stack figure,
  .runtime-image {
    margin: 0;
    border: 2px solid var(--ink);
    background: #0d0e12;
  }

  .squad-image-stack figure:last-child {
    transform: translateY(32px);
  }

  .squad-image-stack figcaption {
    padding: 12px 16px;
    border-top: 1px solid #393a3f;
  }

  .runtime-image {
    margin-top: 38px;
  }

  .start-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 72px;
    align-items: start;
  }

  .start-actions {
    border-top: 2px solid var(--ink);
  }

  .start-card {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: 10px 24px;
    padding: 24px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
    text-decoration: none;
  }

  .start-card:hover {
    background: var(--cobalt-wash);
  }

  .start-card-primary {
    background: var(--cobalt);
    color: white;
  }

  .start-card-primary:hover {
    background: var(--cobalt-deep);
  }

  .start-card span {
    grid-row: 1 / span 2;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .start-card strong {
    line-height: 1.35;
  }

  .start-card small {
    color: currentColor;
    opacity: 0.72;
  }

  @media (max-width: 1099px) {
    .public-landing {
      min-width: 0;
      overflow: visible;
    }

    .public-landing .landing-hero,
    .public-landing .squad-story-grid,
    .public-landing .squad-image-stack,
    .public-landing .runtime-boundary,
    .public-landing .start-section {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-landing .landing-hero {
      gap: 40px;
      min-height: 0;
      padding: 48px 0 56px;
    }

    .hero-title-line {
      white-space: normal;
    }

    .public-landing .proof-strip,
    .public-landing .work-mode-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-landing .proof-strip article,
    .public-landing .proof-strip article:last-child {
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid var(--ink);
    }

    .work-mode-grid article {
      min-height: 0;
    }

    .work-mode-grid article > p:not(.mode-use),
    .mode-use {
      min-height: 0;
    }

    .mode-use {
      margin-top: 24px;
    }

    .public-landing .squad-story-grid,
    .public-landing .squad-image-stack,
    .public-landing .start-section {
      gap: 32px;
    }

    .squad-image-stack figure:last-child {
      transform: none;
    }

    .public-landing .runtime-boundary {
      gap: 38px;
    }

    .public-landing .runtime-facts article {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .start-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .start-card span {
      grid-row: auto;
    }
  }

  @media (max-width: 720px) {
    .public-landing .concept-flow-frame {
      aspect-ratio: 9 / 16;
    }

    .public-landing .concept-flow-frame img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .public-landing .concept-flow-meta,
    .public-landing .hero-actions {
      grid-template-columns: minmax(0, 1fr);
    }

    .public-landing .concept-flow-meta {
      display: grid;
      align-items: stretch;
      padding: 14px;
    }

    .concept-flow-toggle {
      min-width: 44px;
      min-height: 44px;
    }

    .public-landing .hero-actions {
      display: grid;
    }

    .public-landing .hero-actions a {
      width: 100%;
    }
  }
</style>

<style is:global>
  :root[data-has-hero] .sl-skip-link {
    display: none;
  }

  :root[data-has-hero] header.header {
    display: none;
  }

  :root[data-has-hero] .main-frame,
  :root[data-has-hero] .main-pane,
  :root[data-has-hero] .main-pane > main {
    padding: 0;
  }

  :root[data-has-hero] .content-panel,
  :root[data-has-hero] .content-panel > .sl-container {
    border: 0;
    margin: 0;
    max-width: none;
    padding: 0 !important;
  }

  :root[data-has-hero] .content-panel .sl-markdown-content {
    display: none;
  }

  :root[data-has-hero] body {
    margin: 0;
    background: var(--paper);
  }
</style>
