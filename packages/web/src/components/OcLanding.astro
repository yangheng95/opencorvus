---
import OcLayout from "./OcLayout.astro"
import OcDownload from "./OcDownload.astro"
import { landingCopy } from "../content/landing-copy"
import { publicPath, type PublicLocale } from "../content/public-market"

const { locale } = Astro.props as { locale: PublicLocale }
const copy = landingCopy[locale]
const zh = locale === "zh-cn"
const languageHref = publicPath(zh ? "root" : "zh-cn")
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const caseHref = publicPath(locale, "/cases/tank-battle/")
---
<OcLayout {locale} current="home" title={copy.meta.title} description={copy.meta.description} {languageHref}>
  <div class="story">
    <section class="story-hero oc-container" id="download" aria-labelledby="story-title">
      <div class="hero-message">
        <p class="eyebrow"><span class="signal" aria-hidden="true"></span>{copy.hero.eyebrow}</p>
        <h1 id="story-title">{copy.hero.titleLines.map((line) => <span>{line}</span>)}</h1>
        <p class="lede">{copy.hero.description}</p>
        <div class="hero-actions">
          <OcDownload {locale} />
          <a class="text-link" href="#case">{copy.hero.secondary}<span aria-hidden="true"> ↗</span></a>
        </div>
        <p class="hero-note">{copy.hero.note}</p>
      </div>
      <div class="execution-map" aria-label={copy.map.label}>
        <div class="map-top"><span class="map-mark" aria-hidden="true">↳</span><span>{copy.map.label}</span><small>{copy.map.badge}</small></div>
        <div class="map-owner"><strong>{copy.map.owner}</strong><span>{copy.map.ownerNote}</span></div>
        <div class="map-stages">
          {copy.map.stages.map((stage, index) => (
            <details class="map-stage" name="execution-stage" open={index === 2}>
              <summary>
                <span class="stage-number">0{index + 1}</span>
                <span class="stage-copy"><strong>{stage.title}</strong><span>{stage.roles.join(" · ")}</span></span>
                <span class="stage-output">{stage.output}</span>
                <span class="stage-toggle" aria-hidden="true">+</span>
              </summary>
              <p>{stage.detail}</p>
            </details>
          ))}
        </div>
        <div class="map-return"><span aria-hidden="true">↶</span>{copy.map.loop}</div>
        <p class="map-hint">{copy.map.hint}</p>
        <p class="map-disclaimer">{copy.map.disclaimer}</p>
      </div>
    </section>

    <section class="pain-section oc-container" id="horizon" aria-labelledby="pain-title">
      <div class="section-heading"><p class="eyebrow">{copy.pains.eyebrow}</p><h2 id="pain-title">{copy.pains.title}</h2></div>
      <div class="pain-grid">
        {copy.pains.cards.map((card, index) => (
          <article class="pain-card">
            <p class="card-index"><span>0{index + 1}</span>{card.tag}</p>
            <h3>{card.title}</h3><p>{card.body}</p><strong class="card-result">{card.result}</strong>
          </article>
        ))}
      </div>
    </section>

    <section class="case-section" id="case" aria-labelledby="case-title">
      <div class="oc-container">
        <div class="case-heading">
          <div><p class="eyebrow">{copy.case.eyebrow}</p><h2 id="case-title">{copy.case.title}</h2></div>
          <p class="case-lead">{copy.case.lead}</p>
        </div>
        <div class="case-grid">
          <div class="case-visual">
            <blockquote><span aria-hidden="true">“</span>{copy.case.request}</blockquote>
            <figure>
              <img src={`${base}/media/tank-battle-case.png`} alt={copy.case.screenshot} width="720" height="624" loading="lazy" decoding="async" />
              <figcaption>{copy.case.caption}</figcaption>
            </figure>
          </div>
          <div class="case-record">
            <div class="case-stats">{copy.case.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div>
            <ol class="case-revisions">
              {copy.case.revisions.map((revision) => <li><span class="revision-label">{revision.label}</span><h3>{revision.title}</h3><p>{revision.body}</p></li>)}
            </ol>
            <a class="text-link" href={caseHref}>{copy.case.link}<span aria-hidden="true"> ↗</span></a>
            <p class="case-caveat">{copy.case.caveat}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="uses-section oc-container" id="work" aria-labelledby="uses-title">
      <div class="section-heading"><p class="eyebrow">{copy.uses.eyebrow}</p><h2 id="uses-title">{copy.uses.title}</h2></div>
      <div class="use-grid">{copy.uses.cards.map((card, index) => (
        <article class="use-card"><span class="use-icon" aria-hidden="true">{["⌘", "⌕", "⇄"][index]}</span><h3>{card.title}</h3><p>{card.body}</p><a class="text-link" href={publicPath(locale, card.href)}>{card.link} ↗</a></article>
      ))}</div>
      <p class="section-note">{copy.uses.note}</p>
    </section>

    <section class="start-section oc-container" id="start" aria-labelledby="start-title">
      <div class="start-panel">
        <div><p class="eyebrow">{copy.start.eyebrow}</p><h2 id="start-title">{copy.start.title}</h2><p class="start-lead">{copy.start.lead}</p>
          <ol class="start-steps">{copy.start.steps.map((step) => <li>{step}</li>)}</ol>
          <div class="oc-btn-group"><a class="oc-btn oc-btn-primary oc-btn-m" href={publicPath(locale, "/start/quickstart/")}>{copy.start.docs} ↗</a><a class="oc-btn oc-btn-secondary oc-btn-m" href={publicPath(locale, "/market/")}>{copy.start.market}</a></div>
        </div>
        <div class="task-example"><p class="eyebrow">{copy.start.exampleLabel}</p><blockquote>{copy.start.example}</blockquote><span class="example-mark" aria-hidden="true">↗</span></div>
      </div>
      <p class="boundaries">{copy.start.boundaries}</p>
      <div class="research-link" id="research"><span>{copy.start.research}</span><a href={`${base}/papers/opencorvus-poc.pdf`}>{copy.start.paper} ↗</a></div>
    </section>
  </div>
</OcLayout>

<style>
  .story { --story-accent: #315be8; --story-green: #117a56; --story-amber: #a15c13; color: var(--oc-color-text-primary); }
  :global([data-theme="dark"]) .story, :global(.dark) .story { --story-accent: #8ca8ff; --story-green: #76d7b1; --story-amber: #e5b47e; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .story { --story-accent: #8ca8ff; --story-green: #76d7b1; --story-amber: #e5b47e; }
  }
  .story section { scroll-margin-top: 100px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; font-size: 11px; font-weight: 700; letter-spacing: .11em; color: var(--story-accent); margin: 0 0 24px; line-height: 1.6; }
  .signal { width: 7px; height: 7px; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 4px color-mix(in srgb, var(--story-accent) 10%, transparent); }
  .story h1, .story h2, .story h3, .story p { margin-top: 0; }
  .story h1 { font-family: var(--oc-font-body); font-size: clamp(42px, 4.5vw, 68px); font-weight: 700; line-height: 1.1; letter-spacing: -.055em; margin-bottom: 28px; }
  .story h1 span { display: block; }
  .story h1 span:first-child { color: var(--oc-color-text-description); }
  :global([lang="zh-CN"]) .story h1 { line-height: 1.23; letter-spacing: -.045em; }
  .story h2 { font-family: var(--oc-font-body); font-size: clamp(30px, 3vw, 43px); line-height: 1.2; letter-spacing: -.035em; font-weight: 700; margin-bottom: 0; text-wrap: balance; }
  .story h3 { font-size: 21px; line-height: 1.4; letter-spacing: -.025em; font-weight: 700; }
  .story-hero { display: grid; grid-template-columns: minmax(0, .93fr) minmax(0, 1.15fr); gap: 64px; align-items: center; padding-block: 64px 80px; }
  .lede { max-width: 43ch; color: var(--oc-color-text-secondary); font-size: 17px; line-height: 1.8; margin-bottom: 28px; }
  .hero-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .text-link { font-size: 14px; font-weight: 700; color: var(--story-accent); text-decoration: none; line-height: 1.6; }
  .text-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .hero-note { margin-block: 25px 0; font-size: 11px; color: var(--oc-color-text-description); line-height: 1.6; }
  .execution-map { padding: 24px; background: #111b2d; color: #e9effa; border: 1px solid #2b3b54; border-radius: 20px; box-shadow: 0 24px 64px #12224818; position: relative; }
  .map-top { display: flex; gap: 9px; align-items: center; font-size: 13px; line-height: 1.6; margin-bottom: 24px; }
  .map-mark { color: #92b1ff; font-size: 22px; }
  .map-top small { margin-left: auto; color: #a9b7cb; font-size: 9px; letter-spacing: .06em; text-align: right; }
  .map-owner { display: flex; flex-direction: column; gap: 5px; border: 1px solid #486899; background: #1b2f4e; border-radius: 8px; padding: 15px 18px; margin-bottom: 16px; }
  .map-owner strong { font-size: 15px; }
  .map-owner span { font-size: 11px; color: #acc3e9; }
  .map-stages { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .map-stage { border: 1px solid #304059; border-radius: 8px; background: #19263a; }
  .map-stage[open] { border-color: #90aaff; background: #203452; }
  .map-stage summary { cursor: pointer; list-style: none; display: grid; grid-template-columns: 23px minmax(0, 1fr) auto 12px; gap: 12px; padding: 12px; align-items: center; }
  .map-stage summary::-webkit-details-marker { display: none; }
  .map-stage summary:hover { background: #ffffff07; border-radius: 8px; }
  .stage-number { font-family: var(--oc-font-mono); font-size: 11px; color: #9bb8ed; }
  .stage-copy { display: flex; flex-direction: column; gap: 4px; }
  .stage-copy strong { font-size: 13px; font-weight: 500; }
  .stage-copy > span { font-size: 10px; color: #afbdd1; }
  .stage-output { font-size: 10px; color: #91c8bc; text-align: right; max-width: 105px; }
  .stage-toggle { color: #b7caff; font-size: 16px; }
  .map-stage[open] .stage-toggle { transform: rotate(45deg); }
  .map-stage > p { padding: 0 16px 15px 47px; color: #c4d2e6; font-size: 12px; line-height: 1.8; margin: 0; }
  .map-return { margin-top: 14px; display: flex; gap: 12px; align-items: center; color: #f1c58d; background: #d39c4320; border-left: 2px solid #d39c43; padding: 11px 14px; border-radius: 0 6px 6px 0; font-size: 12px; }
  .map-return > span { font-size: 24px; line-height: 1; }
  .map-hint { color: #b0bfd5; font-size: 10px; margin: 15px 0 6px; }
  .map-disclaimer { font-size: 10px; color: #9dacc3; line-height: 1.6; margin-bottom: 0; }
  .pain-section { border-top: 1px solid var(--oc-color-border-subtle); padding-block: 70px 90px; }
  .section-heading { max-width: 820px; margin-bottom: 42px; }
  .section-heading .eyebrow { margin-bottom: 16px; }
  .pain-grid, .use-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px; }
  .pain-card + .pain-card { border-left: 1px solid var(--oc-color-border-subtle); padding-left: 36px; }
  .card-index { display: flex; align-items: center; gap: 12px; font-size: 10px; font-weight: 700; letter-spacing: .08em; color: var(--oc-color-text-description); margin-bottom: 22px; }
  .card-index span { color: var(--story-accent); font-family: var(--oc-font-mono); font-size: 14px; }
  .pain-card h3 { min-height: 60px; margin-bottom: 18px; }
  .pain-card > p:not(.card-index), .use-card p { color: var(--oc-color-text-secondary); font-size: 14px; line-height: 1.9; margin-bottom: 24px; }
  .card-result { display: block; color: var(--story-green); font-size: 12px; line-height: 1.7; }
  .case-section { background: var(--oc-color-bg-surface-3); border-block: 1px solid var(--oc-color-border-subtle); padding-block: 80px; }
  .case-heading { display: grid; grid-template-columns: 1.1fr 1fr; gap: 70px; align-items: end; margin-bottom: 42px; }
  .case-heading h2 { white-space: pre-line; }
  .case-heading .eyebrow { margin-bottom: 16px; }
  .case-lead { color: var(--oc-color-text-secondary); line-height: 1.9; font-size: 15px; margin-bottom: 0; }
  .case-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: 70px; }
  .case-visual { align-self: start; }
  .case-visual blockquote { display: flex; gap: 12px; margin: 0; font-size: 14px; line-height: 1.8; padding: 22px; color: #dce7fa; background: #19263a; border-radius: 12px 12px 0 0; }
  .case-visual blockquote > span { color: #8eaaff; font-size: 32px; line-height: 1; }
  .case-visual figure { margin: 0; background: #080c15; border-radius: 0 0 12px 12px; overflow: hidden; }
  .case-visual img { display: block; width: 100%; height: auto; }
  .case-visual figcaption { text-align: center; font-size: 11px; line-height: 1.5; color: #a8b8d2; padding: 15px; }
  .case-stats { display: grid; grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--oc-color-border-subtle); padding-bottom: 24px; margin-bottom: 28px; }
  .case-stats > div { display: flex; flex-direction: column; gap: 5px; }
  .case-stats strong { font-family: var(--oc-font-body); font-size: 44px; font-weight: 500; letter-spacing: -.06em; line-height: 1.2; }
  .case-stats span { font-size: 11px; color: var(--oc-color-text-secondary); line-height: 1.6; padding-right: 10px; }
  .case-revisions { padding: 0; margin: 0; list-style: none; }
  .case-revisions li { border-left: 2px solid var(--story-amber); padding-left: 18px; margin-bottom: 28px; }
  .revision-label { font-size: 10px; font-weight: 700; color: var(--story-amber); letter-spacing: .08em; }
  .case-revisions h3 { font-size: 17px; margin: 8px 0; }
  .case-revisions p { color: var(--oc-color-text-secondary); font-size: 13px; line-height: 1.85; margin: 0; }
  .case-caveat { color: var(--oc-color-text-description); font-size: 11px; line-height: 1.8; margin: 18px 0 0; }
  .uses-section { padding-block: 90px; }
  .use-card { display: flex; flex-direction: column; align-items: flex-start; padding: 26px; border: 1px solid var(--oc-color-border-subtle); border-radius: 12px; }
  .use-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 8px; background: var(--oc-color-bg-surface-3); color: var(--story-accent); font-size: 24px; margin-bottom: 28px; }
  .use-card h3 { font-size: 18px; }
  .use-card .text-link { margin-top: auto; font-size: 12px; }
  .section-note { margin-block: 22px 0; color: var(--oc-color-text-description); font-size: 11px; line-height: 1.7; }
  .start-section { padding-bottom: 64px; }
  .start-panel { display: grid; grid-template-columns: 1.3fr 1fr; gap: 65px; padding: 48px; border-radius: 16px; background: var(--oc-color-bg-surface-3); border: 1px solid var(--oc-color-border-subtle); }
  .start-panel h2 { font-size: 32px; }
  .start-panel .eyebrow { margin-bottom: 18px; }
  .start-lead { margin-block: 20px 24px; color: var(--oc-color-text-secondary); font-size: 14px; line-height: 1.9; }
  .start-steps { color: var(--oc-color-text-secondary); padding-left: 20px; font-size: 13px; line-height: 2.1; margin-bottom: 28px; }
  .task-example { position: relative; align-self: center; background: var(--oc-color-bg-page); border: 1px solid var(--oc-color-border-subtle); padding: 28px; border-radius: 10px; }
  .task-example blockquote { margin: 0; font-size: 15px; line-height: 1.9; }
  .example-mark { display: block; text-align: right; font-size: 28px; color: var(--story-accent); margin-top: 14px; }
  .boundaries { font-size: 12px; line-height: 1.8; color: var(--oc-color-text-description); max-width: 900px; margin: 25px 0 42px; }
  .research-link { display: flex; flex-wrap: wrap; gap: 15px 40px; border-top: 1px solid var(--oc-color-border-subtle); padding-top: 25px; font-size: 12px; color: var(--oc-color-text-description); }
  .research-link a { color: var(--oc-color-text-secondary); }
  .story :is(a, summary):focus-visible { outline: 3px solid var(--story-accent); outline-offset: 5px; }
  .execution-map summary:focus-visible { outline-color: #adc2ff; outline-offset: 2px; }
  @media (max-width: 1100px) {
    .story-hero { gap: 32px; }
    .case-grid, .case-heading { gap: 36px; }
    .map-stage summary { gap: 8px; }
    .stage-output { max-width: 75px; }
    .pain-grid, .use-grid { gap: 20px; }
    .pain-card + .pain-card { padding-left: 20px; }
  }
  @media (max-width: 800px) {
    .story-hero, .case-heading, .case-grid, .start-panel { grid-template-columns: 1fr; }
    .story-hero { padding-top: 42px; gap: 40px; }
    .story h1 { font-size: 52px; }
    .pain-grid, .use-grid { grid-template-columns: 1fr; }
    .pain-card + .pain-card { padding: 24px 0 0; border-left: 0; border-top: 1px solid var(--oc-color-border-subtle); }
    .pain-card h3 { min-height: auto; }
    .pain-section, .case-section, .uses-section { padding-block: 48px; }
    .case-grid, .case-heading { gap: 28px; }
    .start-panel { padding: 28px; gap: 24px; }
    .stage-output { max-width: 100px; }
  }
  @media (max-width: 420px) {
    .story h1 { font-size: 42px; }
    .execution-map { padding: 16px; }
    .stage-output { display: none; }
    .map-stage summary { grid-template-columns: 23px 1fr 12px; }
  }
</style>
