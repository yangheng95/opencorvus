---
import OcLayout from "./OcLayout.astro"
import OcHeroBackdrop from "./OcHeroBackdrop.astro"
import OcDemoVideo from "./OcDemoVideo.astro"
import { landingCopy } from "../content/landing-copy"
import { platformFacts } from "../content/platform-facts"
import { publicPath, type PublicLocale } from "../content/public-market"
import config from "../../config.mjs"
import type { FeaturedSquad } from "../lib/landing-featured-squads"
import { featuredComposition, otherCompositions } from "../lib/landing-compositions"
import { readDownloadManifest, formatBytes } from "../lib/landing-downloads"

type Props = {
  locale: PublicLocale
  /** Featured squads, already trimmed by the page. Empty renders the section without cards. */
  featured?: FeaturedSquad[]
}

const { locale, featured = [] } = Astro.props
const zh = locale === "zh-cn"
const copy = landingCopy[locale]
const languageHref = zh ? publicPath("root") : publicPath("zh-cn")

/** Copy holds bare hrefs; anything site-local has to be run through the locale-aware base. */
const resolve = (href: string) => (href.startsWith("/") ? publicPath(locale, href) : href)

/** Chinese passes the same string for both forms, so this is a no-op there by construction. */
const plural = (count: number, one: string, other: string) => (count === 1 ? one : other)

const marketHref = publicPath(locale, "/market/")
const compositionHref = publicPath(locale, "/concepts/squad-composition/")
const evolutionHref = publicPath(locale, "/expert-squads/evolution/")
const downloads = readDownloadManifest()

// The case study and the shorter chains beside it. Counts come from the generated catalog facts;
// see lib/landing-compositions.ts.
const caseStudy = featuredComposition(locale)
const combinations = otherCompositions(locale)

// Only generated facts are allowed to be the largest thing on the page. See platform-facts.ts.
const featurableSquadTotal = platformFacts.squadTotal
---

<OcLayout
  {locale}
  current="home"
  title={copy.meta.title}
  description={copy.meta.description}
  {languageHref}
>
  {/* ------------------------------------------------------------ 1 · hero */}
  <section class="oc-hero">
    <OcHeroBackdrop />

    <div class="oc-container oc-hero-inner">
      <div class="oc-hero-copy">
        <p class="oc-eyebrow oc-enter" style="--oc-enter-y: 12px">{copy.hero.eyebrow}</p>
        <h1 class="oc-text-hero oc-cjk-spacing oc-hero-title">
          {
            copy.hero.titleLines.map((line, index) => (
              <span class="oc-enter" style={`--oc-enter-y: 22px; --oc-enter-blur: 6px; animation-delay: ${80 + index * 90}ms`}>
                {line}
              </span>
            ))
          }
        </h1>
        <p class="oc-text-body oc-text-secondary oc-hero-lede oc-enter" style="--oc-enter-y: 18px; animation-delay: 280ms">
          {copy.hero.description}
        </p>
        <div class="oc-btn-group oc-enter" style="--oc-enter-y: 16px; animation-delay: 360ms">
          {/*
            The download is the first thing on the page and the menu is rendered server-side, so
            every installer is a real link before any script runs. Detection only swaps the default
            target; with JavaScript off the reader still gets the full list rather than a button
            that does nothing.
          */}
          <div class="oc-download" data-oc-download data-download-verb={copy.hero.download.verb}>
            <a
              class="oc-btn oc-btn-primary oc-btn-m oc-download-primary"
              href={downloads?.releaseUrl ?? config.github}
              data-oc-download-primary
            >
              <span data-oc-download-label>{copy.hero.download.label}</span>
            </a>

            {
              downloads && (
                <details class="oc-download-menu" data-oc-download-menu>
                  <summary
                    class="oc-btn oc-btn-primary oc-btn-m oc-download-toggle"
                    aria-label={copy.hero.download.menuLabel}
                    title={copy.hero.download.menuLabel}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </summary>

                  <div class="oc-glass-dropdown oc-download-panel">
                    <p class="oc-eyebrow oc-download-panel-title">{copy.hero.download.allPlatforms}</p>
                    {
                      downloads.groups.map((group) => (
                        <section class="oc-download-group">
                          <p class="oc-download-group-name">{group.label}</p>
                          <ul>
                            {group.assets.map((asset) => (
                              <li>
                                <a href={asset.url} data-oc-download-asset={`${asset.platform}-${asset.architecture}`}>
                                  <span>{asset.architecture} · {asset.format}</span>
                                  <span class="oc-download-size">{formatBytes(asset.bytes)}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))
                    }
                    <p class="oc-text-xs oc-text-description oc-download-note">
                      {copy.hero.download.releaseNote}
                      {downloads.version && ` · ${downloads.version}`}
                    </p>
                  </div>
                </details>
              )
            }
          </div>

          {
            copy.hero.ctas.map((cta) => (
              <a class={`oc-btn oc-btn-${cta.variant} oc-btn-m`} href={resolve(cta.href)}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="oc-hero-terminal oc-enter" style="--oc-enter-y: 24px; animation-delay: 440ms">
        <div class="oc-terminal" data-oc-terminal>
          <div class="oc-terminal-tabs" role="tablist" aria-label={copy.hero.terminalLabel}>
            {
              copy.hero.terminals.map((terminal, index) => (
                <button
                  type="button"
                  role="tab"
                  class="oc-terminal-tab"
                  data-oc-terminal-tab={terminal.id}
                  data-active={index === 0 ? "true" : undefined}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {terminal.label}
                </button>
              ))
            }
          </div>

          <div class="oc-terminal-body">
            {
              copy.hero.terminals.map((terminal, index) => (
                <div
                  class="oc-terminal-pane"
                  data-oc-terminal-pane={terminal.id}
                  data-active={index === 0 ? "true" : undefined}
                  role="tabpanel"
                >
                  {/*
                    Two stacked <pre> blocks. The hidden one carries the full text so the box is
                    already its final height before typing starts; without it every character
                    reflows the section below and the whole page twitches.
                  */}
                  <pre class="oc-terminal-text" data-oc-terminal-out aria-hidden="true"></pre>
                  <pre class="oc-terminal-text oc-terminal-ghost" data-oc-terminal-source>{terminal.lines.join("\n")}</pre>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- 2 · demo */}
  {/*
    Directly under the hero because "what is it actually like to use" is the question the hero
    raises, and because a recording of one real run is the strongest evidence on the page — it
    belongs where a reader is still deciding whether to keep scrolling.
  */}
  <OcDemoVideo {locale} />

  {/* -------------------------------------------------- 3 · long-horizon */}
  {/*
    Named failures before named mechanisms. Borrowed from LongHorizon-Harness, which opens on
    compounding errors, context rot, task-state loss and unverified premises rather than on its
    loop: a reader who has not yet felt the failure has no question that "durable execution"
    answers. Each card therefore states the break first and the mechanism second.
  */}
  <section class="oc-section oc-anchor" id="horizon">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.horizon.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.horizon.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.horizon.lead}</p>

      <ul class="oc-pillar-grid">
        {
          copy.horizon.breaks.map((entry, index) => (
            <li class="oc-card-raised oc-pillar oc-reveal" style={`transition-delay: ${index * 70}ms`}>
              <h3 class="oc-text-subtitle oc-cjk-spacing">{entry.title}</h3>
              <p class="oc-text-body oc-text-description">{entry.body}</p>
              <p class="oc-pillar-evidence">
                <span class="oc-text-xs oc-text-description">{entry.evidenceLabel}</span>
                <span class="oc-break-evidence-value">{entry.evidenceValue}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------------------------------------------------- 4 · composition */}
  {/*
    The case study is the argument for combining squads, so it is shown as a real chain rather than
    described: every stage names the squad that owns it, how many roles that squad declares, and
    what it hands the next one. The numbers are generated from the shipped catalog — see
    content/squad-compositions.ts for why they are not typed into copy.
  */}
  <section class="oc-section-tight oc-anchor" id="compose">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.compose.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.compose.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.compose.lead}</p>

      <div class="oc-card-raised oc-case oc-reveal">
        <div class="oc-case-head">
          <div class="oc-case-head-copy">
            <p class="oc-eyebrow">{copy.compose.caseLabel}</p>
            <h3 class="oc-text-title oc-cjk-spacing">{caseStudy.title}</h3>
            <p class="oc-text-caption oc-text-description">{caseStudy.lead}</p>
          </div>
          <p class="oc-case-total">
            <span class="oc-case-total-value">{caseStudy.squadCount}</span>
            <span class="oc-text-xs oc-text-description">{copy.compose.squadsUnit}</span>
            <span class="oc-case-total-value">{caseStudy.roleCount}</span>
            <span class="oc-text-xs oc-text-description">{copy.compose.rolesUnit}</span>
          </p>
        </div>

        <ol class="oc-case-chain">
          {
            caseStudy.steps.map((step) => (
              <li class="oc-case-step">
                <p class="oc-case-stage">{step.stage}</p>
                <p class="oc-case-squad">
                  <a class="oc-link" href={step.href}>
                    {step.squadLabel}
                  </a>
                  <span class="oc-text-xs oc-text-description">
                    {step.agentCount} {copy.compose.rolesUnit}
                  </span>
                </p>
                <p class="oc-text-caption oc-text-description oc-case-handoff">{step.handoff}</p>
              </li>
            ))
          }
        </ol>

        {
          caseStudy.extras && (
            <p class="oc-text-caption oc-text-secondary oc-case-extras">
              {caseStudy.extras.lead}{" "}
              <span class="oc-case-extras-total">
                {caseStudy.extras.squadCount} {copy.compose.squadsUnit} · {caseStudy.extras.roleCount}{" "}
                {copy.compose.rolesUnit}
              </span>
            </p>
          )
        }
      </div>

      <p class="oc-eyebrow oc-combo-label oc-reveal">{copy.compose.moreLabel}</p>
      <ul class="oc-combo-grid">
        {
          combinations.map((combination, index) => (
            <li class="oc-card oc-combo oc-reveal" style={`transition-delay: ${(index % 3) * 70}ms`}>
              <h3 class="oc-text-subtitle oc-cjk-spacing">{combination.title}</h3>
              <p class="oc-text-caption oc-text-description">{combination.lead}</p>
              <ul class="oc-combo-chain">
                {combination.steps.map((step) => (
                  <li>
                    <a class="oc-link" href={step.href}>
                      {step.squadLabel}
                    </a>
                  </li>
                ))}
              </ul>
              <p class="oc-text-xs oc-text-description oc-combo-total">
                {combination.squadCount} {copy.compose.squadsUnit} · {combination.roleCount}{" "}
                {copy.compose.rolesUnit}
              </p>
            </li>
          ))
        }
      </ul>

      <p class="oc-compose-cta oc-reveal">
        <a class="oc-btn oc-btn-secondary oc-btn-m" href={compositionHref}>{copy.compose.cta}</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------ 5 · evolution */}
  <section class="oc-section-tight oc-anchor" id="evolve">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.evolve.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.evolve.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.evolve.lead}</p>

      <ul class="oc-evolve-grid">
        {
          copy.evolve.paths.map((path, index) => (
            <li class="oc-card-raised oc-evolve oc-reveal" style={`transition-delay: ${index * 70}ms`}>
              <h3 class="oc-text-subtitle oc-cjk-spacing">{path.title}</h3>
              <p class="oc-text-body oc-text-description">{path.body}</p>
            </li>
          ))
        }
      </ul>

      {/*
        The boundary is stated in the section, not in a footnote: a page that says "squads evolve"
        and leaves the reader to discover elsewhere that nothing installs without them is a page
        that mis-sold the feature.
      */}
      <p class="oc-text-body oc-text-secondary oc-evolve-boundary oc-reveal">{copy.evolve.boundary}</p>
      <p class="oc-compose-cta oc-reveal">
        <a class="oc-btn oc-btn-secondary oc-btn-m" href={evolutionHref}>{copy.evolve.cta}</a>
      </p>
    </div>
  </section>

  {/* ------------------------------------------------------------- 6 · why */}
  <section class="oc-section oc-anchor" id="why">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.why.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.why.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.why.lead}</p>

      <ul class="oc-pillar-grid">
        {
          copy.why.pillars.map((pillar, index) => (
            <li class="oc-card-raised oc-pillar oc-reveal" style={`transition-delay: ${index * 70}ms`}>
              <h3 class="oc-text-subtitle oc-cjk-spacing">{pillar.title}</h3>
              <p class="oc-text-body oc-text-description">{pillar.body}</p>
              <p class="oc-pillar-evidence">
                <span class="oc-pillar-evidence-value">{pillar.evidenceValue}</span>
                <span class="oc-text-xs oc-text-description">{pillar.evidenceLabel}</span>
              </p>
            </li>
          ))
        }
      </ul>

      {/*
        Placed under the pillars because "how is this different from X" is the question the pillars
        raise. Every cell is a checkable fact about a shipped capability, with the source linked —
        a comparison that argues instead of informs is one a reader has to discount.
      */}
      <div class="oc-compare oc-reveal">
        <div class="oc-compare-head">
          <h3 class="oc-text-subtitle oc-cjk-spacing">{copy.why.compare.title}</h3>
          <p class="oc-text-caption oc-text-description">{copy.why.compare.lead}</p>
        </div>

        <div class="oc-compare-scroll">
          <table class="oc-compare-table">
            <thead>
              <tr>
                <th scope="col"><span class="oc-visually-hidden">{copy.why.compare.title}</span></th>
                {
                  copy.why.compare.columns.map((column) => (
                    <th scope="col" class={column.self ? "oc-compare-us" : undefined}>
                      {column.href ? (
                        <a class="oc-link" href={column.href} rel="noopener nofollow">
                          {column.label}
                        </a>
                      ) : (
                        column.label
                      )}
                    </th>
                  ))
                }
              </tr>
            </thead>
            <tbody>
              {
                copy.why.compare.rows.map((row) => (
                  <tr>
                    <th scope="row">{row.axis}</th>
                    {
                      row.cells.map((cell, index) => (
                        <td
                          class={copy.why.compare.columns[index]?.self ? "oc-compare-us" : undefined}
                          data-label={copy.why.compare.columns[index]?.label}
                        >
                          {cell}
                        </td>
                      ))
                    }
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>

        {/*
          Stated plainly rather than buried: one of these is open source too and traces runs just as
          well. A comparison table that only ever wins is one a reader stops believing.
        */}
        <p class="oc-text-caption oc-text-secondary oc-compare-fairness">{copy.why.compare.fairness}</p>
        <p class="oc-text-xs oc-text-description oc-compare-note">{copy.why.compare.note}</p>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------- 7 · squads */}
  {/*
    A funnel, not a second market. Six static cards and a link out. The filtering, search and
    segment browsing all live on /market/ — duplicating them here would mean two implementations
    of the same behaviour drifting apart. Plan §4.1.
  */}
  <section class="oc-section-tight oc-anchor" id="squads">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.squads.eyebrow}</p>
      <div class="oc-squads-head oc-reveal">
        <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title">{copy.squads.title}</h2>
        <a class="oc-btn oc-btn-secondary oc-btn-m" href={marketHref}>{copy.squads.cta}</a>
      </div>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.squads.lead}</p>

      {
        featured.length > 0 && (
          <ul class="oc-squad-grid">
            {featured.map((squad, index) => (
              <li class="oc-card oc-squad-card oc-reveal" style={`transition-delay: ${(index % 3) * 70}ms`}>
                <a href={squad.href}>
                  <h3 class="oc-text-title oc-cjk-spacing">{squad.label}</h3>
                  <p class="oc-text-caption oc-text-description oc-squad-body">{squad.description}</p>
                  <p class="oc-text-xs oc-text-description oc-squad-meta">
                    <span>{squad.agentCount} {plural(squad.agentCount, copy.squads.agentLabel, copy.squads.agentsLabel)}</span>
                    <span aria-hidden="true">·</span>
                    <span>
                      {squad.workflowCount}{" "}
                      {plural(squad.workflowCount, copy.squads.workflowLabel, copy.squads.workflowsLabel)}
                    </span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {/* ---------------------------------------------------------- 8 · start */}
  <section class="oc-section oc-anchor" id="start">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.start.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.start.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.start.lead}</p>

      <div class="oc-start-grid">
        <div class="oc-card-raised oc-reveal">
          <h3 class="oc-text-subtitle oc-cjk-spacing">{copy.start.cliTitle}</h3>
          <p class="oc-text-caption oc-text-description oc-start-body">{copy.start.cliBody}</p>
          {/*
            The command lives in the copy module so it stays reviewable next to the prose, and the
            copy button reads the same string. An earlier draft advertised `npx opencorvus@latest`,
            which the project does not publish — the install paths are a desktop installer or this
            source build. Keep both in step with README.md.
          */}
          <div class="oc-code">
            <code>{copy.start.cliCommand}</code>
            <button class="oc-copy-btn" type="button" data-oc-copy={copy.start.cliCommand} data-copied={copy.start.copied}>
              {copy.start.copy}
            </button>
          </div>
        </div>

        {/*
          The installer download moved into the hero, so this card no longer duplicates it — and
          must not, because it also carried a second [data-oc-download-primary], which would have
          fought the hero control for the same selector.
        */}
        <div class="oc-card-raised oc-reveal" style="transition-delay: 70ms">
          <h3 class="oc-text-subtitle oc-cjk-spacing">{copy.start.desktopTitle}</h3>
          <p class="oc-text-caption oc-text-description oc-start-body">{copy.start.desktopBody}</p>
          <div class="oc-code">
            <code>{copy.start.serveCommand}</code>
            <button class="oc-copy-btn" type="button" data-oc-copy={copy.start.serveCommand} data-copied={copy.start.copied}>
              {copy.start.copy}
            </button>
          </div>
          <div class="oc-btn-group oc-start-actions">
            <a class="oc-btn oc-btn-secondary oc-btn-m" href={publicPath(locale, "/start/quickstart/")}>
              {copy.start.desktopCta}
            </a>
          </div>
        </div>
      </div>

      <div class="oc-trust oc-reveal">
        <p class="oc-eyebrow">{copy.start.trustTitle}</p>
        <ul class="oc-trust-list">
          {
            copy.start.trust.map((item) => (
              <li>
                <span class="oc-text-title oc-cjk-spacing">{item.title}</span>
                <span class="oc-text-caption oc-text-description">{item.body}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ 9 · faq */}
  {/*
    Native <details>. An accordion is the one place a section can hold six answers without costing
    six answers' worth of scroll, and the disclosure widget browsers already ship is keyboard
    accessible, findable by in-page search when open, and needs no JavaScript at all.
  */}
  <section class="oc-section-tight oc-anchor" id="faq">
    <div class="oc-container oc-faq">
      <div class="oc-faq-head">
        <p class="oc-eyebrow oc-reveal">{copy.faq.eyebrow}</p>
        <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.faq.title}</h2>
        <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.faq.lead}</p>
      </div>

      <div class="oc-faq-list">
        {
          copy.faq.items.map((item, index) => (
            <details class="oc-faq-item oc-reveal" style={`transition-delay: ${Math.min(index, 4) * 50}ms`} open={index === 0}>
              <summary>
                <span class="oc-text-title oc-cjk-spacing">{item.q}</span>
                <span class="oc-faq-marker" aria-hidden="true"></span>
              </summary>
              <p class="oc-text-body oc-text-description">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------- 10 · join */}
  <section class="oc-section-tight oc-anchor" id="join">
    <div class="oc-container">
      <div class="oc-cta-block oc-join oc-reveal">
        <p class="oc-eyebrow">{copy.join.eyebrow}</p>
        <h2 class="oc-text-h1 oc-cjk-spacing">{copy.join.title}</h2>
        <p class="oc-text-body oc-text-secondary oc-join-lead">{copy.join.lead}</p>
        <div class="oc-btn-group">
          {
            copy.join.ctas.map((cta) => (
              <a class={`oc-btn oc-btn-${cta.variant} oc-btn-m`} href={resolve(cta.href)}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</OcLayout>

<style>
  /* -------------------------------------------------------------- hero */

  .oc-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: var(--oc-space-11);
    padding-bottom: var(--oc-space-9);
    /* Deliberately not `overflow: hidden`. It used to be, for the backdrop — but the backdrop
       clips itself, and the hero's copy cut 304px off the bottom of the download menu, hiding the
       Linux builds entirely. A section that contains a popover cannot also clip. */
  }

  @media (min-width: 768px) {
    .oc-hero {
      min-height: unset;
      height: 100vh;
      max-height: 1000px;
      padding-top: var(--oc-space-9);
    }
  }

  .oc-hero-inner {
    position: relative;
