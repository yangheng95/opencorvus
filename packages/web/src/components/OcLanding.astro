---
import OcLayout from "./OcLayout.astro"
import OcDownload from "./OcDownload.astro"
import { landingCopy } from "../content/landing-copy"
import { executionGraph } from "../lib/execution-graph"
import { publicPath, type PublicLocale } from "../content/public-market"

const { locale } = Astro.props as { locale: PublicLocale }
const copy = landingCopy[locale]
const zh = locale === "zh-cn"
const base = import.meta.env.BASE_URL.replace(/\/$/, "")
const caseHref = publicPath(locale, "/cases/tank-battle/")
const graphHref = `${base}/media/task-coordination-${zh ? "zh" : "en"}.svg`
---
<OcLayout {locale} current="home" title={copy.meta.title} description={copy.meta.description} languageHref={publicPath(zh ? "root" : "zh-cn")}>
  <div class="product-story">
    <section class="product-hero" id="download" aria-labelledby="product-title">
      <div class="hero-heading">
        <p class="product-name">{copy.hero.eyebrow}</p>
        <h1 id="product-title">{copy.hero.titleLines.map((line) => <span>{line}</span>)}</h1>
        <p class="hero-definition">{copy.hero.description}</p>
        <div class="hero-actions">
          <OcDownload {locale} />
          <a href="#execution">{copy.hero.secondary} <span aria-hidden="true">›</span></a>
        </div>
        <p class="hero-note">{copy.hero.note}</p>
      </div>
      <figure class="execution-scene" id="execution">
        <div class="scene-graph"><Fragment set:html={executionGraph(locale)} /></div>
        <figcaption>
          <span>{copy.map.disclaimer}</span>
          <a href={graphHref} target="_blank" rel="noopener">{zh ? "打开完整执行图" : "Open the full graph"} <span aria-hidden="true">↗</span></a>
        </figcaption>
      </figure>
    </section>

    <section class="capabilities" id="horizon" aria-labelledby="capabilities-title">
      <div class="section-intro">
        <p class="eyebrow">{copy.capabilities.eyebrow}</p>
        <h2 id="capabilities-title">{copy.capabilities.title}</h2>
        <p>{copy.capabilities.lead}</p>
      </div>
      <div class="chapter-wrap">
        {copy.capabilities.chapters.map((chapter, index) => (
          <article class:list={["chapter", `chapter-${chapter.id}`]}>
            <div class="chapter-copy">
              <p class="eyebrow">{chapter.kicker}</p>
              <h3>{chapter.title}</h3>
              <p class="chapter-body">{chapter.body}</p>
              <a href={publicPath(locale, chapter.href)}>{chapter.link} <span aria-hidden="true">›</span></a>
            </div>
            <div class="chapter-visual">
              {index === 0 && (
                <div class="artifact-stack" aria-label={copy.capabilities.artifactLabel}>
                  {copy.capabilities.handoff.map((label, n) => (
                    <div class="artifact-sheet">
                      <span class="sheet-index">0{n + 1}</span><strong>{label}</strong>
                      <span class="sheet-rule"></span><span class="sheet-rule"></span><span class="sheet-rule short"></span>
                      <span class="sheet-arrow" aria-hidden="true">↗</span>
                    </div>
                  ))}
                </div>
              )}
              {index === 1 && (
                <div class="context-thread">
                  <p class="visual-kicker">{copy.capabilities.contextLabel}</p>
                  <div class="thread-track">{copy.capabilities.continuity.map((label, n) => <div class="thread-node"><span>0{n + 1}</span><strong>{label}</strong></div>)}</div>
                  <div class="context-base">{zh ? "目标 · 决定 · 产物" : "Goal · Decisions · Artifacts"}</div>
                </div>
              )}
              {index === 2 && (
                <div class="review-cycle">
                  <svg viewBox="0 0 440 270" aria-hidden="true">
                    <defs><marker id="cycle-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="5" markerHeight="5" orient="auto"><path d="m1 1 6 3-6 3" fill="none" stroke="#8396c7" stroke-width="1.3"/></marker></defs>
                    <path d="M153 70 H285 Q350 70 350 135 Q350 210 280 210 H150 Q90 210 90 145 Q90 70 153 70" fill="none" stroke="#8396c7" stroke-width="2" marker-end="url(#cycle-arrow)"/>
                    <path d="M350 135 V137" stroke="#8396c7" marker-end="url(#cycle-arrow)"/>
                  </svg>
                  {copy.capabilities.review.map((label, n) => <span class={`review-node review-node-${n}`}>{label}</span>)}
                </div>
              )}
              <p class="visual-note">{copy.capabilities.visualNote}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="case-study" id="case" aria-labelledby="case-title">
      <div class="case-intro">
        <p class="eyebrow">{copy.case.eyebrow}</p>
        <h2 id="case-title">{copy.case.title}</h2>
        <p>{copy.case.lead}</p>
        <a href={caseHref}>{copy.case.link} <span aria-hidden="true">›</span></a>
      </div>
      <div class="case-product">
        <figure>
          <img src={`${base}/media/tank-battle-case.png`} alt={copy.case.screenshot} width="720" height="624" loading="lazy" decoding="async" />
          <figcaption>{copy.case.caption}</figcaption>
        </figure>
        <div class="case-evidence">
          <div class="case-stats">{copy.case.stats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}</div>
          {copy.case.revisions.map((revision) => <div class="revision"><p class="eyebrow">{revision.label}</p><h3>{revision.title}</h3><p>{revision.body}</p></div>)}
        </div>
      </div>
      <p class="case-note">{copy.case.caveat} <a href={caseHref}>{zh ? "查看证据与限制" : "Evidence & limits"} ↗</a></p>
    </section>

    <section class="start-section" id="start" aria-labelledby="start-title">
      <p class="eyebrow">{copy.start.eyebrow}</p>
      <h2 id="start-title">{copy.start.title}</h2>
      <p class="start-lead">{copy.start.lead}</p>
      <div class="start-actions">
        <a class="start-button" href={publicPath(locale, "/start/quickstart/")}>{copy.start.docs}</a>
        <a href={publicPath(locale, "/market/")}>{copy.start.market} <span aria-hidden="true">›</span></a>
      </div>
      <p class="boundaries">{copy.start.boundaries}</p>
      <div class="research-link" id="research"><a href={`${base}/papers/opencorvus-poc.pdf`}>{copy.start.paper} ↗</a></div>
    </section>
  </div>
</OcLayout>

<style>
  .product-story {
    --product-ink: var(--oc-color-text-primary);
    --product-muted: var(--oc-color-text-secondary);
    --product-link: #315be8;
    --product-panel: #f0f3f9;
    color: var(--product-ink);
    font-family: var(--oc-font-body);
  }
  :global(:root[data-theme="dark"]) .product-story { --product-link: #91adff; --product-panel: #151923; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .product-story { --product-link: #91adff; --product-panel: #151923; }
  }
  .product-story :where(h1,h2,h3,p,figure) { margin: 0; }
  .product-story :where(section,figure) { scroll-margin-top: 90px; }
  .product-story a { color: var(--product-link); text-decoration: none; }
  .product-story a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .product-story a:focus-visible { outline: 3px solid var(--product-link); outline-offset: 5px; }
  .product-hero { padding: 118px 0 110px; overflow: clip; }
  .hero-heading { max-width: 1000px; margin-inline: auto; padding-inline: 24px; text-align: center; position: relative; z-index: 2; }
  .product-name { font-size: 23px; font-weight: 600; margin-bottom: 22px; letter-spacing: -.025em; }
  h1 { font-size: clamp(60px, 7vw, 96px); font-weight: 700; letter-spacing: -.065em; line-height: 1.08; }
  h1 span { display: block; }
  h1 span:last-child { color: var(--product-link); }
  :global([lang="zh-CN"]) h1 { letter-spacing: -.055em; line-height: 1.2; }
  .hero-definition { font-size: 22px; line-height: 1.5; font-weight: 500; margin-top: 25px; color: var(--product-muted); }
  .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 27px; margin-top: 28px; font-size: 17px; }
  .hero-actions :global(.oc-download-primary), .hero-actions :global(.oc-download-toggle) { background: #315be8; color: #fff; font-size: 13px; }
  .hero-actions :global(.oc-download-primary:hover), .hero-actions :global(.oc-download-toggle:hover) { background: #244acb; }
  .hero-actions :global(.oc-download-panel) { text-align: left; }
  .hero-note { font-size: 12px; color: var(--oc-color-text-description); margin-top: 21px; }
  .execution-scene { width: min(calc(100% - 64px), 1360px); margin: 65px auto 0; }
  .scene-graph { border-radius: 24px; box-shadow: 0 35px 90px -45px #182f6852; border: 1px solid #dfe5f0; overflow: hidden; }
  .scene-graph :global(svg) { display: block; width: 100%; height: auto; }
  .execution-scene figcaption { display: flex; justify-content: space-between; gap: 25px; font-size: 11px; line-height: 1.7; color: var(--oc-color-text-description); padding: 22px 7px 0; }
  .execution-scene figcaption a { white-space: nowrap; }
  .capabilities { padding: 105px 0 0; background: var(--oc-color-bg-surface-3); }
  .section-intro { width: min(calc(100% - 96px), 1120px); margin: 0 auto 20px; }
  .eyebrow { font-size: 12px; font-weight: 600; letter-spacing: .04em; margin-bottom: 20px; color: var(--oc-color-text-description); line-height: 1.6; }
  h2 { white-space: pre-line; font-size: clamp(40px,5vw,64px); font-weight: 700; line-height: 1.15; letter-spacing: -.05em; }
  .section-intro > p:last-child { margin-top: 28px; font-size: 23px; line-height: 1.7; max-width: 690px; color: var(--product-muted); }
  .chapter-wrap { max-width: 1120px; width: calc(100% - 96px); margin-inline: auto; }
  .chapter { display: grid; grid-template-columns: 1fr 1.2fr; gap: 80px; align-items: center; padding-block: 95px; }
  .chapter + .chapter { border-top: 1px solid var(--oc-color-border-subtle); }
  .chapter-continuity { grid-template-columns: 1.2fr 1fr; }
  .chapter-continuity .chapter-copy { grid-column: 2; grid-row: 1; }
  .chapter-continuity .chapter-visual { grid-column: 1; grid-row: 1; }
  .chapter h3 { white-space: pre-line; font-size: 40px; line-height: 1.17; letter-spacing: -.04em; font-weight: 700; }
  .chapter-body { font-size: 17px; line-height: 1.8; color: var(--product-muted); margin: 24px 0 22px; max-width: 39ch; }
  .chapter-copy > a { font-size: 16px; }
  .chapter-visual { min-width: 0; display: flex; flex-direction: column; align-items: center; }
  .visual-note { color: var(--oc-color-text-description); font-size: 10px; text-align: center; margin-top: 20px; line-height: 1.6; }
  .artifact-stack { position: relative; height: 320px; width: 100%; }
  .artifact-sheet { position: absolute; display: flex; flex-direction: column; width: 208px; height: 236px; padding: 25px; background: #fff; border: 1px solid #e2e6ed; border-radius: 14px; box-shadow: 0 25px 50px -25px #2c40724d; color: #28334b; }
  .artifact-sheet:nth-child(1) { top: 0; left: 0; transform: rotate(-8deg); }
  .artifact-sheet:nth-child(2) { top: 38px; left: calc(50% - 104px); transform: rotate(-1deg); }
  .artifact-sheet:nth-child(3) { top: 77px; right: 0; transform: rotate(7deg); }
  .sheet-index { color: #8c9ab4; font-size: 11px; margin-bottom: 23px; }
  .artifact-sheet strong { font-size: 16px; margin-bottom: 25px; }
  .sheet-rule { background: #e9edf4; height: 5px; border-radius: 4px; margin-bottom: 10px; }
  .sheet-rule.short { width: 65%; }
  .sheet-arrow { align-self: flex-end; font-size: 24px; color: #4264d7; margin-top: 8px; }
  .context-thread { width: 100%; padding: 30px; border-radius: 24px; background: var(--product-panel); }
  .visual-kicker { font-size: 11px; letter-spacing: .08em; color: var(--product-muted); }
  .thread-track { margin: 28px 0; display: flex; flex-direction: column; gap: 18px; position: relative; }
  .thread-track::before { position: absolute; content: ""; width: 1px; background: #90a6d8; top: 15px; bottom: 15px; left: 16px; }
  .thread-node { display: flex; align-items: center; gap: 19px; position: relative; }
  .thread-node span { display: grid; place-items: center; width: 33px; height: 33px; border: 1px solid #c8d3eb; border-radius: 50%; font-size: 10px; background: #edf2ff; color: #3e5c9c; }
  .thread-node strong { font-size: 17px; font-weight: 500; }
  .context-base { font-size: 12px; color: var(--product-muted); border-top: 1px solid var(--oc-color-border-default); padding-top: 20px; }
  .review-cycle { width: 100%; max-width: 440px; height: 270px; position: relative; }
  .review-cycle > svg { width: 100%; height: 100%; }
  .review-node { position: absolute; background: #fff; color: #334264; padding: 18px 26px; border-radius: 14px; border: 1px solid #d4deef; box-shadow: 0 14px 35px -20px #26489570; white-space: nowrap; font-size: 17px; }
  .review-node-0 { left: 11%; top: 15%; }
  .review-node-1 { right: 3%; top: 39%; background: #365bed; border-color: #365bed; color: #fff; }
  .review-node-2 { left: 25%; bottom: 12%; }
  .case-study { padding: 110px 48px 72px; background: #090d16; color: #f4f6fc; }
  .case-intro { max-width: 880px; margin: 0 auto; text-align: center; }
  .case-intro .eyebrow { color: #97aacd; }
  .case-intro > p:not(.eyebrow) { font-size: 19px; line-height: 1.8; color: #aebbd2; max-width: 660px; margin: 28px auto 20px; }
  .case-study a { color: #9cb8ff; font-size: 16px; }
  .case-product { max-width: 1030px; display: grid; grid-template-columns: 1.05fr 1fr; align-items: center; gap: 80px; margin: 70px auto 55px; }
  .case-product figure { border-radius: 16px; overflow: hidden; background: #000; border: 1px solid #293344; }
  .case-product img { width: 100%; display: block; height: auto; image-rendering: pixelated; }
  .case-product figcaption { font-size: 11px; line-height: 1.6; text-align: center; color: #99a8c0; padding: 18px; }
  .case-stats { display: flex; gap: 34px; padding-bottom: 33px; border-bottom: 1px solid #ffffff19; margin-bottom: 35px; }
  .case-stats > div { display: flex; flex-direction: column; flex: 1; gap: 9px; }
  .case-stats strong { font-size: 52px; font-weight: 500; line-height: 1; letter-spacing: -.055em; }
  .case-stats span { font-size: 11px; color: #aebbd2; line-height: 1.6; }
  .revision + .revision { margin-top: 30px; }
  .revision .eyebrow { color: #c3a479; font-size: 10px; margin-bottom: 10px; }
  .revision h3 { font-size: 23px; letter-spacing: -.025em; line-height: 1.3; }
  .revision > p:last-child { font-size: 13px; color: #aebbd2; line-height: 1.85; margin-top: 10px; }
  .case-note { max-width: 820px; margin-inline: auto; font-size: 12px; color: #99a8c0; line-height: 1.8; text-align: center; }
  .case-note a { font-size: inherit; white-space: nowrap; }
  .start-section { max-width: 950px; width: calc(100% - 80px); margin-inline: auto; padding: 120px 0 55px; text-align: center; }
  .start-section h2 { font-size: 47px; }
  .start-lead { font-size: 19px; line-height: 1.7; color: var(--product-muted); margin: 25px auto 30px; max-width: 600px; }
  .start-actions { display: flex; align-items: center; justify-content: center; gap: 30px; font-size: 17px; }
  .start-button { background: #315be8; color: #fff !important; border-radius: 30px; padding: 13px 24px; }
  .start-button:hover { background: #244acb; text-decoration: none !important; }
  .boundaries { max-width: 700px; margin: 60px auto 25px; color: var(--oc-color-text-description); font-size: 12px; line-height: 1.8; }
  .research-link { font-size: 12px; }
  @media (max-width: 1000px) {
    .chapter { gap: 40px; }
    .chapter h3 { font-size: 34px; }
    .artifact-sheet { width: 175px; padding: 21px; }
    .artifact-sheet:nth-child(2) { left: calc(50% - 87px); }
    .case-product { gap: 40px; }
  }
  @media (max-width: 760px) {
    .product-hero { padding-top: 110px; padding-bottom: 70px; }
    h1 { font-size: 57px; }
    .hero-definition { font-size: 18px; }
    .execution-scene { width: calc(100% - 24px); margin-top: 45px; }
    .scene-graph { overflow-x: auto; }
    .scene-graph :global(svg) { width: 1020px; max-width: none; }
    .execution-scene figcaption { flex-direction: column; gap: 10px; padding-inline: 12px; }
    .section-intro,.chapter-wrap { width: calc(100% - 48px); }
    .capabilities { padding-top: 70px; }
    .section-intro > p:last-child { font-size: 19px; }
    .chapter,.chapter-continuity { grid-template-columns: 1fr; gap: 45px; padding-block: 65px; }
    .chapter-continuity .chapter-copy,.chapter-continuity .chapter-visual { grid-column: auto; grid-row: auto; }
    .chapter-visual { max-width: 480px; width: 100%; margin-inline: auto; }
    .artifact-sheet { width: 190px; }
    .case-study { padding: 75px 24px 60px; }
    .case-product { grid-template-columns: 1fr; max-width: 480px; }
    .start-section { width: calc(100% - 48px); padding-top: 75px; }
    .start-section h2 { font-size: 36px; }
  }
</style>
