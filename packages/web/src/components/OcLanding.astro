---
import OcLayout from "./OcLayout.astro"
import OcHeroBackdrop from "./OcHeroBackdrop.astro"
import OcDemoVideo from "./OcDemoVideo.astro"
import { executionGraph } from "../lib/execution-graph"
import { executionCopy } from "../content/execution-copy"
import { landingCopy } from "../content/landing-copy"
import { publicPath, type PublicLocale } from "../content/public-market"
import config from "../../config.mjs"
import { readDownloadManifest, formatBytes } from "../lib/landing-downloads"

type Props = {
  locale: PublicLocale
}

const { locale } = Astro.props
const zh = locale === "zh-cn"
const copy = landingCopy[locale]
const languageHref = zh ? publicPath("root") : publicPath("zh-cn")

/** Copy holds bare hrefs; anything site-local has to be run through the locale-aware base. */
const resolve = (href: string) => (href.startsWith("/") ? publicPath(locale, href) : href)

const downloads = readDownloadManifest()


---

<OcLayout
  {locale}
  current="home"
  title={copy.meta.title}
  description={copy.meta.description}
  {languageHref}
>
  {/* ------------------------------------------------------------ 1 · hero */}
  <section class="oc-hero" id="download">
    <OcHeroBackdrop />

    <div class="oc-container oc-hero-inner">
      <div class="oc-hero-copy">
        <p class="oc-eyebrow oc-enter" style="--oc-enter-y: 12px">{copy.hero.eyebrow}</p>
        <h1 class="oc-text-hero oc-cjk-spacing oc-hero-title">
          {
            copy.hero.titleLines.map((line, index) => (
              <span class="oc-enter" style={`--oc-enter-y: 22px; --oc-enter-blur: 6px; animation-delay: ${80 + index * 90}ms`}>
                {line}
              </span>
            ))
          }
        </h1>
        <p class="oc-text-body oc-text-secondary oc-hero-lede oc-enter" style="--oc-enter-y: 18px; animation-delay: 280ms">
          {copy.hero.description}
        </p>
        <div class="oc-btn-group oc-enter" style="--oc-enter-y: 16px; animation-delay: 360ms">
          {/*
            The download is the first thing on the page and the menu is rendered server-side, so
            every installer is a real link before any script runs. Detection only swaps the default
            target; with JavaScript off the reader still gets the full list rather than a button
            that does nothing.
          */}
          <div
            class="oc-download"
            data-oc-download
            data-download-verb={copy.hero.download.verb}
            data-download-version={downloads?.version ?? ""}
          >
            <a
              class="oc-btn oc-btn-primary oc-btn-m oc-download-primary"
              href={downloads?.releaseUrl ?? config.github}
              data-oc-download-primary
            >
              <span data-oc-download-label>
                {copy.hero.download.label}{downloads?.version && ` · ${downloads.version}`}
              </span>
            </a>

            {
              downloads && (
                <details class="oc-download-menu" data-oc-download-menu>
                  <summary
                    class="oc-btn oc-btn-primary oc-btn-m oc-download-toggle"
                    aria-label={copy.hero.download.menuLabel}
                    title={copy.hero.download.menuLabel}
                  >
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                      stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6"></path>
                    </svg>
                  </summary>

                  <div class="oc-glass-dropdown oc-download-panel">
                    <p class="oc-eyebrow oc-download-panel-title">{copy.hero.download.allPlatforms}</p>
                    {
                      downloads.groups.map((group) => (
                        <section class="oc-download-group">
                          <p class="oc-download-group-name">{group.label}</p>
                          <ul>
                            {group.assets.map((asset) => (
                              <li>
                                <a
                                  href={asset.url}
                                  download={asset.fileName}
                                  title={asset.fileName}
                                  data-oc-download-asset
                                  data-oc-download-platform={asset.platform}
                                  data-oc-download-architecture={asset.architecture}
                                  data-oc-download-format={asset.format}
                                  data-oc-download-file={asset.fileName}
                                  data-oc-download-version={downloads.version}
                                >
                                  <span class="oc-download-asset-meta">
                                    <span>{asset.architecture} · {asset.format} · {downloads.version}</span>
                                    <span class="oc-download-file">{asset.fileName}</span>
                                  </span>
                                  <span class="oc-download-size">{formatBytes(asset.bytes)}</span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </section>
                      ))
                    }
                    <p class="oc-text-xs oc-text-description oc-download-note">
                      {copy.hero.download.releaseNote}
                      {downloads.version && ` · ${downloads.version}`}
                    </p>
                  </div>
                </details>
              )
            }
          </div>

          {
            copy.hero.ctas.map((cta) => (
              <a class={`oc-btn oc-btn-${cta.variant} oc-btn-m`} href={resolve(cta.href)}>
                {cta.label}
              </a>
            ))
          }
        </div>
      </div>

      <div class="oc-hero-terminal oc-enter" style="--oc-enter-y: 24px; animation-delay: 440ms">
        <div class="oc-terminal" data-oc-terminal>
          <div class="oc-terminal-tabs" role="tablist" aria-label={copy.hero.terminalLabel}>
            {
              copy.hero.terminals.map((terminal, index) => (
                <button
                  type="button"
                  role="tab"
                  class="oc-terminal-tab"
                  data-oc-terminal-tab={terminal.id}
                  data-active={index === 0 ? "true" : undefined}
                  aria-selected={index === 0 ? "true" : "false"}
                >
                  {terminal.label}
                </button>
              ))
            }
          </div>

          <div class="oc-terminal-body">
            {
              copy.hero.terminals.map((terminal, index) => (
                <div
                  class="oc-terminal-pane"
                  data-oc-terminal-pane={terminal.id}
                  data-active={index === 0 ? "true" : undefined}
                  role="tabpanel"
                >
                  {/*
                    Two stacked <pre> blocks. The hidden one carries the full text so the box is
                    already its final height before typing starts; without it every character
                    reflows the section below and the whole page twitches.
                  */}
                  <pre class="oc-terminal-text" data-oc-terminal-out aria-hidden="true"></pre>
                  <pre class="oc-terminal-text oc-terminal-ghost" data-oc-terminal-source>{terminal.lines.join("\n")}</pre>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ----------------------------------------------------------- 2 · demo */}
  {/*
    Directly under the hero because "what is it actually like to use" is the question the hero
    raises, and because a recording of one real run is the strongest evidence on the page — it
    belongs where a reader is still deciding whether to keep scrolling.
  */}
  <OcDemoVideo {locale} />

  {/* -------------------------------------------------- 4 · long-horizon */}
  {/*
    Named failures before named mechanisms. Borrowed from LongHorizon-Harness, which opens on
    compounding errors, context rot, task-state loss and unverified premises rather than on its
    loop: a reader who has not yet felt the failure has no question that "durable execution"
    answers. Each card therefore states the break first and the mechanism second.
  */}
  <section class="oc-section oc-anchor" id="horizon">
    <div class="oc-container">
      <p class="oc-eyebrow oc-reveal">{copy.horizon.eyebrow}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing oc-section-title oc-reveal">{copy.horizon.title}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead oc-reveal">{copy.horizon.lead}</p>

      <ul class="oc-pillar-grid">
        {
          copy.horizon.breaks.map((entry, index) => (
            <li class="oc-card-raised oc-pillar oc-reveal" style={`transition-delay: ${index * 70}ms`}>
              <h3 class="oc-text-subtitle oc-cjk-spacing">{entry.title}</h3>
              <p class="oc-text-body oc-text-description">{entry.body}</p>
              <p class="oc-pillar-evidence">
                <span class="oc-text-xs oc-text-description">{entry.evidenceLabel}</span>
                <span class="oc-break-evidence-value">{entry.evidenceValue}</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ---------------------------------------------------- 5 · composition */}
  <section class="oc-section-tight oc-anchor" id="execution">
    <div class="oc-container">
      <p class="oc-eyebrow">{zh ? "一次真实任务 · 坦克大战" : "A real task · Tank battle"}</p>
      <h2 class="oc-text-subtitle oc-cjk-spacing">{zh ? "调研、实现、复核，如何衔接。" : "How research, implementation and review connect."}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead">
        {zh ? "19 项验收要求，两轮修正：跨关计分与结算修复，以及 35 关来源数据替换。下图展开这次任务涉及的角色与工作衔接。" : "19 acceptance requirements and two correction rounds: cross-stage scoring and results, then source data for 35 stages. The graph connects the roles involved in this task."}
      </p>
      <div class="oc-execution-graph"><Fragment set:html={executionGraph(locale)} /></div>
      <p class="oc-text-xs oc-text-description">{executionCopy[locale].disclaimer}</p>
      <p class="oc-text-caption oc-text-description">
        {zh ? "含人工决策；测试报告差异及还原程度限制见案例记录。" : "Includes an operator decision; test-report differences and fidelity limits are documented in the case."}
        {" "}<a class="oc-link" href={publicPath(locale, "/cases/tank-battle/")}>{zh ? "查看案例与证据" : "Case and evidence"} ↗</a>
        {" · "}<a class="oc-link" href={`/media/task-coordination-${zh ? "zh" : "en"}.svg`} target="_blank" rel="noopener">{zh ? "打开完整执行图" : "Open full graph"} ↗</a>
      </p>
    </div>
  </section>

  <section class="oc-section oc-anchor" id="start">
    <div class="oc-container">
      <p class="oc-eyebrow">{zh ? "开始" : "Get started"}</p>
      <h2 class="oc-text-h1 oc-cjk-spacing">{zh ? "从一项真实任务开始" : "Start with one real task"}</h2>
      <p class="oc-text-body oc-text-description oc-section-lead">{zh ? "配置模型，选择项目与专家团，写清目标和验收要求。" : "Configure a model, choose a project and squad, and define the goal and acceptance criteria."}</p>
      <div class="oc-btn-group oc-reading-links">
        <a class="oc-btn oc-btn-primary oc-btn-m" href={publicPath(locale, "/start/quickstart/")}>{zh ? "快速开始" : "Quickstart"}</a>
        <a class="oc-btn oc-btn-secondary oc-btn-m" href={publicPath(locale, "/market/")}>{zh ? "选择专家团" : "Explore squads"}</a>
      </div>
      <p class="oc-text-xs oc-text-description oc-reading-links">{zh ? "运行需要在线服务及可访问的模型；重要权限与发布决定由你掌握。" : "Work requires an online runtime and reachable model. Important permissions and publishing decisions remain yours."}</p>
    </div>
  </section>
  <section class="oc-section-tight" id="reading">
    <div class="oc-container">
      <p class="oc-eyebrow">{zh ? "深入阅读" : "Further reading"}</p>
      <h2 class="oc-text-subtitle">{zh ? "案例与机制，放在博客里慢慢展开。" : "Explore the cases and mechanisms in the blog."}</h2>
      <div class="oc-btn-group oc-reading-links">
        <a class="oc-link" href={publicPath(locale, "/blog/squad-composition/")}>{zh ? "多专家团协作" : "Squad coordination"} ↗</a>
        <a class="oc-link" href={publicPath(locale, "/blog/automationbench/")}>AutomationBench ↗</a>
        <a class="oc-link" href={publicPath(locale, "/blog/")}>{zh ? "全部文章" : "All articles"} ↗</a>
      </div>
    </div>
  </section>
</OcLayout>

<style>
  .oc-execution-graph { margin-block: var(--oc-space-6); overflow-x: auto; }
  .oc-execution-graph :global(svg) { display: block; width: 100%; min-width: 840px; height: auto; }
  /* -------------------------------------------------------------- hero */

  .oc-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-top: var(--oc-space-11);
    padding-bottom: var(--oc-space-9);
    /* Deliberately not `overflow: hidden`. It used to be, for the backdrop — but the backdrop
       clips itself, and the hero's copy cut 304px off the bottom of the download menu, hiding the
       Linux builds entirely. A section that contains a popover cannot also clip. */
  }

  @media (min-width: 768px) {
    .oc-hero {
      min-height: unset;
      height: 100vh;
      max-height: 1000px;
      padding-top: var(--oc-space-9);
    }
  }

  .oc-hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--oc-space-8);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .oc-hero-inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: var(--oc-space-9);
    }
  }

  .oc-hero-copy {
    display: flex;
    flex-direction: column;
    gap: var(--oc-space-5);
  }

  .oc-hero-title {
    display: flex;
    flex-direction: column;
  }

  .oc-hero-lede {
    max-width: 44ch;
  }

  /* ------------------------------------------------------- download */

  /* A split control: the link carries the detected build, the disclosure carries every build. They
     read as one pill, so the seam between them is a hairline rather than a gap. */
  .oc-download {
    position: relative;
    display: inline-flex;
    align-items: stretch;
  }

  .oc-download-primary {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    padding-right: var(--oc-space-4);
  }

  /* Flush against the primary, with the divider drawn inside the pill. The previous 1px margin let
     the page background through and read as a crack across the button rather than a seam between
     two halves of one control. */
  .oc-download-toggle {
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    padding-inline: var(--oc-space-3);
    border-left: 1px solid var(--oc-btn-primary-divider);
    list-style: none;
  }

  .oc-download-toggle::-webkit-details-marker {
    display: none;
  }

  .oc-download-toggle svg {
    transition: transform 0.2s ease;
  }

  /* The <details> is the flex item that stretches, but the <summary> inside it does not inherit
     that height — which left the caret half 5px shorter than the button it is joined to. Making
     the disclosure a flex container passes the stretch through to its summary. */
  .oc-download-menu {
    display: flex;
    align-items: stretch;
  }

  .oc-download-menu[open] .oc-download-toggle svg {
    transform: rotate(180deg);
  }

  .oc-download-panel {
    position: absolute;
    z-index: 20;
    top: calc(100% + var(--oc-space-2));
    left: 0;
    width: max(100%, 390px);
    /* Bounded twice: never taller than the viewport allows, and never so tall that it dominates
       the hero on a big screen. Anything beyond that scrolls inside the panel. */
    max-height: min(60vh, 420px);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--oc-space-4);
  }

  .oc-download-panel-title {
    margin-bottom: var(--oc-space-3);
  }

  .oc-download-group + .oc-download-group {
    margin-top: var(--oc-space-4);
  }

  .oc-download-group-name {
    margin: 0 0 var(--oc-space-2);
    font-size: 13px;
    font-weight: 500;
    color: var(--oc-color-text-primary);
  }

  .oc-download-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .oc-download-group a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--oc-space-3);
    padding: var(--oc-space-2) var(--oc-space-3);
    border-radius: var(--oc-radius-sm);
    font-size: 14px;
    color: var(--oc-color-text-secondary);
    text-decoration: none;
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .oc-download-group a:hover {
    color: var(--oc-color-text-primary);
    background: var(--oc-color-bg-hover);
  }

  /* The detected build is marked in the list too, so opening the menu confirms rather than
     contradicts what the button already says. */
  .oc-download-group a[data-detected="true"] {
    color: var(--oc-color-text-primary);
    background: var(--oc-color-bg-surface-5);
  }

  .oc-download-asset-meta {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .oc-download-file {
    overflow-wrap: anywhere;
    font-family: var(--oc-font-mono);
    font-size: 10px;
    line-height: 1.35;
    color: var(--oc-color-text-description);
  }

  .oc-download-size {
    font-family: var(--oc-font-mono);
    font-size: 12px;
    color: var(--oc-color-text-description);
    white-space: nowrap;
  }

  .oc-download-note {
    margin-top: var(--oc-space-4);
    padding-top: var(--oc-space-3);
    border-top: 1px solid var(--oc-color-border-subtle);
  }

  @media (max-width: 448px) {
    /* The CTA group goes full-width single-column here; the split control has to follow or the
       disclosure ends up on its own row. */
    .oc-download {
      width: 100%;
    }

    .oc-download-primary {
      flex: 1;
    }

    .oc-download-panel {
      width: 100%;
    }
  }

  /* ---------------------------------------------------------- terminal */

  .oc-terminal {
    border-radius: var(--oc-radius-card);
    border: 1px solid var(--oc-color-border-default);
    background: var(--oc-color-bg-surface-1);
    -webkit-backdrop-filter: blur(var(--oc-blur-glass));
    backdrop-filter: blur(var(--oc-blur-glass));
    box-shadow: var(--oc-shadow-card);
    overflow: hidden;
  }

  .oc-terminal-tabs {
    display: flex;
    gap: var(--oc-space-1);
    padding: var(--oc-space-2) var(--oc-space-3) 0;
  }

  .oc-terminal-tab {
    padding: var(--oc-space-2) var(--oc-space-4);
    border: 1px solid var(--oc-color-border-subtle);
    border-bottom: 0;
    border-radius: var(--oc-radius-sm) var(--oc-radius-sm) 0 0;
    background: transparent;
    font-family: var(--oc-font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--oc-color-text-description);
    cursor: pointer;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .oc-terminal-tab[data-active="true"] {
    background: var(--oc-color-bg-surface-raised);
    color: var(--oc-color-text-primary);
  }

  .oc-terminal-body {
    padding: var(--oc-space-4);
    border-top: 1px solid var(--oc-color-border-subtle);
  }

  .oc-terminal-pane {
    display: none;
    /* Both <pre> blocks occupy the same cell; the ghost sets the height, the live one paints. */
    grid-template-columns: minmax(0, 1fr);
  }

  .oc-terminal-pane[data-active="true"] {
    display: grid;
  }

  .oc-terminal-text {
    grid-area: 1 / 1;
    margin: 0;
    font-family: var(--oc-font-mono);
    font-size: 13.5px;
    line-height: 1.75;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--oc-color-text-primary);
  }

  .oc-terminal-ghost {
    visibility: hidden;
    pointer-events: none;
  }

  /* ------------------------------------------------------------ shared */

  .oc-section-title {
    margin-top: var(--oc-space-3);
    max-width: 22ch;
  }

  .oc-section-lead {
    margin-top: var(--oc-space-4);
    max-width: 52ch;
  }

  /* -------------------------------------------------------------- why */

  .oc-pillar-grid {
    list-style: none;
    margin: var(--oc-space-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--oc-space-4);
  }

  .oc-pillar {
    display: flex;
    flex-direction: column;
    gap: var(--oc-space-3);
  }

  .oc-pillar-evidence {
    margin: auto 0 0;
    padding-top: var(--oc-space-4);
    border-top: 1px solid var(--oc-color-border-subtle);
    display: flex;
    align-items: baseline;
    gap: var(--oc-space-2);
  }

  .oc-break-evidence-value {
    font-family: var(--oc-font-display);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--oc-color-text-primary);
  }

  .oc-reading-links { margin-top: var(--oc-space-5); }
</style>

<script>
  /* ------------------------------------------------- scroll reveal (shared) */

  // One observer for every revealed element. Building one per element is the usual way this ends up
  // costing more than the animation it drives.
  const revealTargets = document.querySelectorAll<HTMLElement>(".oc-reveal")
  if (revealTargets.length) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      revealTargets.forEach((element) => (element.dataset.revealed = "true"))
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue
            ;(entry.target as HTMLElement).dataset.revealed = "true"
            observer.unobserve(entry.target)
          }
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.05 },
      )
      revealTargets.forEach((element) => observer.observe(element))
    }
  }

  /* ------------------------------------------------------------- tab groups */

  /** Both tab strips behave identically, so they share one activator. */
  function wireTabs(root: Element, tabAttribute: string, paneAttribute: string) {
    const tabs = [...root.querySelectorAll<HTMLElement>(`[${tabAttribute}]`)]
    const panes = [...root.querySelectorAll<HTMLElement>(`[${paneAttribute}]`)]

    const activate = (id: string) => {
      for (const tab of tabs) {
        const active = tab.getAttribute(tabAttribute) === id
        tab.dataset.active = active ? "true" : ""
        tab.setAttribute("aria-selected", active ? "true" : "false")
        if (!active) delete tab.dataset.active
      }
      for (const pane of panes) {
        const active = pane.getAttribute(paneAttribute) === id
        if (active) pane.dataset.active = "true"
        else delete pane.dataset.active
      }
      return panes.find((pane) => pane.getAttribute(paneAttribute) === id)
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        const pane = activate(tab.getAttribute(tabAttribute) ?? "")
        root.dispatchEvent(new CustomEvent("oc:tab", { detail: { pane } }))
      })
      // Roving arrow keys, which is what the tablist role promises a keyboard user.
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0
        if (!step) return
        event.preventDefault()
        const next = tabs[(index + step + tabs.length) % tabs.length]
        next.focus()
        next.click()
      })
    })

    return { activate }
  }

  /* -------------------------------------------------------------- terminal */

  const terminal = document.querySelector("[data-oc-terminal]")
  if (terminal) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    let timer = 0
    // Each recording plays itself out and hands over to the next one. Reading the runs is the
    // point; making someone click a tab to discover there are more is not.
    const HOLD_AFTER_RUN_MS = 2600
    const tabs = [...terminal.querySelectorAll<HTMLElement>("[data-oc-terminal-tab]")]
    let advance = 0
    let handOver = true

    const stopAdvance = () => {
      window.clearTimeout(advance)
      advance = 0
    }

    function queueNext(pane: HTMLElement) {
      stopAdvance()
      if (!handOver || reduced || document.hidden || tabs.length < 2) return
      const id = pane.getAttribute("data-oc-terminal-pane")
      const position = tabs.findIndex((tab) => tab.getAttribute("data-oc-terminal-tab") === id)
      if (position === -1) return
      advance = window.setTimeout(() => tabs[(position + 1) % tabs.length]!.click(), HOLD_AFTER_RUN_MS)
    }

    function type(pane: HTMLElement) {
      const source = pane.querySelector<HTMLElement>("[data-oc-terminal-source]")
      const out = pane.querySelector<HTMLElement>("[data-oc-terminal-out]")
      if (!source || !out) return
      const text = source.textContent ?? ""
      window.clearInterval(timer)
      stopAdvance()

      if (reduced) {
        out.textContent = text
        return
      }

      let index = 0
      out.textContent = ""
      timer = window.setInterval(() => {
        index += 1
        out.textContent = text.slice(0, index)
        if (index >= text.length) {
          window.clearInterval(timer)
          queueNext(pane)
        }
      }, 26)
    }

    wireTabs(terminal, "data-oc-terminal-tab", "data-oc-terminal-pane")
    terminal.addEventListener("oc:tab", (event) => {
      const pane = (event as CustomEvent<{ pane?: HTMLElement }>).detail.pane
      if (pane) type(pane)
    })

    // A reader who takes the wheel keeps it: once a tab is picked by hand, or the pointer is
    // resting on the recording, nothing moves on its own again.
    tabs.forEach((tab) => tab.addEventListener("pointerdown", () => { handOver = false; stopAdvance() }))
    terminal.addEventListener("pointerenter", stopAdvance)
    terminal.addEventListener("focusin", stopAdvance)
    document.addEventListener("visibilitychange", () => { if (document.hidden) stopAdvance() })

    // Hold the typing until the hero is actually on screen, so a deep link into #start does not
    // burn a timer nobody is watching.
    const first = terminal.querySelector<HTMLElement>('[data-oc-terminal-pane][data-active="true"]')
    if (first) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          type(first)
          observer.disconnect()
        }
      })
      observer.observe(terminal)
    }
  }

  /* --------------------------------------------------- platform detect */

  /*
   * Detection only picks a default. Every installer is already a version-bound link in the
   * server-rendered menu, so an ambiguous platform opens that menu instead of presenting the
   * Release page as though it were a direct download. When the browser withholds architecture,
   * the rendered manifest may still prove a safe choice if that platform publishes only one.
   */
  const downloadRoot = document.querySelector<HTMLElement>("[data-oc-download]")
  if (downloadRoot) {
    const primary = downloadRoot.querySelector<HTMLAnchorElement>("[data-oc-download-primary]")
    const label = downloadRoot.querySelector<HTMLElement>("[data-oc-download-label]")
    const menu = downloadRoot.querySelector<HTMLDetailsElement>("[data-oc-download-menu]")

    const PLATFORM_LABEL: Record<string, string> = { windows: "Windows", macos: "macOS", linux: "Linux" }

    type DetectedDownloadTarget = { platform: string; architecture?: string }

    const namedPlatform = (value: string | undefined) => {
      const text = (value ?? "").toLowerCase()
      if (text.includes("win")) return "windows"
      if (text.includes("mac")) return "macos"
      if (text.includes("linux") || text.includes("x11") || text.includes("cros")) return "linux"
      return null
    }

    async function detect(): Promise<DetectedDownloadTarget | null> {
      const uaData = (
        navigator as Navigator & {
          userAgentData?: {
            platform?: string
            getHighEntropyValues?: (hints: string[]) => Promise<{ platform?: string; architecture?: string; bitness?: string }>
          }
        }
      ).userAgentData
      const coarsePlatform =
        namedPlatform(uaData?.platform) ?? namedPlatform(navigator.platform) ?? namedPlatform(navigator.userAgent)
      if (!uaData?.getHighEntropyValues) return coarsePlatform ? { platform: coarsePlatform } : null

      try {
        const hints = await uaData.getHighEntropyValues(["platform", "architecture", "bitness"])
        const platform = namedPlatform(hints.platform ?? uaData.platform) ?? coarsePlatform
        if (!platform) return null
        if (hints.architecture === "arm") return { platform, architecture: "arm64" }
        if (hints.architecture === "x86" && hints.bitness === "64") return { platform, architecture: "x64" }
        return { platform }
      } catch {
        return coarsePlatform ? { platform: coarsePlatform } : null
      }
    }

    if (primary && menu) {
      primary.addEventListener("click", (event) => {
        if (primary.dataset.ocDownloadReady === "true") return
        event.preventDefault()
        menu.open = true
        menu.querySelector("summary")?.focus()
      })
    }

    void (async () => {
      const target = await detect()
      if (!target || !primary || !label) return

      const platformAssets = Array.from(
        downloadRoot.querySelectorAll<HTMLAnchorElement>(
          `[data-oc-download-asset][data-oc-download-platform="${target.platform}"]`,
        ),
      )
      const architectures = new Set(platformAssets.map((asset) => asset.dataset.ocDownloadArchitecture))
      const architecture = target.architecture ?? (architectures.size === 1 ? [...architectures][0] : undefined)
      if (!architecture) return

      // The manifest orders the normal installer before alternatives, so the first match is the
      // platform's preferred current asset (EXE before MSI on Windows).
      const match = platformAssets.find((asset) => asset.dataset.ocDownloadArchitecture === architecture)
      if (!match) return

      const verb = downloadRoot.dataset.downloadVerb ?? ""
      const version = match.dataset.ocDownloadVersion ?? downloadRoot.dataset.downloadVersion ?? ""
      const format = match.dataset.ocDownloadFormat ?? ""
      const fileName = match.dataset.ocDownloadFile ?? ""
      primary.href = match.href
      primary.download = fileName
      primary.title = fileName
      primary.dataset.ocDownloadReady = "true"
      label.textContent = `${verb} ${PLATFORM_LABEL[target.platform] ?? target.platform} · ${architecture} · ${format} · ${version}`.trim()
      match.dataset.detected = "true"
    })()

    // A disclosure stays open until it is clicked again, which is wrong for a menu.
    if (menu) {
      const panel = menu.querySelector<HTMLElement>(".oc-download-panel")
      const placeMenu = () => {
        if (!menu.open || !panel) return
        const bounds = downloadRoot.getBoundingClientRect()
        const above = Math.max(0, bounds.top - 80)
        const below = Math.max(0, window.innerHeight - bounds.bottom - 16)
        const upward = above >= below
        panel.style.maxHeight = `${Math.min(420, upward ? above : below)}px`
        panel.style.top = upward ? "auto" : "calc(100% + 8px)"
        panel.style.bottom = upward ? "calc(100% + 8px)" : "auto"
      }
      menu.addEventListener("toggle", placeMenu)
      window.addEventListener("resize", placeMenu)
      window.addEventListener("scroll", placeMenu, { passive: true })
      document.addEventListener("click", (event) => {
        if (menu.open && event.target instanceof Node && !downloadRoot.contains(event.target)) menu.open = false
      })
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu.open) {
          menu.open = false
          menu.querySelector("summary")?.focus()
        }
      })
    }
  }
</script>
