---
const locale = Astro.props.locale === "zh" ? "zh" : "en"
const standalone = Astro.props.standalone === true
const rootClass = standalone ? "oc-arch-explorer oc-arch-explorer--standalone" : "oc-arch-explorer"
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const localeBase = locale === "zh" ? `${publicBase}/zh-cn` : publicBase
const standaloneHref = `${localeBase}/architecture-explorer/`
const docsHref = `${localeBase}/concepts/enterprise-architecture/`
---

<section class={rootClass} data-oc-architecture-explorer data-locale={locale}>
  <header class="oc-arch-header">
    <div class="oc-arch-title-block">
      <p class="oc-arch-kicker">{locale === "zh" ? "OpenCorvus current runtime map" : "OpenCorvus current runtime map"}</p>
      <h1>{locale === "zh" ? "企业级架构工作台" : "Enterprise Architecture Workbench"}</h1>
      <p>
        {
          locale === "zh"
            ? "用源码路径、artifact kind、agent 责任边界和 overlay 投影链路描述当前系统，而不是历史流程图。"
            : "A source-traceable map of the current runtime: artifact kinds, agent ownership, execution boundaries, and overlay projection."
        }
      </p>
    </div>
    <div class="oc-arch-header-actions">
      {
        standalone ? (
          <a href={docsHref}>{locale === "zh" ? "返回文档入口" : "Back to docs entry"}</a>
        ) : (
          <a href={standaloneHref}>{locale === "zh" ? "打开全屏工作台" : "Open full-screen workbench"}</a>
        )
      }
    </div>
  </header>

  <div class="oc-arch-control-strip">
    <label class="oc-arch-search">
      <span>{locale === "zh" ? "检索组件 / 源码 / artifact" : "Search component / source / artifact"}</span>
      <input data-arch-search type="search" autocomplete="off" />
    </label>
    <div class="oc-arch-view-tabs" data-arch-view-tabs aria-label={locale === "zh" ? "架构视图" : "Architecture views"}></div>
  </div>

  <div class="oc-arch-stats" data-arch-stats></div>

  <div class="oc-arch-shell">
    <aside class="oc-arch-domain-rail">
      <div class="oc-arch-panel-head">
        <span>{locale === "zh" ? "领域目录" : "Domain index"}</span>
        <strong data-arch-domain-count></strong>
      </div>
      <nav data-arch-domain-list aria-label={locale === "zh" ? "架构领域" : "Architecture domains"}></nav>
    </aside>

    <main class="oc-arch-main">
      <section class="oc-arch-flow" aria-label={locale === "zh" ? "当前运行链路" : "Current runtime chain"}>
        <div class="oc-arch-section-title">
          <span data-arch-view-title></span>
          <p data-arch-view-summary></p>
        </div>
        <div class="oc-arch-flow-steps" data-arch-flow></div>
      </section>

      <section class="oc-arch-blueprint" aria-label={locale === "zh" ? "架构领域蓝图" : "Architecture domain blueprint"}>
        <div class="oc-arch-section-title">
          <span>{locale === "zh" ? "领域蓝图" : "Domain blueprint"}</span>
          <p>
            {
              locale === "zh"
                ? "每个领域都绑定当前源码、单一数据责任和与相邻领域的显式契约。"
                : "Each domain binds current source, one data responsibility, and explicit contracts to adjacent domains."
            }
          </p>
        </div>
        <div class="oc-arch-domain-grid" data-arch-domain-grid></div>
      </section>

      <section class="oc-arch-contracts" aria-label={locale === "zh" ? "契约矩阵" : "Contract matrix"}>
        <div class="oc-arch-section-title">
          <span>{locale === "zh" ? "当前视图契约" : "Active view contracts"}</span>
          <p>
            {
              locale === "zh"
                ? "视图切换会更换这里的契约集合，用于区分 runtime、data、A2A、overlay 和治理面。"
                : "Changing views replaces this contract set across runtime, data, A2A, overlay, and governance surfaces."
            }
          </p>
        </div>
        <div class="oc-arch-contract-list" data-arch-contracts></div>
      </section>
    </main>

    <aside class="oc-arch-inspector" data-arch-inspector aria-live="polite"></aside>
  </div>

  <section class="oc-arch-evidence" aria-label={locale === "zh" ? "当前证据索引" : "Current evidence index"}>
    <div class="oc-arch-section-title">
      <span>{locale === "zh" ? "证据索引" : "Evidence index"}</span>
      <p>{locale === "zh" ? "选中领域后，这里只展示该领域的源码锚点和持久记录。" : "After selecting a domain, this shows only that domain's source anchors and durable records."}</p>
    </div>
    <div class="oc-arch-evidence-grid" data-arch-evidence></div>
  </section>
</section>

<style is:global>
  .oc-arch-explorer {
    --oc-bg: #f6f3ec;
    --oc-panel: #fffdf8;
    --oc-panel-strong: #ffffff;
    --oc-ink: #1c1d1f;
    --oc-muted: #5d6066;
    --oc-faint: #8a8d94;
    --oc-line: #d9d3c4;
    --oc-line-strong: #b9b09e;
    --oc-control: #263238;
    --oc-engine: #2f6f73;
    --oc-agent: #9b6b1d;
    --oc-exec: #596bb3;
    --oc-evidence: #a94f68;
    --oc-overlay: #5d7f38;
    --oc-extension: #7a5a96;
    --oc-shadow: 0 18px 45px rgba(31, 34, 38, 0.12);
    box-sizing: border-box;
    color: var(--oc-ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
    margin: 2rem 0 2.5rem;
    width: 100%;
  }

  .oc-arch-explorer *,
  .oc-arch-explorer *::before,
  .oc-arch-explorer *::after {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  .oc-arch-explorer--standalone {
    min-height: 100vh;
    margin: 0;
    padding: 1.25rem;
    background:
      linear-gradient(90deg, rgba(38, 50, 56, 0.05) 1px, transparent 1px),
      linear-gradient(0deg, rgba(38, 50, 56, 0.04) 1px, transparent 1px), var(--oc-bg);
    background-size: 44px 44px;
  }

  .oc-arch-explorer:not(.oc-arch-explorer--standalone) {
    max-width: 1180px;
  }

  .oc-arch-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    margin-bottom: 1rem;
  }

  .oc-arch-title-block {
    display: grid;
    gap: 0.45rem;
    max-width: 940px;
  }

  .oc-arch-kicker,
  .oc-arch-title-block p,
  .oc-arch-section-title p,
  .oc-arch-search span,
  .oc-arch-domain-sub,
  .oc-arch-flow-card small,
  .oc-arch-contract-row p,
  .oc-arch-inspector p,
  .oc-arch-evidence-item span {
    margin: 0;
    color: var(--oc-muted);
  }

  .oc-arch-kicker {
    color: var(--oc-engine);
    font-size: 0.76rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .oc-arch-title-block h1 {
    margin: 0;
    color: var(--oc-ink) !important;
    font-size: clamp(1.9rem, 3vw, 3.05rem) !important;
    font-weight: 760 !important;
    line-height: 1.02;
    text-transform: none !important;
  }

  .oc-arch-title-block p {
    max-width: 860px;
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .oc-arch-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .oc-arch-header-actions a {
    display: inline-flex;
    min-height: 2.4rem;
    align-items: center;
    border: 1px solid var(--oc-control);
    border-radius: 6px;
    padding: 0.55rem 0.8rem;
    background: var(--oc-control);
    color: #fff !important;
    font-size: 0.86rem;
    font-weight: 720;
    text-decoration: none;
    white-space: nowrap;
  }

  .oc-arch-control-strip {
    display: grid;
    grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.4fr);
    gap: 0.8rem;
    margin-bottom: 0.8rem;
  }

  .oc-arch-search {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .oc-arch-search input {
    width: 100%;
    min-height: 2.6rem;
    border: 1px solid var(--oc-line);
    border-radius: 6px;
    padding: 0.55rem 0.75rem;
    background: var(--oc-panel-strong);
    color: var(--oc-ink);
    font: inherit;
  }

  .oc-arch-view-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.35rem;
    align-self: end;
  }

  .oc-arch-view-tab,
  .oc-arch-domain-button,
  .oc-arch-domain-card,
  .oc-arch-domain-select,
  .oc-arch-component-chip,
  .oc-arch-flow-card,
  .oc-arch-contract-row {
    border: 1px solid var(--oc-line);
    border-radius: 7px;
    background: var(--oc-panel);
    color: var(--oc-ink);
    font: inherit;
  }

  .oc-arch-view-tab,
  .oc-arch-domain-button,
  .oc-arch-domain-select,
  .oc-arch-component-chip,
  .oc-arch-flow-card {
    cursor: pointer;
  }

  .oc-arch-view-tab {
    min-height: 2.6rem;
    padding: 0.45rem 0.55rem;
    text-align: center;
    font-size: 0.76rem;
    font-weight: 760;
    line-height: 1.14;
    white-space: normal;
  }

  .oc-arch-view-tab[aria-pressed="true"] {
    border-color: var(--oc-control);
    background: var(--oc-control);
    color: #fff;
  }

  .oc-arch-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
    margin-bottom: 0.9rem;
  }

  .oc-arch-stat {
    min-height: 4.25rem;
    border: 1px solid var(--oc-line);
    border-radius: 7px;
    padding: 0.65rem 0.75rem;
    background: rgba(255, 253, 248, 0.82);
  }

  .oc-arch-stat strong {
    display: block;
    color: var(--oc-ink);
    font-size: 1.35rem;
    font-weight: 780 !important;
    line-height: 1.05;
  }

  .oc-arch-stat span {
    display: block;
    margin-top: 0.25rem;
    color: var(--oc-muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .oc-arch-shell {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr) 300px;
    gap: 0.9rem;
    align-items: start;
  }

  .oc-arch-domain-rail,
  .oc-arch-flow,
  .oc-arch-blueprint,
  .oc-arch-contracts,
  .oc-arch-inspector,
  .oc-arch-evidence {
    border: 1px solid var(--oc-line);
    border-radius: 8px;
    background: rgba(255, 253, 248, 0.9);
    box-shadow: var(--oc-shadow);
  }

  .oc-arch-domain-rail,
  .oc-arch-inspector {
    position: sticky;
    top: 1rem;
  }

  .oc-arch-panel-head,
  .oc-arch-section-title {
    display: grid;
    gap: 0.25rem;
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid var(--oc-line);
  }

  .oc-arch-panel-head {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
  }

  .oc-arch-panel-head span,
  .oc-arch-section-title span {
    color: var(--oc-ink);
    font-size: 0.9rem;
    font-weight: 780;
  }

  .oc-arch-panel-head strong {
    color: var(--oc-muted);
    font-size: 0.78rem;
  }

  .oc-arch-section-title p {
    font-size: 0.78rem;
    line-height: 1.42;
  }

  .oc-arch-domain-rail nav {
    display: grid;
    gap: 0.45rem;
    padding: 0.65rem;
    max-height: calc(100vh - 16rem);
    overflow: auto;
  }

  .oc-arch-domain-button {
    display: grid;
    gap: 0.3rem;
    padding: 0.55rem;
    text-align: left;
  }

  .oc-arch-domain-button[aria-current="true"],
  .oc-arch-domain-card[data-selected="true"],
  .oc-arch-component-chip[aria-pressed="true"],
  .oc-arch-flow-card[aria-pressed="true"] {
    border-color: var(--domain-color, var(--oc-control));
    box-shadow: inset 4px 0 0 var(--domain-color, var(--oc-control));
    background: #fff;
  }

  .oc-arch-domain-button[data-match="false"],
  .oc-arch-domain-card[data-match="false"] {
    opacity: 0.34;
  }

  .oc-arch-domain-line {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.45rem;
    align-items: center;
  }

  .oc-arch-domain-index {
    display: inline-flex;
    width: 1.6rem;
    height: 1.6rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--domain-color, var(--oc-control));
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .oc-arch-domain-name {
    overflow-wrap: anywhere;
    font-size: 0.82rem;
    font-weight: 760;
    line-height: 1.25;
  }

  .oc-arch-domain-sub {
    font-size: 0.72rem;
    line-height: 1.32;
  }

  .oc-arch-main {
    display: grid;
    gap: 0.9rem;
    min-width: 0;
  }

  .oc-arch-flow-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.55rem;
    padding: 0.75rem;
  }

  .oc-arch-flow-card {
    position: relative;
    display: grid;
    gap: 0.35rem;
    min-height: 5.8rem;
    padding: 0.65rem;
    text-align: left;
  }

  .oc-arch-flow-card b {
    color: var(--oc-ink);
    font-size: 0.78rem;
    line-height: 1.25;
  }

  .oc-arch-flow-card small {
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .oc-arch-domain-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0.75rem;
  }

  .oc-arch-domain-card {
    display: grid;
    gap: 0.55rem;
    min-height: 10rem;
    padding: 0.72rem;
    text-align: left;
  }

  .oc-arch-domain-select {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    text-align: left;
  }

  .oc-arch-domain-card-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
  }

  .oc-arch-layer-tag {
    display: inline-flex;
    width: max-content;
    max-width: 100%;
    border: 1px solid color-mix(in srgb, var(--domain-color, var(--oc-control)) 40%, var(--oc-line));
    border-radius: 999px;
    padding: 0.18rem 0.45rem;
    background: color-mix(in srgb, var(--domain-color, var(--oc-control)) 12%, #fff);
    color: var(--domain-color, var(--oc-control));
    font-size: 0.68rem;
    font-weight: 800;
  }

  .oc-arch-domain-card h3 {
    margin: 0;
    color: var(--oc-ink) !important;
    font-size: 0.98rem !important;
    font-weight: 780 !important;
    line-height: 1.22;
  }

  .oc-arch-domain-card p {
    margin: 0;
    color: var(--oc-muted);
    font-size: 0.78rem;
    line-height: 1.42;
  }

  .oc-arch-component-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .oc-arch-component-chip {
    min-height: 1.95rem;
    padding: 0.28rem 0.45rem;
    font-size: 0.72rem;
    font-weight: 720;
  }

  .oc-arch-records {
    display: grid;
    gap: 0.22rem;
    margin: 0;
    padding: 0;
  }

  .oc-arch-records li {
    display: grid;
    grid-template-columns: 0.45rem minmax(0, 1fr);
    gap: 0.35rem;
    align-items: start;
    color: var(--oc-muted);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .oc-arch-records li::before {
    content: "";
    width: 0.42rem;
    height: 0.42rem;
    margin-top: 0.34rem;
    border-radius: 999px;
    background: var(--domain-color, var(--oc-control));
  }

  .oc-arch-contract-list {
    display: grid;
    gap: 0.45rem;
    padding: 0.75rem;
  }

  .oc-arch-contract-row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr) 7rem;
    gap: 0.55rem;
    align-items: center;
    min-height: 3.5rem;
    padding: 0.58rem 0.65rem;
  }

  .oc-arch-contract-node {
    overflow-wrap: anywhere;
    color: var(--oc-ink);
    font-size: 0.72rem;
    font-weight: 780;
    line-height: 1.25;
  }

  .oc-arch-contract-row p {
    font-size: 0.73rem;
    line-height: 1.38;
  }

  .oc-arch-inspector {
    min-height: 34rem;
    overflow: hidden;
  }

  .oc-arch-inspector-inner {
    display: grid;
    gap: 0.75rem;
    padding: 0.85rem;
  }

  .oc-arch-inspector-kicker {
    width: max-content;
    max-width: 100%;
    border-radius: 999px;
    padding: 0.22rem 0.5rem;
    background: color-mix(in srgb, var(--domain-color, var(--oc-control)) 14%, #fff);
    color: var(--domain-color, var(--oc-control));
    font-size: 0.7rem;
    font-weight: 820;
  }

  .oc-arch-inspector h2 {
    margin: 0;
    color: var(--oc-ink) !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    line-height: 1.15;
  }

  .oc-arch-inspector p {
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .oc-arch-detail-block {
    display: grid;
    gap: 0.38rem;
  }

  .oc-arch-detail-block h3 {
    margin: 0;
    color: var(--oc-ink) !important;
    font-size: 0.78rem !important;
    font-weight: 800 !important;
    text-transform: uppercase;
  }

  .oc-arch-detail-block ul {
    display: grid;
    gap: 0.32rem;
    margin: 0;
    padding: 0;
  }

  .oc-arch-detail-block li,
  .oc-arch-code-list code {
    overflow-wrap: anywhere;
    color: var(--oc-muted);
    font-size: 0.73rem;
    line-height: 1.38;
  }

  .oc-arch-code-list {
    display: grid;
    gap: 0.3rem;
  }

  .oc-arch-code-list code {
    display: block;
    border: 1px solid var(--oc-line);
    border-radius: 6px;
    padding: 0.35rem 0.45rem;
    background: #f4f0e7;
    color: #3a3d42;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
  }

  .oc-arch-evidence {
    margin-top: 0.9rem;
  }

  .oc-arch-evidence-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
    padding: 0.75rem;
  }

  .oc-arch-evidence-item {
    display: grid;
    gap: 0.3rem;
    border: 1px solid var(--oc-line);
    border-radius: 7px;
    padding: 0.55rem;
    background: var(--oc-panel);
  }

  .oc-arch-evidence-item strong {
    overflow-wrap: anywhere;
    color: var(--oc-ink);
    font-size: 0.74rem;
    font-weight: 780 !important;
    line-height: 1.28;
  }

  .oc-arch-evidence-item span {
    overflow-wrap: anywhere;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.68rem;
    line-height: 1.35;
  }

  .oc-arch-empty {
    border: 1px dashed var(--oc-line-strong);
    border-radius: 7px;
    padding: 1rem;
    color: var(--oc-muted);
    font-size: 0.82rem;
  }

  .oc-arch-view-tab:focus-visible,
  .oc-arch-search input:focus-visible,
  .oc-arch-domain-button:focus-visible,
  .oc-arch-domain-select:focus-visible,
  .oc-arch-component-chip:focus-visible,
  .oc-arch-flow-card:focus-visible {
    outline: 2px solid var(--domain-color, var(--oc-control));
    outline-offset: 2px;
  }

  @media (min-width: 78rem) {
    .oc-arch-explorer:not(.oc-arch-explorer--standalone) {
      width: min(1180px, calc(100vw - 22rem));
      margin-left: -3rem;
    }
  }

  @media (max-width: 86rem) {
    .oc-arch-control-strip {
      grid-template-columns: 1fr;
    }

    .oc-arch-shell {
      grid-template-columns: 220px minmax(0, 1fr);
    }

    .oc-arch-domain-rail {
      position: static;
    }

    .oc-arch-inspector {
      position: static;
      grid-column: 1 / -1;
      min-height: 0;
    }
  }

  @media (max-width: 1120px) {
    .oc-arch-flow-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .oc-arch-evidence-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .oc-arch-explorer--standalone {
      padding: 0.8rem;
    }

    .oc-arch-header,
    .oc-arch-control-strip,
    .oc-arch-shell {
      grid-template-columns: 1fr;
    }

    .oc-arch-header-actions {
      justify-content: start;
    }

    .oc-arch-stats,
    .oc-arch-view-tabs,
    .oc-arch-flow-steps,
    .oc-arch-domain-grid,
    .oc-arch-evidence-grid {
      grid-template-columns: 1fr;
    }

    .oc-arch-domain-rail {
      position: static;
    }

    .oc-arch-domain-rail nav {
      max-height: none;
    }

    .oc-arch-contract-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
