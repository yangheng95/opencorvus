  function localize(value: string | LocalizedText, locale: ArchLocale): string {
    if (typeof value === "string") return value
    const text = value[locale]
    if (typeof text !== "string") throw new Error(`architecture explorer: missing ${locale} text`)
    return text
  }

  function domainByID(id: string): ArchDomain {
    const domain = architectureDomains.find((item) => item.id === id)
    if (!domain) throw new Error(`architecture explorer: unknown domain ${id}`)
    return domain
  }

  function viewByID(id: string): ArchView {
    const view = architectureViews.find((item) => item.id === id)
    if (!view) throw new Error(`architecture explorer: unknown view ${id}`)
    return view
  }

  function componentByID(id: string): { domain: ArchDomain; component: ArchComponent } {
    for (const domain of architectureDomains) {
      const component = domain.components.find((item) => item.id === id)
      if (component) return { domain, component }
    }
    throw new Error(`architecture explorer: unknown component ${id}`)
  }

  function itemSearchText(domain: ArchDomain, locale: ArchLocale): string {
    const componentText = domain.components
      .map((component) => `${component.title} ${localize(component.responsibility, locale)} ${component.sources.join(" ")}`)
      .join(" ")
    return [
      domain.id,
      domain.index,
      localize(domain.layer, locale),
      localize(domain.title, locale),
      localize(domain.summary, locale),
      domain.responsibilities.map((item) => localize(item, locale)).join(" "),
      domain.boundaries.map((item) => localize(item, locale)).join(" "),
      domain.sources.join(" "),
      domain.records.join(" "),
      componentText,
    ].join(" ").toLowerCase()
  }

  function createElement<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    className = "",
    text = "",
  ): HTMLElementTagNameMap[K] {
    const el = document.createElement(tag)
    if (className) el.className = className
    if (text.length > 0) el.textContent = text
    return el
  }

  function clear(el: HTMLElement): void {
    el.replaceChildren()
  }

  function requireElement<T extends Element>(root: ParentNode, selector: string): T {
    const el = root.querySelector(selector)
    if (!el) throw new Error(`architecture explorer: missing element ${selector}`)
    return el as T
  }

  function initArchitectureExplorer(root: HTMLElement): void {
    const localeValue = root.dataset.locale
    if (localeValue !== "en" && localeValue !== "zh") throw new Error("architecture explorer: invalid locale")
    const locale: ArchLocale = localeValue
    const copy = architectureCopy[locale]
    const els = {
      search: requireElement<HTMLInputElement>(root, "[data-arch-search]"),
      tabs: requireElement<HTMLElement>(root, "[data-arch-view-tabs]"),
      stats: requireElement<HTMLElement>(root, "[data-arch-stats]"),
      domainCount: requireElement<HTMLElement>(root, "[data-arch-domain-count]"),
      domainList: requireElement<HTMLElement>(root, "[data-arch-domain-list]"),
      viewTitle: requireElement<HTMLElement>(root, "[data-arch-view-title]"),
      viewSummary: requireElement<HTMLElement>(root, "[data-arch-view-summary]"),
      flow: requireElement<HTMLElement>(root, "[data-arch-flow]"),
      grid: requireElement<HTMLElement>(root, "[data-arch-domain-grid]"),
      contracts: requireElement<HTMLElement>(root, "[data-arch-contracts]"),
      inspector: requireElement<HTMLElement>(root, "[data-arch-inspector]"),
      evidence: requireElement<HTMLElement>(root, "[data-arch-evidence]"),
    }

    let activeViewID = "runtime"
    let activeDomainID = "engine-spine"
    let activeComponentID = ""
    let search = ""

    els.search.placeholder = copy.searchPlaceholder
    els.search.addEventListener("input", () => {
      search = els.search.value.trim().toLowerCase()
      if (search.length > 0) {
        const firstMatch = architectureDomains.find((domain) => matches(domain))
        if (firstMatch) {
          activeViewID = preferredViewForDomain(firstMatch.id)
          activeDomainID = firstMatch.id
          if (activeComponentID) {
            const found = componentByID(activeComponentID)
            if (found.domain.id !== firstMatch.id || !componentMatches(found.component)) activeComponentID = ""
          }
        }
      }
      render()
    })

    function activeDomainIDs(): Set<string> {
      return new Set(viewByID(activeViewID).sequence)
    }

    function matches(domain: ArchDomain): boolean {
      return search.length === 0 || itemSearchText(domain, locale).includes(search)
    }

    function searchHasMatches(): boolean {
      return search.length === 0 || architectureDomains.some((domain) => matches(domain))
    }

    function componentMatches(component: ArchComponent): boolean {
      return (
        search.length === 0 ||
        [component.id, component.title, localize(component.responsibility, locale), component.sources.join(" ")]
          .join(" ")
          .toLowerCase()
          .includes(search)
      )
    }

    function relatedContracts(domainID: string): string[] {
      const view = viewByID(activeViewID)
      return view.contracts
        .filter(([fromID, toID]) => fromID === domainID || toID === domainID)
        .map(([fromID, toID, label]) => {
          const from = domainByID(fromID)
          const to = domainByID(toID)
          return `${localize(from.title, locale)} -> ${localize(to.title, locale)}: ${localize(label, locale)}`
        })
    }

    function selectionPath(domain: ArchDomain, component?: ArchComponent): string {
      const view = viewByID(activeViewID)
      const parts = [localize(view.title, locale), localize(domain.title, locale)]
      if (component) parts.push(component.title)
      return parts.join(" / ")
    }

    function preferredViewForDomain(domainID: string): string {
      if (viewByID(activeViewID).sequence.includes(domainID)) return activeViewID
      const preferred: Record<string, string> = {
        "a2a-coordination": "a2a",
        "overlay-projection": "overlay",
        "operator-surfaces": "overlay",
        "agent-team": "agents",
        "worktree-execution": "agents",
        verification: "data",
        "engine-spine": "data",
      }
      const preferredID = preferred[domainID]
      if (preferredID && viewByID(preferredID).sequence.includes(domainID)) return preferredID
      const view = architectureViews.find((item) => item.sequence.includes(domainID))
      if (!view) throw new Error(`architecture explorer: no view contains domain ${domainID}`)
      return view.id
    }

    function setDomain(id: string): void {
      activeViewID = preferredViewForDomain(id)
      activeDomainID = id
      activeComponentID = ""
      render()
    }

    function setComponent(id: string): void {
      const found = componentByID(id)
      activeViewID = preferredViewForDomain(found.domain.id)
      activeDomainID = found.domain.id
      activeComponentID = id
      render()
    }

    function renderTabs(): void {
      clear(els.tabs)
      for (const view of architectureViews) {
        const button = createElement("button", "oc-arch-view-tab", localize(view.title, locale))
        button.type = "button"
        button.setAttribute("aria-pressed", view.id === activeViewID ? "true" : "false")
        button.addEventListener("click", () => {
          activeViewID = view.id
          const selectedView = viewByID(activeViewID)
          if (!selectedView.sequence.includes(activeDomainID)) {
            const firstDomainID = selectedView.sequence[0]
            if (!firstDomainID) throw new Error(`architecture explorer: empty sequence for view ${activeViewID}`)
            activeDomainID = firstDomainID
            activeComponentID = ""
          }
          render()
        })
        els.tabs.appendChild(button)
      }
    }

    function renderStats(): void {
      clear(els.stats)
      const values = [
        String(architectureDomains.length),
        String(architectureDomains.reduce((total, domain) => total + domain.components.length, 0)),
        String(currentEngineArtifactKinds.length),
        String(["dispatch_lineage", "build_host_observation", "host_verification_observation", "visual_feedback_verification", "visual_review", "integrity_review", "task_completion_decision", "agent_coordination_request", "agent_coordination_response", "agent_coordination_action"].length),
      ]
      for (const [index, label] of copy.statLabels.entries()) {
        const card = createElement("div", "oc-arch-stat")
        const value = values[index]
        if (!value) throw new Error(`architecture explorer: missing stat value ${index}`)
        card.appendChild(createElement("strong", "", value))
        card.appendChild(createElement("span", "", label))
        els.stats.appendChild(card)
      }
      els.domainCount.textContent = `${architectureDomains.length}`
    }

    function renderDomainList(): void {
      clear(els.domainList)
      let visible = 0
      for (const domain of architectureDomains) {
        const isMatch = matches(domain)
        if (search.length > 0 && !isMatch) continue
        if (isMatch) visible += 1
        const button = createElement("button", "oc-arch-domain-button")
        button.type = "button"
        button.dataset.domainId = domain.id
        button.style.setProperty("--domain-color", domain.color)
        button.dataset.match = isMatch ? "true" : "false"
        button.setAttribute("aria-current", domain.id === activeDomainID ? "true" : "false")
        button.addEventListener("click", () => setDomain(domain.id))

        const line = createElement("div", "oc-arch-domain-line")
        line.appendChild(createElement("span", "oc-arch-domain-index", domain.index))
        line.appendChild(createElement("span", "oc-arch-domain-name", localize(domain.title, locale)))
        button.appendChild(line)
        button.appendChild(createElement("span", "oc-arch-domain-sub", localize(domain.summary, locale)))
        els.domainList.appendChild(button)
      }
      if (visible === 0) els.domainList.appendChild(createElement("div", "oc-arch-empty", copy.noSearch))
    }

    function renderFlow(): void {
      const view = viewByID(activeViewID)
      els.viewTitle.textContent = localize(view.title, locale)
      els.viewSummary.textContent = localize(view.summary, locale)
      clear(els.flow)
      for (const domainID of view.sequence) {
        const domain = domainByID(domainID)
        const button = createElement("button", "oc-arch-flow-card")
        button.type = "button"
        button.dataset.domainId = domain.id
        button.style.setProperty("--domain-color", domain.color)
        button.setAttribute("aria-pressed", domain.id === activeDomainID ? "true" : "false")
        button.addEventListener("click", () => setDomain(domain.id))
        button.appendChild(createElement("span", "oc-arch-layer-tag", localize(domain.layer, locale)))
        button.appendChild(createElement("b", "", `${domain.index} ${localize(domain.title, locale)}`))
        button.appendChild(createElement("small", "", localize(domain.summary, locale)))
        els.flow.appendChild(button)
      }
    }

    function renderDomainGrid(): void {
      clear(els.grid)
      const focused = activeDomainIDs()
      let visible = 0
      for (const domain of architectureDomains) {
        const isMatch = matches(domain)
        if (search.length > 0 && !isMatch) continue
        if (isMatch) visible += 1
        const card = createElement("article", "oc-arch-domain-card")
        card.dataset.domainId = domain.id
        card.style.setProperty("--domain-color", domain.color)
        card.dataset.match = isMatch ? "true" : "false"
        card.dataset.selected = domain.id === activeDomainID ? "true" : "false"
        if (!focused.has(domain.id)) card.style.opacity = search.length > 0 && isMatch ? "0.72" : "0.46"

        const select = createElement("button", "oc-arch-domain-select")
        select.type = "button"
        select.dataset.domainId = domain.id
        select.style.setProperty("--domain-color", domain.color)
        select.setAttribute("aria-pressed", domain.id === activeDomainID ? "true" : "false")
        select.addEventListener("click", () => setDomain(domain.id))

        const header = createElement("div", "oc-arch-domain-card-header")
        header.appendChild(createElement("span", "oc-arch-domain-index", domain.index))
        const titleBlock = createElement("div")
        titleBlock.appendChild(createElement("span", "oc-arch-layer-tag", localize(domain.layer, locale)))
        titleBlock.appendChild(createElement("h3", "", localize(domain.title, locale)))
        header.appendChild(titleBlock)
        select.appendChild(header)
        select.appendChild(createElement("p", "", localize(domain.summary, locale)))
        card.appendChild(select)

        const chips = createElement("div", "oc-arch-component-list")
        for (const component of domain.components) {
          if (search.length > 0 && !componentMatches(component)) continue
          const chip = createElement("button", "oc-arch-component-chip", component.title)
          chip.type = "button"
          chip.dataset.componentId = component.id
          chip.style.setProperty("--domain-color", domain.color)
          chip.setAttribute("aria-pressed", component.id === activeComponentID ? "true" : "false")
          chip.addEventListener("click", (event: MouseEvent) => {
            event.stopPropagation()
            setComponent(component.id)
          })
          chips.appendChild(chip)
        }
        card.appendChild(chips)

        const records = createElement("ul", "oc-arch-records")
        for (const record of domain.records.slice(0, 3)) records.appendChild(createElement("li", "", record))
        card.appendChild(records)
        els.grid.appendChild(card)
      }
      if (visible === 0) els.grid.appendChild(createElement("div", "oc-arch-empty", copy.noSearch))
    }

    function renderContracts(): void {
      const view = viewByID(activeViewID)
      clear(els.contracts)
      for (const [fromID, toID, label] of view.contracts) {
        const from = domainByID(fromID)
        const to = domainByID(toID)
        const row = createElement("div", "oc-arch-contract-row")
        row.style.setProperty("--domain-color", from.color)
        row.appendChild(createElement("div", "oc-arch-contract-node", localize(from.title, locale)))
        row.appendChild(createElement("p", "", localize(label, locale)))
        row.appendChild(createElement("div", "oc-arch-contract-node", localize(to.title, locale)))
        els.contracts.appendChild(row)
      }
    }

    function renderInspector(): void {
      clear(els.inspector)
      if (!searchHasMatches()) {
        els.inspector.appendChild(createElement("div", "oc-arch-empty", copy.noSearch))
        return
      }
      const domain = domainByID(activeDomainID)
      const inner = createElement("div", "oc-arch-inspector-inner")
      inner.style.setProperty("--domain-color", domain.color)

      if (activeComponentID) {
        const found = componentByID(activeComponentID)
        inner.appendChild(createElement("div", "oc-arch-inspector-kicker", copy.selectedComponent))
        inner.appendChild(createElement("h2", "", found.component.title))
        inner.appendChild(createElement("p", "", localize(found.component.responsibility, locale)))
        inner.appendChild(detailList(copy.selectionPath, [selectionPath(found.domain, found.component)], "text"))
        inner.appendChild(detailList(copy.responsibilities, [localize(found.component.responsibility, locale)], "text"))
        inner.appendChild(detailList(copy.sourcePaths, found.component.sources, "code"))
        inner.appendChild(detailList(copy.durableRecords, found.domain.records, "code"))
        inner.appendChild(detailList(copy.boundaries, found.domain.boundaries.map((item) => localize(item, locale)), "text"))
        inner.appendChild(detailList(copy.relatedContracts, relatedContracts(found.domain.id), "text"))
      } else {
        inner.appendChild(createElement("div", "oc-arch-inspector-kicker", copy.selectedDomain))
        inner.appendChild(createElement("h2", "", localize(domain.title, locale)))
        inner.appendChild(createElement("p", "", localize(domain.summary, locale)))
        inner.appendChild(detailList(copy.selectionPath, [selectionPath(domain)], "text"))
        inner.appendChild(detailList(copy.durableRecords, domain.records, "code"))
        inner.appendChild(detailList(copy.sourcePaths, domain.sources, "code"))
        inner.appendChild(detailList(copy.responsibilities, domain.responsibilities.map((item) => localize(item, locale)), "text"))
        inner.appendChild(detailList(copy.boundaries, domain.boundaries.map((item) => localize(item, locale)), "text"))
        inner.appendChild(detailList(copy.relatedContracts, relatedContracts(domain.id), "text"))
      }

      els.inspector.appendChild(inner)
    }

    function detailList(title: string, items: string[], mode: "code" | "text"): HTMLElement {
      const block = createElement("div", "oc-arch-detail-block")
      block.appendChild(createElement("h3", "", title))
      if (mode === "code") {
        const list = createElement("div", "oc-arch-code-list")
        for (const item of items) list.appendChild(createElement("code", "", item))
        block.appendChild(list)
      } else {
        const list = createElement("ul")
        for (const item of items) list.appendChild(createElement("li", "", item))
        block.appendChild(list)
      }
      return block
    }

    function renderEvidence(): void {
      clear(els.evidence)
      if (!searchHasMatches()) {
        els.evidence.appendChild(createElement("div", "oc-arch-empty", copy.noSearch))
        return
      }
      const domain = domainByID(activeDomainID)
      const evidenceItems = activeComponentID
        ? (() => {
            const found = componentByID(activeComponentID)
            return [
              { label: copy.selectionPath, value: selectionPath(found.domain, found.component) },
              { label: copy.responsibilities, value: localize(found.component.responsibility, locale) },
              ...found.component.sources.map((source) => ({ label: copy.sourcePaths, value: source })),
              ...found.domain.records.map((record) => ({ label: copy.durableRecords, value: record })),
            ]
          })()
        : [
            { label: copy.selectionPath, value: selectionPath(domain) },
            ...domain.records.map((record) => ({ label: copy.highlightedStreams, value: record })),
            ...domain.sources.map((source) => ({ label: copy.sourcePaths, value: source })),
          ]
      for (const item of evidenceItems) {
        const card = createElement("div", "oc-arch-evidence-item")
        card.appendChild(createElement("strong", "", item.label))
        card.appendChild(createElement("span", "", item.value))
        els.evidence.appendChild(card)
      }
    }

    function render(): void {
      renderTabs()
      renderStats()
      renderDomainList()
      renderFlow()
      renderDomainGrid()
      renderContracts()
      renderInspector()
      renderEvidence()
    }

    render()
  }

  for (const root of document.querySelectorAll<HTMLElement>("[data-oc-architecture-explorer]")) initArchitectureExplorer(root)
</script>
