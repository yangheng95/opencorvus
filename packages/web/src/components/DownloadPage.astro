---
import PublicSiteLayout from "./PublicSiteLayout.astro"
import { publicPath, type PublicLocale } from "../content/public-market"

const { locale } = Astro.props as { locale: PublicLocale }
const publicBase = import.meta.env.BASE_URL.replace(/\/$/, "")
const manifestUrl = `${publicBase}/downloads/latest.json`
const copy =
  locale === "zh-cn"
    ? {
        title: "下载 OpenCorvus · OpenCorvus",
        description: "下载适用于 Windows、macOS 与 Linux 的最新版 OpenCorvus 桌面端或命令行工具。",
        languageHref: publicPath("root", "/download/"),
        eyebrow: "下载",
        heading: "把 OpenCorvus 安装到你的工作区。",
        lead: "选择桌面端或命令行工具。下方安装包与版本直接来自已验证的发布工作流。",
        latest: "最新发布版本",
        loading: "正在读取已验证的发布清单…",
        recommendedEyebrow: "为当前设备推荐",
        recommendedLoading: "正在识别平台并匹配安装包",
        recommendedHint: "页面只在浏览器明确提供架构时自动选择；不可靠的信息不会被猜测。",
        chooseMac: "已识别为 macOS，请选择 Apple Silicon 或 Intel 版本。",
        chooseLinux: "已识别为 Linux，请选择 x64 或 ARM64 版本。",
        chooseUnknown: "当前设备不提供桌面平台信息，请从下方选择操作系统。",
        allPlatforms: "选择桌面平台",
        choosePlatform: "查看适合当前平台的版本",
        releaseNotes: "查看 Release 说明",
        desktopEyebrow: "桌面端",
        desktopTitle: "选择你的操作系统。",
        desktopLead: "图形化工作台与本地运行时。macOS 和 Linux 同时列出可用架构与安装格式。",
        cliEyebrow: "命令行工具",
        cliTitle: "在终端和自动化环境中运行。",
        cliLead: "每个归档都绑定到同一发布版本；兼容版面向较旧的 x64 处理器。",
        verifyEyebrow: "验证下载",
        verifyTitle: "先确认版本，再校验文件。",
        verifyBody: "每个 GitHub Release 都同时发布 SHA256SUMS。下载后核对文件摘要，可以确认传输字节与发布记录一致。",
        checksum: "打开 SHA256SUMS",
        allAssets: "查看全部 Release 资源",
        unavailable: "发布清单暂时不可用",
        unavailableBody: "页面没有得到可验证的当前版本，因此不会猜测或显示旧下载。",
        platformNames: { windows: "Windows", macos: "macOS", linux: "Linux" },
        systemHints: { windows: "Windows 10 / 11 · x64", macos: "Apple Silicon 与 Intel", linux: "x64 与 ARM64" },
        download: "下载",
        compatible: "兼容版",
        appleSilicon: "Apple Silicon",
        intel: "Intel",
      }
    : {
        title: "Download OpenCorvus · OpenCorvus",
        description: "Download the latest OpenCorvus desktop app or command-line interface for Windows, macOS, and Linux.",
        languageHref: publicPath("zh-cn", "/download/"),
        eyebrow: "Download",
        heading: "OpenCorvus for your workspace.",
        lead: "Choose the desktop app or command-line interface. Published packages and the version below come directly from the verified release workflow.",
        latest: "Latest published version",
        loading: "Reading the verified release manifest…",
        recommendedEyebrow: "Recommended for this device",
        recommendedLoading: "Detecting the platform and matching an installer",
        recommendedHint: "Architecture is selected only when the browser exposes it reliably. The page does not guess.",
        chooseMac: "macOS detected. Choose Apple Silicon or Intel below.",
        chooseLinux: "Linux detected. Choose x64 or ARM64 below.",
        chooseUnknown: "This device does not expose a desktop platform. Choose an operating system below.",
        allPlatforms: "Choose a desktop platform",
        choosePlatform: "View this platform's downloads",
        releaseNotes: "Read the Release notes",
        desktopEyebrow: "Desktop app",
        desktopTitle: "Choose your operating system.",
        desktopLead: "The graphical workbench and local runtime. macOS and Linux show every available architecture and installer format.",
        cliEyebrow: "Command-line interface",
        cliTitle: "Run from a terminal or automation environment.",
        cliLead: "Every archive is bound to the same release version. Compatible builds support older x64 processors.",
        verifyEyebrow: "Verify your download",
        verifyTitle: "Confirm the version, then check the file.",
        verifyBody: "Every GitHub Release includes SHA256SUMS. Compare the digest after download to confirm that the bytes match the published record.",
        checksum: "Open SHA256SUMS",
        allAssets: "View every Release asset",
        unavailable: "The release manifest is unavailable",
        unavailableBody: "The page did not receive a verifiable current version, so it will not guess or show an older download.",
        platformNames: { windows: "Windows", macos: "macOS", linux: "Linux" },
        systemHints: { windows: "Windows 10 / 11 · x64", macos: "Apple Silicon and Intel", linux: "x64 and ARM64" },
        download: "Download",
        compatible: "Compatible",
        appleSilicon: "Apple Silicon",
        intel: "Intel",
      }

const copyJson = JSON.stringify(copy)
---

<PublicSiteLayout
  {locale}
  current="download"
  title={copy.title}
  description={copy.description}
  languageHref={copy.languageHref}
>
  <main id="main-content" class="public-main download-page" data-download-page data-locale={locale} data-manifest-url={manifestUrl} data-copy={copyJson}>
    <section class="download-hero" aria-labelledby="download-title">
      <div class="download-hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1 id="download-title">{copy.heading}</h1>
        <p class="section-lead">{copy.lead}</p>
        <div class="release-identity" aria-live="polite">
          <span>{copy.latest}</span>
          <strong data-release-version>{copy.loading}</strong>
          <small data-release-date></small>
        </div>
      </div>

      <aside class="recommended-download" aria-labelledby="recommended-title" data-recommended>
        <p class="eyebrow">{copy.recommendedEyebrow}</p>
        <h2 id="recommended-title" data-recommended-title>{copy.recommendedLoading}</h2>
        <p data-recommended-copy>{copy.recommendedHint}</p>
        <div class="recommended-actions" data-recommended-actions></div>
      </aside>
    </section>

    <section class="utility-section download-section" aria-labelledby="desktop-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{copy.desktopEyebrow}</p>
          <h2 id="desktop-title">{copy.desktopTitle}</h2>
        </div>
        <p class="section-lead">{copy.desktopLead}</p>
      </div>
      <div class="download-platform-grid" data-product="desktop">
        {(["windows", "macos", "linux"] as const).map((platform, index) => (
          <article id={`desktop-${platform}`} data-platform={platform}>
            <span class="platform-index">0{index + 1}</span>
            <div class="platform-title">
              <h3>{copy.platformNames[platform]}</h3>
              <p>{copy.systemHints[platform]}</p>
            </div>
            <div class="asset-list" data-asset-list>
              <p class="asset-loading">{copy.loading}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="utility-section download-section cli-section" aria-labelledby="cli-title">
      <div class="landing-band-header">
        <div>
          <p class="eyebrow">{copy.cliEyebrow}</p>
          <h2 id="cli-title">{copy.cliTitle}</h2>
        </div>
        <p class="section-lead">{copy.cliLead}</p>
      </div>
      <div class="cli-downloads" data-product="cli">
        {(["windows", "macos", "linux"] as const).map((platform) => (
          <article data-platform={platform}>
            <h3>{copy.platformNames[platform]}</h3>
            <div class="asset-list" data-asset-list><p class="asset-loading">{copy.loading}</p></div>
          </article>
        ))}
      </div>
    </section>

    <section class="utility-section verify-download" aria-labelledby="verify-title">
      <div>
        <p class="eyebrow">{copy.verifyEyebrow}</p>
        <h2 id="verify-title">{copy.verifyTitle}</h2>
      </div>
      <div>
        <p class="section-lead">{copy.verifyBody}</p>
        <div class="hero-actions">
          <a class="primary-action" data-checksum-link href="https://github.com/yangheng95/opencorvus/releases">{copy.checksum}</a>
          <a class="secondary-action" data-release-link href="https://github.com/yangheng95/opencorvus/releases">{copy.allAssets}</a>
        </div>
      </div>
    </section>

    <section class="download-error" data-download-error hidden aria-live="assertive">
      <strong>{copy.unavailable}</strong>
      <p>{copy.unavailableBody}</p>
      <a class="secondary-action" href="https://github.com/yangheng95/opencorvus/releases">GitHub Releases →</a>
    </section>
  </main>
</PublicSiteLayout>

<script>
  type Platform = "windows" | "macos" | "linux"
  type DetectedPlatform = Platform | "unknown"
  type Architecture = "x64" | "arm64"
  type DownloadAsset = {
    id: string
    product: "desktop" | "cli"
    platform: Platform
    architecture: Architecture
    format: string
    fileName: string
    bytes: number
    url: string
    compatible: boolean
  }
  type DownloadManifest = {
    protocol: "opencorvus/website-downloads@1"
    version: string
    publishedAt: string
    releaseUrl: string
    prerelease: boolean
    assets: DownloadAsset[]
  }

  const root = document.querySelector<HTMLElement>("[data-download-page]")!
  if (!root) throw new Error("Download page root is missing")
  const copy = JSON.parse(root.dataset.copy ?? "{}")
  const locale = root.dataset.locale === "zh-cn" ? "zh-CN" : "en"

  function parseManifest(value: unknown): DownloadManifest {
    if (!value || typeof value !== "object") throw new Error("invalid manifest")
    const manifest = value as DownloadManifest
    if (
      manifest.protocol !== "opencorvus/website-downloads@1" ||
      !/^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/.test(manifest.version) ||
      !Array.isArray(manifest.assets) ||
      manifest.assets.length === 0 ||
      manifest.assets.some((asset) => !asset.url.includes(`/releases/download/v${manifest.version}/`) || asset.bytes <= 0)
    ) {
      throw new Error("invalid manifest")
    }
    return manifest
  }

  function device() {
    const navigatorWithData = navigator as Navigator & { userAgentData?: { platform?: string } }
    const value = `${navigatorWithData.userAgentData?.platform ?? ""} ${navigator.platform} ${navigator.userAgent}`.toLowerCase()
    const mobile = /android|iphone|ipad|ipod|mobile/.test(value)
    const platform: DetectedPlatform = mobile
      ? "unknown"
      : /windows|win32|win64/.test(value)
        ? "windows"
        : /mac|darwin/.test(value)
          ? "macos"
          : /linux|x11/.test(value)
            ? "linux"
            : "unknown"
    const architecture: Architecture | undefined = /arm64|aarch64/.test(value) ? "arm64" : /x86_64|x64|win64|amd64/.test(value) ? "x64" : undefined
    return { platform, architecture }
  }

  function bytes(value: number) {
    return `${(value / 1024 / 1024).toFixed(1)} MB`
  }

  function architectureLabel(asset: DownloadAsset) {
    if (asset.platform === "macos") return asset.architecture === "arm64" ? copy.appleSilicon : copy.intel
    return asset.architecture === "arm64" ? "ARM64" : "x64"
  }

  function assetLink(asset: DownloadAsset) {
    const link = document.createElement("a")
    link.className = "asset-row"
    link.href = asset.url
    const identity = document.createElement("span")
    const title = document.createElement("strong")
    title.textContent = asset.format
    const detail = document.createElement("small")
    detail.textContent = `${architectureLabel(asset)}${asset.compatible ? ` · ${copy.compatible}` : ""}`
    identity.append(title, detail)
    const meta = document.createElement("span")
    const size = document.createElement("small")
    size.textContent = bytes(asset.bytes)
    const action = document.createElement("b")
    action.textContent = `${copy.download} ↓`
    meta.append(size, action)
    link.append(identity, meta)
    return link
  }

  function populate(manifest: DownloadManifest) {
    root.querySelector<HTMLElement>("[data-release-version]")!.textContent = `v${manifest.version}${manifest.prerelease ? " · beta" : ""}`
    root.querySelector<HTMLElement>("[data-release-date]")!.textContent = new Intl.DateTimeFormat(locale, {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(new Date(manifest.publishedAt))
    for (const group of root.querySelectorAll<HTMLElement>("[data-product]")) {
      const product = group.dataset.product
      for (const card of group.querySelectorAll<HTMLElement>("[data-platform]")) {
        const list = card.querySelector<HTMLElement>("[data-asset-list]")!
        list.replaceChildren(
          ...manifest.assets
            .filter((asset) => asset.product === product && asset.platform === card.dataset.platform)
            .map(assetLink),
        )
      }
    }

    const current = device()
    const panel = root.querySelector<HTMLElement>("[data-recommended]")!
    panel.dataset.platform = current.platform
    const title = root.querySelector<HTMLElement>("[data-recommended-title]")!
    const description = root.querySelector<HTMLElement>("[data-recommended-copy]")!
    const actions = root.querySelector<HTMLElement>("[data-recommended-actions]")!
    const platformAssets = manifest.assets.filter(
      (asset) => asset.product === "desktop" && current.platform !== "unknown" && asset.platform === current.platform,
    )
    let preferred: DownloadAsset | undefined = platformAssets
      .filter((asset) => !current.architecture || asset.architecture === current.architecture)
      .sort((left, right) => {
        const priority = { EXE: 0, DMG: 0, AppImage: 0, MSI: 1, DEB: 1, RPM: 2 }
        return (priority[left.format as keyof typeof priority] ?? 9) - (priority[right.format as keyof typeof priority] ?? 9)
      })[0]

    if (!preferred && current.platform === "windows") {
      preferred = platformAssets.find((asset) => asset.architecture === "x64" && asset.format === "EXE")
    }

    title.textContent = current.platform === "unknown" ? copy.allPlatforms : copy.platformNames[current.platform]
    actions.replaceChildren()
    if (current.platform === "unknown") {
      description.textContent = copy.chooseUnknown
      const choose = document.createElement("a")
      choose.className = "primary-action"
      choose.href = "#desktop-title"
      choose.textContent = copy.choosePlatform
      actions.append(choose)
    } else if ((current.platform === "macos" || current.platform === "linux") && !current.architecture) {
      description.textContent = current.platform === "macos" ? copy.chooseMac : copy.chooseLinux
      const choose = document.createElement("a")
      choose.className = "primary-action"
      choose.href = `#desktop-${current.platform}`
      choose.textContent = copy.choosePlatform
      actions.append(choose)
    } else if (preferred) {
      description.textContent = `${preferred.format} · ${architectureLabel(preferred)} · ${bytes(preferred.bytes)}`
      const download = document.createElement("a")
      download.className = "primary-action"
      download.href = preferred.url
      download.textContent = `${copy.download} OpenCorvus ↓`
      actions.append(download)
    }
    const notes = document.createElement("a")
    notes.className = "secondary-action"
    notes.href = manifest.releaseUrl
    notes.textContent = copy.releaseNotes
    actions.append(notes)

    root.querySelector<HTMLAnchorElement>("[data-release-link]")!.href = manifest.releaseUrl
    root.querySelector<HTMLAnchorElement>("[data-checksum-link]")!.href = `${manifest.releaseUrl.replace("/tag/", "/download/")}/SHA256SUMS`
  }

  fetch(root.dataset.manifestUrl ?? "/downloads/latest.json", { headers: { Accept: "application/json" } })
    .then(async (response) => {
      if (!response.ok) throw new Error(`manifest ${response.status}`)
      return parseManifest(await response.json())
    })
    .then(populate)
    .catch(() => {
      root.querySelector<HTMLElement>("[data-download-error]")!.hidden = false
      root.querySelector<HTMLElement>("[data-recommended]")!.hidden = true
      root.querySelector<HTMLElement>("[data-release-version]")!.textContent = copy.unavailable
    })
</script>

<style>
  .download-page {
    padding-bottom: 96px;
  }

  .download-hero {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 72px;
    align-items: center;
    min-height: 560px;
    padding: 74px 0 78px;
    border-bottom: 2px solid var(--ink);
  }

  .download-hero h1 {
    max-width: 700px;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(60px, 5.4vw, 78px);
    font-weight: 760;
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .release-identity {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 5px 18px;
    max-width: 560px;
    margin-top: 34px;
    padding-top: 18px;
    border-top: 1px solid var(--ink);
    font-family: var(--mono);
  }

  .release-identity span,
  .release-identity small {
    color: var(--muted);
    font-size: 11px;
  }

  .release-identity strong {
    font-size: 14px;
  }

  .release-identity small {
    grid-column: 2;
  }

  .recommended-download {
    position: relative;
    min-height: 330px;
    padding: 38px;
    border: 2px solid var(--ink);
    background: var(--paper-raised);
    box-shadow: 14px 14px 0 var(--cobalt-wash);
  }

  .recommended-download::after {
    content: attr(data-platform);
    position: absolute;
    top: 18px;
    right: 18px;
    font-family: var(--mono);
    font-size: 10px;
    text-transform: uppercase;
  }

  .recommended-download h2 {
    max-width: 450px;
    margin: 42px 0 18px;
    font-family: var(--display);
    font-size: 42px;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .recommended-download > p:not(.eyebrow) {
    color: var(--muted);
  }

  .recommended-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .download-section {
    padding-bottom: 86px;
  }

  .download-section .landing-band-header h2,
  .verify-download h2 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(44px, 4.1vw, 66px);
    line-height: 0.96;
    letter-spacing: -0.055em;
  }

  .download-platform-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 44px;
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .download-platform-grid > article {
    min-height: 390px;
    padding: 28px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    background: var(--paper-raised);
  }

  .download-platform-grid > article:nth-child(2) {
    background: var(--cobalt-wash);
  }

  .platform-index {
    color: var(--cobalt);
    font-family: var(--mono);
    font-size: 11px;
  }

  .platform-title {
    margin: 42px 0 18px;
  }

  .platform-title h3,
  .cli-downloads h3 {
    margin: 0;
    font-family: var(--display);
    font-size: 38px;
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .platform-title p {
    margin: 8px 0 0;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 11px;
  }

  .asset-list {
    border-top: 1px solid var(--ink);
  }

  .asset-loading {
    color: var(--muted);
    font-size: 13px;
  }

  :global(.asset-row) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    min-height: 62px;
    border-bottom: 1px solid var(--rule-strong);
    text-decoration: none;
  }

  :global(.asset-row:hover) {
    color: var(--cobalt);
  }

  :global(.asset-row > span) {
    display: grid;
    gap: 2px;
  }

  :global(.asset-row > span:last-child) {
    justify-items: end;
    flex: 0 0 auto;
  }

  :global(.asset-row strong),
  :global(.asset-row b) {
    font-size: 12px;
  }

  :global(.asset-row small) {
    color: var(--muted);
    font-family: var(--mono);
    font-size: 10px;
  }

  .cli-section {
    background: var(--ink);
    color: var(--paper-raised);
    padding-right: 44px;
    padding-left: 44px;
  }

  .cli-section .section-lead,
  .cli-section :global(.asset-row small) {
    color: #aaa99f;
  }

  .cli-downloads {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 42px;
  }

  .cli-downloads article {
    min-width: 0;
  }

  .cli-downloads h3 {
    margin-bottom: 18px;
    font-size: 30px;
  }

  .cli-downloads :global(.asset-row) {
    color: var(--paper-raised);
    border-color: #55574f;
  }

  .verify-download {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 72px;
    background: var(--clay-wash);
  }

  .verify-download .section-lead {
    margin-top: 0;
    color: #47352d;
  }

  .download-error {
    margin-top: 34px;
    padding: 28px;
    border: 2px solid var(--clay);
    background: var(--clay-wash);
  }

  .download-error strong {
    font-family: var(--display);
    font-size: 28px;
  }

  @media (max-width: 1099px) {
    :global(body.public-site-body) {
      min-width: 0;
    }

    :global(.public-header),
    .download-page,
    :global(.public-footer) {
      width: calc(100% - 32px);
    }

    :global(.public-header) {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 12px 20px;
      min-height: 0;
      padding: 14px 0 0;
    }

    :global(.public-brand) {
      grid-column: 1;
      grid-row: 1;
    }

    :global(.language-switch) {
      grid-column: 2;
      grid-row: 1;
    }

    :global(.public-nav) {
      grid-column: 1 / -1;
      grid-row: 2;
      flex-wrap: wrap;
      gap: 10px 20px;
      min-width: 0;
      max-width: 100%;
      padding: 4px 0 16px;
    }

    :global(.public-nav a) {
      flex: 0 0 auto;
      white-space: nowrap;
    }

    :global(.public-nav a::after) {
      bottom: -4px;
    }

    .download-page {
      padding-bottom: 56px;
    }

    .download-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      min-height: 0;
      padding: 48px 0 58px;
    }

    .download-hero h1 {
      font-size: clamp(46px, 15vw, 64px);
      line-height: 0.94;
    }

    .release-identity {
      min-width: 0;
      margin-top: 28px;
    }

    .release-identity strong,
    .release-identity small {
      min-width: 0;
      overflow-wrap: anywhere;
    }

    .recommended-download {
      min-height: 0;
      padding: 26px;
      box-shadow: 8px 8px 0 var(--cobalt-wash);
    }

    .recommended-download h2 {
      margin: 38px 0 16px;
      font-size: 36px;
    }

    .recommended-actions {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }

    .recommended-actions :global(a) {
      width: 100%;
    }

    .download-section {
