---
import Default from '@astrojs/starlight/components/Hero.astro';
import Lander from './Lander.astro';

const { data, slug } = Astro.locals.starlightRoute.entry;
const isLandingPage = Boolean(data.hero) && (slug === "" || slug === "zh-cn");
---

{ isLandingPage
  ? <Lander {...Astro.props} />
  : <Default {...Astro.props}><slot /></Default>
}
