---
import Default from '@astrojs/starlight/components/Hero.astro';
import Lander from './Lander.astro';

const { data, id } = Astro.locals.starlightRoute.entry;
const isLandingPage = Boolean(data.hero) && (id === "" || id === "zh-cn");
---

{ isLandingPage
  ? <Lander {...Astro.props} />
  : <Default {...Astro.props}><slot /></Default>
}
