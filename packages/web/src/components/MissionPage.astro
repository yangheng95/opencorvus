---
import PublicSiteLayout from "./PublicSiteLayout.astro"
import { publicPath, type PublicLocale } from "../content/public-market"

const { locale } = Astro.props as { locale: PublicLocale }
const copy =
  locale === "zh-cn"
    ? {
        title: "Mission 如何运行长程任务 · OpenCorvus",
        description: "了解 OpenCorvus 如何用固定专家团的 Task、带类型交接、证据与恢复机制协调长程目标。",
        languageHref: publicPath("root", "/mission/"),
        eyebrow: "Mission",
        heading: "把一个长程目标拆成责任清晰、可审查的任务链。",
        lead: "Mission 协调结果，但它不是一个更大的 Agent。每个子任务固定拥有一个精确版本的专家团与工作流，任务依赖、消息、产物、证据和生命周期决策都保持可见。",
        ownsEyebrow: "Mission 负责什么",
        ownsHeading: "协调与执行保持分离。",
        ownsLead: "Mission 负责目标与依赖图；具体工作、能力投影与证据仍归属于各自真实责任方。",
        owners: [
          ["Mission", "目标与依赖", "跨子任务协调目标，并记录它们的依赖图。"],
          ["Task", "一项有明确归属的交付", "负责一项项目范围内的交付、一个固定专家团版本、已选工作流、相关 Session 与生命周期决策。"],
          ["Expert Squad", "角色与能力投影", "提供具名 Agent、指令、Skills、工具、MCP 访问、选择说明与已声明工作流。"],
          ["Artifact 与证据", "精确、可审查的交接", "带类型的 Artifact 携带来源与精确引用；Host observation 独立于 Agent 总结记录文件与命令事实。"],
        ],
        worksEyebrow: "如何运行",
        worksHeading: "Mission 通过责任明确的任务推进，而不是依赖一个无限延长的 Agent 回合。",
        worksLead: "每次流转都保留任务边界、已选能力身份，以及下一次决策所依据的证据。",
        stages: [
          ["定义目标", "记录所需结果、任务边界与验收条件。"],
          ["拆分责任明确的任务", "只有当交付可以独立负责、验收、重试或被依赖时，才拆成独立任务。"],
          ["持有专家团身份", "Mission 启动时记录可使用的专家团 ID；之后新安装的能力不会静默扩大这一集合。"],
          ["冻结每个任务的版本", "创建子任务时，一个获准的专家团 ID 会为该任务解析并固定到一个精确能力包版本及已选工作流。"],
          ["运行任务内协作", "具名角色流式产生消息与工具工作，再交接带类型的 Artifact 引用与可见证据。"],
          ["读取证据并决策", "Mission 读取已终止子任务的输出，并通过显式验收、重试、重规划或依赖任务路径继续。"],
        ],
        longEyebrow: "为什么能做长程任务",
        longHeading: "长程能力来自持久边界与证据。",
        longLead: "这些机制让多个 Session 与任务保持连续，但不承诺必然自治或必然高质量。",
        reasons: [
          ["持久组织", "Mission 与 Task 状态持久保存，版本化目标与验收契约保留正在交付和判断的内容。"],
          ["固定任务权限", "一个精确版本的专家团及已选工作流在任务生命周期内保持固定。"],
          ["带证据的交接", "带类型的 Artifact 引用、来源、完整读取与 Host observation 让后续工作检查决策的精确依据。"],
          ["显式恢复", "重试与重规划保留已接受输入和执行历史，而不是用自动重放掩盖失败。"],
        ],
        boundaryEyebrow: "真实边界",
        boundaryHeading: "长程运行不等于无限执行或永久无人值守。",
        boundaryBody:
          "无人值守工作只会在本地或托管 OpenCorvus 运行时在线期间继续。输出质量取决于所选模型、可访问来源、已安装能力与可用证据。外部影响仍受权限规则约束。任务不能在生命周期中静默切换专家团，Mission 协调也不会抹去 Task 或 Agent 的责任归属。",
        reference: "阅读 Mission 与 Task 参考",
        market: "探索专家团",
      }
    : {
        title: "How Missions run long-horizon work · OpenCorvus",
        description: "How OpenCorvus coordinates fixed-squad Tasks, typed handoffs, evidence, and recovery across a long-horizon outcome.",
        languageHref: publicPath("zh-cn", "/mission/"),
        eyebrow: "Mission",
        heading: "Turn one long-horizon outcome into a chain of owned, reviewable Tasks.",
        lead: "Mission coordinates the outcome; it is not a larger Agent. Each child Task owns one exact Expert Squad and workflow, while dependencies, messages, Artifacts, evidence, and lifecycle decisions remain visible.",
        ownsEyebrow: "What Mission owns",
        ownsHeading: "Coordination stays separate from execution.",
        ownsLead: "Mission owns the outcome and the dependency graph. The work, capability projection, and evidence remain with their real owners.",
        owners: [
          ["Mission", "Outcome and dependencies", "Coordinates the outcome across child Tasks and records their dependency graph."],
          ["Task", "One owned delivery", "Owns one project-scoped delivery, one fixed Expert Squad revision, any selected workflow, its Sessions, and lifecycle decisions."],
          ["Expert Squad", "Roles and capability projection", "Supplies named Agents, instructions, Skills, tools, MCP access, selection guidance, and any declared workflow."],
          ["Artifacts and evidence", "Exact, reviewable handoffs", "Typed Artifacts carry provenance and exact references; host observations record file and command facts independently of Agent summaries."],
        ],
        worksEyebrow: "How it works",
        worksHeading: "A Mission advances through owned Tasks, not one endless Agent turn.",
        worksLead: "Every transition preserves the Task boundary, selected capability identity, and evidence used for the next decision.",
        stages: [
          ["Define the outcome", "Record the requested outcome, boundaries, and acceptance conditions."],
          ["Split owned Tasks", "Create separate Tasks only where a delivery can be independently owned, accepted, retried, or depended on."],
          ["Hold Squad identities", "At launch, Mission records the Expert Squad IDs it may use; later installs do not silently widen that set."],
          ["Freeze each Task revision", "When a child Task is created, one allowed Squad ID resolves to one exact package revision and any selected workflow for that Task."],
          ["Run Task-local collaboration", "Named roles stream messages and tool work, then hand off typed Artifact references and visible evidence."],
          ["Read evidence and decide", "Mission reads terminal child outputs and uses explicit acceptance, retry, replan, or dependent-Task paths."],
        ],
        longEyebrow: "Why it can run long",
        longHeading: "Long-horizon work comes from durable boundaries and evidence.",
        longLead: "These mechanisms preserve continuity across many Sessions and Tasks; they do not promise guaranteed autonomy or quality.",
        reasons: [
          ["Durable organization", "Mission and Task state persist, while versioned goal and acceptance contracts preserve what is being delivered and judged."],
          ["Fixed Task authority", "One exact Expert Squad revision and any selected workflow remain fixed for the Task lifecycle."],
          ["Evidence-carrying handoffs", "Typed Artifact references, provenance, complete reads, and host observations let later work inspect the exact basis for a decision."],
          ["Explicit recovery", "Retry and replan preserve accepted inputs and execution history instead of hiding failure behind an automatic replay."],
        ],
        boundaryEyebrow: "The real boundary",
        boundaryHeading: "Long-running does not mean unlimited or unattended forever.",
        boundaryBody:
          "Unattended work runs only while the local or hosted OpenCorvus runtime is online. Output quality depends on selected models, reachable sources, installed capabilities, and available evidence. Permission rules still govern external effects. A Task cannot silently switch Expert Squads mid-lifecycle, and Mission coordination never erases Task or Agent ownership.",
        reference: "Read the Mission and Task reference",
        market: "Explore Expert Squads",
      }
---

<PublicSiteLayout
  {locale}
  current="mission"
  title={copy.title}
  description={copy.description}
  languageHref={copy.languageHref}
>
  <main id="main-content" class="public-main mission-page">
    <section class="utility-intro mission-intro" aria-labelledby="mission-page-title">
      <div><p class="eyebrow">{copy.eyebrow}</p><h1 id="mission-page-title">{copy.heading}</h1></div>
      <p class="section-lead">{copy.lead}</p>
    </section>

    <section class="utility-section" aria-labelledby="mission-owns-title">
      <div class="landing-band-header">
        <div><p class="eyebrow">{copy.ownsEyebrow}</p><h2 id="mission-owns-title">{copy.ownsHeading}</h2></div>
        <p class="section-lead">{copy.ownsLead}</p>
      </div>
      <div class="mission-owner-grid">
        {copy.owners.map(([title, scope, description]) => (
          <article><h3>{title}</h3><strong>{scope}</strong><p>{description}</p></article>
        ))}
      </div>
    </section>

    <section class="utility-section" aria-labelledby="mission-flow-title">
      <div class="landing-band-header">
        <div><p class="eyebrow">{copy.worksEyebrow}</p><h2 id="mission-flow-title">{copy.worksHeading}</h2></div>
        <p class="section-lead">{copy.worksLead}</p>
      </div>
      <ol class="mission-chain">
        {copy.stages.map(([title, description], index) => (
          <li><span class="chain-number">0{index + 1}</span><h3>{title}</h3><p>{description}</p></li>
        ))}
      </ol>
    </section>

    <section class="utility-section" aria-labelledby="mission-long-title">
      <div class="landing-band-header">
        <div><p class="eyebrow">{copy.longEyebrow}</p><h2 id="mission-long-title">{copy.longHeading}</h2></div>
        <p class="section-lead">{copy.longLead}</p>
      </div>
      <div class="state-grid mission-reason-grid">
        {copy.reasons.map(([title, description], index) => (
          <article><span class="reason-index">0{index + 1}</span><h3>{title}</h3><p>{description}</p></article>
        ))}
      </div>
    </section>

    <section class="utility-section mission-boundary" aria-labelledby="mission-boundary-title">
      <div>
        <p class="eyebrow">{copy.boundaryEyebrow}</p>
        <h2 id="mission-boundary-title">{copy.boundaryHeading}</h2>
      </div>
      <div>
        <p class="section-lead">{copy.boundaryBody}</p>
        <div class="hero-actions">
          <a class="primary-action" href={publicPath(locale, "/reference/mission-task/")}>{copy.reference}</a>
          <a class="secondary-action" href={publicPath(locale, "/market/")}>{copy.market}</a>
        </div>
      </div>
    </section>
  </main>
</PublicSiteLayout>

<style>
  .mission-intro::after {
    content: "MISSION / TASK / SQUAD";
  }

  .mission-owner-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: 42px;
    border-top: 2px solid var(--ink);
    border-left: 2px solid var(--ink);
  }

  .mission-owner-grid article {
    min-height: 260px;
    padding: 26px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
  }

  .mission-owner-grid article:nth-child(even) {
    background: var(--cobalt-wash);
  }

  .mission-owner-grid h3 {
    margin: 0 0 30px;
    font-family: var(--display);
    font-size: 32px;
    line-height: 1;
  }

  .mission-owner-grid strong {
    display: block;
    min-height: 42px;
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  .mission-owner-grid p {
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 14px;
  }

  .mission-chain {
    margin: 42px 0 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--ink);
  }

  .mission-chain li {
    display: grid;
    grid-template-columns: 72px 0.8fr 1.4fr;
    gap: 28px;
    min-height: 108px;
    padding: 25px 22px;
    border-right: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    border-left: 1px solid var(--ink);
  }

  .mission-chain li:nth-child(even) {
    background: var(--cobalt-wash);
  }

  .mission-chain h3,
  .mission-chain p {
    margin: 0;
  }

  .mission-chain h3 {
    font-size: 17px;
  }

  .mission-chain p {
    color: var(--muted);
    font-size: 14px;
  }

  .mission-reason-grid {
    grid-template-columns: repeat(4, 1fr);
    margin-top: 42px;
  }

  .mission-reason-grid article {
    min-height: 230px;
  }

  .reason-index {
    display: block;
    margin-bottom: 26px;
    color: var(--cobalt);
    font-family: var(--mono);
    font-size: 12px;
  }

  .mission-boundary {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 72px;
    padding: 72px 64px;
    background: var(--clay-wash);
  }

  .mission-boundary .section-lead {
    margin: 0;
    color: #47352d;
  }
</style>
