        "source-planned-execution-verification": {
          "label": "Source Planning, Execution, and Independent Verification",
          "description": "Classify traceable source authority and applicable constraints through a bounded minimal-anchor worklist, execute each irreversible mutation whose real prerequisites are resolved, then independently verify the classification and settled outcome.",
          "nodes": {
            "base-planner": {
              "agent_id": "base-planner",
              "description": "Separates execution-authority conditions, applicable constraints, and Developer-owned outcome semantics and destination execution dependencies; resolves traceable source obligations through a bounded minimal-anchor worklist before mutation.",
              "depends_on": []
            },
            "base-developer": {
              "agent_id": "base-developer",
              "description": "Reconciles per-operation source classes with original authority, owns destination discovery for operations whose real prerequisites are resolved, performs the authorized mutation, and hands off the complete Host-recorded receipt.",
              "depends_on": [
                "base-planner"
              ]
            },
            "base-tester": {
              "agent_id": "base-tester",
              "description": "Independently checks source classifications and coordinates against original authority, then maps applicable rules and outcome semantics to the raw mutation receipt and any correct same-record destination read.",
              "depends_on": [
                "base-developer"
              ]
            }
          }
        },
        "planner-parallel-delivery": {
          "label": "Planner, Parallel Workers, and Verification",
          "description": "Publish one bounded Task plan, run the research and implementation partitions in the same dependency-ready frontier, then verify the settled result.",
          "nodes": {
            "base-planner": {
              "agent_id": "base-planner",
              "description": "Publishes the complete Task-element inventory, stable acceptance criteria, shared inputs, owned paths, and acceptance allocation.",
              "depends_on": []
            },
            "base-researcher": {
              "agent_id": "base-researcher",
              "description": "Executes the plan's evidence and repository research partition.",
              "depends_on": [
                "base-planner"
              ]
            },
            "base-developer": {
              "agent_id": "base-developer",
              "description": "Executes the plan's implementation partition and its implementation-owned checks.",
              "depends_on": [
                "base-planner"
              ]
            },
            "base-tester": {
              "agent_id": "base-tester",
              "description": "Executes every planned acceptance criterion against the settled result and records criterion-by-criterion evidence.",
              "depends_on": [
                "base-developer"
              ]
            }
          }
        }
