import { batch, createEffect, createSignal, onCleanup, onMount, untrack } from "solid-js"
import { createMarkdownRenderer } from "../services/markdown-render"
import { localeTag } from "../utils/i18n"
import { appStore } from "../store/app"
import { cardTreeStore } from "../store/card-tree"
import { boardStore } from "../store/board"
import { AppLog } from "../utils/log"

export type MarkdownLifetimeObservationContext = { partID: string; messageID: string; sessionID: string }

/** Temporary lifecycle metadata collector; callers protect and untrack every read. */
export function markdownElementLifetimeSnapshot(element: HTMLElement | undefined) {
  const main = element?.closest<HTMLElement>("#chatScroll")
  const child = element?.closest<HTMLElement>('[data-ui="subagent-conversation-scroll"]')
  const scroller = child ?? main
  const rect = element?.getBoundingClientRect()
  const scrollRect = scroller?.getBoundingClientRect()
  const source = boardStore.selectedSource
  return {
    elementPresent: Boolean(element),
    connected: element?.isConnected ?? null,
    tag: element?.tagName ?? null,
    dockID: element?.closest("#rightDock")?.id ?? null,
    dockBodyID: element?.closest("#rightDockBody")?.id ?? null,
    virtualItemID: element?.closest(".conversation-virtual-item")?.getAttribute("data-virtual-card-id") ?? null,
    cardID: element?.closest("[data-card-id]")?.getAttribute("data-card-id") ?? null,
    childScroll: Boolean(child),
    mainScroll: Boolean(main),
    rect: rect ? { top: rect.top, bottom: rect.bottom, height: rect.height } : null,
    scroll: scroller && scrollRect ? {
      id: scroller.id || null,
      child: Boolean(child),
      top: scrollRect.top,
      bottom: scrollRect.bottom,
      scrollTop: scroller.scrollTop,
      clientHeight: scroller.clientHeight,
      scrollHeight: scroller.scrollHeight,
    } : null,
    intersectsScroll: element?.isConnected && rect && scrollRect
      ? rect.bottom > scrollRect.top && rect.top < scrollRect.bottom
      : null,
    viewport: { width: window.innerWidth, height: window.innerHeight },
    treeEpoch: cardTreeStore.treeEpoch,
    treeReplacementCause: cardTreeStore.treeReplacementCause,
    selectedSource: source ? { kind: source.kind, id: source.id } : null,
  }
}

export const STREAMING_ACTIVE_TEXT_LIMIT = 12_000

export function visibleStreamingText(text: string, limit = STREAMING_ACTIVE_TEXT_LIMIT): string {
  const source = String(text || "")
  const n = Math.max(0, Math.floor(Number(limit) || 0))
  return source.length <= n ? source : `... ${source.slice(-n)}`
}

/** Parse/highlight off-thread; commit bounded batches after browser paints.
 * Frozen HTML strings retain their Solid For identity across updates. */
export function createStreamingTextPartModel(props: {
  text: string
  streaming?: boolean
  observation?: MarkdownLifetimeObservationContext
  observationElement?: () => HTMLElement | undefined
}) {
  const [frozenHtml, setFrozenHtml] = createSignal<string[]>([])
  const [activeText, setActiveText] = createSignal("")
  const [pending, setPending] = createSignal(false)
  const [error, setError] = createSignal("")
  let revision = 0
  let requestFrame = 0
  let mountFrame = 0
  let target: string[] = []
  let complete = false
  let receivedRevision = 0
  let disposed = false
  let latestText = ""
  let latestLocale = ""
  let latestLocaleSeq = -1
  let latestStreaming = false
  const constructedAt = new Date().toISOString()
  let mountedTuple: MarkdownLifetimeObservationContext | null = null
  let mountedElement: ReturnType<typeof markdownElementLifetimeSnapshot> | null = null
  const observe = (phase: "mount" | "cleanup") => {
    untrack(() => {
      try {
        const value = props.observation
        if (
          !value ||
          ![value.partID, value.messageID, value.sessionID].every((id) => typeof id === "string" && id.trim().length > 0)
        ) return
        const tuple = { partID: value.partID, messageID: value.messageID, sessionID: value.sessionID }
        const element = markdownElementLifetimeSnapshot(props.observationElement?.())
        if (phase === "mount") {
          mountedTuple = tuple
          mountedElement = element
        }
        AppLog.debug("markdown-viewport-lifetime-observation", phase, {
          observedAt: new Date().toISOString(),
          constructedAt,
          mountedTuple,
          currentTuple: tuple,
          mountedElement,
          currentElement: element,
          revision,
          receivedRevision,
          textLength: latestText.length,
          streaming: latestStreaming,
          localeSeq: latestLocaleSeq,
          frozenCount: frozenHtml().length,
          activeLength: activeText().length,
          pending: pending(),
          error: Boolean(error()),
          renderingState: pending() && frozenHtml().length === 0 && !activeText(),
        })
      } catch {
        // Temporary observation has no Markdown execution authority.
      }
    })
  }
  onMount(() => observe("mount"))

  const mount = () => {
    mountFrame = 0
    if (disposed) return
    const current = frozenHtml()
    let prefix = 0
    while (prefix < current.length && prefix < target.length && current[prefix] === target[prefix]) prefix++
    const next = current.slice(0, prefix)
    const deadline = performance.now() + 4
    for (let index = prefix; index < target.length && index < prefix + 16; index++) {
      next.push(target[index])
      setFrozenHtml(next.slice())
      if (performance.now() >= deadline) break
    }
    if (complete && prefix === target.length && current.length !== target.length) setFrozenHtml(target.slice())
    if (frozenHtml().length < target.length) mountFrame = requestAnimationFrame(mount)
    else if (complete) setPending(false)
  }
  const renderer = createMarkdownRenderer((reply, request) => {
    if (disposed) return
    const currentSource =
      request.locale === latestLocale &&
      request.localeSeq === latestLocaleSeq &&
      latestText.startsWith(request.text) &&
      request.streaming === latestStreaming
    if (reply.revision !== -1 && !currentSource) return
    if (reply.error) {
      setError(reply.error)
      setPending(false)
      return
    }
    // Older append-only snapshots still contain valid completed blocks. Keep
    // displaying them while the coalesced latest request finishes off-thread.
    setError("")
    if (receivedRevision !== reply.revision) {
      target = []
      receivedRevision = reply.revision
    }
    target.splice(reply.start, target.length - reply.start, ...reply.html)
    complete = reply.done && reply.revision === revision
    setActiveText(visibleStreamingText(reply.activeText))
    if (!mountFrame) mountFrame = requestAnimationFrame(mount)
  })

  createEffect(() => {
    const text = props.text || ""
    const streaming = props.streaming === true
    const localeSeq = appStore.localeSeq
    const locale = localeTag()
    if (
      text === latestText &&
      streaming === latestStreaming &&
      locale === latestLocale &&
      localeSeq === latestLocaleSeq
    )
      return
    latestLocale = locale
    latestLocaleSeq = localeSeq
    latestStreaming = streaming
    const append = text.startsWith(latestText)
    latestText = text
    revision++
    complete = false
    if (requestFrame) cancelAnimationFrame(requestFrame)
    if (!append && mountFrame) {
      cancelAnimationFrame(mountFrame)
      mountFrame = 0
    }
    batch(() => {
      setPending(Boolean(text))
      setError("")
      if (!text) {
        target = []
        setFrozenHtml([])
        setActiveText("")
      }
    })
    requestFrame = requestAnimationFrame(() => {
      requestFrame = 0
      try {
        renderer.render(text, streaming, revision, localeSeq)
      } catch (reason) {
        setError(String(reason))
        setPending(false)
      }
    })
  })

  onCleanup(() => {
    observe("cleanup")
    disposed = true
    cancelAnimationFrame(requestFrame)
    cancelAnimationFrame(mountFrame)
    renderer.dispose()
  })
  return { frozenHtml, activeText, pending, error }
}
