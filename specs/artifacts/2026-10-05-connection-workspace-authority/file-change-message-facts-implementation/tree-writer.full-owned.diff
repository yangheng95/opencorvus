+        time: message.time,
+        acceptedInputMessageIDs: message.acceptedInputMessageIDs ? [...message.acceptedInputMessageIDs] : undefined,
+        completed: message.completed,
+        finish: message.finish,
+        hasError: message.hasError,
+        stepParts: message.stepParts?.map((part) => ({ ...part })),
+        toolParts: message.toolParts?.map((part) => ({ ...part })),
+      })
+    }
+  }
+  return result
+}
