+function validateIncomingFullMessage(info: any, parts: any[], admittedSourceSessionID?: string): void {
+  const id = String(info?.id || ""), sessionID = String(info?.sessionID || "")
+  if (!id || !sessionID || !Array.isArray(parts)) throw new Error("Full Message replay missing actual identity or Parts bundle")
+  const origin = requireMessageOrigin(info, id)
+  requireCanonicalMessageAgentID(info.agentID, origin, id)
+  if (!String(info.sessionAgentID || "").trim() || typeof info.role !== "string" || !info.role || typeof info.resolvedRole !== "string" || !info.resolvedRole) {
+    throw new Error(`Full Message replay ${id} missing canonical actor or role`)
+  }
+  if (typeof info.time?.created !== "number" || !Number.isFinite(info.time.created) || info.time.created <= 0) throw new Error(`Full Message replay ${id} missing actual created time`)
+  requireTimelineOrderKeyDomain(info.orderKey, `Full Message replay ${id}`, "message")
+  const ids = new Set<string>()
+  for (const part of parts) {
+    if (!part || typeof part.id !== "string" || !part.id || part.messageID !== id || part.sessionID !== sessionID) throw new Error(`Full Message replay ${id} Part ownership mismatch`)
+    if (ids.has(part.id)) throw new Error(`Full Message replay ${id} duplicate Part ${part.id}`)
+    ids.add(part.id)
+    requireTimelineOrderKeyDomain(part.orderKey, `Full Message replay Part ${part.id}`, "part")
+  }
+  replaceActualPartFacts({ id, sessionID }, parts)
+  const existing = messages.get(id) ?? pendingPartFirstMessages.get(id)
+  if (!existing) return
+  if (existing.sessionID !== sessionID && existing.sessionID !== admittedSourceSessionID) throw new Error(`Full Message replay ${id} current Session owner mismatch`)
+  if (existing.orderKey !== info.orderKey) throw new Error(`Full Message replay ${id} current orderKey mismatch`)
+  const session = requireSessionProjection(existing.sessionID, "Full Message replay")
+  if (messages.has(id) && !session.messageIDs.has(id)) throw new Error(`Full Message replay ${id} current membership mismatch`)
+  const cardID = session.messageCardIDs.get(id)
+  if (!cardID && !existing.metadataOnly) throw new Error(`Full Message replay ${id} current display owner missing`)
+  if (cardID) {
+    const card = cardTreeStore.cards[cardID]
+    if (!card || card.sessionID !== existing.sessionID) throw new Error(`Full Message replay ${id} current Card owner mismatch`)
+    for (const part of card.parts ?? []) {
+      if (part.messageID !== id || isBoundaryMessagePart(part)) continue
+      const target = session.partIndex.get(String(part.id || ""))
+      if (!target || target.cardID !== cardID || card.parts?.[target.index]?.id !== part.id) throw new Error(`Full Message replay ${id} current Part owner mismatch`)
+    }
+  }
+}
+
+function retireIncomingFullMessage(info: any): void {
+  if (!messages.has(info.id) && !pendingPartFirstMessages.has(info.id)) return
+  handleMessageRemoved({ type: "message.removed", properties: { sessionID: info.sessionID, messageID: info.id } })
+}
