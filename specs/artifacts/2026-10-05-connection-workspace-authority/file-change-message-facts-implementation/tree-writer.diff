+/** Transient copies from the sole message owner. The collector subscribes to
+ * publishedCardTreeVersion before deriving; this getter never publishes. */
+export function projectedConversationMessageFacts(sessionIDs: readonly string[]): ProjectedMessageFacts[] {
+  const result: ProjectedMessageFacts[] = []
+  for (const sessionID of new Set(sessionIDs)) {
+    const session = sessions.get(sessionID)
+    if (!session) continue
+    for (const id of session.messageIDs) {
+      const message = messages.get(id)
+      if (!message || message.sessionID !== sessionID) continue
+      result.push({
+        id: message.id,
+        sessionID: message.sessionID,
+        sessionAgentID: message.sessionAgentID,
+        agentID: message.agentID,
+        role: message.role,
+        orderKey: message.orderKey,
+        time: message.time,
+        acceptedInputMessageIDs: message.acceptedInputMessageIDs ? [...message.acceptedInputMessageIDs] : undefined,
+        completed: message.completed,
+        finish: message.finish,
+        hasError: message.hasError,
+      })
+    }
+  }
+  return result
+}
