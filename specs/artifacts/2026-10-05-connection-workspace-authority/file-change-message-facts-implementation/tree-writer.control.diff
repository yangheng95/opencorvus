+  readonly start?: number
+  readonly end?: number
+}
+
+function retainActualPartFact(owner: Pick<MessageInfo, "id" | "sessionID" | "stepParts" | "toolParts">, part: any): void {
+  if (part.type !== "step-start" && part.type !== "step-finish" && part.type !== "tool") return
+  if (part.messageID !== owner.id || part.sessionID !== owner.sessionID || typeof part.id !== "string" || !part.id) {
+    throw new Error(`message part facts ownership mismatch for ${owner.id}`)
+  }
+  const orderKey = requireTimelineOrderKeyDomain(part.orderKey, `message part facts ${part.id}`, "part")
+  if (part.type === "tool") {
+    if (typeof part.tool !== "string" || !part.tool) throw new Error(`message Tool facts ${part.id} missing tool`)
+    const prior = owner.toolParts?.find((fact) => fact.id === part.id)
+    if (owner.stepParts?.some((fact) => fact.id === part.id)) throw new Error(`message part facts ${part.id} type drift`)
+    if (prior && (prior.orderKey !== orderKey || prior.tool !== part.tool)) throw new Error(`message part facts ${part.id} identity drift`)
+    const fact: ProjectedToolPartFacts = {
+      id: part.id, orderKey, tool: part.tool,
+      status: typeof part.state?.status === "string" ? part.state.status : undefined,
+      start: typeof part.state?.time?.start === "number" ? part.state.time.start : undefined,
+      end: typeof part.state?.time?.end === "number" ? part.state.time.end : undefined,
+    }
+    owner.toolParts = [...(owner.toolParts ?? []).filter((item) => item.id !== fact.id), fact]
+  } else {
+    if (owner.toolParts?.some((fact) => fact.id === part.id)) throw new Error(`message part facts ${part.id} type drift`)
+    const prior = owner.stepParts?.find((fact) => fact.id === part.id)
+    if (prior && (prior.orderKey !== orderKey || prior.type !== part.type)) throw new Error(`message part facts ${part.id} identity drift`)
+    const fact: ProjectedStepPartFacts = { id: part.id, orderKey, type: part.type, reason: typeof part.reason === "string" ? part.reason : undefined }
+    owner.stepParts = [...(owner.stepParts ?? []).filter((item) => item.id !== fact.id), fact]
+  }
+}
+
+function replaceActualPartFacts(owner: Pick<MessageInfo, "id" | "sessionID" | "stepParts" | "toolParts">, parts: any[]): void {
+  owner.stepParts = []
+  owner.toolParts = []
+  for (const part of parts) retainActualPartFact(owner, part)
+}
