        "source-planned-execution-verification": {
          "label": "Source Planning, Execution, and Independent Verification",
          "description": "Classify traceable source authority and applicable constraints through a bounded minimal-anchor worklist, execute each irreversible mutation whose real prerequisites are resolved, then independently verify the classification and settled outcome.",
          "nodes": {
            "base-planner": {
              "agent_id": "base-planner",
              "description": "Separates execution-authority conditions, applicable constraints, and Developer-owned outcome semantics and destination execution dependencies; resolves traceable source obligations through a bounded minimal-anchor worklist before mutation.",
              "depends_on": []
            },
            "base-developer": {
              "agent_id": "base-developer",
              "description": "Reconciles per-operation source classes with original authority, owns destination discovery for operations whose real prerequisites are resolved, performs the authorized mutation, and hands off the complete Host-recorded receipt.",
