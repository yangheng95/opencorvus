+function sourcePreview(source: ConversationSourcePart): string {
+  if (source.type === "source-url" && source.url) {
+    const title = source.title?.trim() || ""
+    try {
+      const url = new URL(source.url)
+      if (title) {
+        try {
+          if (new URL(title).href !== url.href) return title
+        } catch {
+          return title
+        }
+      }
+      return `${url.hostname}${url.pathname}${url.search}`
+    } catch {
+      return title || source.url
+    }
+  }
+  const label = sourceLabel(source)
+  return source.type === "source-file" && source.range
+    ? `${label}:${source.range.startLine}-${source.range.endLine}`
+    : label
+}
