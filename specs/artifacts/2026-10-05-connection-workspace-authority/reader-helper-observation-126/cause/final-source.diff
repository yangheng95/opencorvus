+      ? Object.getOwnPropertyDescriptor(error, "code") : undefined
+    const code = STREAM_ERROR_CODES.find((candidate) => descriptor && "value" in descriptor && descriptor.value === candidate)
+    return { origin, type, ...(code ? { code } : {}) }
+  } catch {
+    return { origin, type: "unknown" }
+  }
