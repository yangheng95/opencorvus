+      : error instanceof SyntaxError ? "SyntaxError"
+      : error instanceof ReferenceError ? "ReferenceError"
+      : error instanceof URIError ? "URIError"
+      : error instanceof EvalError ? "EvalError"
+      : error instanceof DOMException ? "DOMException"
