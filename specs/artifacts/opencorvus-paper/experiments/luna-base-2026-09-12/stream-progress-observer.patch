@@ -0,0 +1,66 @@
+import { expect, test } from "bun:test"
+import {
+  benchmarkActivitySignature,
+  advanceBenchmarkActivityWindow,
+  benchmarkSessionActivity,
+} from "../../script/benchmark/external-agent/contract"
+import { withStreamActivity } from "../../src/util/stream-activity"
+
+test("accepted stream progress renews the benchmark window before a Tool input is published", async () => {
+  const monitor = withStreamActivity({ idleMs: 1000 })
+  try {
+    const observation = () =>
+      benchmarkActivitySignature({
+        board: {},
+        transcript: [],
+        trace: [],
+        benchmarkEventCount: 0,
+        sessionActivity: benchmarkSessionActivity({
+          sessionIDs: ["worker-session"],
+          readActivity: () => ({ last_activity_at: monitor.lastActivityAt() }),
+        }),
+      })
+    const prior = observation()
+    await Bun.sleep(10)
+    monitor.observe()
+    expect(
+      advanceBenchmarkActivityWindow({
+        now: 100,
+        currentDeadline: 150,
+        inactivityMs: 100,
+        previousSignature: prior,
+        observedSignature: observation(),
+      }),
+    ).toMatchObject({ changed: true, deadline: 200 })
+  } finally {
+    monitor.dispose()
+  }
+})
+
+test("read-only observations retain the real idle timeout", async () => {
+  const monitor = withStreamActivity({ idleMs: 30 })
+  try {
+    for (let i = 0; i < 5; i++) {
+      monitor.lastActivityAt()
+      await Bun.sleep(10)
+    }
+    expect(monitor.timedOut()).toBe(true)
+    expect(monitor.signal.reason).toBeInstanceOf(DOMException)
+  } finally {
+    monitor.dispose()
+  }
+})
+
+test("samples exact Mission and child Session identities once in canonical order", () => {
+  const activity: Record<string, { last_activity_at: number }> = {
+    mission: { last_activity_at: 10 },
+    worker: { last_activity_at: 20 },
+    other_project: { last_activity_at: 999 },
+  }
+  expect(
+    benchmarkSessionActivity({ sessionIDs: ["worker", "mission", "worker"], readActivity: (id) => activity[id] }),
+  ).toEqual([
+    { session_id: "mission", last_activity_at: 10 },
+    { session_id: "worker", last_activity_at: 20 },
+  ])
+})
