diff --git a/packages/opencorvus/test/benchmark/automationbench-natural-terminal.test.ts b/packages/opencorvus/test/benchmark/automationbench-natural-terminal.test.ts
new file mode 100644
index 00000000..3922cfbc
--- /dev/null
+++ b/packages/opencorvus/test/benchmark/automationbench-natural-terminal.test.ts
@@ -0,0 +1,28 @@
+import { expect, test } from "bun:test"
+import { auditMissionOutcome, auditMissionQuiescence } from "../../script/benchmark/external-agent/contract"
+
+for (const status of ["completed", "failed"] as const) {
+  test(`accepts a naturally ${status} Task and its settled occurrences for Mission scoring`, () => {
+    const missionRecord = { missionID: "mission-1", sessionID: "mission-session", interruptible: false,
+      pendingInteractions: 0, tasks: [{ id: "task-1" }] }
+    const missionStatus = { status: "inactive", tasks: [{ taskID: "task-1", lifecycleStatus: status }] }
+    const missionTranscript = [
+      { info: { id: "user-1", sessionID: "mission-session", role: "user" }, parts: [] },
+      { info: { id: "answer-1", parentID: "user-1", sessionID: "mission-session", role: "assistant",
+        time: { completed: 100 }, finish: "stop" }, parts: [] },
+    ]
+    const taskTranscript = [{ info: { role: "assistant", sessionID: "task-session" }, parts: [{
+      type: "tool", tool: "manage_task", state: { status: "completed", input: { action: "fail_task" } },
+    }] }]
+    expect(auditMissionOutcome({ missionRecord, missionStatus, missionTranscript,
+      taskTranscripts: [{ task_id: "task-1", lifecycle_status: status, transcript: taskTranscript }] }))
+      .toMatchObject({ scored_terminal: true, mission_assistant_healthy: true,
+        child_tasks: [{ task_id: "task-1", outcome: status === "failed" ? "natural_failed" : "completed" }] })
+    expect(auditMissionQuiescence({ missionRecord, missionStatus, taskBoards: [{ task_id: "task-1",
+      board: { task: { status }, executionProjection: { occurrences: Array.from({ length: 11 }, (_, i) => ({
+        agent: i === 0 ? "orchestrator" : "worker", sessionID: `session-${i}`,
+        events: [{ status: { type: i === 0 ? "idle" : "terminal" } }],
+      })) } } }] })).toMatchObject({ passed: true, task_count: 1,
+        task_audits: [{ task_id: "task-1", lifecycle_status: status, occurrence_count: 11, unsettled_occurrences: [] }] })
+  })
+}
