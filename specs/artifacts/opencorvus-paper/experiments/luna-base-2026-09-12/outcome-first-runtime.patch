ng-input model.\",\n        \"base_role\": \"deep-research\",\n        \"prompt\": \"agents/office-source-analyst/system.md\",\n        \"inherit_base_tools\": true,\n        \"built_in_tool_ids\": [],\n        \"default_skill_refs\": [],\n        \"package_skill_refs\": [\n          \"office-delivery/shared/office-delivery-method\"\n        ],\n        \"default_tool_refs\": [],\n        \"package_tool_refs\": [],\n        \"default_mcp_server_refs\": [],\n        \"package_mcp_server_refs\": [],\n        \"default_mcp_tool_refs\": [],\n        \"package_mcp_tool_refs\": [],\n        \"default_mcp_prompt_refs\": [],\n        \"package_mcp_prompt_refs\": [],\n        \"default_mcp_resource_refs\": [],\n        \"package_mcp_resource_refs\": []\n      },\n      \"office-delivery-builder\": {\n        \"label\": \"Office Delivery Builder\",\n        \"description\": \"Builds editable deliverables and canonical exports directly from the Planner contract and original sources, then renders and inspects them.\",\n        \"base_role\": \"build\",\n        \"prompt\": \"agents/office-delivery-builder/system.md\",\n        \"inherit_base_tools\": true,\n        \"built_in_tool_ids\": [\n          \"work_artifact_inspect\",\n          \"work_artifact_author\",\n          \"work_artifact_validate\",\n          \"work_artifact_deliver\"\n        ],\n        \"default_skill_refs\": [\n          \"default/skill/work-artifacts\"\n        ],\n        \"package_skill_refs\": [\n          \"office-delivery/shared/office-delivery-method\"\n        ],\n        \"default_tool_refs\": [],\n        \"package_tool_refs\": [],\n        \"default_mcp_server_refs\": [],\n        \"package_mcp_server_refs\": [],\n        \"default_mcp_tool_refs\": [],\n        \"package_mcp_tool_refs\": [],\n        \"default_mcp_prompt_refs\": [],\n        \"package_mcp_prompt_refs\": [],\n        \"default_mcp_resource_refs\": [],\n        \"package_mcp_resource_refs\": []\n      },\n      \"office-delivery-planner\": {\n        \"label\": \"Office Delivery Planner\",\n        \"description\": \"Publishes the source boundary, document structure, formatting system, worker partition, and acceptance allocation.\",\n        \"base_role\": \"delegated-worker\",\n        \"prompt\": \"agents/office-delivery-planner/system.md\",\n        \"inherit_base_tools\": true,\n        \"built_in_tool_ids\": [],\n        \"default_skill_refs\": [],\n        \"package_skill_refs\": [\n          \"office-delivery/shared/office-delivery-method\"\n        ],\n        \"default_tool_refs\": [],\n        \"package_tool_refs\": [],\n        \"default_mcp_server_refs\": [],\n        \"package_mcp_server_refs\": [],\n        \"default_mcp_tool_refs\": [],\n        \"package_mcp_tool_refs\": [],\n        \"default_mcp_prompt_refs\": [],\n        \"package_mcp_prompt_refs\": [],\n        \"default_mcp_resource_refs\": [],\n        \"package_mcp_resource_refs\": []\n      }\n    },\n    \"virtual_workflows\": {\n      \"planned-office-delivery\": {\n        \"label\": \"Planned Parallel Office Delivery\",\n        \"description\": \"One Planner fixes the source and formatting contract before source and build workers execute in parallel; no separate visual-review Agent exists.\",\n        \"nodes\": {\n          \"office-delivery-planner\": {\n            \"agent_id\": \"office-delivery-planner\",\n            \"description\": \"Publishes the source boundary, document structure, formatting system, and acceptance allocation.\",\n            \"depends_on\": []\n          },\n          \"office-source-analyst\": {\n            \"agent_id\": \"office-source-analyst\",\n            \"description\": \"Validates source facts, citations, data, and content completeness.\",\n            \"depends_on\": [\n              \"office-delivery-planner\"\n            ]\n          },\n          \"office-delivery-builder\": {\n            \"agent_id\": \"office-delivery-builder\",\n            \"description\": \"Buil