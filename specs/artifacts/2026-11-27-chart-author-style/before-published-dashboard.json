{
  "schemaVersion": "1",
  "title": "销售核对｜背景设计复核",
  "renderer": "dashboard@1",
  "metrics": [],
  "filters": [
    {
      "id": "region",
      "label": "区域",
      "field": "区域",
      "values": [
        "华东",
        "华南"
      ]
    }
  ],
  "views": [
    {
      "id": "summary",
      "title": "当前筛选｜总订单数与净额",
      "spec": {
        "height": 40,
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "订单数"
              },
              {
                "op": "sum",
                "field": "金额",
                "as": "净额"
              }
            ]
          },
          {
            "calculate": "'总订单数：' + format(datum['订单数'], '.0f') + '    净额：' + format(datum['净额'], '.2f')",
            "as": "汇总"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 20
        },
        "encoding": {
          "text": {
            "field": "汇总"
          }
        }
      },
      "span": "full"
    },
    {
      "id": "theme-default",
      "title": "主题默认",
      "spec": {
        "height": 220,
        "encoding": {
          "x": {
            "field": "订单编号",
            "type": "nominal",
            "sort": [
              "A001",
              "A002",
              "A003",
              "A004",
              "A005"
            ],
            "title": "原始订单编号",
            "axis": {
              "labelAngle": 0
            }
          },
          "y": {
            "field": "金额",
            "type": "quantitative",
            "title": "逐单金额（未注明币种或单位）",
            "scale": {
              "zero": true
            },
            "axis": {
              "format": ".2f"
            }
          },
          "tooltip": [
            {
              "field": "订单编号",
              "type": "nominal",
              "title": "原始订单编号"
            },
            {
              "field": "区域",
              "type": "nominal"
            },
            {
              "field": "金额",
              "type": "quantitative",
              "format": ".2f"
            },
            {
              "field": "备注",
              "type": "nominal",
              "title": "原始备注"
            }
          ]
        },
        "layer": [
          {
            "mark": {
              "type": "bar"
            }
          },
          {
            "mark": {
              "type": "point",
              "filled": true,
              "size": 45
            }
          },
          {
            "mark": {
              "type": "text",
              "dy": -10
            },
            "encoding": {
              "text": {
                "field": "金额",
                "type": "quantitative",
                "format": ".2f"
              }
            }
          }
        ]
      },
      "span": "full"
    },
