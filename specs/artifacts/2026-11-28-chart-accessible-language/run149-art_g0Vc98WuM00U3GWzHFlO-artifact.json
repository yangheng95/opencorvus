        "金额": 0,
        "金额分": 0,
        "备注": "免费样品",
        "原序": 4
      },
      {
        "订单编号": "A005",
        "区域": "华南",
        "金额": 7.35,
        "金额分": 735,
        "备注": "普通订单",
        "原序": 5
      }
    ]
  },
