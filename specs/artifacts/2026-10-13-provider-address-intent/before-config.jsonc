{
  "terminal": {
    "default_profile_id": "powershell",
    "profiles": {
      "powershell": {
        "label": "Windows PowerShell",
        "command": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
          "-NoLogo"
        ],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "powershell"
      },
      "pwsh": {
        "label": "PowerShell",
        "command": "C:\\Users\\hengu\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\native\\powershell\\pwsh.exe",
        "args": [
          "-NoLogo"
        ],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "powershell"
      },
      "cmd": {
        "label": "Command Prompt",
        "command": "C:\\WINDOWS\\system32\\cmd.exe",
        "args": [],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "command-prompt"
      },
      "git-bash": {
        "label": "Git Bash",
        "command": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": [],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "bash"
      }
    }
  },
  "$schema": "https://opencorvus.ai/config.json",
  "provider": {
    "audit-invalid-endpoint": {
      "name": "audit-invalid-endpoint",
      "api": "not-a-url",
      "env": [],
      "models": {
        "audit-local-model": {
          "name": "audit-local-model",
          "tool_call": true
        }
      }
    }
  }
}