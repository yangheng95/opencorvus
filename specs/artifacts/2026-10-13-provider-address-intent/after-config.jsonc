{
  "$schema": "https://opencorvus.ai/config.json",
  "provider": {
    "audit-inherited-endpoint": {
      "name": "Inherited renamed",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "audit:latest": {
          "name": "Inherited audit model",
          "tool_call": true
        }
      }
    },
    "audit-template-endpoint": {
      "name": "Template renamed",
      "api": "https://${AUDIT_PROVIDER_HOST}/v1",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "audit:latest": {
          "name": "Template audit model",
          "tool_call": true
        }
      }
    },
    "audit-valid-endpoint": {
      "name": "audit-valid-endpoint",
      "api": "http://[::1]:17879/v1",
      "env": [],
      "models": {
        "audit-local-model": {
          "name": "audit-local-model",
          "tool_call": true
        }
      }
    },
    "audit-en-endpoint": {
      "name": "audit-en-endpoint",
      "api": "https://example.com/v1",
      "env": [],
      "models": {
        "audit-local-model": {
          "name": "audit-local-model",
          "tool_call": true
        }
      }
    }
  },
  "terminal": {
    "default_profile_id": "powershell",
    "profiles": {
      "powershell": {
        "label": "Windows PowerShell",
        "command": "C:\\WINDOWS\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
        "args": [
          "-NoLogo"
        ],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "powershell"
      },
      "pwsh": {
        "label": "PowerShell",
        "command": "C:\\Users\\hengu\\.cache\\codex-runtimes\\codex-primary-runtime\\dependencies\\native\\powershell\\pwsh.exe",
        "args": [
          "-NoLogo"
        ],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "powershell"
      },
      "cmd": {
        "label": "Command Prompt",
        "command": "C:\\WINDOWS\\system32\\cmd.exe",
        "args": [],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "command-prompt"
      },
      "git-bash": {
        "label": "Git Bash",
        "command": "C:\\Program Files\\Git\\bin\\bash.exe",
        "args": [],
        "env": {
          "TERM": "xterm-256color",
          "COLORTERM": "truecolor"
        },
        "icon": "bash"
      }
    }
  }
}