+/**
+ * An Artifact with the direct sources its publication selected. A run names its
+ * Campaign that way, and a review names the earlier reviews it supersedes.
+ */
+export type SourcedArtifact<T> = Located<T> & { sources: readonly ArtifactLocator[] }
+export type LocatedReview = SourcedArtifact<Review>
+export type LocatedRun = SourcedArtifact<RunEvidence>
+
+/**
+ * The evidence a comparison of this Campaign and Candidate consumes: every
+ * measurement of this Campaign (and, on the candidate arm, this Candidate),
+ * every run that names this Campaign and belongs to its baseline or this
+ * candidate, and every review of one of those measurements. Evidence for
+ * another candidate under the same Campaign belongs to that comparison.
+ */
+export function boundComparisonEvidence(input: {
+  campaign: Campaign
+  candidate: Candidate
+  campaignLocator: ArtifactLocator
+  candidateLocator: ArtifactLocator
+  evaluations: readonly Located<Evaluation>[]
+  runs: readonly LocatedRun[]
+  reviews: readonly LocatedReview[]
+}) {
+  const evaluations = input.evaluations.filter(
+    (located) =>
+      sameLocator(located.value.campaign_spec_locator, input.campaignLocator) &&
+      sameLocator(
+        located.value.candidate_revision_locator,
+        located.value.arm === "candidate" ? input.candidateLocator : null,
+      ),
+  )
+  const revisions = new Set([input.campaign.baseline_revision.package_digest, input.candidate.candidate_revision.package_digest])
+  const runs = input.runs.filter(
+    (located) =>
+      located.sources.some((source) => sameLocator(source, input.campaignLocator)) &&
+      revisions.has(located.value.revision_equality.installed),
+  )
+  const measured = new Set(evaluations.map((located) => JSON.stringify(located.locator)))
+  const reviews = input.reviews.filter((located) => measured.has(JSON.stringify(located.value.evaluation_result_locator)))
+  return { evaluations, runs, reviews }
+}
+
+type MergedReview = Pick<Review, "status" | "findings" | "unknowns" | "accepted_limitations">
+
+type SlotEvidence = {
+  evaluation?: Located<Evaluation>
+  run?: LocatedRun
+  review?: MergedReview
+}
+
+function catalogOrder(locator: ArtifactLocator) {
+  return locator.source === "engine_artifact" ? locator.catalog_revision : 0
+}
+
+function inCatalogOrder<T extends { locator: ArtifactLocator }>(values: readonly T[]) {
+  return values.toSorted(
+    (left, right) =>
+      catalogOrder(left.locator) - catalogOrder(right.locator) ||
+      JSON.stringify(left.locator).localeCompare(JSON.stringify(right.locator)),
+  )
 }
 
