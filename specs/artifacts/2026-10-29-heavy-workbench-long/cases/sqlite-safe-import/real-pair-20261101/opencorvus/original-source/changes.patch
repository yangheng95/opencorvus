+def test_checkpoint_lifecycle_and_nested(tmp_path):
+    db = Database(tmp_path / "checkpoints.db")
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    outer = db.create_import_checkpoint()
+    assert isinstance(outer, str) and outer
+    db["items"].insert({"id": 1})
+    inner = db.create_import_checkpoint()
+    db["items"].insert({"id": 2})
+    db.rollback_to_checkpoint(inner)
+    assert list(db["items"].rows) == [{"id": 1}]
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(inner)
+    db.cleanup_checkpoint(inner)
+    with pytest.raises(CheckpointNotFoundError):
+        db.rollback_to_checkpoint(inner)
+    child = db.create_import_checkpoint()
+    db["items"].insert({"id": 3})
+    db.commit_checkpoint(child)
+    db.rollback_to_checkpoint(outer)
+    assert not db["items"].exists()
+    for checkpoint in (outer, child):
+        with pytest.raises(CheckpointNotActiveError):
+            db.rollback_to_checkpoint(checkpoint)
+    cp = db.create_import_checkpoint()
+    db["committed"].insert({"x": 1})
+    db.commit_checkpoint(cp)
+    with Database(tmp_path / "checkpoints.db") as reopened:
+        assert list(reopened["committed"].rows) == [{"x": 1}]
+    db.disable_safe_import()
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
