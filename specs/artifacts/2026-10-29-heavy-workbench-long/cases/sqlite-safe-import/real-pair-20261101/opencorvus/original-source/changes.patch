+    table = 'odd " table'
+    db = Database(path)
+    db.enable_safe_import()
+    db.execute('CREATE TABLE "odd "" table" (n INTEGER)')
+    row_id = db.add_import_invariant(table, "n > 0")
+    assert db.validate_import_invariants(table)["valid"]  # vacuous all rows
+    aggregate = db.add_import_invariant(table, "COUNT(*) > 0")
+    assert db.validate_import_invariants(table)["failures"][0]["id"] == aggregate
+    db.close()
+    db = Database(path)
+    assert db.list_import_invariants(table) == [
+        {"id": row_id, "expression": "n > 0"},
+        {"id": aggregate, "expression": "COUNT(*) > 0"},
+    ]
+    db.remove_import_invariant("wrong table", aggregate)
+    assert len(db.list_import_invariants(table)) == 2
+    db.remove_import_invariant(table, aggregate)
+    assert db.safe_bulk_insert(table, [{"n": 2}]) == {"success": True}
+    db.disable_safe_import()
+    assert len(db.list_import_invariants(table)) == 1
