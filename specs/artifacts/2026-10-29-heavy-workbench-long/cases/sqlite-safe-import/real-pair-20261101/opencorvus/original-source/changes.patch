+def _safe_database(path):
+    db = sqlite_utils.Database(path)
+    _register_db_for_cleanup(db)
+    return db
+
+
+@cli.command(name="enable-safe-import")
+@click.argument("path", type=click.Path(dir_okay=False))
+def enable_safe_import(path):
+    """Enable safe imports for this database (persistent across connections)."""
+    _safe_database(path).enable_safe_import()
+    click.echo("Safe import enabled")
+
+
+@cli.command(name="disable-safe-import")
+@click.argument("path", type=click.Path(dir_okay=False))
+def disable_safe_import(path):
+    """Disable safe imports without deleting registered invariants."""
+    _safe_database(path).disable_safe_import()
+    click.echo("Safe import disabled")
+
+
+@cli.command(name="add-import-invariant")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+@click.argument("sql")
+def add_import_invariant(path, table, sql):
+    """Register an SQL invariant for TABLE and print its ID."""
+    click.echo(_safe_database(path).add_import_invariant(table, sql))
+
+
+@cli.command(name="remove-import-invariant")
+@click.argument("path", type=click.Path(dir_okay=False))
+@click.argument("table")
+@click.argument("invariant_id")
+def remove_import_invariant(path, table, invariant_id):
+    """Remove an invariant by its textual ID."""
+    _safe_database(path).remove_import_invariant(table, invariant_id)
