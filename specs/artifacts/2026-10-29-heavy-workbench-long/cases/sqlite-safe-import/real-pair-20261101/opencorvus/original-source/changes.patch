+
+def state(db):
+    """Independent state oracle: complete schema SQL and all user table rows."""
+    schema = list(
+        db.execute(
+            "SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY type, name"
+        )
+    )
+    rows = {}
+    for name in db.table_names():
+        quoted = '"' + name.replace('"', '""') + '"'
+        rows[name] = list(db.execute("SELECT * FROM " + quoted))
+    return schema, rows
+
