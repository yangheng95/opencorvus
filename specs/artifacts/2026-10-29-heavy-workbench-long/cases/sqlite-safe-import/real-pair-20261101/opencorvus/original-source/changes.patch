+@pytest.mark.parametrize("strict", [False, True])
+@pytest.mark.parametrize("operation", ["insert", "upsert", "json", "csv"])
+def test_safe_operations_rollback_and_success(tmp_path, operation, strict):
+    db = Database(tmp_path / "atomic.db")
+    db.enable_safe_import()
+    db["items"].insert({"id": 1, "n": 5}, pk="id")
+    invariant = db.add_import_invariant("items", "CAST(n AS INTEGER) >= 0")
+    before = state(db)
+
+    def run(n):
+        records = [{"id": 1 if operation == "upsert" else 2, "n": n, "added": "new"}]
+        kwargs = dict(strict=strict, alter=True, batch_size=1)
+        if operation == "insert":
+            return db.safe_bulk_insert("items", records, **kwargs)
+        if operation == "upsert":
+            return db.safe_bulk_upsert("items", records, pk="id", **kwargs)
+        if operation == "json":
+            return db.import_json(
+                "items", json.dumps(records), safe_mode=True, **kwargs
+            )
+        return db.import_csv(
+            "items",
+            io.StringIO("id,n,added\n2,{},new\n".format(n)),
+            safe_mode=True,
+            **kwargs,
+        )
+
+    if strict:
+        with pytest.raises(ImportInvariantError, match="validation"):
+            run(-1)
+    else:
+        result = run(-1)
+        assert result["success"] is False
+        assert isinstance(result["checkpoint_id"], str) and result["checkpoint_id"]
+        assert result["failures"][0]["id"] == invariant
+        assert "validation" in result["error_report"]
+    assert state(db) == before
+    assert run(8) == {"success": True}
+    assert "added" in db["items"].columns_dict
+
