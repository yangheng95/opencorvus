+def snapshot(db):
+    return {
+        "schema": list(db.query("SELECT type, name, tbl_name, sql FROM sqlite_master ORDER BY type, name")),
+        "rows": {name: list(db[name].rows) for name in db.table_names()},
+    }
+
+
+def test_checkpoint_lifecycle_and_persistence(tmp_path):
+    path = tmp_path / "lifecycle.db"
+    db = Database(path)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    db.enable_safe_import()
+    db.close()
+    db = Database(path)
+    outer = db.create_import_checkpoint()
+    assert isinstance(outer, str) and len(outer) > 0
+    db["items"].insert({"id": 1}, pk="id")
+    inner = db.create_import_checkpoint()
+    db["items"].insert({"id": 2})
+    db.rollback_to_checkpoint(inner)
+    assert list(db["items"].rows) == [{"id": 1}]
+    for action in (db.commit_checkpoint, db.rollback_to_checkpoint):
+        with pytest.raises(CheckpointNotActiveError):
+            action(inner)
+    db.cleanup_checkpoint(inner)
+    with pytest.raises(CheckpointNotFoundError):
+        db.commit_checkpoint(inner)
+    db.commit_checkpoint(outer)
+    with pytest.raises(CheckpointNotActiveError):
+        db.rollback_to_checkpoint(outer)
+    db.close()
+    db = Database(path)
+    assert list(db["items"].rows) == [{"id": 1}]
+    db.disable_safe_import()
+    db.close()
+    db = Database(path)
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    with pytest.raises(CheckpointNotFoundError):
+        db.cleanup_checkpoint("unknown")
+
+
+@pytest.mark.parametrize("finalize", ["commit_checkpoint", "rollback_to_checkpoint", "cleanup_checkpoint", "disable_safe_import"])
+def test_ancestor_finalizes_children(finalize):
+    db = Database(memory=True)
+    db.enable_safe_import()
+    db["t"].insert({"n": 0})
+    outer = db.create_import_checkpoint()
+    db["t"].insert({"n": 1})
+    inner = db.create_import_checkpoint()
+    db["t"].insert({"n": 2})
+    if finalize == "disable_safe_import":
+        db.disable_safe_import()
+    else:
+        getattr(db, finalize)(outer)
+    assert list(db["t"].rows) == ([{"n": 0}, {"n": 1}, {"n": 2}] if finalize == "commit_checkpoint" else [{"n": 0}])
+    with pytest.raises(CheckpointNotActiveError):
+        db.commit_checkpoint(inner)
+
+
+def test_invariants_persist_and_use_sqlite_expression_semantics(tmp_path):
+    path = tmp_path / "invariants.db"
+    db = Database(path)
+    db["odd table"].insert_all([{"value": 2}, {"value": 4}])
+    expressions = [
+        "value > 0",
+        "COUNT(*) = 2 AND SUM(value) = 6 AND AVG(value) = 3 AND MIN(value) = 2 AND MAX(value) = 4",
+        "  select sum(value) = 6 from [odd table]",
+        "length('SUM(value)') > 0",  # Scalar text containing an aggregate name.
+    ]
+    ids = [db.add_import_invariant("odd table", sql) for sql in expressions]
+    db.close()
+    db = Database(path)
+    assert db.list_import_invariants("odd table") == [dict(id=id_, expression=sql) for id_, sql in zip(ids, expressions)]
+    assert db.validate_import_invariants("odd table") == {"valid": True, "failures": []}
+    for id_ in ids:
+        db.remove_import_invariant("odd table", str(id_))
+    assert db.list_import_invariants("odd table") == []
+
+
+def test_invariant_failure_details_and_empty_table():
+    db = Database(memory=True)
+    db["t"].insert_all([{"n": 2}, {"n": -1}])
+    row_id = db.add_import_invariant("t", "n > 0")
+    select_id = db.add_import_invariant("t", "SELECT 0 UNION ALL SELECT 1")
+    error_id = db.add_import_invariant("t", "missing_column > 0")
+    result = db.validate_import_invariants("t")
+    assert result["valid"] is False
+    assert [f["id"] for f in result["failures"]] == [row_id, select_id, error_id]
+    assert result["failures"][0] == {"id": row_id, "expression": "n > 0", "error": "Invariant evaluated to false"}
+    assert result["failures"][2]["error"] == "no such column: missing_column"
+    db["empty"].create({"n": int})
+    db.add_import_invariant("empty", "n > 0")
+    assert db.validate_import_invariants("empty") == {"valid": True, "failures": []}
+    count_id = db.add_import_invariant("empty", "COUNT(*) > 0")
+    assert db.validate_import_invariants("empty")["failures"] == [{"id": count_id, "expression": "COUNT(*) > 0", "error": "Invariant evaluated to false"}]
+
