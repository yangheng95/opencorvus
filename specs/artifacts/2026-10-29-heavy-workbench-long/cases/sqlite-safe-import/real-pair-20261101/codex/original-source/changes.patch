+def test_safe_operation_preserves_caller_transaction():
+    db = Database(memory=True)
+    db["t"].create({"n": int})
+    db.execute('INSERT INTO t VALUES (1)')
+    assert db.safe_bulk_insert("t", [{"n": 2}]) == {"success": True}
+    assert db.conn.in_transaction is True
+    assert list(db["t"].rows) == [{"n": 1}, {"n": 2}]
+    db.conn.rollback()
+    assert list(db["t"].rows) == []
