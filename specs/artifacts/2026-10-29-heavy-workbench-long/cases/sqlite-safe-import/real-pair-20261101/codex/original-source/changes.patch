+def test_ordinary_csv_and_json_imports():
+    db = Database(memory=True)
+    assert db.import_csv("t", io.StringIO("n\n2\n3\n")) == {"success": True}
+    assert db.import_json("t", {"n": "4"}) == {"success": True}
+    assert list(db["t"].rows) == [{"n": "2"}, {"n": "3"}, {"n": "4"}]
+
