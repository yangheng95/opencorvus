+@pytest.mark.parametrize("strict", [False, True])
+def test_sql_error_rollback_after_batches_and_added_column(strict):
+    db = Database(memory=True)
+    db.enable_safe_import()
+    db["t"].insert({"id": 1, "n": 2}, pk="id")
+    before = snapshot(db)
+    rows = [{"id": 2, "n": 3, "extra": "column"}, {"id": 1, "n": 4}]
+    if strict:
+        with pytest.raises(sqlite3.IntegrityError, match="UNIQUE constraint failed"):
+            db.safe_bulk_insert("t", rows, alter=True, batch_size=1, strict=True)
+    else:
+        result = db.safe_bulk_insert("t", rows, alter=True, batch_size=1)
+        assert result["success"] is False
+        assert result["failures"] == []
+        assert "UNIQUE constraint failed" in result["error_report"]
+    assert snapshot(db) == before
