+@pytest.mark.parametrize("strict", [False, True])
+def test_full_schema_and_data_rollback(strict):
+    db = Database(memory=True)
+    db.enable_safe_import()
+    db.executescript("""
+        CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER, payload BLOB);
+        CREATE UNIQUE INDEX t_n ON t(n);
+        CREATE TABLE audit (n INTEGER);
+        CREATE TRIGGER t_log AFTER INSERT ON t BEGIN INSERT INTO audit VALUES(new.n); END;
+        INSERT INTO t VALUES(1, 2, x'001122');
+    """)
+    invariant = db.add_import_invariant("t", "n > 0")
+    before = snapshot(db)
+
+    def records():
+        db.executescript("""
+            ALTER TABLE t ADD COLUMN extra TEXT;
+            CREATE TABLE transient (text TEXT);
+            CREATE INDEX transient_index ON transient(text);
+            DROP INDEX t_n;
+            DROP TRIGGER t_log;
+            CREATE TRIGGER altered AFTER UPDATE ON t BEGIN INSERT INTO audit VALUES (new.n); END;
+        """)
+        yield {"id": 2, "n": 5, "extra": "first batch"}
+        yield {"id": 3, "n": -1, "extra": "second batch"}
+
+    if strict:
+        with pytest.raises(ImportInvariantError, match="validation") as ex:
+            db.safe_bulk_insert("t", records(), batch_size=1, strict=True)
+        assert ex.value.failures[0]["id"] == invariant
+    else:
+        result = db.safe_bulk_insert("t", records(), batch_size=1)
+        assert result["success"] is False
+        assert isinstance(result["checkpoint_id"], str) and len(result["checkpoint_id"]) > 0
+        assert result["failures"][0]["id"] == invariant
+        with pytest.raises(CheckpointNotActiveError):
+            db.rollback_to_checkpoint(result["checkpoint_id"])
+        db.cleanup_checkpoint(result["checkpoint_id"])
+    assert snapshot(db) == before
+
