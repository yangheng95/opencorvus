+def test_native_cli_csv_transform_and_late_json_error(tmp_path):
+    path = tmp_path / "csv.db"
+    result = native_cli("insert", path, "t", "-", "--csv", "--safe-mode", input="id,n\n1,2\n2,3\n")
+    assert result.returncode == 0, result.stderr
+    with Database(path) as db:
+        assert list(db["t"].rows) == [{"id": 1, "n": 2}, {"id": 2, "n": 3}]
+        db.add_import_invariant("t", "n > 0")
+        before = snapshot(db)
+    result = native_cli("insert", path, "t", "-", "--csv", "--safe-mode", "--alter", input="id,n,extra\n3,-1,new\n")
+    assert result.returncode == 1
+    with Database(path) as db:
+        assert snapshot(db) == before
+    result = native_cli("insert", path, "t", "-", "--nl", "--safe-mode", "--batch-size", "1", input='{"id": 3, "n": 4}\n{\n')
+    assert result.returncode == 1
+    with Database(path) as db:
+        assert snapshot(db) == before
+    result = native_cli("insert", path, "t", "-", "--csv", "--safe-mode", "--batch-size", "1", input='id,n\n3,4\n4,"unterminated\n')
+    assert result.returncode == 1
+    assert "unexpected end of data" in result.stderr
+    with Database(path) as db:
+        assert snapshot(db) == before
