+def test_user_defined_aggregate_uses_sqlite_semantics():
+    class Sum:
+        def __init__(self):
+            self.value = 0
+
+        def step(self, value):
+            self.value += value
+
+        def finalize(self):
+            return self.value
+
+    db = Database(memory=True)
+    db.conn.create_aggregate("custom_sum", 1, Sum)
+    db["t"].insert_all([{"n": 2}, {"n": 3}])
+    db.add_import_invariant("t", "custom_sum(n) = 5")
+    db.add_import_invariant("t", "TOTAL(n) = 5 AND GROUP_CONCAT(n) = '2,3'")
+    assert db.validate_import_invariants("t") == {"valid": True, "failures": []}
+
