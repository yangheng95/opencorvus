+def test_native_cli_management_and_insert_upsert_bulk_update(tmp_path):
+    path = tmp_path / "cli.db"
+    assert native_cli("enable-safe-import", path).returncode == 0
+    added = native_cli("add-import-invariant", path, "t", "n > 0")
+    assert added.returncode == 0, added.stderr
+    invariant = added.stdout.strip()
+    listed = native_cli("list-import-invariants", path, "t")
+    assert json.loads(listed.stdout) == [{"id": invariant, "expression": "n > 0"}]
+    inserted = native_cli("insert", path, "t", "-", "--pk", "id", "--safe-mode", input='[{"id": 1, "n": 2}]')
+    assert inserted.returncode == 0, inserted.stderr
+    passed = native_cli("validate-import-invariants", path, "t")
+    assert passed.returncode == 0
+    assert "Validation passed" in passed.stdout
+    upserted = native_cli("upsert", path, "t", "-", "--pk", "id", "--safe-mode", input='[{"id": 1, "n": 3}]')
+    assert upserted.returncode == 0, upserted.stderr
+    for command, arguments, data in [
+        ("insert", ["t", "-", "--alter", "--pk", "id"], '[{"id": 2, "n": 4, "extra": 1}, {"id": 3, "n": -1, "extra": 2}]'),
+        ("upsert", ["t", "-", "--pk", "id"], '[{"id": 1, "n": 4}, {"id": 2, "n": -1}]'),
+        ("bulk", ["UPDATE t SET n = :n WHERE id = :id", "-"], '[{"id": 1, "n": 4}, {"id": 1, "n": -1}]'),
+    ]:
+        with Database(path) as db:
+            before = snapshot(db)
+        result = native_cli(command, path, *arguments, "--safe-mode", "--batch-size", "1", input=data)
+        assert result.returncode == 1, result.stderr
+        assert invariant in result.stderr
+        with Database(path) as db:
+            assert snapshot(db) == before
+    updated = native_cli("bulk", path, "UPDATE t SET n = :n WHERE id = :id", "-", "--safe-mode", input='[{"id": 1, "n": 7}]')
+    assert updated.returncode == 0, updated.stderr
+    with Database(path) as db:
+        assert list(db["t"].rows) == [{"id": 1, "n": 7}]
+        db["t"].update(1, {"n": -1})
+    failed = native_cli("validate-import-invariants", path, "t")
+    assert failed.returncode == 0
