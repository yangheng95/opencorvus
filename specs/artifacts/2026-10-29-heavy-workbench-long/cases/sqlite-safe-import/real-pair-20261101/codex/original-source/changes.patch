+def test_first_safe_failure_restores_complete_database_and_disabled_setting():
+    db = Database(memory=True)
+    invariant = db.add_import_invariant("t", "n > 0")
+    before = snapshot(db)
+    result = db.safe_bulk_insert("t", [{"n": -1}])
+    assert result["failures"][0]["id"] == invariant
+    assert snapshot(db) == before
+    with pytest.raises(SafeImportNotEnabledError):
+        db.create_import_checkpoint()
+    assert db.safe_bulk_insert("t", [{"n": 2}]) == {"success": True}
+    checkpoint = db.create_import_checkpoint()
+    db.commit_checkpoint(checkpoint)
+
