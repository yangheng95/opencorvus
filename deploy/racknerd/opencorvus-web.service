[Unit]
Description=OpenCorvus public website database runtime
After=network.target
Before=caddy.service

[Service]
Type=simple
User=opencorvus-web
Group=opencorvus-web
WorkingDirectory=/srv/opencorvus/current
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=NODE_ENV=production
Environment=OPENCORVUS_WEB_REGISTRY_DB=/var/lib/opencorvus-web/registry.sqlite3
Environment=OPENCORVUS_WEB_REGISTRY_DATA=/var/lib/opencorvus-web
ExecStart=/usr/bin/bun /srv/opencorvus/current/server/opencorvus-web.mjs
Restart=on-failure
RestartSec=2s
TimeoutStartSec=30s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/opencorvus-web
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
MemoryMax=512M
TasksMax=128
UMask=0077

[Install]
WantedBy=multi-user.target
