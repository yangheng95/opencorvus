(opencorvus_static) {
	root * /srv/opencorvus/current/client
	encode zstd gzip

	@website_runtime path /market /market/* /zh-cn/market /zh-cn/market/* /api/registry/* /api/site/v1/views /health/live /health/ready
	@view_post {
		path /api/site/v1/views
		method POST
	}
	request_body @view_post {
		max_size 1KB
	}
	reverse_proxy @website_runtime 127.0.0.1:4321

	# Signed archives normalize mtimes; metadata cannot validate mutable pages.
	@mutable_document {
		method GET HEAD
		path / */ *.html /downloads/latest.json /expert-squads/catalog.json
	}
	request_header @mutable_document -If-None-Match
	request_header @mutable_document -If-Modified-Since
	header @mutable_document {
		Cache-Control "no-store, max-age=0"
		-Etag
		-Last-Modified
	}

	@expert_squad_immutable path /expert-squads/archives/* /expert-squads/catalogs/* /expert-squads/signatures/* /expert-squads/bundles/*
	header @expert_squad_immutable Cache-Control "public, max-age=31536000, immutable"

	file_server
}

opencorvus.com {
	import opencorvus_static
}

http://127.0.0.1:8080 {
	bind 127.0.0.1
	import opencorvus_static
}

www.opencorvus.com {
	redir https://opencorvus.com{uri} permanent
}
