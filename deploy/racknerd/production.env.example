# Public production inventory. Copy to the local vault as production.env and fill
# the values from GitHub variables plus the generated vault manifest. Never put
# private key bytes, passwords, or tokens in this file.
OPENCORVUS_PRODUCTION_ORIGIN=https://opencorvus.com
OPENCORVUS_PRODUCTION_WWW_ORIGIN=https://www.opencorvus.com
OPENCORVUS_GITHUB_REPOSITORY=yangheng95/opencorvus
OPENCORVUS_GITHUB_ENVIRONMENT=production
OPENCORVUS_AUTOMATIC_DEPLOYMENT_ENABLED=true

RACKNERD_HOST=<server-ipv4>
RACKNERD_SSH_PORT=22
RACKNERD_DEPLOY_USER=opencorvus-deploy
RACKNERD_KNOWN_HOSTS_FILE=<absolute-path-to-known_hosts>
RACKNERD_SSH_PRIVATE_KEY_DPAPI_FILE=<absolute-path-to-deploy-key.dpapi.json>

EXPERT_SQUAD_SIGNING_KEY_ID=<current-signing-key-id>
EXPERT_SQUAD_SIGNING_PRIVATE_KEY_DPAPI_FILE=<absolute-path-to-signing-key.dpapi.json>
EXPERT_SQUAD_TRUSTED_KEYS_JSON=<single-line-public-trust-root-json>
EXPERT_SQUAD_BOOTSTRAP_PUBLICATION_VERSION=<positive-integer>
EXPERT_SQUAD_BOOTSTRAP_PUBLICATION_EXPIRES_AT=<utc-timestamp>
EXPERT_SQUAD_CURRENT_PUBLICATION_VERSION=<positive-integer>
EXPERT_SQUAD_CURRENT_PUBLICATION_EXPIRES_AT=<utc-timestamp>
# Present only during a planned dual-signature rotation overlap:
# EXPERT_SQUAD_SECONDARY_SIGNING_KEY_ID=<secondary-key-id>
# EXPERT_SQUAD_SECONDARY_SIGNING_PRIVATE_KEY_DPAPI_FILE=<absolute-path-to-secondary-signing-key.dpapi.json>

OPENCORVUS_SERVER_RELEASE_ROOT=/srv/opencorvus/releases
OPENCORVUS_SERVER_CURRENT_LINK=/srv/opencorvus/current
OPENCORVUS_SERVER_CADDY_CONFIG=/etc/caddy/Caddyfile
OPENCORVUS_SERVER_ACTIVATOR=/usr/local/bin/opencorvus-activate-release
OPENCORVUS_SERVER_SERVICE_UNIT=/etc/systemd/system/opencorvus-web.service
OPENCORVUS_SERVER_SERVICE_USER=opencorvus-web
OPENCORVUS_SERVER_REGISTRY_STATE=/var/lib/opencorvus-web
OPENCORVUS_SERVER_REGISTRY_DATABASE=/var/lib/opencorvus-web/registry.sqlite3
OPENCORVUS_SERVER_REGISTRY_BACKUPS=/var/lib/opencorvus-web/backups
OPENCORVUS_SERVER_BUN=/usr/bin/bun
OPENCORVUS_OFFSITE_BACKUP_DESTINATION=<encrypted-off-host-destination>
OPENCORVUS_BACKUP_RETENTION_DAILY=7
OPENCORVUS_BACKUP_RETENTION_WEEKLY=4
OPENCORVUS_RPO_HOURS=24
OPENCORVUS_RTO_MINUTES=30
OPENCORVUS_ROOT_RECOVERY_KEY_FILE=<absolute-path-to-existing-root-recovery-private-key>
