# Force LF line endings for all text files
* text=auto eol=lf

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.exe binary
*.msi filter=lfs diff=lfs merge=lfs -text
*.dll binary
*.so binary
*.dylib binary
*.patch -whitespace
expert-squads/builtin/medical-device-human-factors-usability-assurance/skills/method/references/UPSTREAM-LICENSE -whitespace
*.pdf binary
*.doc binary
*.docx binary
*.docm binary
*.xls binary
*.xlsx binary
*.xlsm binary
*.xlsb binary
*.ppt binary
*.pptx binary
*.pptm binary

# Preserve benchmark evidence byte-for-byte so committed SHA-256 manifests remain verifiable across platforms.
specs/artifacts/2026-08-20-external-agent-benchmark/** -text
packages/opencorvus/script/benchmark/external-agent/automationbench-case-set.json text eol=lf
