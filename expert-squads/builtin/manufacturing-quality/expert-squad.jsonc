{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "manufacturing-quality",
  "name": "Manufacturing Quality",
  "label": "Manufacturing Quality",
  "description": "Process evidence, defect analysis, and control verification joined into a traceable nonconformance disposition pack.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed manufacturing quality analysis.",
    "selection_guidance": "Select for nonconformance, defect, containment, root-cause, or control-verification support without production-release authority.",
