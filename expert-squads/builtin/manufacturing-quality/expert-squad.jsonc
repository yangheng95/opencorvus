{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "manufacturing-quality",
  "name": "Manufacturing Quality",
  "label": "Manufacturing Quality",
  "description": "Process evidence, defect analysis, and control verification joined into a traceable nonconformance disposition pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed manufacturing quality analysis.",
    "selection_guidance": "Select for nonconformance, defect, containment, root-cause, or control-verification support without production-release authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:manufacturing-quality:manufacturing-quality%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:manufacturing-quality:manufacturing-quality%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "quality-process-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Process Evidence Analyst",
        "description": "Maps affected process, records, changes, lots, and missing evidence.",
        "base_role": "explore",
        "prompt": "agents/quality-process-evidence-analyst/system.md"
      },
      "quality-defect-analysis-specialist": {
        "capability_refs": [
          "capability:capability_set:package:manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Defect Analysis Specialist",
        "description": "Tests defect patterns and competing causal hypotheses.",
        "base_role": "delegated-worker",
        "prompt": "agents/quality-defect-analysis-specialist/system.md"
      },
      "quality-control-verification-analyst": {
        "capability_refs": [
          "capability:capability_set:package:manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Control Verification Analyst",
        "description": "Assesses inspection, measurement, sampling, calibration, and control evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/quality-control-verification-analyst/system.md"
      },
      "quality-disposition-owner": {
        "capability_refs": [
          "capability:capability_set:package:manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Quality Disposition Owner",
        "description": "Joins all branches into a traceable disposition pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/quality-disposition-owner/system.md"
      }
    },
    "virtual_workflows": {
      "manufacturing-quality-disposition-pack": {
        "label": "Manufacturing Quality Disposition Pack",
        "description": "Three independent quality branches converge into one disposition pack.",
        "nodes": {
          "quality-process-evidence-analyst": {
            "agent_id": "quality-process-evidence-analyst",
            "description": "Maps process evidence.",
            "depends_on": []
          },
          "quality-defect-analysis-specialist": {
            "agent_id": "quality-defect-analysis-specialist",
            "description": "Tests defect hypotheses.",
            "depends_on": []
          },
          "quality-control-verification-analyst": {
            "agent_id": "quality-control-verification-analyst",
            "description": "Maps control verification evidence.",
            "depends_on": []
          },
          "quality-disposition-owner": {
            "agent_id": "quality-disposition-owner",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "quality-control-verification-analyst",
              "quality-defect-analysis-specialist",
              "quality-process-evidence-analyst"
            ]
          }
        }
      }
    }
  }
}
