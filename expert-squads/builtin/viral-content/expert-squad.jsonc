{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "viral-content",
  "name": "Viral Content",
  "label": "Viral Content",
  "description": "Evidence-backed audience and trend research, testable concepts, complete text-led campaign copy, independent review, and canonical delivery without promised engagement.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed, text-led campaign concepts and copy variants.",
    "selection_guidance": "Select for complete text-led campaign development; do not select for actual media generation, external posting, or guaranteed engagement.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:viral-content:viral-content%2Fshared%2Facceptance",
        "capability:skill:package:viral-content:viral-content%2Fshared%2Fmethod",
        "capability:skill:package:viral-content:viral-content%2Fshared%2Fworkflow",
        "capability:tool:package:viral-content:viral-content%2Fshared%2Fpublish-viral-content-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:viral-content:viral-content%2Fshared%2Facceptance",
        "capability:skill:package:viral-content:viral-content%2Fshared%2Fmethod",
        "capability:skill:package:viral-content:viral-content%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "viral-brief-strategist": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Viral Campaign Brief Strategist",
        "description": "Defines the bounded campaign, evidence questions, and falsifiable success hypotheses.",
        "base_role": "delegated-worker",
        "prompt": "agents/viral-brief-strategist/system.md"
      },
      "viral-audience-researcher": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Viral Audience Researcher",
        "description": "Builds the attributable audience-needs and language dossier.",
        "base_role": "deep-research",
        "prompt": "agents/viral-audience-researcher/system.md"
      },
      "viral-trend-researcher": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Viral Trend Researcher",
        "description": "Builds the dated content-pattern and lifecycle dossier.",
        "base_role": "deep-research",
        "prompt": "agents/viral-trend-researcher/system.md"
      },
      "viral-concept-strategist": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Viral Concept Strategist",
        "description": "Joins audience and trend evidence into distinct, testable concepts.",
        "base_role": "delegated-worker",
        "prompt": "agents/viral-concept-strategist/system.md"
      },
      "viral-copy-producer": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Viral Copy Producer",
        "description": "Creates complete long-form and short-form text with claim traceability.",
        "base_role": "delegated-worker",
        "prompt": "agents/viral-copy-producer/system.md"
      },
      "viral-content-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Viral Content Reviewer",
        "description": "Independently reviews the one copy-pack predecessor and publishes corrections.",
        "base_role": "fact-check",
        "prompt": "agents/viral-content-reviewer/system.md"
      },
      "viral-delivery-owner": {
        "capability_refs": [
          "capability:capability_set:package:viral-content:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Viral Campaign Delivery Owner",
        "description": "Resolves review findings and publishes the canonical campaign resources.",
        "base_role": "build",
        "prompt": "agents/viral-delivery-owner/system.md"
      }
    },
    "virtual_workflows": {
      "evidence-backed-content-campaign": {
        "label": "Evidence-backed Content Campaign",
        "description": "Use when the Task provides a real product or offer, target audience, desired channels, and permission to research current public evidence; produce a reviewed text-led campaign bundle without external posting.",
        "nodes": {
          "viral-brief-strategist": {
            "agent_id": "viral-brief-strategist",
            "description": "Publishes the bounded campaign brief.",
            "depends_on": []
          },
          "viral-audience-researcher": {
            "agent_id": "viral-audience-researcher",
            "description": "Publishes attributable audience evidence.",
            "depends_on": [
              "viral-brief-strategist"
            ]
          },
          "viral-trend-researcher": {
            "agent_id": "viral-trend-researcher",
            "description": "Publishes dated trend evidence.",
            "depends_on": [
              "viral-brief-strategist"
            ]
          },
          "viral-concept-strategist": {
            "agent_id": "viral-concept-strategist",
            "description": "Joins both research branches into a selected concept.",
            "depends_on": [
              "viral-audience-researcher",
              "viral-trend-researcher"
            ]
          },
          "viral-copy-producer": {
            "agent_id": "viral-copy-producer",
            "description": "Publishes complete campaign copy.",
            "depends_on": [
              "viral-concept-strategist"
            ]
          },
          "viral-content-reviewer": {
            "agent_id": "viral-content-reviewer",
            "description": "Independently reviews the single copy-pack predecessor.",
            "depends_on": [
              "viral-copy-producer"
            ]
          },
          "viral-delivery-owner": {
            "agent_id": "viral-delivery-owner",
            "description": "Publishes canonical campaign resources and matching interactive Artifacts.",
            "depends_on": [
              "viral-content-reviewer"
            ]
          }
        }
      }
    }
  }
}
