{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "clinical-biostatistics-data-monitoring",
  "name": "Clinical Biostatistics and Data Monitoring",
  "label": "Clinical Biostatistics and Data Monitoring",
  "description": "Estimand, SAP, analysis-population, SDTM/ADaM traceability, model, missing-data, multiplicity, sensitivity, interim and monitoring evidence without unblinding or stop/continue authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound clinical biostatistics and independent data-monitoring evidence preparation.",
    "selection_guidance": "Select for estimand and SAP trace, analysis populations, source-to-SDTM-to-ADaM derivations, statistical model specifications, missing-data or multiplicity controls, sensitivity analyses, interim evidence, blinding boundaries or DMC packet readiness. Do not select to choose unapproved methods or thresholds, unblind data, lock a database, sign results or recommend stop/continue.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:clinical-biostatistics-data-monitoring:clinical-biostatistics-data-monitoring%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:clinical-biostatistics-data-monitoring:clinical-biostatistics-data-monitoring%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "clinical-estimand-sap-population-analyst": {
        "capability_refs": [
          "capability:capability_set:package:clinical-biostatistics-data-monitoring:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Estimand SAP and Population Analyst",
        "description": "Freezes protocol, estimand, endpoint, intercurrent-event strategy, SAP and analysis-population evidence.",
        "base_role": "explore",
        "prompt": "agents/clinical-estimand-sap-population-analyst/system.md"
      },
      "clinical-analysis-dataset-traceability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:clinical-biostatistics-data-monitoring:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Source SDTM ADaM Traceability Analyst",
        "description": "Traces authorized source data through SDTM, ADaM, metadata, derivations and results without changing or locking data.",
        "base_role": "delegated-worker",
        "prompt": "agents/clinical-analysis-dataset-traceability-analyst/system.md"
      },
      "clinical-model-missing-data-multiplicity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:clinical-biostatistics-data-monitoring:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Model Missing Data and Multiplicity Analyst",
        "description": "Reconciles prespecified models, effect measures, missing-data handling, multiplicity and sensitivity evidence without choosing thresholds.",
        "base_role": "delegated-worker",
        "prompt": "agents/clinical-model-missing-data-multiplicity-analyst/system.md"
      },
      "clinical-interim-data-monitoring-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:clinical-biostatistics-data-monitoring:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Interim Blinding and Monitoring Evidence Analyst",
        "description": "Traces authorized interim snapshots, access separation, DMC charter outputs and communication evidence without unblinding or recommendations.",
        "base_role": "delegated-worker",
        "prompt": "agents/clinical-interim-data-monitoring-evidence-analyst/system.md"
      },
      "clinical-biostatistics-data-monitoring-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:clinical-biostatistics-data-monitoring:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Clinical Biostatistics Data Monitoring Review Owner",
        "description": "Joins estimand, derivation, model and interim-monitoring evidence into a controlled qualified-review pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/clinical-biostatistics-data-monitoring-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "qualified-review": {
        "label": "Clinical Biostatistics and Data Monitoring Qualified Review",
        "description": "Four independent clinical-statistical evidence branches converge into one controlled qualified review.",
        "nodes": {
          "clinical-estimand-sap-population-analyst": {
            "agent_id": "clinical-estimand-sap-population-analyst",
            "description": "Freezes estimand, SAP and population evidence.",
            "depends_on": []
          },
          "clinical-analysis-dataset-traceability-analyst": {
            "agent_id": "clinical-analysis-dataset-traceability-analyst",
            "description": "Traces source, SDTM, ADaM and results.",
            "depends_on": []
          },
          "clinical-model-missing-data-multiplicity-analyst": {
            "agent_id": "clinical-model-missing-data-multiplicity-analyst",
            "description": "Reconciles model, missing-data and multiplicity evidence.",
            "depends_on": []
          },
          "clinical-interim-data-monitoring-evidence-analyst": {
            "agent_id": "clinical-interim-data-monitoring-evidence-analyst",
            "description": "Traces interim, blinding and monitoring evidence.",
            "depends_on": []
          },
          "clinical-biostatistics-data-monitoring-review-owner": {
            "agent_id": "clinical-biostatistics-data-monitoring-review-owner",
            "description": "Joins every branch without unblinding, signing results or recommending stop/continue.",
            "depends_on": [
              "clinical-analysis-dataset-traceability-analyst",
              "clinical-estimand-sap-population-analyst",
              "clinical-interim-data-monitoring-evidence-analyst",
              "clinical-model-missing-data-multiplicity-analyst"
            ]
          }
        }
      }
    }
  }
}
