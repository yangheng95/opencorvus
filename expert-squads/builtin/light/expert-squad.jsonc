{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "light",
  "name": "Light",
  "label": "Light",
  "description": "Read-only consultation, investigation, and clarifying-question support with variable parallel Planner and Investigator sessions.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use Light for read-only consultation, investigation, comparison, planning, and clarifying questions.",
    "selection_guidance": "Select Light when the requested outcome is advice, an evidence-backed investigation, a plan, a comparison, or the smallest useful set of clarifying questions. Do not select it for implementation, file changes, external actions, transactions, or operational execution.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 2 projections.",
      "member_refs": [
        "capability:skill:package:light:light%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:capability_search",
        "capability:tool:platform:tool-registry:external_code_search",
        "capability:tool:platform:tool-registry:glob",
        "capability:tool:platform:tool-registry:read",
        "capability:tool:platform:tool-registry:search_code",
        "capability:tool:platform:tool-registry:skill",
        "capability:tool:platform:tool-registry:webfetch",
        "capability:tool:platform:tool-registry:websearch"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:tool:platform:tool-registry:dispatch_agents",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:no_action",
        "capability:tool:platform:tool-registry:question",
        "capability:tool:platform:tool-registry:read_agent_message",
        "capability:tool:platform:tool-registry:read_task_message",
        "capability:tool:platform:tool-registry:scheduler_message"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "light-investigator": {
        "capability_refs": [
          "capability:capability_set:package:light:shared-capabilities-1"
        ],
        "label": "Light Investigator",
        "description": "Performs one bounded read-only evidence investigation and reports facts, inferences, unknowns, and source references.",
        "base_role": "delegated-worker",
        "prompt": "agents/light-investigator/system.md"
      },
      "light-planner": {
        "capability_refs": [
          "capability:capability_set:package:light:shared-capabilities-1"
        ],
        "label": "Light Planner",
        "description": "Produces one bounded advisory plan, option analysis, decision frame, or minimal clarifying-question set without implementation or mutation.",
        "base_role": "delegated-worker",
        "prompt": "agents/light-planner/system.md"
      }
    },
    "virtual_workflows": {}
  }
}
