{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "light",
  "name": "Light",
  "label": "Light",
  "description": "Read-only consultation, investigation, and clarifying-question support with variable parallel Planner and Investigator sessions.",
  "version": "2026.08.29.1",
  "product_pillars": ["code", "work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use Light for read-only consultation, investigation, comparison, planning, and clarifying questions.",
    "selection_guidance": "Select Light when the requested outcome is advice, an evidence-backed investigation, a plan, a comparison, or the smallest useful set of clarifying questions. Do not select it for implementation, file changes, external actions, transactions, or operational execution.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": ["dispatch_agent", "manage_task", "read"],
      "default_skill_refs": [],
      "package_skill_refs": ["light/shared/method"],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "light-investigator": {
        "label": "Light Investigator",
        "description": "Performs one bounded read-only evidence investigation and reports facts, inferences, unknowns, and source references.",
        "base_role": "delegated-worker",
        "prompt": "agents/light-investigator/system.md",
        "inherit_base_tools": false,
        "built_in_tool_ids": [
          "capability_search",
          "read",
          "glob",
          "search_code",
          "webfetch",
          "websearch",
          "external_code_search",
          "skill",
        ],
        "default_skill_refs": [],
        "package_skill_refs": ["light/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "light-planner": {
        "label": "Light Planner",
        "description": "Produces one bounded advisory plan, option analysis, decision frame, or minimal clarifying-question set without implementation or mutation.",
        "base_role": "delegated-worker",
        "prompt": "agents/light-planner/system.md",
        "inherit_base_tools": false,
        "built_in_tool_ids": [
          "capability_search",
          "read",
          "glob",
          "search_code",
          "webfetch",
          "websearch",
          "external_code_search",
          "skill",
        ],
        "default_skill_refs": [],
        "package_skill_refs": ["light/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
    },
    "virtual_workflows": {},
  },
}
