{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "product-video",
  "name": "Product Video Production",
  "label": "Product Video Production",
  "description": "Source-grounded product-video briefs, narrative and visual planning in parallel, and an independently reviewed production handoff without pretending unavailable media generation occurred.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for an evidence-backed product-video brief, script, storyboard, shot plan, and production acceptance handoff.",
    "selection_guidance": "Select when the Task supplies a concrete product, audience, channel, duration, claims evidence, and production constraints. This package plans and reviews production; it performs media generation only when the active Task independently grants an exact compatible media tool.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:product-video:product-video%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:product-video:product-video%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "product-video-brief-strategist": {
        "capability_refs": [
          "capability:capability_set:package:product-video:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Product Video Brief Strategist",
        "description": "Freezes the product truth, audience, channel, duration, claims, constraints, and measurable acceptance boundary.",
        "base_role": "explore",
        "prompt": "agents/product-video-brief-strategist/system.md"
      },
      "product-video-narrative-producer": {
        "capability_refs": [
          "capability:capability_set:package:product-video:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Product Video Narrative Producer",
        "description": "Turns the approved brief into timed narration, on-screen copy, claim references, and alternate openings.",
        "base_role": "delegated-worker",
        "prompt": "agents/product-video-narrative-producer/system.md"
      },
      "product-video-visual-planner": {
        "capability_refs": [
          "capability:capability_set:package:product-video:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Product Video Visual Planner",
        "description": "Builds the storyboard, shot list, asset ledger, accessibility plan, and production constraints from the same brief.",
        "base_role": "delegated-worker",
        "prompt": "agents/product-video-visual-planner/system.md"
      },
      "product-video-delivery-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:product-video:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Product Video Delivery Reviewer",
        "description": "Joins narrative and visual plans, resolves contradictions, and issues the canonical production and acceptance handoff.",
        "base_role": "fact-check",
        "prompt": "agents/product-video-delivery-reviewer/system.md"
      }
    },
    "virtual_workflows": {
      "product-video-production-handoff": {
        "label": "Product Video Production Handoff",
        "description": "Freeze a source-grounded brief, develop narrative and visual plans in parallel, then join and independently review the canonical production handoff.",
        "nodes": {
          "product-video-brief-strategist": {
            "agent_id": "product-video-brief-strategist",
            "description": "Publishes the bounded brief and claim ledger.",
            "depends_on": []
          },
          "product-video-narrative-producer": {
            "agent_id": "product-video-narrative-producer",
            "description": "Publishes timed narration and on-screen copy from the brief.",
            "depends_on": [
              "product-video-brief-strategist"
            ]
          },
          "product-video-visual-planner": {
            "agent_id": "product-video-visual-planner",
            "description": "Publishes the storyboard, shot, asset, and accessibility plan from the brief.",
            "depends_on": [
              "product-video-brief-strategist"
            ]
          },
          "product-video-delivery-reviewer": {
            "agent_id": "product-video-delivery-reviewer",
            "description": "Joins both branches and publishes the reviewed production and acceptance handoff.",
            "depends_on": [
              "product-video-narrative-producer",
              "product-video-visual-planner"
            ]
          }
        }
      }
    }
  }
}
