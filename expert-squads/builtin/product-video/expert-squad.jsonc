{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "product-video",
  "name": "Product Video Production",
  "label": "Product Video Production",
  "description": "Source-grounded product-video briefs, narrative and visual planning in parallel, and an independently reviewed production handoff without pretending unavailable media generation occurred.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for an evidence-backed product-video brief, script, storyboard, shot plan, and production acceptance handoff.",
    "selection_guidance": "Select when the Task supplies a concrete product, audience, channel, duration, claims evidence, and production constraints. This package plans and reviews production; it performs media generation only when the active Task independently grants an exact compatible media tool.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "product-video/shared/method"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "product-video-brief-strategist": {
        "label": "Product Video Brief Strategist",
        "description": "Freezes the product truth, audience, channel, duration, claims, constraints, and measurable acceptance boundary.",
