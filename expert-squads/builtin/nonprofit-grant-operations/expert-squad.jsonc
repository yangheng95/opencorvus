{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "nonprofit-grant-operations",
  "name": "Nonprofit Grant Operations",
  "label": "Nonprofit Grant Operations",
  "description": "Funder fit, program evidence, budget, compliance, and delivery readiness joined into a traceable grant operations pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded nonprofit grant planning and delivery evidence.",
    "selection_guidance": "Select for opportunity fit, proposal evidence, theory of change, budget justification, compliance mapping, milestone planning, reporting readiness, or reviewer-response preparation without fabricating claims or submitting on behalf of an organization.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:nonprofit-grant-operations:nonprofit-grant-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:nonprofit-grant-operations:nonprofit-grant-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "grant-funder-fit-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nonprofit-grant-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Funder Fit Analyst",
        "description": "Maps solicitation requirements, eligibility evidence, review criteria, and strategic fit.",
        "base_role": "explore",
        "prompt": "agents/grant-funder-fit-analyst/system.md"
      },
      "grant-program-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nonprofit-grant-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Program Evidence Analyst",
        "description": "Maps need, beneficiaries, theory of change, outcomes, evidence, and delivery feasibility.",
        "base_role": "delegated-worker",
        "prompt": "agents/grant-program-evidence-analyst/system.md"
      },
      "grant-budget-compliance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nonprofit-grant-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Budget and Compliance Analyst",
        "description": "Maps cost basis, restrictions, match assumptions, reporting duties, and control gaps.",
        "base_role": "delegated-worker",
        "prompt": "agents/grant-budget-compliance-analyst/system.md"
      },
      "grant-delivery-pack-owner": {
        "capability_refs": [
          "capability:capability_set:package:nonprofit-grant-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Grant Delivery Pack Owner",
        "description": "Joins the branches into a reviewable proposal and delivery plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/grant-delivery-pack-owner/system.md"
      }
    },
    "virtual_workflows": {
      "grant-delivery-pack": {
        "label": "Grant Delivery Pack",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "grant-funder-fit-analyst": {
            "agent_id": "grant-funder-fit-analyst",
            "description": "Maps solicitation requirements, eligibility evidence, review criteria, and strategic fit.",
            "depends_on": []
          },
          "grant-program-evidence-analyst": {
            "agent_id": "grant-program-evidence-analyst",
            "description": "Maps need, beneficiaries, theory of change, outcomes, evidence, and delivery feasibility.",
            "depends_on": []
          },
          "grant-budget-compliance-analyst": {
            "agent_id": "grant-budget-compliance-analyst",
            "description": "Maps cost basis, restrictions, match assumptions, reporting duties, and control gaps.",
            "depends_on": []
          },
          "grant-delivery-pack-owner": {
            "agent_id": "grant-delivery-pack-owner",
            "description": "Joins the branches into a reviewable proposal and delivery plan.",
            "depends_on": [
              "grant-budget-compliance-analyst",
              "grant-funder-fit-analyst",
              "grant-program-evidence-analyst"
            ]
          }
        }
      }
    }
  }
}
