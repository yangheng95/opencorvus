{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "squad-sdk",
  "name": "Generate Agent Squads",
  "label": "Generate Agent Squads",
  "description": "Evidence-led heterogeneous algorithm import and canonical generation of project-owned, traceable OpenCorvus Agent Squads with independent contract review.",
  "version": "2026.08.10.1",
  "product_pillars": ["code", "work"],
  "system_role": "expert_squad_generator",
  "readme": "README.md",
  "selector": {
    "summary": "Use to import an external heterogeneous agent algorithm or design, validate, and install a new OpenCorvus Expert Squad through the canonical SDK.",
    "selection_guidance": "Select Generate Agent Squads only when the requested deliverable is a project-owned Expert Squad package or a lossless import of an external agent team. Use the resulting domain Squad, not Generate Agent Squads, for subsequent domain work.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read",
        "expert_squad_author",
        "multica_catalog",
        "multica_preview",
        "multica_import",
      ],
      "default_skill_refs": [],
      "package_skill_refs": ["squad-sdk/shared/authoring", "squad-sdk/shared/import"],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "squad-sdk-source-analyst": {
        "label": "Generate Agent Squads Source Analyst",
        "description": "Extracts the source algorithm, domain boundary, actors, evidence flow, resources, portability constraints, and acceptance contract.",
        "base_role": "deep-research",
        "prompt": "agents/squad-sdk-source-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["squad-sdk/shared/authoring"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "squad-sdk-package-architect": {
        "label": "Generate Agent Squads Package Architect",
        "description": "Turns accepted source evidence into the smallest complete SDK blueprint and binding workflow topology.",
        "base_role": "architect",
        "prompt": "agents/squad-sdk-package-architect/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["squad-sdk/shared/authoring"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "squad-sdk-import-analyst": {
        "label": "Generate Agent Squads Import Analyst",
        "description": "Examines an external Squad's roster, instructions, Skill closures, MCP capabilities, mapping evidence, and portability blockers.",
        "base_role": "deep-research",
        "prompt": "agents/squad-sdk-import-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["squad-sdk/shared/import"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "squad-sdk-contract-reviewer": {
        "label": "Generate Agent Squads Contract Reviewer",
        "description": "Independently validates the complete authoring blueprint or import mapping against source evidence and package invariants.",
        "base_role": "fact-check",
        "prompt": "agents/squad-sdk-contract-reviewer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["squad-sdk/shared/authoring", "squad-sdk/shared/import"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
    },
    "virtual_workflows": {
      "sdk-authoring": {
        "label": "Generate Agent Squads Authoring",
        "description": "Extract the domain algorithm, design one canonical package blueprint, independently validate it, and then materialize it through the SDK author tool.",
        "nodes": {
          "source-analysis": {
            "agent_id": "squad-sdk-source-analyst",
            "description": "Publishes the source algorithm and package-boundary evidence.",
            "depends_on": [],
          },
          "package-architecture": {
            "agent_id": "squad-sdk-package-architect",
            "description": "Publishes the complete SDK authoring blueprint.",
            "depends_on": ["source-analysis"],
          },
          "contract-review": {
            "agent_id": "squad-sdk-contract-reviewer",
            "description": "Publishes the independent positive validation of the exact blueprint.",
            "depends_on": ["package-architecture"],
          },
        },
      },
      "heterogeneous-import": {
        "label": "Heterogeneous Squad Import",
        "description": "Inspect the external Squad and preview evidence, repair the mapping, independently validate the exact digests, and then import once.",
        "nodes": {
          "import-analysis": {
            "agent_id": "squad-sdk-import-analyst",
            "description": "Publishes source, portability, and mapping analysis for the selected external Squad.",
            "depends_on": [],
          },
          "contract-review": {
            "agent_id": "squad-sdk-contract-reviewer",
            "description": "Publishes independent positive validation of the blocker-free preview and exact mapping.",
            "depends_on": ["import-analysis"],
          },
        },
      },
    },
  },
}
