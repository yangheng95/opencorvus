{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "squad-sdk",
  "name": "Generate Expert Squads",
  "label": "Generate Expert Squads",
  "description": "Evidence-led heterogeneous algorithm import and canonical generation of project-owned, traceable OpenCorvus Expert Squads with independent contract review.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "system_role": "expert_squad_generator",
  "readme": "README.md",
  "selector": {
    "summary": "Use to import an external heterogeneous agent algorithm or design, validate, and install a new OpenCorvus Expert Squad through the canonical SDK.",
    "selection_guidance": "Select Generate Expert Squads only when the requested deliverable is a project-owned Expert Squad package or a lossless import of an external agent team. Use the resulting domain Squad, not Generate Expert Squads, for subsequent domain work.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read",
        "expert_squad_author",
        "multica_catalog",
        "multica_preview",
        "multica_import"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "squad-sdk/shared/authoring",
        "squad-sdk/shared/import"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "squad-sdk-source-analyst": {
        "label": "Generate Expert Squads Source Analyst",
        "description": "Extracts the source algorithm, domain boundary, actors, evidence flow, resources, portability constraints, and acceptance contract.",
        "base_role": "deep-research",
        "prompt": "agents/squad-sdk-source-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "squad-sdk/shared/authoring"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "squad-sdk-import-analyst": {
        "label": "Generate Expert Squads Import Analyst",
        "description": "Examines an external Squad's roster, instructions, Skill closures, MCP capabilities, mapping evidence, and portability blockers.",
        "base_role": "deep-research",
        "prompt": "agents/squad-sdk-import-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "squad-sdk/shared/import"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "squad-sdk-contract-reviewer": {
        "label": "Generate Expert Squads Contract Reviewer",
        "description": "Independently validates the complete authoring blueprint or import mapping against source evidence and package invariants.",
        "base_role": "fact-check",
        "prompt": "agents/squad-sdk-contract-reviewer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "squad-sdk/shared/authoring",
          "squad-sdk/shared/import"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "squad-sdk-planner": {
        "label": "Generate Expert Squads Planner",
        "description": "Publishes the package boundary, flat Planner/parallel-worker topology, resource closure, and acceptance allocation.",
        "base_role": "delegated-worker",
        "prompt": "agents/squad-sdk-planner/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "squad-sdk/shared/authoring"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      }
    },
    "virtual_workflows": {
      "sdk-authoring": {
        "label": "Planned Parallel Expert Squad Authoring",
        "description": "One Planner fixes the canonical flat package blueprint before source and contract workers validate it in parallel and the scheduler invokes the single SDK writer.",
        "nodes": {
          "squad-sdk-planner": {
            "agent_id": "squad-sdk-planner",
            "description": "Publishes the canonical package blueprint and flat Planner/parallel-worker topology.",
            "depends_on": []
          },
          "source-analysis": {
            "agent_id": "squad-sdk-source-analyst",
            "description": "Validates source algorithm, actors, evidence flow, resources, and portability constraints.",
            "depends_on": [
              "squad-sdk-planner"
            ]
          },
          "contract-review": {
            "agent_id": "squad-sdk-contract-reviewer",
            "description": "Independently validates the exact blueprint and closure against SDK invariants.",
            "depends_on": [
              "squad-sdk-planner"
            ]
          }
        }
      },
      "heterogeneous-import": {
        "label": "Planned Parallel Heterogeneous Import",
        "description": "One Planner fixes the import boundary before mapping and contract workers validate it in parallel and the scheduler invokes the single importer.",
        "nodes": {
          "squad-sdk-planner": {
            "agent_id": "squad-sdk-planner",
            "description": "Publishes the import boundary, mapping responsibilities, and acceptance allocation.",
            "depends_on": []
          },
          "import-analysis": {
            "agent_id": "squad-sdk-import-analyst",
            "description": "Validates source roster, instructions, Skill closure, MCP capabilities, and portability blockers.",
            "depends_on": [
              "squad-sdk-planner"
            ]
          },
          "contract-review": {
            "agent_id": "squad-sdk-contract-reviewer",
            "description": "Independently validates the exact preview, mapping, and source digests.",
            "depends_on": [
              "squad-sdk-planner"
            ]
          }
        }
      }
    }
  }
}
