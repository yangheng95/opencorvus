{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "satellite-mission-operations",
  "name": "Satellite Mission Operations",
  "label": "Satellite Mission Operations",
  "description": "Evidence-bounded spacecraft telemetry, mission-plan, ground-contact, and telecommand-readiness review joined without live flight or ground-system authority.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound satellite mission operations evidence and qualified review preparation.",
    "selection_guidance": "Select for spacecraft telemetry state reconstruction, ground-contact and mission-resource planning evidence, or telecommand procedure and anomaly-readiness review. Do not select for live spacecraft control, orbital decisions, pass booking, or emergency response.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "satellite-mission-operations/shared/method"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "spacecraft-telemetry-health-state-analyst": {
        "label": "Spacecraft Telemetry Health State Analyst",
        "description": "Reconstructs source-bound telemetry, mode, limit-set, and event evidence without issuing alerts or operational diagnoses.",
        "base_role": "explore",
        "prompt": "agents/spacecraft-telemetry-health-state-analyst/system.md",
