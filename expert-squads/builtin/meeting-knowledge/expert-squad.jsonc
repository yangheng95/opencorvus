{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "meeting-knowledge",
  "name": "Meeting Knowledge Operations",
  "label": "Meeting Knowledge Operations",
  "description": "Source-grounded meeting capture, decision and action extraction, knowledge publication, and independent traceability review.",
  "version": "2026.08.10.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Convert meeting evidence into traceable decisions, actions, open questions, and reusable knowledge.",
    "selection_guidance": "Use when the user provides or identifies meeting transcripts, recordings, notes, chat, documents, or decisions and needs a decision log, action register, minutes, or knowledge update. Do not infer attendance, consent, agreement, ownership, or confidential publication from incomplete evidence.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": ["dispatch_agent", "manage_task", "read"],
      "default_skill_refs": [],
      "package_skill_refs": ["meeting-knowledge/shared/method"],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "meeting-evidence-curator": {
        "label": "Meeting Evidence Curator",
        "description": "Builds the canonical, timestamped source ledger from transcripts, recordings, notes, chat, and referenced documents.",
        "base_role": "delegated-worker",
        "prompt": "agents/meeting-evidence-curator/system.md",
        "inherit_base_tools": true,
