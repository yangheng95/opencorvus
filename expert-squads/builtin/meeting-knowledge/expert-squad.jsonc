{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "meeting-knowledge",
  "name": "Meeting Knowledge Operations",
  "label": "Meeting Knowledge Operations",
  "description": "Source-grounded meeting capture, decision and action extraction, knowledge publication, and independent traceability review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Convert meeting evidence into traceable decisions, actions, open questions, and reusable knowledge.",
    "selection_guidance": "Use when the user provides or identifies meeting transcripts, recordings, notes, chat, documents, or decisions and needs a decision log, action register, minutes, or knowledge update. Do not infer attendance, consent, agreement, ownership, or confidential publication from incomplete evidence.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:meeting-knowledge:meeting-knowledge%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:meeting-knowledge:meeting-knowledge%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "meeting-evidence-curator": {
        "capability_refs": [
          "capability:capability_set:package:meeting-knowledge:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Meeting Evidence Curator",
        "description": "Builds the canonical, timestamped source ledger from transcripts, recordings, notes, chat, and referenced documents.",
        "base_role": "delegated-worker",
        "prompt": "agents/meeting-evidence-curator/system.md"
      },
      "meeting-decision-analyst": {
        "capability_refs": [
          "capability:capability_set:package:meeting-knowledge:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Meeting Decision and Action Analyst",
        "description": "Classifies candidate decisions, actions, owners, dates, questions, risks, and disagreements without manufacturing consensus.",
        "base_role": "delegated-worker",
        "prompt": "agents/meeting-decision-analyst/system.md"
      },
      "meeting-knowledge-editor": {
        "capability_refs": [
          "capability:capability_set:package:meeting-knowledge:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Meeting Knowledge Editor",
        "description": "Joins source evidence and classified outcomes into canonical minutes, decision and action registers, and scoped knowledge updates.",
        "base_role": "build",
        "prompt": "agents/meeting-knowledge-editor/system.md"
      },
      "meeting-knowledge-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:meeting-knowledge:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Meeting Knowledge Reviewer",
        "description": "Independently checks attribution, timestamps, decision state, action ownership, confidentiality, contradictions, and source coverage.",
        "base_role": "fact-check",
        "prompt": "agents/meeting-knowledge-reviewer/system.md"
      }
    },
    "virtual_workflows": {
      "meeting-knowledge-publication": {
        "label": "Meeting Knowledge Publication",
        "description": "Run source curation and outcome classification concurrently, join both into one knowledge publication, then independently review source fidelity and publication boundaries.",
        "nodes": {
          "meeting-evidence-curator": {
            "agent_id": "meeting-evidence-curator",
            "description": "Produces the timestamped meeting source ledger and coverage map.",
            "depends_on": []
          },
          "meeting-decision-analyst": {
            "agent_id": "meeting-decision-analyst",
            "description": "Produces the classified decision, action, question, risk, and disagreement register.",
            "depends_on": []
          },
          "meeting-knowledge-editor": {
            "agent_id": "meeting-knowledge-editor",
            "description": "Joins both analyses into canonical minutes, registers, and scoped knowledge updates.",
            "depends_on": [
              "meeting-decision-analyst",
              "meeting-evidence-curator"
            ]
          },
          "meeting-knowledge-reviewer": {
            "agent_id": "meeting-knowledge-reviewer",
            "description": "Independently reviews the joined publication and records required corrections or withheld material.",
            "depends_on": [
              "meeting-knowledge-editor"
            ]
          }
        }
      }
    }
  }
}
