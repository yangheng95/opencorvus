{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "forestry-wildfire-resource-management",
  "name": "Forestry Wildfire Resource Management",
  "label": "Forestry Wildfire Resource Management",
  "description": "Forest inventory, fuels and wildfire risk, treatment scenarios and post-fire resource evidence joined for qualified review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded forestry and wildfire resource-management evidence.",
    "selection_guidance": "Select for forest inventory/condition, fuel/hazard/exposure, supplied treatment scenarios and non-tactical post-fire monitoring.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:forestry-wildfire-resource-management:forestry-wildfire-resource-management%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:forestry-wildfire-resource-management:forestry-wildfire-resource-management%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "forest-inventory-condition-trend-analyst": {
        "capability_refs": [
          "capability:capability_set:package:forestry-wildfire-resource-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Forest Inventory, Condition and Trend Analyst",
        "description": "Reconciles forest planning-unit, plot/stand, species, structure, health and change evidence.",
        "base_role": "explore",
        "prompt": "agents/forest-inventory-condition-trend-analyst/system.md"
      },
      "wildfire-hazard-exposure-fuels-analyst": {
        "capability_refs": [
          "capability:capability_set:package:forestry-wildfire-resource-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Wildfire Hazard, Fuel and Exposure Analyst",
        "description": "Traces supplied vegetation, fuel, topography, weather/climate and exposure datasets to bounded hazard evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/wildfire-hazard-exposure-fuels-analyst/system.md"
      },
      "forest-treatment-scenario-tradeoff-analyst": {
        "capability_refs": [
          "capability:capability_set:package:forestry-wildfire-resource-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Forest Treatment Scenario and Tradeoff Analyst",
        "description": "Compares supplied forest/fuel treatment scenarios across ecological, social, operational and cost objectives.",
        "base_role": "delegated-worker",
        "prompt": "agents/forest-treatment-scenario-tradeoff-analyst/system.md"
      },
      "wildfire-monitoring-burn-severity-recovery-analyst": {
        "capability_refs": [
          "capability:capability_set:package:forestry-wildfire-resource-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Wildfire Monitoring, Burn Severity and Recovery Analyst",
        "description": "Organizes non-tactical fire observations, perimeter/burn-severity products and post-fire resource monitoring.",
        "base_role": "delegated-worker",
        "prompt": "agents/wildfire-monitoring-burn-severity-recovery-analyst/system.md"
      },
      "forestry-wildfire-resource-management-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:forestry-wildfire-resource-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Forestry Wildfire Resource Management Review Owner",
        "description": "Joins inventory, hazard/exposure, treatment and post-fire evidence for qualified resource-management decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/forestry-wildfire-resource-management-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "forestry-wildfire-resource-management-review": {
        "label": "Forestry Wildfire Resource Management Review",
        "description": "Four independent resource evidence branches converge into an explicit review owner.",
        "nodes": {
          "forest-inventory-condition-trend-analyst": {
            "agent_id": "forest-inventory-condition-trend-analyst",
            "description": "Reconciles forest planning-unit, plot/stand, species, structure, health and change evidence.",
            "depends_on": []
          },
          "wildfire-hazard-exposure-fuels-analyst": {
            "agent_id": "wildfire-hazard-exposure-fuels-analyst",
            "description": "Traces supplied vegetation, fuel, topography, weather/climate and exposure datasets to bounded hazard evidence.",
            "depends_on": []
          },
          "forest-treatment-scenario-tradeoff-analyst": {
            "agent_id": "forest-treatment-scenario-tradeoff-analyst",
            "description": "Compares supplied forest/fuel treatment scenarios across ecological, social, operational and cost objectives.",
            "depends_on": []
          },
          "wildfire-monitoring-burn-severity-recovery-analyst": {
            "agent_id": "wildfire-monitoring-burn-severity-recovery-analyst",
            "description": "Organizes non-tactical fire observations, perimeter/burn-severity products and post-fire resource monitoring.",
            "depends_on": []
          },
          "forestry-wildfire-resource-management-review-owner": {
            "agent_id": "forestry-wildfire-resource-management-review-owner",
            "description": "Joins inventory, hazard/exposure, treatment and post-fire evidence for qualified resource-management decisions.",
            "depends_on": [
              "forest-inventory-condition-trend-analyst",
              "forest-treatment-scenario-tradeoff-analyst",
              "wildfire-hazard-exposure-fuels-analyst",
              "wildfire-monitoring-burn-severity-recovery-analyst"
            ]
          }
        }
      }
    }
  }
}
