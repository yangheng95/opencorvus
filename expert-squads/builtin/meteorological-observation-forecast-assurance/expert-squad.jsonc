{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "meteorological-observation-forecast-assurance",
  "name": "Meteorological Observation Forecast Assurance",
  "label": "Meteorological Observation Forecast Assurance",
  "description": "Station/sensor metadata, observation QC, forecast cycle provenance, alignment, and verification evidence without forecast or warning authority.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound meteorological observation and forecast assurance evidence.",
    "selection_guidance": "Select for station/sensor metadata, observation quality control, forecast issue/valid/lead-time provenance, matching, and verification. Do not select for live weather, forecasting, warnings, operational routing, or safety decisions.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:meteorological-observation-forecast-assurance:meteorological-observation-forecast-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:meteorological-observation-forecast-assurance:meteorological-observation-forecast-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "meteorological-observation-metadata-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:meteorological-observation-forecast-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Meteorological Observation Metadata Quality Analyst",
        "description": "Traces station, platform, sensor, calibration, observation, quality-control, latency, and revision evidence.",
        "base_role": "explore",
        "prompt": "agents/meteorological-observation-metadata-quality-analyst/system.md"
      },
      "forecast-cycle-provenance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:meteorological-observation-forecast-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Forecast Cycle Provenance Analyst",
        "description": "Traces producing system, model/product, cycle, issue, valid, lead-time, grid, level, member, post-processing, and revision evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/forecast-cycle-provenance-analyst/system.md"
      },
      "forecast-verification-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:meteorological-observation-forecast-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Forecast Verification Evidence Analyst",
        "description": "Aligns eligible observation–forecast pairs and prepares source-defined continuous, categorical, probabilistic, or spatial verification evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/forecast-verification-evidence-analyst/system.md"
      },
      "meteorological-observation-forecast-assurance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:meteorological-observation-forecast-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Meteorological Observation Forecast Assurance Review Owner",
        "description": "Joins observation, forecast provenance, alignment, and verification evidence while preserving official and operational decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/meteorological-observation-forecast-assurance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "meteorological-observation-forecast-assurance-review": {
        "label": "Meteorological Observation Forecast Assurance Review",
        "description": "Three independent meteorological evidence branches converge into one controlled assurance review.",
        "nodes": {
          "meteorological-observation-metadata-quality-analyst": {
            "agent_id": "meteorological-observation-metadata-quality-analyst",
            "description": "Traces station/sensor metadata, observations, and quality control.",
            "depends_on": []
          },
          "forecast-cycle-provenance-analyst": {
            "agent_id": "forecast-cycle-provenance-analyst",
            "description": "Traces exact forecast product, cycle, issue, valid, and lead-time provenance.",
            "depends_on": []
          },
          "forecast-verification-evidence-analyst": {
            "agent_id": "forecast-verification-evidence-analyst",
            "description": "Builds eligible matched pairs and source-defined verification evidence.",
            "depends_on": []
          },
          "meteorological-observation-forecast-assurance-review-owner": {
            "agent_id": "meteorological-observation-forecast-assurance-review-owner",
            "description": "Joins all evidence without forecast, warning, operational, or official-service authority.",
            "depends_on": [
              "forecast-cycle-provenance-analyst",
              "forecast-verification-evidence-analyst",
              "meteorological-observation-metadata-quality-analyst"
            ]
          }
        }
      }
    }
  }
}
