{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "energy-utilities-planning",
  "name": "Energy and Utilities Planning",
  "label": "Energy and Utilities Planning",
  "description": "Demand, supply, reliability, cost, and emissions evidence joined into a bounded utility scenario register.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed energy and utility planning scenarios.",
    "selection_guidance": "Select for demand and supply scenarios, asset constraints, reliability tradeoffs, cost and emissions evidence, or planning-stage option comparison without grid dispatch, trading, tariff, engineering, or safety authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:energy-utilities-planning:energy-utilities-planning%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:energy-utilities-planning:energy-utilities-planning%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "utility-demand-supply-analyst": {
        "capability_refs": [
          "capability:capability_set:package:energy-utilities-planning:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Demand and Supply Analyst",
        "description": "Builds sourced demand, generation, storage, and import assumptions.",
        "base_role": "explore",
        "prompt": "agents/utility-demand-supply-analyst/system.md"
      },
      "utility-reliability-constraints-analyst": {
        "capability_refs": [
          "capability:capability_set:package:energy-utilities-planning:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reliability Constraints Analyst",
        "description": "Maps asset, network, resilience, maintenance, and safety constraints.",
        "base_role": "delegated-worker",
        "prompt": "agents/utility-reliability-constraints-analyst/system.md"
      },
      "utility-cost-emissions-analyst": {
        "capability_refs": [
          "capability:capability_set:package:energy-utilities-planning:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Cost and Emissions Analyst",
        "description": "Compares sourced cost, emissions, and policy assumptions across scenarios.",
        "base_role": "delegated-worker",
        "prompt": "agents/utility-cost-emissions-analyst/system.md"
      },
      "utility-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:energy-utilities-planning:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Utility Plan Owner",
        "description": "Joins the branches into a scenario register with human decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/utility-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "utility-scenario-plan": {
        "label": "Utility Scenario Plan",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "utility-demand-supply-analyst": {
            "agent_id": "utility-demand-supply-analyst",
            "description": "Builds sourced demand, generation, storage, and import assumptions.",
            "depends_on": []
          },
          "utility-reliability-constraints-analyst": {
            "agent_id": "utility-reliability-constraints-analyst",
            "description": "Maps asset, network, resilience, maintenance, and safety constraints.",
            "depends_on": []
          },
          "utility-cost-emissions-analyst": {
            "agent_id": "utility-cost-emissions-analyst",
            "description": "Compares sourced cost, emissions, and policy assumptions across scenarios.",
            "depends_on": []
          },
          "utility-plan-owner": {
            "agent_id": "utility-plan-owner",
            "description": "Joins the branches into a scenario register with human decision gates.",
            "depends_on": [
              "utility-cost-emissions-analyst",
              "utility-demand-supply-analyst",
              "utility-reliability-constraints-analyst"
            ]
          }
        }
      }
    }
  }
}
