{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "fire-protection-engineering-assurance",
  "name": "Fire Protection Engineering Assurance",
  "label": "Fire Protection Engineering Assurance",
  "description": "Source-bound facility fire-protection basis, passive and active systems, modeling, inspection, and impairment evidence for qualified review without design, compliance, emergency, or equipment authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded fire protection engineering assurance evidence and qualified review preparation.",
    "selection_guidance": "Select for a named facility fire-protection review involving adopted-basis identity, occupancy and hazards, passive compartmentation and egress evidence, detection/alarm/suppression/water-supply interfaces, supplied fire-model provenance, inspection/testing, defects, or impairments. Do not select for chemical-process hazard analysis, wildfire resource management, incident command, emergency response, live system operation, design approval, code interpretation, evacuation orders, or compliance certification.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:fire-protection-engineering-assurance:fire-protection-engineering-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:fire-protection-engineering-assurance:fire-protection-engineering-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "fire-protection-basis-occupancy-hazard-analyst": {
        "capability_refs": [
          "capability:capability_set:package:fire-protection-engineering-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Fire Protection Basis Occupancy Hazard Analyst",
        "description": "Freezes facility, area, occupancy/use, hazard inventory, adopted authority basis, design/as-built revisions, and review applicability.",
        "base_role": "explore",
        "prompt": "agents/fire-protection-basis-occupancy-hazard-analyst/system.md"
      },
      "passive-fire-compartmentation-egress-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:fire-protection-engineering-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Passive Fire Compartmentation Egress Evidence Analyst",
        "description": "Traces rated assemblies, openings, penetrations, smoke/fire compartments, continuity, and source-defined egress evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/passive-fire-compartmentation-egress-evidence-analyst/system.md"
      },
      "active-fire-detection-suppression-water-supply-analyst": {
        "capability_refs": [
          "capability:capability_set:package:fire-protection-engineering-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Active Fire Detection Suppression Water Supply Analyst",
        "description": "Reconciles detection, alarm, notification, suppression, water supply, smoke-control, power, and cause-and-effect evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/active-fire-detection-suppression-water-supply-analyst/system.md"
      },
      "fire-modeling-inspection-impairment-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:fire-protection-engineering-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Fire Modeling Inspection Impairment Evidence Analyst",
        "description": "Preserves supplied FDS/model provenance, inspection/test/maintenance findings, impairments, compensatory measures, and restoration evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/fire-modeling-inspection-impairment-evidence-analyst/system.md"
      },
      "fire-protection-engineering-assurance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:fire-protection-engineering-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Fire Protection Engineering Assurance Review Owner",
        "description": "Joins basis, passive, active, modeling, inspection, and impairment evidence while preserving AHJ and professional authority.",
        "base_role": "delegated-worker",
        "prompt": "agents/fire-protection-engineering-assurance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "fire-protection-engineering-assurance-review": {
        "label": "Fire Protection Engineering Assurance Review",
        "description": "Four independent professional evidence branches converge into one controlled fire protection engineering assurance review.",
        "nodes": {
          "fire-protection-basis-occupancy-hazard-analyst": {
            "agent_id": "fire-protection-basis-occupancy-hazard-analyst",
            "description": "Freezes facility, area, occupancy/use, hazard inventory, adopted authority basis, design/as-built revisions, and review applicability.",
            "depends_on": []
          },
          "passive-fire-compartmentation-egress-evidence-analyst": {
            "agent_id": "passive-fire-compartmentation-egress-evidence-analyst",
            "description": "Traces rated assemblies, openings, penetrations, smoke/fire compartments, continuity, and source-defined egress evidence.",
            "depends_on": []
          },
          "active-fire-detection-suppression-water-supply-analyst": {
            "agent_id": "active-fire-detection-suppression-water-supply-analyst",
            "description": "Reconciles detection, alarm, notification, suppression, water supply, smoke-control, power, and cause-and-effect evidence.",
            "depends_on": []
          },
          "fire-modeling-inspection-impairment-evidence-analyst": {
            "agent_id": "fire-modeling-inspection-impairment-evidence-analyst",
            "description": "Preserves supplied FDS/model provenance, inspection/test/maintenance findings, impairments, compensatory measures, and restoration evidence.",
            "depends_on": []
          },
          "fire-protection-engineering-assurance-review-owner": {
            "agent_id": "fire-protection-engineering-assurance-review-owner",
            "description": "Joins basis, passive, active, modeling, inspection, and impairment evidence while preserving AHJ and professional authority.",
            "depends_on": [
              "active-fire-detection-suppression-water-supply-analyst",
              "fire-modeling-inspection-impairment-evidence-analyst",
              "fire-protection-basis-occupancy-hazard-analyst",
              "passive-fire-compartmentation-egress-evidence-analyst"
            ]
          }
        }
      }
    }
  }
}
