  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound dam inspection and surveillance evidence prepared for qualified dam-safety review.",
    "selection_guidance": "Select for dam configuration/design-authority trace, consequence context, inspection findings, instrumentation data, behavior trends, potential failure modes, controls or action verification. Do not select to operate gates, set alarm levels, declare safety, warn the public, order evacuation or approve engineering work.",
    "instructions": "selector.md"
  },
