{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "data-analysis",
  "name": "Data Analysis & Business Insights",
  "label": "Data Analysis & Business Insights",
  "description": "Turns bounded operating data into reproducible performance and segment analysis, audited business insights, and an actionable operating report.",
  "version": "2026.08.10.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for a bounded operating dataset that needs metric reconciliation, parallel performance and segment analysis, and an audited decision report.",
    "selection_guidance": "Select when the operator supplies or identifies business data, metric definitions, a time boundary, and decision questions. Use Deep Research for broad public-source questions and Equity Research for public-company valuation.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
