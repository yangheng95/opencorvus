{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "hospitality-service-operations",
  "name": "Hospitality Service Operations",
  "label": "Hospitality Service Operations",
  "description": "Guest journey, revenue and capacity, workforce, safety, and service-recovery evidence joined into a bounded hospitality operations plan.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed hospitality service-operations planning.",
    "selection_guidance": "Select for guest journeys, demand and capacity, rate or inventory hypotheses, staffing constraints, service recovery, housekeeping, food-service interfaces, or experience improvement without changing bookings, prices, inventory, staffing, payments, or safety controls.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:hospitality-service-operations:hospitality-service-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:hospitality-service-operations:hospitality-service-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "hospitality-guest-journey-analyst": {
        "capability_refs": [
          "capability:capability_set:package:hospitality-service-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Guest Journey Analyst",
        "description": "Maps booking-to-departure journeys, service moments, complaints, and recovery evidence.",
        "base_role": "explore",
        "prompt": "agents/hospitality-guest-journey-analyst/system.md"
      },
      "hospitality-revenue-capacity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:hospitality-service-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Revenue and Capacity Analyst",
        "description": "Maps demand, occupancy, rate, inventory, channel, and capacity evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/hospitality-revenue-capacity-analyst/system.md"
      },
      "hospitality-workforce-safety-analyst": {
        "capability_refs": [
          "capability:capability_set:package:hospitality-service-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Workforce and Safety Analyst",
        "description": "Maps staffing, housekeeping, food-service, maintenance, accessibility, and safety constraints.",
        "base_role": "delegated-worker",
        "prompt": "agents/hospitality-workforce-safety-analyst/system.md"
      },
      "hospitality-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:hospitality-service-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Hospitality Plan Owner",
        "description": "Joins the branches into a reversible guest-service operations plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/hospitality-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "hospitality-operations-plan": {
        "label": "Hospitality Operations Plan",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "hospitality-guest-journey-analyst": {
            "agent_id": "hospitality-guest-journey-analyst",
            "description": "Maps booking-to-departure journeys, service moments, complaints, and recovery evidence.",
            "depends_on": []
          },
          "hospitality-revenue-capacity-analyst": {
            "agent_id": "hospitality-revenue-capacity-analyst",
            "description": "Maps demand, occupancy, rate, inventory, channel, and capacity evidence.",
            "depends_on": []
          },
          "hospitality-workforce-safety-analyst": {
            "agent_id": "hospitality-workforce-safety-analyst",
            "description": "Maps staffing, housekeeping, food-service, maintenance, accessibility, and safety constraints.",
            "depends_on": []
          },
          "hospitality-plan-owner": {
            "agent_id": "hospitality-plan-owner",
            "description": "Joins the branches into a reversible guest-service operations plan.",
            "depends_on": [
              "hospitality-guest-journey-analyst",
              "hospitality-revenue-capacity-analyst",
              "hospitality-workforce-safety-analyst"
            ]
          }
        }
      }
    }
  }
}
