{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "industrial-hygiene-exposure-assessment",
  "name": "Industrial Hygiene Exposure Assessment",
  "label": "Industrial Hygiene Exposure Assessment",
  "description": "Worker, agent, similar-exposure-group, sampling, analytical-quality, exposure-limit, and control evidence joined for qualified industrial-hygiene review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded workplace exposure-assessment evidence without site, medical, PPE-selection, compliance, or reporting authority.",
    "selection_guidance": "Select for workplace agent/task/route scoping, similar exposure groups, occupational exposure-limit authority, sampling and analytical QA, time-weighted exposure calculations, control and respiratory-program evidence, and uncertainty review. Do not select for major-process-hazard analysis, clinical diagnosis, laboratory accreditation, product-quality disposition, site entry, live sampling, worker assignment, PPE or respirator selection, overexposure/compliance determinations, or employee-health reporting.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:industrial-hygiene-exposure-assessment:industrial-hygiene-exposure-assessment%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:industrial-hygiene-exposure-assessment:industrial-hygiene-exposure-assessment%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "industrial-hygiene-scope-exposure-group-analyst": {
        "capability_refs": [
          "capability:capability_set:package:industrial-hygiene-exposure-assessment:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Industrial Hygiene Scope and Exposure-group Analyst",
        "description": "Builds the worker, task, agent, route, shift, and similar-exposure-group evidence spine.",
        "base_role": "explore",
        "prompt": "agents/industrial-hygiene-scope-exposure-group-analyst/system.md"
      },
      "industrial-hygiene-sampling-analytical-qa-analyst": {
        "capability_refs": [
          "capability:capability_set:package:industrial-hygiene-exposure-assessment:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Industrial Hygiene Sampling and Analytical QA Analyst",
        "description": "Reconciles sample identity, method, calibration, blanks, laboratory results, units, censoring, and uncertainty.",
        "base_role": "delegated-worker",
        "prompt": "agents/industrial-hygiene-sampling-analytical-qa-analyst/system.md"
      },
      "industrial-hygiene-exposure-control-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:industrial-hygiene-exposure-assessment:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Industrial Hygiene Exposure and Control Evidence Analyst",
        "description": "Calculates compatible exposure measures and maps engineering, work-practice, administrative, and respiratory-program evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/industrial-hygiene-exposure-control-evidence-analyst/system.md"
      },
      "industrial-hygiene-exposure-assessment-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:industrial-hygiene-exposure-assessment:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Industrial Hygiene Exposure Assessment Review Owner",
        "description": "Joins three independent evidence branches and routes all exposure, control, medical, and compliance decisions to qualified humans.",
        "base_role": "delegated-worker",
        "prompt": "agents/industrial-hygiene-exposure-assessment-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "industrial-hygiene-exposure-assessment-review": {
        "label": "Industrial Hygiene Exposure Assessment Review",
        "description": "Three independent scope, measurement, and exposure-control branches converge into a bounded qualified-review pack.",
        "nodes": {
          "industrial-hygiene-scope-exposure-group-analyst": {
            "agent_id": "industrial-hygiene-scope-exposure-group-analyst",
            "description": "Builds the agent, task, worker, route, shift, and similar-exposure-group evidence spine.",
            "depends_on": []
          },
          "industrial-hygiene-sampling-analytical-qa-analyst": {
            "agent_id": "industrial-hygiene-sampling-analytical-qa-analyst",
            "description": "Reconciles sampling design, custody, calibration, laboratory QA, units, detection limits, and uncertainty.",
            "depends_on": []
          },
          "industrial-hygiene-exposure-control-evidence-analyst": {
            "agent_id": "industrial-hygiene-exposure-control-evidence-analyst",
            "description": "Calculates only compatible exposure measures and maps supplied control and respiratory-program evidence.",
            "depends_on": []
          },
          "industrial-hygiene-exposure-assessment-review-owner": {
            "agent_id": "industrial-hygiene-exposure-assessment-review-owner",
            "description": "Joins all three branches, preserves contradictions and unknowns, and routes professional decisions.",
            "depends_on": [
              "industrial-hygiene-exposure-control-evidence-analyst",
              "industrial-hygiene-sampling-analytical-qa-analyst",
              "industrial-hygiene-scope-exposure-group-analyst"
            ]
          }
        }
      }
    }
  }
}
