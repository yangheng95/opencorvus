  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded workplace exposure-assessment evidence without site, medical, PPE-selection, compliance, or reporting authority.",
    "selection_guidance": "Select for workplace agent/task/route scoping, similar exposure groups, occupational exposure-limit authority, sampling and analytical QA, time-weighted exposure calculations, control and respiratory-program evidence, and uncertainty review. Do not select for major-process-hazard analysis, clinical diagnosis, laboratory accreditation, product-quality disposition, site entry, live sampling, worker assignment, PPE or respirator selection, overexposure/compliance determinations, or employee-health reporting.",
    "instructions": "selector.md",
  },
