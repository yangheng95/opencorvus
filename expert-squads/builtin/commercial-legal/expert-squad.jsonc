{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "commercial-legal",
  "name": "Commercial Legal",
  "label": "Commercial Legal",
  "description": "Jurisdiction- and date-bound commercial matter planning, authority research, parallel contract and regulatory analysis, legal strategy, independent review, and canonical reporting.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for a bounded commercial contract, transaction, negotiation, or regulatory-risk review that requires current authority and a decision-ready report.",
    "selection_guidance": "Select when the user supplies or identifies the matter, client position, jurisdiction, as-of date, and documents or clauses to review. Use Deep Research for general legal scholarship without a transaction-specific legal strategy.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:commercial-legal:commercial-legal%2Fshared%2Fmethod",
        "capability:skill:package:commercial-legal:commercial-legal%2Fshared%2Fworkflow",
        "capability:tool:package:commercial-legal:commercial-legal%2Fshared%2Fpublish-commercial-legal-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:commercial-legal:commercial-legal%2Fshared%2Fmethod",
        "capability:skill:package:commercial-legal:commercial-legal%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "commercial-legal-matter-planner": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Commercial Legal Matter Planner",
        "description": "Defines the exact legal matter, client position, jurisdiction, documents, questions, source policy, and acceptance boundary.",
        "base_role": "delegated-worker",
        "prompt": "agents/commercial-legal-matter-planner/system.md"
      },
      "commercial-legal-authority-researcher": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Commercial Legal Authority Researcher",
        "description": "Builds a dated official-authority dossier and exact document-clause inventory for the bounded matter.",
        "base_role": "deep-research",
        "prompt": "agents/commercial-legal-authority-researcher/system.md"
      },
      "commercial-legal-contract-analyst": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Commercial Legal Contract Analyst",
        "description": "Performs clause-level commercial contract analysis and prepares precise revisions from the selected authority dossier.",
        "base_role": "delegated-worker",
        "prompt": "agents/commercial-legal-contract-analyst/system.md"
      },
      "commercial-legal-regulatory-analyst": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Commercial Legal Regulatory Analyst",
        "description": "Determines fact-bound regulatory applicability, obligations, exposure, and actions across the transaction.",
        "base_role": "delegated-worker",
        "prompt": "agents/commercial-legal-regulatory-analyst/system.md"
      },
      "commercial-legal-strategy-counsel": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Commercial Legal Strategy Counsel",
        "description": "Synthesizes contract and regulatory findings into prioritized revisions, negotiation positions, signing actions, and residual risk.",
        "base_role": "delegated-worker",
        "prompt": "agents/commercial-legal-strategy-counsel/system.md"
      },
      "commercial-legal-fact-checker": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Commercial Legal Fact Checker",
        "description": "Independently audits the single synthesized legal strategy for authority, clause traceability, date, jurisdiction, coverage, and calibrated conclusions.",
        "base_role": "fact-check",
        "prompt": "agents/commercial-legal-fact-checker/system.md"
      },
      "commercial-legal-report-writer": {
        "capability_refs": [
          "capability:capability_set:package:commercial-legal:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Commercial Legal Report Writer",
        "description": "Resolves the audit and publishes the canonical legal report and matching interactive document.",
        "base_role": "build",
        "prompt": "agents/commercial-legal-report-writer/system.md"
      }
    },
    "virtual_workflows": {
      "commercial-legal-review": {
        "label": "Commercial Legal Review",
        "description": "Use when the Task provides a bounded commercial matter, client position, governing jurisdictions, as-of date, and identifiable documents or clauses; every node is mandatory.",
        "nodes": {
          "commercial-legal-matter-planner": {
            "agent_id": "commercial-legal-matter-planner",
            "description": "Publishes the bounded matter charter.",
            "depends_on": []
          },
          "commercial-legal-authority-researcher": {
            "agent_id": "commercial-legal-authority-researcher",
            "description": "Publishes the official-authority dossier and clause inventory.",
            "depends_on": [
              "commercial-legal-matter-planner"
            ]
          },
          "commercial-legal-contract-analyst": {
            "agent_id": "commercial-legal-contract-analyst",
            "description": "Publishes clause-level contract analysis and revisions.",
            "depends_on": [
              "commercial-legal-authority-researcher"
            ]
          },
          "commercial-legal-regulatory-analyst": {
            "agent_id": "commercial-legal-regulatory-analyst",
            "description": "Publishes fact-bound regulatory applicability analysis.",
            "depends_on": [
              "commercial-legal-authority-researcher"
            ]
          },
          "commercial-legal-strategy-counsel": {
            "agent_id": "commercial-legal-strategy-counsel",
            "description": "Publishes the synthesized legal strategy.",
            "depends_on": [
              "commercial-legal-contract-analyst",
              "commercial-legal-regulatory-analyst"
            ]
          },
          "commercial-legal-fact-checker": {
            "agent_id": "commercial-legal-fact-checker",
            "description": "Independently audits the single synthesized strategy.",
            "depends_on": [
              "commercial-legal-strategy-counsel"
            ]
          },
          "commercial-legal-report-writer": {
            "agent_id": "commercial-legal-report-writer",
            "description": "Publishes canonical Markdown, typed report, and matching interactive document.",
            "depends_on": [
              "commercial-legal-fact-checker"
            ]
          }
        }
      }
    }
  }
}
