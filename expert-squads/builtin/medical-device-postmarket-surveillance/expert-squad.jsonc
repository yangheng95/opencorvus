{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "medical-device-postmarket-surveillance",
  "name": "Medical Device Postmarket Surveillance",
  "label": "Medical Device Postmarket Surveillance",
  "description": "Complaint, installed-base, device-event, vigilance, trend, PMCF, RWE, field-action, CAPA and risk-file evidence without reportability, recall or compliance authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound medical-device postmarket evidence preparation before qualified review.",
    "selection_guidance": "Select for device installed-base and complaint intake reconciliation, adverse-event or vigilance evidence, trend denominators, PMCF or real-world performance evidence, field-action trace, CAPA effectiveness or risk-file linkage. Do not select to decide causality, seriousness, reportability, recall, compliance, submission or clinical action.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:medical-device-postmarket-surveillance:medical-device-postmarket-surveillance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:medical-device-postmarket-surveillance:medical-device-postmarket-surveillance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "device-installed-base-complaint-intake-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-device-postmarket-surveillance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Installed Base and Complaint Intake Analyst",
        "description": "Freezes device identity, distribution exposure and complaint-source evidence without closing or recoding complaints.",
        "base_role": "explore",
        "prompt": "agents/device-installed-base-complaint-intake-quality-analyst/system.md"
      },
      "device-adverse-event-vigilance-reportability-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-device-postmarket-surveillance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Adverse Event and Vigilance Evidence Analyst",
        "description": "Traces event facts, device problems, health effects, investigation and jurisdictional rule sources without reportability decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/device-adverse-event-vigilance-reportability-evidence-analyst/system.md"
      },
      "device-trend-benefit-risk-pmcf-rwe-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-device-postmarket-surveillance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Trend Benefit-Risk PMCF and RWE Analyst",
        "description": "Reconciles counts, exposure denominators, PMCF and real-world evidence without declaring a signal or benefit-risk conclusion.",
        "base_role": "delegated-worker",
        "prompt": "agents/device-trend-benefit-risk-pmcf-rwe-analyst/system.md"
      },
      "device-field-action-capa-effectiveness-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-device-postmarket-surveillance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Field Action CAPA and Effectiveness Analyst",
        "description": "Traces proposed or recorded field actions, CAPA, verification, effectiveness and risk-file links without initiating action.",
        "base_role": "delegated-worker",
        "prompt": "agents/device-field-action-capa-effectiveness-analyst/system.md"
      },
      "medical-device-postmarket-surveillance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:medical-device-postmarket-surveillance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Medical Device Postmarket Review Owner",
        "description": "Joins installed-base, event, trend and CAPA/field-action evidence into a controlled qualified-review pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/medical-device-postmarket-surveillance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "qualified-review": {
        "label": "Medical Device Postmarket Surveillance Qualified Review",
        "description": "Four independent postmarket evidence branches converge into one controlled qualified review.",
        "nodes": {
          "device-installed-base-complaint-intake-quality-analyst": {
            "agent_id": "device-installed-base-complaint-intake-quality-analyst",
            "description": "Freezes installed-base and complaint intake evidence.",
            "depends_on": []
          },
          "device-adverse-event-vigilance-reportability-evidence-analyst": {
            "agent_id": "device-adverse-event-vigilance-reportability-evidence-analyst",
            "description": "Traces event and vigilance evidence.",
            "depends_on": []
          },
          "device-trend-benefit-risk-pmcf-rwe-analyst": {
            "agent_id": "device-trend-benefit-risk-pmcf-rwe-analyst",
            "description": "Reconciles trends, PMCF and RWE evidence.",
            "depends_on": []
          },
          "device-field-action-capa-effectiveness-analyst": {
            "agent_id": "device-field-action-capa-effectiveness-analyst",
            "description": "Traces field-action, CAPA and effectiveness evidence.",
            "depends_on": []
          },
          "medical-device-postmarket-surveillance-review-owner": {
            "agent_id": "medical-device-postmarket-surveillance-review-owner",
            "description": "Joins every branch without making a reportability, recall or compliance decision.",
            "depends_on": [
              "device-adverse-event-vigilance-reportability-evidence-analyst",
              "device-field-action-capa-effectiveness-analyst",
              "device-installed-base-complaint-intake-quality-analyst",
              "device-trend-benefit-risk-pmcf-rwe-analyst"
            ]
          }
        }
      }
    }
  }
}
