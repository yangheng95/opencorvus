        "description": "Joins source, change, and lifecycle evidence into the canonical prepared publication record.",
        "base_role": "build",
        "prompt": "agents/knowledge-publication-integrator/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["knowledge-base-operations/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
