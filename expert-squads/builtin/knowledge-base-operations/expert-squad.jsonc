        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "knowledge-change-editor": {
        "label": "Knowledge Change Editor",
        "description": "Prepares canonical additions or revisions with stable keys, material diffs, and dependency impacts.",
        "base_role": "delegated-worker",
        "prompt": "agents/knowledge-change-editor/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["knowledge-base-operations/shared/method"],
        "default_tool_refs": [],
