        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "knowledge-lifecycle-governor": {
        "label": "Knowledge Lifecycle Governor",
        "description": "Defines ownership, review, approval, deprecation, replacement, retention, and correction controls.",
        "base_role": "fact-check",
        "prompt": "agents/knowledge-lifecycle-governor/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["knowledge-base-operations/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
