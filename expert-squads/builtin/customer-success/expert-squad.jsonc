{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "customer-success",
  "name": "Customer Success Operations",
  "label": "Customer Success Operations",
  "description": "Evidence-led customer health, lifecycle, retention, handoff, and operating-plan analysis with explicit source and human-decision boundaries.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Turn customer evidence and operating facts into an auditable customer-success plan.",
    "selection_guidance": "Use for customer health, onboarding, adoption, renewal, escalation, churn-signal, voice-of-customer, or revenue-team handoff work. Do not use to invent customer evidence or automatically change a CRM, contract, price, entitlement, or account status.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:customer-success:customer-success%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:customer-success:customer-success%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "customer-success-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:customer-success:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Customer Evidence Analyst",
        "description": "Builds a dated, segmented evidence ledger from customer, support, product, commercial, and relationship records.",
        "base_role": "deep-research",
        "prompt": "agents/customer-success-evidence-analyst/system.md"
      },
      "customer-success-lifecycle-analyst": {
        "capability_refs": [
          "capability:capability_set:package:customer-success:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Customer Lifecycle Analyst",
        "description": "Maps onboarding, adoption, support, renewal, escalation, and handoff definitions, owners, and control gaps.",
        "base_role": "delegated-worker",
        "prompt": "agents/customer-success-lifecycle-analyst/system.md"
      },
      "customer-success-operations-designer": {
        "capability_refs": [
          "capability:capability_set:package:customer-success:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Customer Success Operations Designer",
        "description": "Joins evidence and lifecycle analysis into one prioritized operating plan with owners, triggers, measures, and review points.",
        "base_role": "delegated-worker",
        "prompt": "agents/customer-success-operations-designer/system.md"
      },
      "customer-success-plan-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:customer-success:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Customer Success Plan Reviewer",
        "description": "Independently checks evidence traceability, segment validity, ownership, measurement, handoff closure, and calibrated conclusions.",
        "base_role": "fact-check",
        "prompt": "agents/customer-success-plan-reviewer/system.md"
      }
    },
    "virtual_workflows": {
      "customer-success-operating-plan": {
        "label": "Customer Success Operating Plan",
        "description": "Run both bounded analyses concurrently, join their exact outputs into one operating plan, then independently review the joined result.",
        "nodes": {
          "customer-success-evidence-analyst": {
            "agent_id": "customer-success-evidence-analyst",
            "description": "Produces the dated and segmented customer evidence ledger.",
            "depends_on": []
          },
          "customer-success-lifecycle-analyst": {
            "agent_id": "customer-success-lifecycle-analyst",
            "description": "Produces the lifecycle, ownership, handoff, and control map.",
            "depends_on": []
          },
          "customer-success-operations-designer": {
            "agent_id": "customer-success-operations-designer",
            "description": "Joins both analyses into the single customer-success operating plan.",
            "depends_on": [
              "customer-success-evidence-analyst",
              "customer-success-lifecycle-analyst"
            ]
          },
          "customer-success-plan-reviewer": {
            "agent_id": "customer-success-plan-reviewer",
            "description": "Independently reviews the joined operating plan and records required corrections.",
            "depends_on": [
              "customer-success-operations-designer"
            ]
          }
        }
      }
    }
  }
}
