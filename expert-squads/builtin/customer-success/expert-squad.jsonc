{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "customer-success",
  "name": "Customer Success Operations",
  "label": "Customer Success Operations",
  "description": "Evidence-led customer health, lifecycle, retention, handoff, and operating-plan analysis with explicit source and human-decision boundaries.",
  "version": "2026.08.10.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Turn customer evidence and operating facts into an auditable customer-success plan.",
    "selection_guidance": "Use for customer health, onboarding, adoption, renewal, escalation, churn-signal, voice-of-customer, or revenue-team handoff work. Do not use to invent customer evidence or automatically change a CRM, contract, price, entitlement, or account status.",
    "instructions": "selector.md",
  },
