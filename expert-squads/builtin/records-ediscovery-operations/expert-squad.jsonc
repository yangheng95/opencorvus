{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "records-ediscovery-operations",
  "name": "Records and E-Discovery Operations",
  "label": "Records and E-Discovery Operations",
  "description": "Matter-authorized records, preservation, collection provenance, processing, review and production evidence without live collection, deletion, legal rulings or production authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound records and e-discovery operational evidence prepared for counsel and records-owner review.",
    "selection_guidance": "Select for matter authority, retention and hold sources, custodians and systems, collection provenance, processing, deduplication, families, search/review, privilege flags, request mapping and production evidence. Do not select for live collection, deletion, hold release, production, privilege/responsiveness/admissibility/spoliation decisions or legal advice.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:records-ediscovery-operations:records-ediscovery-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:records-ediscovery-operations:records-ediscovery-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "custodian-source-collection-provenance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:records-ediscovery-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Custodian Source Collection Provenance Analyst",
        "description": "Maps authorized custodians, systems, preservation and collection provenance without live collection.",
        "base_role": "delegated-worker",
        "prompt": "agents/custodian-source-collection-provenance-analyst/system.md"
      },
      "processing-dedup-search-review-analyst": {
        "capability_refs": [
          "capability:capability_set:package:records-ediscovery-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Processing Dedup Search Review Analyst",
        "description": "Reconciles processing, normalization, deduplication, family, search and review evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/processing-dedup-search-review-analyst/system.md"
      },
      "production-privilege-disposition-analyst": {
        "capability_refs": [
          "capability:capability_set:package:records-ediscovery-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Production Privilege Disposition Analyst",
        "description": "Builds request, privilege-flag, redaction, production and disposition evidence for counsel review.",
        "base_role": "delegated-worker",
        "prompt": "agents/production-privilege-disposition-analyst/system.md"
      },
      "records-authority-retention-hold-analyst": {
        "capability_refs": [
          "capability:capability_set:package:records-ediscovery-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Records Authority Retention Hold Analyst",
        "description": "Freezes matter authority, records schedules, retention, hold scope, notices and acknowledgement evidence.",
        "base_role": "explore",
        "prompt": "agents/records-authority-retention-hold-analyst/system.md"
      },
      "records-ediscovery-operations-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:records-ediscovery-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Records Ediscovery Operations Review Owner",
        "description": "Joins all records and e-discovery branches into a conflict-preserving qualified review pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/records-ediscovery-operations-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "qualified-review": {
        "label": "Records and E-Discovery Operations Qualified Review",
        "description": "Four independent records and e-discovery branches converge into one qualified review owner.",
        "nodes": {
          "custodian-source-collection-provenance-analyst": {
            "agent_id": "custodian-source-collection-provenance-analyst",
            "description": "Maps authorized custodians, systems, preservation and collection provenance without live collection.",
            "depends_on": []
          },
          "processing-dedup-search-review-analyst": {
            "agent_id": "processing-dedup-search-review-analyst",
            "description": "Reconciles processing, normalization, deduplication, family, search and review evidence.",
            "depends_on": []
          },
          "production-privilege-disposition-analyst": {
            "agent_id": "production-privilege-disposition-analyst",
            "description": "Builds request, privilege-flag, redaction, production and disposition evidence for counsel review.",
            "depends_on": []
          },
          "records-authority-retention-hold-analyst": {
            "agent_id": "records-authority-retention-hold-analyst",
            "description": "Freezes matter authority, records schedules, retention, hold scope, notices and acknowledgement evidence.",
            "depends_on": []
          },
          "records-ediscovery-operations-review-owner": {
            "agent_id": "records-ediscovery-operations-review-owner",
            "description": "Joins all records and e-discovery branches into a conflict-preserving qualified review pack.",
            "depends_on": [
              "custodian-source-collection-provenance-analyst",
              "processing-dedup-search-review-analyst",
              "production-privilege-disposition-analyst",
              "records-authority-retention-hold-analyst"
            ]
          }
        }
      }
    }
  }
}
