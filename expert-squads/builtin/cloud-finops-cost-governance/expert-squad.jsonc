{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "cloud-finops-cost-governance",
  "name": "Cloud FinOps Cost Governance",
  "label": "Cloud FinOps Cost Governance",
  "description": "Cloud cost, usage, billing quality, allocation, unit economics, forecast, commitment, optimization, anomaly, governance, and value evidence joined into a bounded FinOps review pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded technology cost and usage governance evidence without purchasing commitments, changing resources, booking entries, or setting budgets.",
    "selection_guidance": "Select for cloud, software-as-a-service, artificial-intelligence, platform, data, and other technology cost/usage ingestion; billing quality; allocation and unit economics; budget/forecast evidence; commitment and optimization candidates; anomalies; governance; and value linkage. Do not select to buy or exchange commitments, change production resources, create budgets, post accounting entries, determine tax treatment, enforce tags, contact vendors, or approve savings claims.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:cloud-finops-cost-governance:cloud-finops-cost-governance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:cloud-finops-cost-governance:cloud-finops-cost-governance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "finops-cost-usage-billing-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-finops-cost-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "FinOps Cost Usage and Billing Quality Analyst",
        "description": "Reconciles technology cost, usage, billing, currency, schema, invoice, and source-quality evidence.",
        "base_role": "explore",
        "prompt": "agents/finops-cost-usage-billing-quality-analyst/system.md"
      },
      "finops-allocation-unit-economics-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-finops-cost-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "FinOps Allocation and Unit Economics Analyst",
        "description": "Builds traceable direct, shared, and unallocated cost evidence plus versioned unit-economics calculations.",
        "base_role": "delegated-worker",
        "prompt": "agents/finops-allocation-unit-economics-analyst/system.md"
      },
      "finops-forecast-commitment-optimization-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-finops-cost-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "FinOps Forecast Commitment and Optimization Analyst",
        "description": "Compares source-grounded budget, forecast, commitment, utilization, and optimization evidence without transactions or changes.",
        "base_role": "delegated-worker",
        "prompt": "agents/finops-forecast-commitment-optimization-analyst/system.md"
      },
      "finops-anomaly-governance-value-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-finops-cost-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "FinOps Anomaly Governance and Value Analyst",
        "description": "Reconstructs cost anomalies, control ownership, exceptions, value links, and outcome uncertainty.",
        "base_role": "explore",
        "prompt": "agents/finops-anomaly-governance-value-analyst/system.md"
      },
      "cloud-finops-cost-governance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:cloud-finops-cost-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Cloud FinOps Cost Governance Review Owner",
        "description": "Joins billing, allocation, forecast, commitment, anomaly, governance, and value evidence while retaining human decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/cloud-finops-cost-governance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "cloud-finops-cost-governance-review": {
        "label": "Cloud FinOps Cost Governance Review",
        "description": "Four independent technology-cost evidence branches converge into one bounded FinOps qualified-review pack.",
        "nodes": {
          "finops-cost-usage-billing-quality-analyst": {
            "agent_id": "finops-cost-usage-billing-quality-analyst",
            "description": "Reconciles cost, usage, billing, currency, invoice, and source-quality evidence.",
            "depends_on": []
          },
          "finops-allocation-unit-economics-analyst": {
            "agent_id": "finops-allocation-unit-economics-analyst",
            "description": "Builds allocation and unit-economics evidence with formulas, denominators, and unknowns.",
            "depends_on": []
          },
          "finops-forecast-commitment-optimization-analyst": {
            "agent_id": "finops-forecast-commitment-optimization-analyst",
            "description": "Builds forecast, commitment, and optimization candidate evidence without purchasing or deployment.",
            "depends_on": []
          },
          "finops-anomaly-governance-value-analyst": {
            "agent_id": "finops-anomaly-governance-value-analyst",
            "description": "Reconstructs anomalies, governance controls, exceptions, and value evidence.",
            "depends_on": []
          },
          "cloud-finops-cost-governance-review-owner": {
            "agent_id": "cloud-finops-cost-governance-review-owner",
            "description": "Joins all four branches, preserves conflicts, and routes every decision or action to authorized humans.",
            "depends_on": [
              "finops-allocation-unit-economics-analyst",
              "finops-anomaly-governance-value-analyst",
              "finops-cost-usage-billing-quality-analyst",
              "finops-forecast-commitment-optimization-analyst"
            ]
          }
        }
      }
    }
  }
}
