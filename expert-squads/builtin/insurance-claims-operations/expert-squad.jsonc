{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "insurance-claims-operations",
  "name": "Insurance Claims Operations",
  "label": "Insurance Claims Operations",
  "description": "Claim evidence, policy traceability, and control analysis joined into a reviewable claims evidence pack without adjudication authority.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded insurance-claims evidence and process analysis.",
    "selection_guidance": "Select for claim intake, evidence completeness, policy traceability, handoff, fraud-indicator, reserve-governance, or process-improvement analysis without approving, denying, pricing, reserving, or paying a claim.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:insurance-claims-operations:insurance-claims-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:insurance-claims-operations:insurance-claims-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "claims-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:insurance-claims-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Claims Evidence Analyst",
        "description": "Maps claim chronology, documents, parties, damage evidence, and missing facts.",
        "base_role": "explore",
        "prompt": "agents/claims-evidence-analyst/system.md"
      },
      "claims-policy-traceability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:insurance-claims-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Policy Traceability Analyst",
        "description": "Maps supplied policy language, endorsements, exclusions, and unresolved interpretation questions.",
        "base_role": "delegated-worker",
        "prompt": "agents/claims-policy-traceability-analyst/system.md"
      },
      "claims-control-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:insurance-claims-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Claims Control and Risk Analyst",
        "description": "Reviews handoffs, fraud indicators, reserve governance, privacy, and process controls.",
        "base_role": "delegated-worker",
        "prompt": "agents/claims-control-risk-analyst/system.md"
      },
      "claims-evidence-pack-owner": {
        "capability_refs": [
          "capability:capability_set:package:insurance-claims-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Claims Evidence Pack Owner",
        "description": "Joins the three branches into an evidence and review register.",
        "base_role": "delegated-worker",
        "prompt": "agents/claims-evidence-pack-owner/system.md"
      }
    },
    "virtual_workflows": {
      "claims-evidence-pack": {
        "label": "Claims Evidence Pack",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "claims-evidence-analyst": {
            "agent_id": "claims-evidence-analyst",
            "description": "Maps claim chronology, documents, parties, damage evidence, and missing facts.",
            "depends_on": []
          },
          "claims-policy-traceability-analyst": {
            "agent_id": "claims-policy-traceability-analyst",
            "description": "Maps supplied policy language, endorsements, exclusions, and unresolved interpretation questions.",
            "depends_on": []
          },
          "claims-control-risk-analyst": {
            "agent_id": "claims-control-risk-analyst",
            "description": "Reviews handoffs, fraud indicators, reserve governance, privacy, and process controls.",
            "depends_on": []
          },
          "claims-evidence-pack-owner": {
            "agent_id": "claims-evidence-pack-owner",
            "description": "Joins the three branches into an evidence and review register.",
            "depends_on": [
              "claims-control-risk-analyst",
              "claims-evidence-analyst",
              "claims-policy-traceability-analyst"
            ]
          }
        }
      }
    }
  }
}
