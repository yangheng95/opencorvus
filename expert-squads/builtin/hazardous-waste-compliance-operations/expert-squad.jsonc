{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "hazardous-waste-compliance-operations",
  "name": "Hazardous Waste Compliance Operations",
  "label": "Hazardous Waste Compliance Operations",
  "description": "Source-bound waste-stream determinations, generator/accumulation evidence, and manifest-to-disposition reconciliation without legal, handling, shipping, or disposal authority.",
  "version": "2026.08.11.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-controlled hazardous-waste compliance operations.",
    "selection_guidance": "Select for waste-stream/process identity, determination evidence, generator category by site/month, accumulation-unit controls, and manifest/disposition chain reconciliation. Do not select for handling waste, emergency response, legal conclusions, signing/submitting manifests, or treatment/disposal decisions.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
