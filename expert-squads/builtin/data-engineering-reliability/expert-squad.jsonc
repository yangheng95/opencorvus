{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "data-engineering-reliability",
  "name": "Data Engineering Reliability",
  "label": "Data Engineering Reliability",
  "description": "Contract, replay-safety, and observability analysis joined into an evidence-backed data product release pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for reliable data-product and pipeline release planning.",
    "selection_guidance": "Select when data contracts, replay safety, quality, lineage, observability, and release ownership must be proven together.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:data-engineering-reliability:data-engineering-reliability%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:data-engineering-reliability:data-engineering-reliability%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "data-contract-analyst": {
        "capability_refs": [
          "capability:capability_set:package:data-engineering-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:requirements-base"
        ],
        "label": "Data Contract Analyst",
        "description": "Defines source, output, lineage, and compatibility contracts.",
        "base_role": "requirements",
        "prompt": "agents/data-contract-analyst/system.md"
      },
      "data-pipeline-resilience-analyst": {
        "capability_refs": [
          "capability:capability_set:package:data-engineering-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Pipeline Resilience Analyst",
        "description": "Analyzes idempotency, replay, backfill, ordering, and rollback.",
        "base_role": "delegated-worker",
        "prompt": "agents/data-pipeline-resilience-analyst/system.md"
      },
      "data-observability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:data-engineering-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Data Observability Analyst",
        "description": "Defines quality evidence, service indicators, alerts, and ownership.",
        "base_role": "delegated-worker",
        "prompt": "agents/data-observability-analyst/system.md"
      },
      "data-release-integrator": {
        "capability_refs": [
          "capability:capability_set:package:data-engineering-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Data Release Integrator",
        "description": "Joins contracts, resilience, and observability into one release pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/data-release-integrator/system.md"
      }
    },
    "virtual_workflows": {
      "data-product-release-pack": {
        "label": "Data Product Release Pack",
        "description": "Three independent reliability branches converge into one controlled release pack.",
        "nodes": {
          "data-contract-analyst": {
            "agent_id": "data-contract-analyst",
            "description": "Defines contracts and consumers.",
            "depends_on": []
          },
          "data-pipeline-resilience-analyst": {
            "agent_id": "data-pipeline-resilience-analyst",
            "description": "Analyzes replay and failure behavior.",
            "depends_on": []
          },
          "data-observability-analyst": {
            "agent_id": "data-observability-analyst",
            "description": "Defines observability and quality evidence.",
            "depends_on": []
          },
          "data-release-integrator": {
            "agent_id": "data-release-integrator",
            "description": "Joins all branches into the release pack.",
            "depends_on": [
              "data-contract-analyst",
              "data-observability-analyst",
              "data-pipeline-resilience-analyst"
            ]
          }
        }
      }
    }
  }
}
