{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "medical-imaging-quality-assurance",
  "name": "Medical Imaging Quality Assurance",
  "label": "Medical Imaging Quality Assurance",
  "description": "Evidence-bounded imaging equipment, protocol, phantom QC, DICOM workflow, display, dose-index, and nonconformance review without clinical or system-operation authority.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound medical-imaging QA evidence and qualified review preparation.",
    "selection_guidance": "Select for equipment/configuration baselines, phantom technical QC, DICOM transfer/display integrity, dose-index context, or imaging CAPA trends. Do not select for diagnosis, clinical image acceptance, patient-dose decisions, system operation, or accreditation decisions.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:medical-imaging-quality-assurance:medical-imaging-quality-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:medical-imaging-quality-assurance:medical-imaging-quality-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "imaging-equipment-protocol-configuration-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-imaging-quality-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Imaging Equipment Protocol Configuration Analyst",
        "description": "Reconciles device, detector, software, protocol, and approved baseline evidence.",
        "base_role": "explore",
        "prompt": "agents/imaging-equipment-protocol-configuration-analyst/system.md"
      },
      "imaging-phantom-technical-qc-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-imaging-quality-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Imaging Phantom Technical QC Analyst",
        "description": "Traces phantom procedures, technical measurements, calculations, tolerances, and uncertainty.",
        "base_role": "delegated-worker",
        "prompt": "agents/imaging-phantom-technical-qc-analyst/system.md"
      },
      "dicom-data-display-workflow-integrity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-imaging-quality-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "DICOM Data Display Workflow Integrity Analyst",
        "description": "Reconciles minimized DICOM identity, transfer, storage, derived-output, and display-chain evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/dicom-data-display-workflow-integrity-analyst/system.md"
      },
      "imaging-dose-nonconformance-trend-analyst": {
        "capability_refs": [
          "capability:capability_set:package:medical-imaging-quality-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Imaging Dose Nonconformance Trend Analyst",
        "description": "Traces modality dose-index context, nonconformance, service, retest, CAPA, and trend evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/imaging-dose-nonconformance-trend-analyst/system.md"
      },
      "medical-imaging-quality-assurance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:medical-imaging-quality-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Medical Imaging Quality Assurance Review Owner",
        "description": "Joins all four branches into a qualified-review pack while preserving clinical and operational decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/medical-imaging-quality-assurance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "medical-imaging-quality-assurance-review": {
        "label": "Medical Imaging Quality Assurance Review",
        "description": "Four independent imaging QA evidence branches converge into one controlled review.",
        "nodes": {
          "imaging-equipment-protocol-configuration-analyst": {
            "agent_id": "imaging-equipment-protocol-configuration-analyst",
            "description": "Reconciles equipment, protocol, and configuration baselines.",
            "depends_on": []
          },
          "imaging-phantom-technical-qc-analyst": {
            "agent_id": "imaging-phantom-technical-qc-analyst",
            "description": "Traces phantom QC measurements and uncertainty.",
            "depends_on": []
          },
          "dicom-data-display-workflow-integrity-analyst": {
            "agent_id": "dicom-data-display-workflow-integrity-analyst",
            "description": "Reconciles DICOM and display-chain integrity evidence.",
            "depends_on": []
          },
          "imaging-dose-nonconformance-trend-analyst": {
            "agent_id": "imaging-dose-nonconformance-trend-analyst",
            "description": "Traces dose-index, nonconformance, service, CAPA, and trends.",
            "depends_on": []
          },
          "medical-imaging-quality-assurance-review-owner": {
            "agent_id": "medical-imaging-quality-assurance-review-owner",
            "description": "Joins all evidence without clinical, operational, return-to-service, or accreditation authority.",
            "depends_on": [
              "dicom-data-display-workflow-integrity-analyst",
              "imaging-dose-nonconformance-trend-analyst",
              "imaging-equipment-protocol-configuration-analyst",
              "imaging-phantom-technical-qc-analyst"
            ]
          }
        }
      }
    }
  }
}
