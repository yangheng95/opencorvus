{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "railway-operations-safety",
  "name": "Railway Operations Safety",
  "label": "Railway Operations Safety",
  "description": "Timetable, route-capacity, signalling-restriction, service-occurrence, and assurance evidence joined into a bounded railway operations review pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded railway operating-plan and safety-assurance review without train-control authority.",
    "selection_guidance": "Select for railway timetable paths, platforms, route occupancy, approved headway evidence, signalling or infrastructure restrictions, possessions, service disruption, delay attribution, occurrences, and assurance actions. Do not select for movement authority, live signalling, dispatch, maintenance release, accident classification, or emergency command.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:railway-operations-safety:railway-operations-safety%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:railway-operations-safety:railway-operations-safety%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "railway-timetable-capacity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:railway-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Railway Timetable and Capacity Analyst",
        "description": "Reconciles train paths, platforms, route occupation, recovery time, and approved separation evidence.",
        "base_role": "explore",
        "prompt": "agents/railway-timetable-capacity-analyst/system.md"
      },
      "railway-signalling-infrastructure-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:railway-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Railway Signalling and Infrastructure Risk Analyst",
        "description": "Traces signalling, interlocking, route, possession, temporary restriction, and control evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/railway-signalling-infrastructure-risk-analyst/system.md"
      },
      "railway-service-occurrence-assurance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:railway-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Railway Service Occurrence and Assurance Analyst",
        "description": "Reconciles service performance, disruptions, occurrences, candidate attribution, controls, and assurance actions.",
        "base_role": "delegated-worker",
        "prompt": "agents/railway-service-occurrence-assurance-analyst/system.md"
      },
      "railway-operations-safety-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:railway-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Railway Operations Safety Review Owner",
        "description": "Joins three independent railway evidence branches and assigns qualified decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/railway-operations-safety-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "railway-operations-safety-review": {
        "label": "Railway Operations Safety Review",
        "description": "Three independent operating-evidence branches converge into one bounded railway assurance pack.",
        "nodes": {
          "railway-timetable-capacity-analyst": {
            "agent_id": "railway-timetable-capacity-analyst",
            "description": "Reconciles paths, platforms, route occupancy, dwell, recovery, and approved separation evidence.",
            "depends_on": []
          },
          "railway-signalling-infrastructure-risk-analyst": {
            "agent_id": "railway-signalling-infrastructure-risk-analyst",
            "description": "Traces signalling, infrastructure, possessions, restrictions, hazards, controls, and evidence.",
            "depends_on": []
          },
          "railway-service-occurrence-assurance-analyst": {
            "agent_id": "railway-service-occurrence-assurance-analyst",
            "description": "Reconciles service events, occurrences, attribution candidates, actions, and assurance status.",
            "depends_on": []
          },
          "railway-operations-safety-review-owner": {
            "agent_id": "railway-operations-safety-review-owner",
            "description": "Joins all branches, exposes conflicts and unknowns, and routes qualified decisions.",
            "depends_on": [
              "railway-service-occurrence-assurance-analyst",
              "railway-signalling-infrastructure-risk-analyst",
              "railway-timetable-capacity-analyst"
            ]
          }
        }
      }
    }
  }
}
