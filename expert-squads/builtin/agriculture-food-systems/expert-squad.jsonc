{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "agriculture-food-systems",
  "name": "Agriculture and Food Systems",
  "label": "Agriculture and Food Systems",
  "description": "Production context, resource constraints, and market and biosecurity evidence joined into a bounded seasonal system plan.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed agriculture and food-system planning.",
    "selection_guidance": "Select for seasonal production planning, resource constraints, input traceability, market evidence, biosecurity risks, or food-system coordination without prescribing regulated inputs, veterinary care, certification, or transactions.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:agriculture-food-systems:agriculture-food-systems%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:agriculture-food-systems:agriculture-food-systems%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "agriculture-production-context-analyst": {
        "capability_refs": [
          "capability:capability_set:package:agriculture-food-systems:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Production Context Analyst",
        "description": "Maps crop, livestock, climate, soil, water, and seasonal evidence.",
        "base_role": "explore",
        "prompt": "agents/agriculture-production-context-analyst/system.md"
      },
      "agriculture-resource-input-analyst": {
        "capability_refs": [
          "capability:capability_set:package:agriculture-food-systems:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Resource and Input Analyst",
        "description": "Maps labor, equipment, input, water, storage, and traceability constraints.",
        "base_role": "delegated-worker",
        "prompt": "agents/agriculture-resource-input-analyst/system.md"
      },
      "agriculture-market-biosecurity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:agriculture-food-systems:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Market and Biosecurity Analyst",
        "description": "Maps demand, logistics, food-safety, biosecurity, and market risks.",
        "base_role": "delegated-worker",
        "prompt": "agents/agriculture-market-biosecurity-analyst/system.md"
      },
      "food-system-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:agriculture-food-systems:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Food-System Plan Owner",
        "description": "Joins the branches into a bounded season and food-system plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/food-system-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "season-food-system-plan": {
        "label": "Season and Food-System Plan",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "agriculture-production-context-analyst": {
            "agent_id": "agriculture-production-context-analyst",
            "description": "Maps crop, livestock, climate, soil, water, and seasonal evidence.",
            "depends_on": []
          },
          "agriculture-resource-input-analyst": {
            "agent_id": "agriculture-resource-input-analyst",
            "description": "Maps labor, equipment, input, water, storage, and traceability constraints.",
            "depends_on": []
          },
          "agriculture-market-biosecurity-analyst": {
            "agent_id": "agriculture-market-biosecurity-analyst",
            "description": "Maps demand, logistics, food-safety, biosecurity, and market risks.",
            "depends_on": []
          },
          "food-system-plan-owner": {
            "agent_id": "food-system-plan-owner",
            "description": "Joins the branches into a bounded season and food-system plan.",
            "depends_on": [
              "agriculture-market-biosecurity-analyst",
              "agriculture-production-context-analyst",
              "agriculture-resource-input-analyst"
            ]
          }
        }
      }
    }
  }
}
