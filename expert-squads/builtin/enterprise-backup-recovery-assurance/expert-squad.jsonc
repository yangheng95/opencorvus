{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "enterprise-backup-recovery-assurance",
  "name": "Enterprise Backup Recovery Assurance",
  "label": "Enterprise Backup Recovery Assurance",
  "description": "Workload scope, backup-copy, integrity and isolated-restore evidence joined for qualified recovery assurance.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded backup recoverability evidence without live backup or restore actions.",
    "selection_guidance": "Select for workload/recovery scope, copy/retention/immutability, catalog/hash integrity and isolated restore validation.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:enterprise-backup-recovery-assurance:enterprise-backup-recovery-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:enterprise-backup-recovery-assurance:enterprise-backup-recovery-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "workload-recovery-scope-analyst": {
        "capability_refs": [
          "capability:capability_set:package:enterprise-backup-recovery-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Workload and Recovery Scope Analyst",
        "description": "Freezes workload, data, dependency and human-owned recovery-objective evidence.",
        "base_role": "explore",
        "prompt": "agents/workload-recovery-scope-analyst/system.md"
      },
      "backup-copy-retention-immutability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:enterprise-backup-recovery-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Backup Copy, Retention and Immutability Analyst",
        "description": "Reconciles backup jobs, copies, retention and supplied immutability evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/backup-copy-retention-immutability-analyst/system.md"
      },
      "backup-catalog-hash-integrity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:enterprise-backup-recovery-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Backup Catalog and Hash Integrity Analyst",
        "description": "Tests supplied catalog, manifest, checksum and completeness evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/backup-catalog-hash-integrity-analyst/system.md"
      },
      "isolated-restore-recovery-validation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:enterprise-backup-recovery-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Isolated Restore and Recovery Validation Analyst",
        "description": "Reviews authorized isolated restore tests and recovery validation evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/isolated-restore-recovery-validation-analyst/system.md"
      },
      "enterprise-backup-recovery-assurance-owner": {
        "capability_refs": [
          "capability:capability_set:package:enterprise-backup-recovery-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Enterprise Backup Recovery Assurance Owner",
        "description": "Joins scope, copy, integrity and isolated restore evidence without executing recovery.",
        "base_role": "delegated-worker",
        "prompt": "agents/enterprise-backup-recovery-assurance-owner/system.md"
      }
    },
    "virtual_workflows": {
      "enterprise-backup-recovery-assurance-review": {
        "label": "Enterprise Backup Recovery Assurance Review",
        "description": "Four independent professional evidence branches converge into Enterprise Backup Recovery Assurance Owner.",
        "nodes": {
          "workload-recovery-scope-analyst": {
            "agent_id": "workload-recovery-scope-analyst",
            "description": "Freezes workload, data, dependency and human-owned recovery-objective evidence.",
            "depends_on": []
          },
          "backup-copy-retention-immutability-analyst": {
            "agent_id": "backup-copy-retention-immutability-analyst",
            "description": "Reconciles backup jobs, copies, retention and supplied immutability evidence.",
            "depends_on": []
          },
          "backup-catalog-hash-integrity-analyst": {
            "agent_id": "backup-catalog-hash-integrity-analyst",
            "description": "Tests supplied catalog, manifest, checksum and completeness evidence.",
            "depends_on": []
          },
          "isolated-restore-recovery-validation-analyst": {
            "agent_id": "isolated-restore-recovery-validation-analyst",
            "description": "Reviews authorized isolated restore tests and recovery validation evidence.",
            "depends_on": []
          },
          "enterprise-backup-recovery-assurance-owner": {
            "agent_id": "enterprise-backup-recovery-assurance-owner",
            "description": "Joins scope, copy, integrity and isolated restore evidence without executing recovery.",
            "depends_on": [
              "backup-catalog-hash-integrity-analyst",
              "backup-copy-retention-immutability-analyst",
              "isolated-restore-recovery-validation-analyst",
              "workload-recovery-scope-analyst"
            ]
          }
        }
      }
    }
  }
}
