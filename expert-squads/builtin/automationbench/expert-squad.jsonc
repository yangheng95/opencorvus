{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "automationbench",
  "name": "AutomationBench",
  "label": "AutomationBench",
  "description": "Execute simulated cross-application business workflows and independently verify exact outcomes through the official AutomationBench API tools.",
  "version": "2026.09.25.5",
  "product_pillars": ["code", "work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for official AutomationBench API-mode tasks.",
    "selection_guidance": "Requires a sample-scoped automationbench MCP server supplied by the Inspect harness. A read-only source reviewer establishes eligibility before the sole executor mutates; a separate verifier checks current records and exact receipts afterward.",
    "instructions": "selector.md",
  },
  "capability_sets": {},
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
    },
    "agents": {
      "automationbench-source-reviewer": {
        "capability_refs": [
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_fetch",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_search",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fbase64_encode",
        ],
        "label": "AutomationBench Source Reviewer",
        "description": "Reads authoritative policy, current updates and exclusions before business mutation and hands off the eligible set with source evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/automationbench-source-reviewer/system.md",
      },
      "automationbench-executor": {
        "capability_refs": [
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_fetch",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_search",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fbase64_encode",
        ],
        "label": "AutomationBench Executor",
        "description": "Discovers source records, executes authorized simulated business mutations and preserves exact receipts.",
        "base_role": "delegated-worker",
        "prompt": "agents/automationbench-executor/system.md",
      },
      "automationbench-verifier": {
        "capability_refs": [
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_fetch",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fapi_search",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fautomationbench%2Ftool%2Fbase64_encode",
        ],
        "label": "AutomationBench Verifier",
        "description": "Independently maps original requirements to exact records and receipts after execution settles.",
        "base_role": "delegated-worker",
        "prompt": "agents/automationbench-verifier/system.md",
      },
    },
    "virtual_workflows": {
      "review-execute-verify": {
        "label": "Review sources, execute and verify",
        "description": "Read-only source eligibility review precedes the sole mutation owner and independent outcome verification.",
        "nodes": {
          "automationbench-source-reviewer": {
            "agent_id": "automationbench-source-reviewer",
            "description": "Resolve current governing records, exclusions and eligible entities before any mutation.",
            "depends_on": [],
          },
          "automationbench-executor": {
            "agent_id": "automationbench-executor",
            "description": "Resolve source facts, execute the business request and preserve evidence.",
            "depends_on": ["automationbench-source-reviewer"],
          },
          "automationbench-verifier": {
            "agent_id": "automationbench-verifier",
            "description": "Verify current outcomes independently from the original request and source records.",
            "depends_on": ["automationbench-executor"],
          },
        },
      },
    },
  },
}
