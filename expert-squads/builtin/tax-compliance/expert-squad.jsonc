{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "tax-compliance",
  "name": "Tax Compliance",
  "label": "Tax Compliance",
  "description": "Dated official-authority research, parallel accounting-controls and tax-obligation analysis, remediation planning, independent review, and canonical compliance reporting.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for a bounded accounting and tax compliance assessment that requires official authority, reproducible calculations, remediation, and a decision-ready report.",
    "selection_guidance": "Select when the user identifies entities, jurisdictions, reporting periods, transactions, reporting framework, and records or explicit data gaps. Use general research when no entity- and period-specific compliance plan is requested.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:tax-compliance:tax-compliance%2Fshared%2Fmethod",
        "capability:skill:package:tax-compliance:tax-compliance%2Fshared%2Fworkflow",
        "capability:tool:package:tax-compliance:tax-compliance%2Fshared%2Fpublish-tax-compliance-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:tax-compliance:tax-compliance%2Fshared%2Fmethod",
        "capability:skill:package:tax-compliance:tax-compliance%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "tax-compliance-engagement-planner": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Tax Compliance Engagement Planner",
        "description": "Defines entities, jurisdictions, periods, reporting framework, transactions, taxes, materiality, data cutoff, and questions.",
        "base_role": "delegated-worker",
        "prompt": "agents/tax-compliance-engagement-planner/system.md"
      },
      "tax-compliance-authority-researcher": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Tax Compliance Authority Researcher",
        "description": "Builds a dated official-authority and accounting-record evidence dossier for the bounded engagement.",
        "base_role": "deep-research",
        "prompt": "agents/tax-compliance-authority-researcher/system.md"
      },
      "tax-compliance-accounting-controls-analyst": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Tax Compliance Accounting Controls Analyst",
        "description": "Analyzes accounting treatment, journal-entry logic, book-to-tax differences, reconciliations, document chains, and controls.",
        "base_role": "delegated-worker",
        "prompt": "agents/tax-compliance-accounting-controls-analyst/system.md"
      },
      "tax-compliance-tax-obligation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Tax Compliance Tax Obligation Analyst",
        "description": "Determines fact-bound tax obligations, rates or treatments, deadlines, calculations, filing positions, and evidence needs.",
        "base_role": "delegated-worker",
        "prompt": "agents/tax-compliance-tax-obligation-analyst/system.md"
      },
      "tax-compliance-remediation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Tax Compliance Remediation Analyst",
        "description": "Synthesizes accounting and tax findings into a prioritized compliance plan, reconciliation, calendar, and evidence-retention program.",
        "base_role": "delegated-worker",
        "prompt": "agents/tax-compliance-remediation-analyst/system.md"
      },
      "tax-compliance-fact-checker": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Tax Compliance Fact Checker",
        "description": "Independently audits the single synthesized compliance plan for authority, period, rate, arithmetic, reconciliation, coverage, and calibrated conclusions.",
        "base_role": "fact-check",
        "prompt": "agents/tax-compliance-fact-checker/system.md"
      },
      "tax-compliance-report-writer": {
        "capability_refs": [
          "capability:capability_set:package:tax-compliance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Tax Compliance Report Writer",
        "description": "Resolves the audit and publishes the canonical tax compliance report and matching interactive document.",
        "base_role": "build",
        "prompt": "agents/tax-compliance-report-writer/system.md"
      }
    },
    "virtual_workflows": {
      "tax-compliance-assessment": {
        "label": "Tax Compliance Assessment",
        "description": "Use when the Task provides identifiable entities, jurisdictions, reporting periods, transactions, reporting framework, and accounting or filing records or explicit data gaps; every node is mandatory.",
        "nodes": {
          "tax-compliance-engagement-planner": {
            "agent_id": "tax-compliance-engagement-planner",
            "description": "Publishes the bounded engagement charter.",
            "depends_on": []
          },
          "tax-compliance-authority-researcher": {
            "agent_id": "tax-compliance-authority-researcher",
            "description": "Publishes the official-authority and accounting-record dossier.",
            "depends_on": [
              "tax-compliance-engagement-planner"
            ]
          },
          "tax-compliance-accounting-controls-analyst": {
            "agent_id": "tax-compliance-accounting-controls-analyst",
            "description": "Publishes accounting, reconciliation, document-chain, and control analysis.",
            "depends_on": [
              "tax-compliance-authority-researcher"
            ]
          },
          "tax-compliance-tax-obligation-analyst": {
            "agent_id": "tax-compliance-tax-obligation-analyst",
            "description": "Publishes tax obligation, filing, and calculation analysis.",
            "depends_on": [
              "tax-compliance-authority-researcher"
            ]
          },
          "tax-compliance-remediation-analyst": {
            "agent_id": "tax-compliance-remediation-analyst",
            "description": "Publishes the synthesized compliance and remediation plan.",
            "depends_on": [
              "tax-compliance-accounting-controls-analyst",
              "tax-compliance-tax-obligation-analyst"
            ]
          },
          "tax-compliance-fact-checker": {
            "agent_id": "tax-compliance-fact-checker",
            "description": "Independently audits the single synthesized compliance plan.",
            "depends_on": [
              "tax-compliance-remediation-analyst"
            ]
          },
          "tax-compliance-report-writer": {
            "agent_id": "tax-compliance-report-writer",
            "description": "Publishes canonical Markdown, typed report, and matching interactive document.",
            "depends_on": [
              "tax-compliance-fact-checker"
            ]
          }
        }
      }
    }
  }
}
