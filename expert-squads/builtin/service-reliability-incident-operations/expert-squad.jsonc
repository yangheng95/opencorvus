{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "service-reliability-incident-operations",
  "name": "Service Reliability Incident Operations",
  "label": "Service Reliability Incident Operations",
  "description": "Service-level, observability, alert-quality, incident coordination, handoff, post-incident learning, and action evidence joined into a bounded reliability review pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded service reliability and incident evidence without production mitigation, severity declaration, paging, or external communication.",
    "selection_guidance": "Select for service and dependency identity, service-level indicator/objective and error-budget evidence, telemetry and alert quality, incident timeline and impact evidence, role and handoff context, post-incident contributing factors, learning, and owned follow-up actions. Do not select to declare severity, page responders, run production commands, change infrastructure or code, issue status updates, attribute a security incident, declare root cause, or approve closure.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:service-reliability-incident-operations:service-reliability-incident-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:service-reliability-incident-operations:service-reliability-incident-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "reliability-sli-slo-error-budget-analyst": {
        "capability_refs": [
          "capability:capability_set:package:service-reliability-incident-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reliability SLI SLO and Error Budget Analyst",
        "description": "Reconciles service boundaries, service-level indicator/objective definitions, measurements, windows, exclusions, and error-budget evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/reliability-sli-slo-error-budget-analyst/system.md"
      },
      "reliability-observability-alert-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:service-reliability-incident-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Reliability Observability and Alert Quality Analyst",
        "description": "Maps telemetry, instrumentation, queries, alert states, routing evidence, blind spots, and signal quality.",
        "base_role": "explore",
        "prompt": "agents/reliability-observability-alert-quality-analyst/system.md"
      },
      "reliability-incident-coordination-handoff-analyst": {
        "capability_refs": [
          "capability:capability_set:package:service-reliability-incident-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reliability Incident Coordination and Handoff Analyst",
        "description": "Builds an evidence-sourced incident timeline, impact record, role ledger, decision log, and handoff context without command authority.",
        "base_role": "delegated-worker",
        "prompt": "agents/reliability-incident-coordination-handoff-analyst/system.md"
      },
      "reliability-postincident-learning-action-analyst": {
        "capability_refs": [
          "capability:capability_set:package:service-reliability-incident-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Reliability Post-incident Learning and Action Analyst",
        "description": "Separates observations, contributing factors, hypotheses, counterevidence, learning, and owned action evidence.",
        "base_role": "explore",
        "prompt": "agents/reliability-postincident-learning-action-analyst/system.md"
      },
      "service-reliability-incident-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:service-reliability-incident-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Service Reliability Incident Review Owner",
        "description": "Joins SLO, observability, incident, handoff, learning, and action evidence while retaining human operational authority.",
        "base_role": "delegated-worker",
        "prompt": "agents/service-reliability-incident-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "service-reliability-incident-review": {
        "label": "Service Reliability Incident Review",
        "description": "Four independent reliability and incident evidence branches converge into one bounded qualified-review pack.",
        "nodes": {
          "reliability-sli-slo-error-budget-analyst": {
            "agent_id": "reliability-sli-slo-error-budget-analyst",
            "description": "Reconciles service boundaries, SLI/SLO definitions, windows, exclusions, and error-budget evidence.",
            "depends_on": []
          },
          "reliability-observability-alert-quality-analyst": {
            "agent_id": "reliability-observability-alert-quality-analyst",
            "description": "Maps telemetry, queries, alerts, routing, blind spots, and signal quality.",
            "depends_on": []
          },
          "reliability-incident-coordination-handoff-analyst": {
            "agent_id": "reliability-incident-coordination-handoff-analyst",
            "description": "Builds incident timeline, impact, roles, decision, and handoff evidence without operational command.",
            "depends_on": []
          },
          "reliability-postincident-learning-action-analyst": {
            "agent_id": "reliability-postincident-learning-action-analyst",
            "description": "Builds blameless contributing-factor, counterevidence, learning, and action records.",
            "depends_on": []
          },
          "service-reliability-incident-review-owner": {
            "agent_id": "service-reliability-incident-review-owner",
            "description": "Joins all four branches, preserves conflicts and unknowns, and routes every production decision to authorized responders.",
            "depends_on": [
              "reliability-incident-coordination-handoff-analyst",
              "reliability-observability-alert-quality-analyst",
              "reliability-postincident-learning-action-analyst",
              "reliability-sli-slo-error-budget-analyst"
            ]
          }
        }
      }
    }
  }
}
