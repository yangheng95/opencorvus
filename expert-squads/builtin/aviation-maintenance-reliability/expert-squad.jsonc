{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "aviation-maintenance-reliability",
  "name": "Aviation Maintenance Reliability",
  "label": "Aviation Maintenance Reliability",
  "description": "Aircraft configuration, maintenance reliability, and planning evidence joined into an authorized airworthiness review pack without maintenance or release authority.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded aircraft maintenance reliability evidence and planning review.",
    "selection_guidance": "Select for aircraft configuration reconciliation, life-limited-part status, maintenance-event reliability, repeat defects, due-work planning, or continuing-airworthiness review preparation without issuing maintenance instructions or return-to-service approval.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:aviation-maintenance-reliability:aviation-maintenance-reliability%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:aviation-maintenance-reliability:aviation-maintenance-reliability%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "aircraft-configuration-records-analyst": {
        "capability_refs": [
          "capability:capability_set:package:aviation-maintenance-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Aircraft Configuration and Records Analyst",
        "description": "Reconciles serialized aircraft configuration, life limits, maintenance records, and supplied applicability evidence.",
        "base_role": "explore",
        "prompt": "agents/aircraft-configuration-records-analyst/system.md"
      },
      "maintenance-reliability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:aviation-maintenance-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Maintenance Reliability Analyst",
        "description": "Analyzes exposure-normalized maintenance events, repeats, removals, and stratified reliability evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/maintenance-reliability-analyst/system.md"
      },
      "maintenance-planning-airworthiness-analyst": {
        "capability_refs": [
          "capability:capability_set:package:aviation-maintenance-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Maintenance Planning and Airworthiness Analyst",
        "description": "Traces due work, approved-program revisions, deferrals, dependencies, and authorized review needs.",
        "base_role": "delegated-worker",
        "prompt": "agents/maintenance-planning-airworthiness-analyst/system.md"
      },
      "aviation-maintenance-reliability-owner": {
        "capability_refs": [
          "capability:capability_set:package:aviation-maintenance-reliability:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Aviation Maintenance Reliability Owner",
        "description": "Joins configuration, reliability, and planning evidence into a qualified-review decision pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/aviation-maintenance-reliability-owner/system.md"
      }
    },
    "virtual_workflows": {
      "aviation-maintenance-reliability-review": {
        "label": "Aviation Maintenance Reliability Review",
        "description": "Three independent aircraft evidence branches converge into one authorized-review pack.",
        "nodes": {
          "aircraft-configuration-records-analyst": {
            "agent_id": "aircraft-configuration-records-analyst",
            "description": "Reconciles configuration, life limits, records, and applicability.",
            "depends_on": []
          },
          "maintenance-reliability-analyst": {
            "agent_id": "maintenance-reliability-analyst",
            "description": "Analyzes exposure-normalized reliability evidence.",
            "depends_on": []
          },
          "maintenance-planning-airworthiness-analyst": {
            "agent_id": "maintenance-planning-airworthiness-analyst",
            "description": "Traces due work and qualified airworthiness review needs.",
            "depends_on": []
          },
          "aviation-maintenance-reliability-owner": {
            "agent_id": "aviation-maintenance-reliability-owner",
            "description": "Joins all three branches without issuing an airworthiness or release decision.",
            "depends_on": [
              "aircraft-configuration-records-analyst",
              "maintenance-planning-airworthiness-analyst",
              "maintenance-reliability-analyst"
            ]
          }
        }
      }
    }
  }
}
