{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "seo-geo",
  "name": "SEO & Generative Engine Optimization",
  "label": "SEO & Generative Engine Optimization",
  "description": "Evidence-led search and generative discovery research, technical/content analysis, and prioritized optimization planning.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Diagnose and improve search-engine and generative-engine discoverability with dated evidence.",
    "selection_guidance": "Use for Search Engine Optimization (SEO), Generative Engine Optimization (GEO), source visibility, content architecture, and measurement. Do not use to guarantee ranking, indexing, citation, or model mention.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:seo-geo:seo-geo%2Fshared%2Fmethod",
        "capability:skill:package:seo-geo:seo-geo%2Fshared%2Fworkflow",
        "capability:tool:package:seo-geo:seo-geo%2Fshared%2Fpublish-seo-geo-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:seo-geo:seo-geo%2Fshared%2Fmethod",
        "capability:skill:package:seo-geo:seo-geo%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "seo-geo-planner": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "SEO and GEO Planner",
        "description": "Defines the discovery scope, targets, questions, evidence, and acceptance measures.",
        "base_role": "delegated-worker",
        "prompt": "agents/seo-geo-planner/system.md"
      },
      "seo-geo-source-researcher": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Discovery Source Researcher",
        "description": "Builds a current dossier from first-party pages, search guidance, observed results, and authoritative sources.",
        "base_role": "deep-research",
        "prompt": "agents/seo-geo-source-researcher/system.md"
      },
      "seo-geo-search-analyst": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Search Optimization Analyst",
        "description": "Analyzes technical and content search discoverability with reproducible observations.",
        "base_role": "delegated-worker",
        "prompt": "agents/seo-geo-search-analyst/system.md"
      },
      "seo-geo-generative-analyst": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Generative Discovery Analyst",
        "description": "Analyzes entity clarity, answer extractability, source corroboration, and current generative discovery evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/seo-geo-generative-analyst/system.md"
      },
      "seo-geo-strategist": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Discoverability Strategy Synthesizer",
        "description": "Combines search and generative evidence into one prioritized implementation and measurement strategy.",
        "base_role": "delegated-worker",
        "prompt": "agents/seo-geo-strategist/system.md"
      },
      "seo-geo-fact-checker": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "SEO and GEO Fact Checker",
        "description": "Audits evidence, observations, recommendation mechanisms, dates, scope, and unsupported ranking claims.",
        "base_role": "fact-check",
        "prompt": "agents/seo-geo-fact-checker/system.md"
      },
      "seo-geo-plan-writer": {
        "capability_refs": [
          "capability:capability_set:package:seo-geo:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "SEO and GEO Optimization Plan Writer",
        "description": "Owns the corrected canonical optimization plan and interactive delivery.",
        "base_role": "build",
        "prompt": "agents/seo-geo-plan-writer/system.md"
      }
    },
    "virtual_workflows": {
      "search-generative-discovery-plan": {
        "label": "Search and Generative Discovery Plan",
        "description": "Binding SEO & Generative Engine Optimization workflow. Every node runs exactly once; independent branches start concurrently and joins wait for every predecessor.",
        "nodes": {
          "seo-geo-planner": {
            "agent_id": "seo-geo-planner",
            "description": "Defines the discovery scope, targets, questions, evidence, and acceptance measures.",
            "depends_on": []
          },
          "seo-geo-source-researcher": {
            "agent_id": "seo-geo-source-researcher",
            "description": "Builds a current dossier from first-party pages, search guidance, observed results, and authoritative sources.",
            "depends_on": [
              "seo-geo-planner"
            ]
          },
          "seo-geo-search-analyst": {
            "agent_id": "seo-geo-search-analyst",
            "description": "Analyzes technical and content search discoverability with reproducible observations.",
            "depends_on": [
              "seo-geo-source-researcher"
            ]
          },
          "seo-geo-generative-analyst": {
            "agent_id": "seo-geo-generative-analyst",
            "description": "Analyzes entity clarity, answer extractability, source corroboration, and current generative discovery evidence.",
            "depends_on": [
              "seo-geo-source-researcher"
            ]
          },
          "seo-geo-strategist": {
            "agent_id": "seo-geo-strategist",
            "description": "Combines search and generative evidence into one prioritized implementation and measurement strategy.",
            "depends_on": [
              "seo-geo-generative-analyst",
              "seo-geo-search-analyst"
            ]
          },
          "seo-geo-fact-checker": {
            "agent_id": "seo-geo-fact-checker",
            "description": "Audits evidence, observations, recommendation mechanisms, dates, scope, and unsupported ranking claims.",
            "depends_on": [
              "seo-geo-strategist"
            ]
          },
          "seo-geo-plan-writer": {
            "agent_id": "seo-geo-plan-writer",
            "description": "Owns the corrected canonical optimization plan and interactive delivery.",
            "depends_on": [
              "seo-geo-fact-checker"
            ]
          }
        }
      }
    }
  }
}
