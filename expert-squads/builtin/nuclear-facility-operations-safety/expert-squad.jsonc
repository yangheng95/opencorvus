{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "nuclear-facility-operations-safety",
  "name": "Nuclear Facility Operations Safety",
  "label": "Nuclear Facility Operations Safety",
  "description": "Configuration, design-basis, plant-state, defence-in-depth, barrier, event, and operating-experience evidence joined into a bounded nuclear-safety review pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded nuclear-facility configuration and operations-safety evidence without control, operability, reportability, or licensing authority.",
    "selection_guidance": "Select for nuclear facility design/licensing basis, physical-document-requirement configuration alignment, plant-state evidence, safety functions, defence in depth, barriers, surveillance/test records, events, corrective actions, and operating experience. Do not select for reactor operation, reactivity or setpoint change, operability or Technical Specification determination, event classification/reportability, radiation-dose decision, emergency command, maintenance instruction, modification approval, startup, shutdown, or safety acceptance.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:nuclear-facility-operations-safety:nuclear-facility-operations-safety%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:nuclear-facility-operations-safety:nuclear-facility-operations-safety%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "nuclear-configuration-design-basis-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nuclear-facility-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Nuclear Configuration and Design-basis Analyst",
        "description": "Reconciles design requirements, physical configuration, facility documents, temporary changes, and work records.",
        "base_role": "explore",
        "prompt": "agents/nuclear-configuration-design-basis-analyst/system.md"
      },
      "nuclear-defence-in-depth-barrier-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nuclear-facility-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Nuclear Defence-in-depth and Barrier Analyst",
        "description": "Maps supplied safety functions, SSCs, barriers, controls, dependencies, availability evidence, and unknowns.",
        "base_role": "delegated-worker",
        "prompt": "agents/nuclear-defence-in-depth-barrier-analyst/system.md"
      },
      "nuclear-event-operating-experience-analyst": {
        "capability_refs": [
          "capability:capability_set:package:nuclear-facility-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Nuclear Event and Operating-experience Analyst",
        "description": "Reconstructs event chronology, challenged safety functions, notifications, operating experience, and action evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/nuclear-event-operating-experience-analyst/system.md"
      },
      "nuclear-operations-safety-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:nuclear-facility-operations-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Nuclear Operations Safety Review Owner",
        "description": "Joins three independent evidence branches and routes every nuclear-safety decision to licensed and qualified authorities.",
        "base_role": "delegated-worker",
        "prompt": "agents/nuclear-operations-safety-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "nuclear-facility-operations-safety-review": {
        "label": "Nuclear Facility Operations Safety Review",
        "description": "Three independent configuration, barrier, and event branches converge into a bounded qualified-review pack.",
        "nodes": {
          "nuclear-configuration-design-basis-analyst": {
            "agent_id": "nuclear-configuration-design-basis-analyst",
            "description": "Reconciles design requirements, physical configuration, controlled documents, changes, and work evidence.",
            "depends_on": []
          },
          "nuclear-defence-in-depth-barrier-analyst": {
            "agent_id": "nuclear-defence-in-depth-barrier-analyst",
            "description": "Maps supplied safety functions, SSCs, defence levels, barriers, controls, dependencies, and evidence.",
            "depends_on": []
          },
          "nuclear-event-operating-experience-analyst": {
            "agent_id": "nuclear-event-operating-experience-analyst",
            "description": "Reconstructs events, challenged functions, notifications, corrective actions, and operating experience.",
            "depends_on": []
          },
          "nuclear-operations-safety-review-owner": {
            "agent_id": "nuclear-operations-safety-review-owner",
            "description": "Joins all branches, preserves contradiction and unknowns, and routes licensed decisions.",
            "depends_on": [
              "nuclear-configuration-design-basis-analyst",
              "nuclear-defence-in-depth-barrier-analyst",
              "nuclear-event-operating-experience-analyst"
            ]
          }
        }
      }
    }
  }
}
