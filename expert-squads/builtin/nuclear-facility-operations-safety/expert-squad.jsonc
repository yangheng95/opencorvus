  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded nuclear-facility configuration and operations-safety evidence without control, operability, reportability, or licensing authority.",
    "selection_guidance": "Select for nuclear facility design/licensing basis, physical-document-requirement configuration alignment, plant-state evidence, safety functions, defence in depth, barriers, surveillance/test records, events, corrective actions, and operating experience. Do not select for reactor operation, reactivity or setpoint change, operability or Technical Specification determination, event classification/reportability, radiation-dose decision, emergency command, maintenance instruction, modification approval, startup, shutdown, or safety acceptance.",
    "instructions": "selector.md"
  },
