        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "browser-interaction-auditor": {
        "label": "Browser Interaction Auditor",
        "description": "Exercises declared interaction scenarios and records visible outcomes, state transitions, and unresolved blockers.",
        "base_role": "visual-qa",
        "prompt": "agents/browser-interaction-auditor/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["browser-research-acceptance/shared/browser-evidence-acceptance"],
