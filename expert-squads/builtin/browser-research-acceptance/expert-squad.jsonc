{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "browser-research-acceptance",
  "name": "Browser Research & Acceptance",
  "label": "Browser Research & Acceptance",
  "description": "Plans bounded browser research, then runs independent real-page observation and criterion-level acceptance workers in parallel.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use when a result depends on current rendered pages, observable browser interaction, and evidence-backed acceptance.",
    "selection_guidance": "Select this package for browser research or UI acceptance that must inspect a real page, preserve source and screenshot evidence, and reconcile content and interaction findings.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 3 projections.",
      "member_refs": [
        "capability:skill:package:browser-research-acceptance:browser-research-acceptance%2Fshared%2Fbrowser-evidence-acceptance"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:browser-research-acceptance:browser-research-acceptance%2Fshared%2Fbrowser-evidence-acceptance",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "browser-research-planner": {
        "capability_refs": [
          "capability:capability_set:package:browser-research-acceptance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Browser Research Planner",
        "description": "Defines the observable goal, page boundary, evidence matrix, interaction scenarios, and stopping conditions.",
        "base_role": "delegated-worker",
        "prompt": "agents/browser-research-planner/system.md"
      },
      "browser-evidence-observer": {
        "capability_refs": [
          "capability:capability_set:package:browser-research-acceptance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:frontend-research-base"
        ],
        "label": "Browser Evidence Observer",
        "description": "Inspects real pages and records dated claims, visible state, source locators, and screenshots against the research matrix.",
        "base_role": "frontend-research",
        "prompt": "agents/browser-evidence-observer/system.md"
      },
      "browser-acceptance-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:browser-research-acceptance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Browser Acceptance Reviewer",
        "description": "Independently executes the planned acceptance partition and publishes criterion-level pass, fail, blocked, or unverified decisions.",
        "base_role": "fact-check",
        "prompt": "agents/browser-acceptance-reviewer/system.md"
      }
    },
    "virtual_workflows": {
      "browser-evidence-acceptance": {
        "label": "Planned Parallel Browser Evidence Acceptance",
        "description": "One Planner fixes the page journey and evidence boundary before observation and acceptance workers execute in parallel.",
        "nodes": {
          "browser-research-planner": {
            "agent_id": "browser-research-planner",
            "description": "Publishes the exact page journey, viewport, interaction, and evidence acceptance allocation.",
            "depends_on": []
          },
          "browser-evidence-observer": {
            "agent_id": "browser-evidence-observer",
            "description": "Captures the planned real-page states, interactions, diagnostics, and screenshots.",
            "depends_on": [
              "browser-research-planner"
            ]
          },
          "browser-acceptance-reviewer": {
            "agent_id": "browser-acceptance-reviewer",
            "description": "Independently checks the requested browser claims against the planned evidence contract.",
            "depends_on": [
              "browser-research-planner"
            ]
          }
        }
      }
    }
  }
}
