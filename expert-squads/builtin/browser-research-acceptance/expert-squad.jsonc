        "description": "Joins research and interaction evidence into criterion-level pass, fail, blocked, or unverified decisions.",
        "base_role": "fact-check",
        "prompt": "agents/browser-acceptance-reviewer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["browser-research-acceptance/shared/browser-evidence-acceptance"],
        "default_tool_refs": [],
