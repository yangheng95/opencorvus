{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "privacy-data-protection-operations",
  "name": "Privacy Data Protection Operations",
  "label": "Privacy Data Protection Operations",
  "description": "Evidence-bounded data inventory, privacy-impact, data-subject request, retention/deletion, and incident review without legal or production-system authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound privacy and data-protection operations evidence.",
    "selection_guidance": "Select for processing inventory and flows, privacy impact evidence, data-subject request search/retention conflicts, or personal-data incident facts. Do not select for legal conclusions, production searches/disclosures/deletions, hold release, incident containment, or notification.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:privacy-data-protection-operations:privacy-data-protection-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:privacy-data-protection-operations:privacy-data-protection-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "personal-data-inventory-flow-analyst": {
        "capability_refs": [
          "capability:capability_set:package:privacy-data-protection-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Personal Data Inventory Flow Analyst",
        "description": "Maps source-bound processing activities, systems, data categories, recipients, transfers, roles, and retention sources without deciding lawful basis.",
        "base_role": "explore",
        "prompt": "agents/personal-data-inventory-flow-analyst/system.md"
      },
      "privacy-impact-assessment-analyst": {
        "capability_refs": [
          "capability:capability_set:package:privacy-data-protection-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Privacy Impact Assessment Analyst",
        "description": "Structures processing, necessity, proportionality, rights-and-freedoms risk, measure, and residual-uncertainty evidence without accepting risk.",
        "base_role": "delegated-worker",
        "prompt": "agents/privacy-impact-assessment-analyst/system.md"
      },
      "data-subject-request-retention-analyst": {
        "capability_refs": [
          "capability:capability_set:package:privacy-data-protection-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Data Subject Request Retention Analyst",
        "description": "Traces authorized request intake, evidence search, retention/deletion rules, hold conflicts, and review questions without production action or response.",
        "base_role": "delegated-worker",
        "prompt": "agents/data-subject-request-retention-analyst/system.md"
      },
      "personal-data-incident-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:privacy-data-protection-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Personal Data Incident Evidence Analyst",
        "description": "Reconstructs personal-data incident facts, chronology, affected-data scope, effects, and remedial evidence without breach or notification decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/personal-data-incident-evidence-analyst/system.md"
      },
      "privacy-data-protection-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:privacy-data-protection-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Privacy Data Protection Review Owner",
        "description": "Joins inventory, assessment, request/retention, and incident branches into a qualified-review pack without legal or operational decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/privacy-data-protection-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "privacy-data-protection-operations-review": {
        "label": "Privacy Data Protection Operations Review",
        "description": "Four independent privacy evidence branches converge into one qualified-review pack.",
        "nodes": {
          "personal-data-inventory-flow-analyst": {
            "agent_id": "personal-data-inventory-flow-analyst",
            "description": "Maps authorized processing inventories and flows.",
            "depends_on": []
          },
          "privacy-impact-assessment-analyst": {
            "agent_id": "privacy-impact-assessment-analyst",
            "description": "Structures privacy-impact and risk-measure evidence.",
            "depends_on": []
          },
          "data-subject-request-retention-analyst": {
            "agent_id": "data-subject-request-retention-analyst",
            "description": "Traces requests, source searches, retention, deletion, and hold conflicts.",
            "depends_on": []
          },
          "personal-data-incident-evidence-analyst": {
            "agent_id": "personal-data-incident-evidence-analyst",
            "description": "Reconstructs personal-data incident facts and evidence.",
            "depends_on": []
          },
          "privacy-data-protection-review-owner": {
            "agent_id": "privacy-data-protection-review-owner",
            "description": "Joins all branches without legal, production, disclosure, deletion, containment, or notification authority.",
            "depends_on": [
              "data-subject-request-retention-analyst",
              "personal-data-incident-evidence-analyst",
              "personal-data-inventory-flow-analyst",
              "privacy-impact-assessment-analyst"
            ]
          }
        }
      }
    }
  }
}
