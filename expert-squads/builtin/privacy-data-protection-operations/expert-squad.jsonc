{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "privacy-data-protection-operations",
  "name": "Privacy Data Protection Operations",
  "label": "Privacy Data Protection Operations",
  "description": "Evidence-bounded data inventory, privacy-impact, data-subject request, retention/deletion, and incident review without legal or production-system authority.",
  "version": "2026.08.11.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound privacy and data-protection operations evidence.",
    "selection_guidance": "Select for processing inventory and flows, privacy impact evidence, data-subject request search/retention conflicts, or personal-data incident facts. Do not select for legal conclusions, production searches/disclosures/deletions, hold release, incident containment, or notification.",
    "instructions": "selector.md",
  },
