{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "emergency-management-continuity",
  "name": "Emergency Management and Continuity",
  "label": "Emergency Management and Continuity",
  "description": "All-hazards, essential-function, resource, communications, and exercise evidence joined into a non-operational continuity-readiness pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded emergency and continuity readiness planning.",
    "selection_guidance": "Select for all-hazards assumptions, essential-function continuity, recovery objectives, succession, resource and communications coordination, exercises, and improvement actions without live command, dispatch, warning, plan-mutation, or readiness-certification authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:emergency-management-continuity:emergency-management-continuity%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:emergency-management-continuity:emergency-management-continuity%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "hazard-scenario-assumption-analyst": {
        "capability_refs": [
          "capability:capability_set:package:emergency-management-continuity:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Hazard Scenario and Assumption Analyst",
        "description": "Builds dated all-hazards planning scenarios and cascading-impact assumptions without forecasting.",
        "base_role": "explore",
        "prompt": "agents/hazard-scenario-assumption-analyst/system.md"
      },
      "essential-functions-continuity-analyst": {
        "capability_refs": [
          "capability:capability_set:package:emergency-management-continuity:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Essential Functions Continuity Analyst",
        "description": "Maps essential functions, recovery objectives, dependencies, succession, delegations and continuity strategies.",
        "base_role": "delegated-worker",
        "prompt": "agents/essential-functions-continuity-analyst/system.md"
      },
      "incident-resource-communications-analyst": {
        "capability_refs": [
          "capability:capability_set:package:emergency-management-continuity:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Incident Resource and Communications Analyst",
        "description": "Maps approved incident interfaces, typed resources, mutual aid, logistics and accessible communications.",
        "base_role": "delegated-worker",
        "prompt": "agents/incident-resource-communications-analyst/system.md"
      },
      "exercise-improvement-analyst": {
        "capability_refs": [
          "capability:capability_set:package:emergency-management-continuity:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Exercise and Improvement Analyst",
        "description": "Traces exercise objectives, observations, evaluation evidence and corrective actions.",
        "base_role": "delegated-worker",
        "prompt": "agents/exercise-improvement-analyst/system.md"
      },
      "emergency-continuity-readiness-owner": {
        "capability_refs": [
          "capability:capability_set:package:emergency-management-continuity:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Emergency Continuity Readiness Owner",
        "description": "Joins four branches into a versioned readiness and improvement decision pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/emergency-continuity-readiness-owner/system.md"
      }
    },
    "virtual_workflows": {
      "emergency-continuity-readiness-pack": {
        "label": "Emergency Continuity Readiness Pack",
        "description": "Four independent planning branches converge into one accountable non-operational readiness pack.",
        "nodes": {
          "hazard-scenario-assumption-analyst": {
            "agent_id": "hazard-scenario-assumption-analyst",
            "description": "Builds all-hazards scenarios and cascading-impact assumptions.",
            "depends_on": []
          },
          "essential-functions-continuity-analyst": {
            "agent_id": "essential-functions-continuity-analyst",
            "description": "Maps essential functions, objectives, dependencies and strategies.",
            "depends_on": []
          },
          "incident-resource-communications-analyst": {
            "agent_id": "incident-resource-communications-analyst",
            "description": "Maps approved incident, resource and communications interfaces.",
            "depends_on": []
          },
          "exercise-improvement-analyst": {
            "agent_id": "exercise-improvement-analyst",
            "description": "Maps exercise evidence and improvement actions.",
            "depends_on": []
          },
          "emergency-continuity-readiness-owner": {
            "agent_id": "emergency-continuity-readiness-owner",
            "description": "Joins all branches into a readiness decision pack.",
            "depends_on": [
              "essential-functions-continuity-analyst",
              "exercise-improvement-analyst",
              "hazard-scenario-assumption-analyst",
              "incident-resource-communications-analyst"
            ]
          }
        }
      }
    }
  }
}
