    "virtual_workflows": {
      "review-only": {
        "label": "Evidence-backed Review",
        "description": "Establish the exact requirement, review target, diff, and call-graph evidence, then issue an evidence-backed code review without implying product repair.",
        "nodes": {
          "review-debug-evidence-investigator": {
            "agent_id": "review-debug-evidence-investigator",
            "description": "Establishes the exact requirement, review target, diff, checks, and affected call graph.",
            "depends_on": [],
          },
          "review-debug-code-reviewer": {
            "agent_id": "review-debug-code-reviewer",
            "description": "Reviews the change and surrounding call graph against the established evidence.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
        },
      },
      "debug-repair": {
        "label": "Product Debug and Repair",
        "description": "Reproduce the defect, independently review code and prove root cause, repair the product, and independently verify the repair.",
        "nodes": {
          "review-debug-evidence-investigator": {
            "agent_id": "review-debug-evidence-investigator",
            "description": "Reproduces the defect and establishes the exact evidence and affected surface.",
            "depends_on": [],
          },
          "review-debug-code-reviewer": {
            "agent_id": "review-debug-code-reviewer",
            "description": "Reviews the affected call graph and existing change for correctness and regression risk.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
          "review-debug-root-cause-investigator": {
            "agent_id": "review-debug-root-cause-investigator",
            "description": "Proves the causal chain and explains why earlier paths did not cure the defect.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
          "review-debug-repair-implementer": {
            "agent_id": "review-debug-repair-implementer",
            "description": "Repairs the proven root cause and adds focused regression coverage.",
            "depends_on": ["review-debug-code-reviewer", "review-debug-root-cause-investigator"],
          },
          "review-debug-integrity-reviewer": {
            "agent_id": "review-debug-integrity-reviewer",
            "description": "Independently reviews the diff and reruns the reproduction and regression checks.",
            "depends_on": ["review-debug-repair-implementer"],
          },
        },
      },
      "visual-debug-repair": {
        "label": "Graphical Product Debug and Repair",
        "description": "Reproduce a graphical defect, prove its code and visual causes, repair it, and independently verify fresh browser and repository evidence.",
        "nodes": {
          "review-debug-evidence-investigator": {
            "agent_id": "review-debug-evidence-investigator",
            "description": "Establishes the reported symptom, product boundary, repository evidence, and preview target.",
            "depends_on": [],
          },
          "review-debug-code-reviewer": {
            "agent_id": "review-debug-code-reviewer",
            "description": "Reviews the graphical implementation call graph and regression risk.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
          "review-debug-root-cause-investigator": {
            "agent_id": "review-debug-root-cause-investigator",
            "description": "Proves the product data, event, rendering, or styling causal chain.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
          "review-debug-visual-investigator": {
            "agent_id": "review-debug-visual-investigator",
            "description": "Captures the broken graphical states and interaction evidence in a real task-scoped preview.",
            "depends_on": ["review-debug-evidence-investigator"],
          },
          "review-debug-repair-implementer": {
            "agent_id": "review-debug-repair-implementer",
            "description": "Repairs the proven graphical product root cause and adds regression coverage.",
            "depends_on": [
              "review-debug-code-reviewer",
              "review-debug-root-cause-investigator",
              "review-debug-visual-investigator",
            ],
          },
          "review-debug-integrity-reviewer": {
            "agent_id": "review-debug-integrity-reviewer",
            "description": "Independently reviews the repair diff and repository regression evidence.",
            "depends_on": ["review-debug-repair-implementer"],
          },
          "review-debug-visual-reviewer": {
            "agent_id": "review-debug-visual-reviewer",
            "description": "Verifies the repaired states with fresh screenshots, interactions, focus paths, and diagnostics.",
            "depends_on": ["review-debug-repair-implementer"],
          },
        },
      },
    },
  },
}
