{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "review-debug",
  "name": "Review & Debug",
  "label": "Review & Debug",
  "description": "Evidence-backed product review, root-cause debugging, product-source repair, and independent repair verification through durable catalog facts and visible narrative Turn summaries.",
  "version": "2026.08.05.1",
  "product_pillars": ["code"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for review of existing product changes, reproducible defect investigation, root-cause debugging, product repair, and repair verification.",
    "selection_guidance": "Select Review & Debug only when the Task already identifies the concrete repository/revision and review target or reproducible defect evidence; bootstrap repository and issue selection under Advanced first. Keep independent audit responsible for post-delivery test artifacts and independent audit reports.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": ["dispatch_agent", "manage_task", "read"],
      "default_skill_refs": [],
      "package_skill_refs": ["review-debug/shared/workflow"],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "review-debug-evidence-investigator": {
        "label": "Review & Debug Evidence Investigator",
        "description": "Reproduces the observed symptom, inventories runtime and repository evidence, and bounds the affected product surface.",
        "base_role": "explore",
        "prompt": "agents/review-debug-evidence-investigator/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
