{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "scientific-research-design",
  "name": "Scientific Research Design",
  "label": "Scientific Research Design",
  "description": "Evidence landscape, competing hypothesis, and rigor or ethics analysis joined into a reproducible research decision register.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-aware scientific ideation and research design decisions.",
    "selection_guidance": "Select when evidence, competing hypotheses, disconfirming tests, uncertainty, and institutional review gates must remain explicit.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:scientific-research-design:scientific-research-design%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:scientific-research-design:scientific-research-design%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "research-evidence-landscape-analyst": {
        "capability_refs": [
          "capability:capability_set:package:scientific-research-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base",
          "capability:tool:platform:tool-registry:webfetch",
          "capability:tool:platform:tool-registry:websearch"
        ],
        "label": "Research Evidence Landscape Analyst",
        "description": "Maps bounded literature and evidence for and against candidate directions.",
        "base_role": "explore",
        "prompt": "agents/research-evidence-landscape-analyst/system.md"
      },
      "research-hypothesis-alternatives-analyst": {
        "capability_refs": [
          "capability:capability_set:package:scientific-research-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Hypothesis Alternatives Analyst",
        "description": "Generates testable alternatives, predictions, and disconfirming observations.",
        "base_role": "delegated-worker",
        "prompt": "agents/research-hypothesis-alternatives-analyst/system.md"
      },
      "research-rigor-ethics-analyst": {
        "capability_refs": [
          "capability:capability_set:package:scientific-research-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Research Rigor and Ethics Analyst",
        "description": "Maps bias, feasibility, safety, privacy, ethics, and regulatory gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/research-rigor-ethics-analyst/system.md"
      },
      "research-decision-integrator": {
        "capability_refs": [
          "capability:capability_set:package:scientific-research-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:architect-base"
        ],
        "label": "Research Decision Integrator",
        "description": "Joins evidence, alternatives, and gates into a reproducible research register.",
        "base_role": "architect",
        "prompt": "agents/research-decision-integrator/system.md"
      }
    },
    "virtual_workflows": {
      "research-design-decision-register": {
        "label": "Research Design Decision Register",
        "description": "Independent evidence, hypothesis, and rigor branches converge into one decision register.",
        "nodes": {
          "research-evidence-landscape-analyst": {
            "agent_id": "research-evidence-landscape-analyst",
            "description": "Maps current evidence and search limits.",
            "depends_on": []
          },
          "research-hypothesis-alternatives-analyst": {
            "agent_id": "research-hypothesis-alternatives-analyst",
            "description": "Generates testable competing explanations.",
            "depends_on": []
          },
          "research-rigor-ethics-analyst": {
            "agent_id": "research-rigor-ethics-analyst",
            "description": "Maps rigor, safety, and review gates.",
            "depends_on": []
          },
          "research-decision-integrator": {
            "agent_id": "research-decision-integrator",
            "description": "Joins all branches into the research register.",
            "depends_on": [
              "research-evidence-landscape-analyst",
              "research-hypothesis-alternatives-analyst",
              "research-rigor-ethics-analyst"
            ]
          }
        }
      }
    }
  }
}
