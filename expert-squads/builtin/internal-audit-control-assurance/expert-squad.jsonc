{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "internal-audit-control-assurance",
  "name": "Internal Audit Control Assurance",
  "label": "Internal Audit Control Assurance",
  "description": "Charter-bound audit-universe, control-design, operating-effectiveness, finding and remediation evidence without opinion, fraud, risk-acceptance or control authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound internal-audit and control-assurance evidence prepared for qualified review.",
    "selection_guidance": "Select for audit universe, risk priority, control design, walkthrough, population/sample testing, operating effectiveness, findings and remediation evidence. Do not select for an audit opinion, fraud or material-weakness determination, control changes, risk acceptance or external-audit work.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:internal-audit-control-assurance:internal-audit-control-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:internal-audit-control-assurance:internal-audit-control-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "audit-universe-risk-prioritization-analyst": {
        "capability_refs": [
          "capability:capability_set:package:internal-audit-control-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Audit Universe Risk Prioritization Analyst",
        "description": "Freezes mandate, universe, scope and evidence-backed risk prioritization.",
        "base_role": "explore",
        "prompt": "agents/audit-universe-risk-prioritization-analyst/system.md"
      },
      "control-design-walkthrough-analyst": {
        "capability_refs": [
          "capability:capability_set:package:internal-audit-control-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Control Design Walkthrough Analyst",
        "description": "Traces objectives, risks, control design, implementation and walkthrough evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/control-design-walkthrough-analyst/system.md"
      },
      "control-operating-effectiveness-testing-analyst": {
        "capability_refs": [
          "capability:capability_set:package:internal-audit-control-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Control Operating Effectiveness Testing Analyst",
        "description": "Reconciles populations, samples, test procedures, exceptions and coverage limits.",
        "base_role": "delegated-worker",
        "prompt": "agents/control-operating-effectiveness-testing-analyst/system.md"
      },
      "finding-root-cause-remediation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:internal-audit-control-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Finding Root Cause Remediation Analyst",
        "description": "Builds evidence-bound exception, finding, root-cause and remediation-verification records.",
        "base_role": "delegated-worker",
        "prompt": "agents/finding-root-cause-remediation-analyst/system.md"
      },
      "internal-audit-control-assurance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:internal-audit-control-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Internal Audit Control Assurance Review Owner",
        "description": "Joins universe, design, testing and remediation evidence without issuing an audit conclusion.",
        "base_role": "delegated-worker",
        "prompt": "agents/internal-audit-control-assurance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "qualified-review": {
        "label": "Internal Audit Control Assurance Qualified Review",
        "description": "Four independent audit-evidence branches converge into one qualified review owner.",
        "nodes": {
          "audit-universe-risk-prioritization-analyst": {
            "agent_id": "audit-universe-risk-prioritization-analyst",
            "description": "Freezes mandate, universe, scope and evidence-backed risk prioritization.",
            "depends_on": []
          },
          "control-design-walkthrough-analyst": {
            "agent_id": "control-design-walkthrough-analyst",
            "description": "Traces objectives, risks, control design, implementation and walkthrough evidence.",
            "depends_on": []
          },
          "control-operating-effectiveness-testing-analyst": {
            "agent_id": "control-operating-effectiveness-testing-analyst",
            "description": "Reconciles populations, samples, test procedures, exceptions and coverage limits.",
            "depends_on": []
          },
          "finding-root-cause-remediation-analyst": {
            "agent_id": "finding-root-cause-remediation-analyst",
            "description": "Builds evidence-bound exception, finding, root-cause and remediation-verification records.",
            "depends_on": []
          },
          "internal-audit-control-assurance-review-owner": {
            "agent_id": "internal-audit-control-assurance-review-owner",
            "description": "Joins universe, design, testing and remediation evidence without issuing an audit conclusion.",
            "depends_on": [
              "audit-universe-risk-prioritization-analyst",
              "control-design-walkthrough-analyst",
              "control-operating-effectiveness-testing-analyst",
              "finding-root-cause-remediation-analyst"
            ]
          }
        }
      }
    }
  }
