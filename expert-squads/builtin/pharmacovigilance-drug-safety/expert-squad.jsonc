{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "pharmacovigilance-drug-safety",
  "name": "Pharmacovigilance Drug Safety",
  "label": "Pharmacovigilance Drug Safety",
  "description": "Evidence-bounded case-quality, aggregate-signal, and risk-plan trace review joined for qualified pharmacovigilance assessment without medical, reporting, or regulatory authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded pharmacovigilance case, aggregate signal, and risk-management evidence review.",
    "selection_guidance": "Select when work requires case version and duplicate controls, adverse-event aggregate calculations, reference-safety-information traceability, or signal lifecycle evidence. Do not select for patient care, medical judgment, reportability decisions, submissions, or label changes.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:pharmacovigilance-drug-safety:pharmacovigilance-drug-safety%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:pharmacovigilance-drug-safety:pharmacovigilance-drug-safety%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "pv-case-intake-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pharmacovigilance-drug-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "PV Case Intake Quality Analyst",
        "description": "Builds a source-bound case, follow-up, duplicate, and data-quality ledger without making case judgments.",
        "base_role": "explore",
        "prompt": "agents/pv-case-intake-quality-analyst/system.md"
      },
      "pv-aggregate-signal-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pharmacovigilance-drug-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "PV Aggregate Signal Analyst",
        "description": "Computes auditable descriptive disproportionality and documents limitations without declaring a signal or incidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/pv-aggregate-signal-analyst/system.md"
      },
      "pv-risk-management-compliance-trace-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pharmacovigilance-drug-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "PV Risk Management Compliance Trace Analyst",
        "description": "Traces reference-safety-information, risk-plan, signal-stage, action, and accountable-review evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/pv-risk-management-compliance-trace-analyst/system.md"
      },
      "pharmacovigilance-safety-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:pharmacovigilance-drug-safety:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Pharmacovigilance Safety Review Owner",
        "description": "Joins case, aggregate, and risk-trace branches into a qualified-review pack while preserving unresolved decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/pharmacovigilance-safety-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "pharmacovigilance-drug-safety-review": {
        "label": "Pharmacovigilance Drug Safety Review",
        "description": "Three independent evidence branches converge into one controlled safety review pack.",
        "nodes": {
          "pv-case-intake-quality-analyst": {
            "agent_id": "pv-case-intake-quality-analyst",
            "description": "Audits case source, version, follow-up, duplicate, and completeness evidence.",
            "depends_on": []
          },
          "pv-aggregate-signal-analyst": {
            "agent_id": "pv-aggregate-signal-analyst",
            "description": "Produces descriptive aggregate signal measures and limitations.",
            "depends_on": []
          },
          "pv-risk-management-compliance-trace-analyst": {
            "agent_id": "pv-risk-management-compliance-trace-analyst",
            "description": "Traces RSI, risk-plan, signal stages, actions, and qualified ownership.",
            "depends_on": []
          },
          "pharmacovigilance-safety-review-owner": {
            "agent_id": "pharmacovigilance-safety-review-owner",
            "description": "Joins all branches without medical, case-processing, submission, or regulatory authority.",
            "depends_on": [
              "pv-aggregate-signal-analyst",
              "pv-case-intake-quality-analyst",
              "pv-risk-management-compliance-trace-analyst"
            ]
          }
        }
      }
    }
  }
}
