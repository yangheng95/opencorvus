{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "biopharmaceutical-manufacturing-quality",
  "name": "Biopharmaceutical Manufacturing Quality",
  "label": "Biopharmaceutical Manufacturing Quality",
  "description": "GMP batch, material/equipment genealogy, deviation, CAPA, process-validation, continued-verification, and data-integrity evidence joined into a bounded quality review pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded biopharmaceutical GMP manufacturing-quality evidence without batch, deviation, CAPA, validation, release, or compliance authority.",
    "selection_guidance": "Select for master/executed batch records, material/lot/equipment genealogy, yields and audit trails, deviations/OOS/OOT, investigation and CAPA evidence, process validation, control-strategy traceability, continued process verification, cleaning/contamination-control applicability, and manufacturing data integrity. Do not select for record mutation, process-parameter change, deviation/root-cause/CAPA closure, result validation, equipment/area/batch release, product quality or sterility assurance, regulatory submission, or GMP certification.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:biopharmaceutical-manufacturing-quality:biopharmaceutical-manufacturing-quality%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:biopharmaceutical-manufacturing-quality:biopharmaceutical-manufacturing-quality%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "biopharma-batch-record-genealogy-analyst": {
        "capability_refs": [
          "capability:capability_set:package:biopharmaceutical-manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Biopharma Batch Record and Genealogy Analyst",
        "description": "Reconciles master/executed batch records, materials, lots, equipment, personnel entries, yields, status, and audit trails.",
        "base_role": "explore",
        "prompt": "agents/biopharma-batch-record-genealogy-analyst/system.md"
      },
      "biopharma-deviation-capa-analyst": {
        "capability_refs": [
          "capability:capability_set:package:biopharmaceutical-manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Biopharma Deviation and CAPA Analyst",
        "description": "Builds deviation chronology, impact scope, evidence-backed cause hypotheses, CAPA actions, and effectiveness evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/biopharma-deviation-capa-analyst/system.md"
      },
      "biopharma-process-validation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:biopharmaceutical-manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Biopharma Process Validation Analyst",
        "description": "Traces lifecycle validation, CQA/CPP/control strategy, qualification, sampling, statistics, and continued verification evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/biopharma-process-validation-analyst/system.md"
      },
      "biopharma-manufacturing-quality-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:biopharmaceutical-manufacturing-quality:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Biopharma Manufacturing Quality Review Owner",
        "description": "Joins batch, deviation/CAPA, and validation evidence while preserving Quality Unit and batch-release authority.",
        "base_role": "delegated-worker",
        "prompt": "agents/biopharma-manufacturing-quality-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "biopharma-manufacturing-quality-review": {
        "label": "Biopharma Manufacturing Quality Review",
        "description": "Three independent batch, deviation/CAPA, and validation branches converge into one bounded GMP review pack.",
        "nodes": {
          "biopharma-batch-record-genealogy-analyst": {
            "agent_id": "biopharma-batch-record-genealogy-analyst",
            "description": "Reconciles batch execution, material/equipment genealogy, yields, status, signatures, and audit trails.",
            "depends_on": []
          },
          "biopharma-deviation-capa-analyst": {
            "agent_id": "biopharma-deviation-capa-analyst",
            "description": "Builds deviation, investigation, impact, CAPA, implementation, and effectiveness evidence.",
            "depends_on": []
          },
          "biopharma-process-validation-analyst": {
            "agent_id": "biopharma-process-validation-analyst",
            "description": "Traces process design, qualification, control strategy, sampling, statistics, and continued verification.",
            "depends_on": []
          },
          "biopharma-manufacturing-quality-review-owner": {
            "agent_id": "biopharma-manufacturing-quality-review-owner",
            "description": "Joins all branches, preserves contradictions, and routes Quality Unit and release decisions.",
            "depends_on": [
              "biopharma-batch-record-genealogy-analyst",
              "biopharma-deviation-capa-analyst",
              "biopharma-process-validation-analyst"
            ]
          }
        }
      }
    }
  }
}
