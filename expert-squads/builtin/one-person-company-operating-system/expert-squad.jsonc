{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "one-person-company-operating-system",
  "name": "One Person Company Operating System",
  "label": "One Person Company Operating System",
  "description": "A commercial-grade operating evidence system for an owner-operated company, joining offer and demand, revenue and obligations, delivery capacity, and automation governance without performing external actions.",
  "version": "2026.08.11.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Run one evidence-grounded operating review across the whole owner-operated company.",
    "selection_guidance": "Select when one owner needs a single operating state across offers, demand, pipeline, revenue, cash, obligations, delivery, customers, capacity, workflows, approvals, and resilience. This is a company-level reconciliation and priority surface, not a substitute for specialist marketing, sales, finance, tax, legal, product, customer-success, security, or engineering review. It never sends, publishes, pays, refunds, signs, files, deploys, deletes, changes permissions, or contacts external parties.",
    "instructions": "selector.md",
  },
  "capability_projection": {
