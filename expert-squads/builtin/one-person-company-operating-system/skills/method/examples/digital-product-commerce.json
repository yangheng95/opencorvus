  "pipeline": {
    "unit": "reconciled-order",
    "stage_definitions": [
      {
        "stage_id": "placed",
        "entry_rule": "Order exists in the frozen storefront source with an eligible catalog version",
        "denominator": "eligible order records in the frozen window"
      },
      {
        "stage_id": "paid",
        "entry_rule": "Order and payment events reconcile without unresolved dispute or refund",
        "denominator": "placed orders eligible for payment"
      },
      {
        "stage_id": "fulfilled",
        "entry_rule": "Paid order and exact entitlement/download/shipment evidence reconcile",
        "denominator": "paid orders eligible for the configured channel mode"
      }
    ],
    "source_id": "storefront-orders",
    "owner": "owner/primary"
  },
  "delivery_capacity": {
    "delivery_unit": "reconciled-entitlement-download-or-fulfillment-unit",
    "available_capacity_formula": "available_digital_or_physical_units minus reserved_and_exception_units with channel_mode recorded",
    "source_id": "fulfillment-support",
    "owner": "owner/primary",
    "uncertainty": "Channel mode, vendor, inventory, download, license-key, return, and support states may differ"
  },
  "cash_controls": {
    "system_of_record_refs": ["storefront-orders", "payment-refund-events", "accounting-tax-configuration"],
    "reconciliation_key": "order_id+payment_id+refund_id+currency",
    "functional_currency": "CNY",
    "owner": "owner/primary",
    "professional_review_ref": "qualified-review/accounting-tax"
  },
  "metric_definitions": [
    {
      "metric_id": "reconciled-order-revenue",
      "business_definition": "Order amount supported by catalog, payment, refund/dispute, fulfillment, currency, and cutoff evidence",
      "formula_version": "opc-1",
      "numerator": "sum of reconciled order amounts",
      "denominator": "one frozen reporting period",
      "unit": "CNY/period",
      "source_id": "payment-refund-events",
      "cutoff": "operator-selected ISO-8601 cutoff",
      "cadence": "weekly",
      "owner": "owner/primary",
      "uncertainty": "Excludes unresolved refunds, disputes, taxes, fees, conversion, and outcome-unknown events"
    },
    {
      "metric_id": "delivery-success",
      "business_definition": "Eligible paid orders with reconciled entitlement/download/fulfillment evidence",
      "formula_version": "opc-1",
      "numerator": "unique reconciled fulfilled orders",
      "denominator": "unique eligible paid orders",
      "unit": "ratio",
      "source_id": "fulfillment-support",
      "cutoff": "operator-selected ISO-8601 cutoff",
      "cadence": "weekly",
      "owner": "owner/primary",
      "uncertainty": "Depends on channel-mode state definition and reporting lag"
    },
    {
      "metric_id": "support-burden",
      "business_definition": "Open support/return exceptions per reconciled order population",
      "formula_version": "opc-1",
      "numerator": "open deduplicated support and return exceptions",
      "denominator": "reconciled orders in the same cohort/window",
      "unit": "exceptions/order",
      "source_id": "fulfillment-support",
      "cutoff": "operator-selected ISO-8601 cutoff",
      "cadence": "weekly",
      "owner": "owner/primary",
      "uncertainty": "Contact deduplication and order linkage may be incomplete"
    }
  ],
