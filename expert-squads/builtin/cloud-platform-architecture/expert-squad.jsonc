{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "cloud-platform-architecture",
  "name": "Cloud Platform Architecture",
  "label": "Cloud Platform Architecture",
  "description": "Provider-neutral cloud workload, reliability, and cost/operations analysis joined into an architecture decision pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed cloud or hybrid platform architecture decisions.",
    "selection_guidance": "Select when workload requirements, resilience, cost, operations, alternatives, and approval gates must converge before implementation.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:cloud-platform-architecture:cloud-platform-architecture%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:cloud-platform-architecture:cloud-platform-architecture%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "cloud-workload-requirements-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-platform-architecture:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:requirements-base"
        ],
        "label": "Workload Requirements Analyst",
        "description": "Defines workload boundaries, objectives, constraints, and assumptions.",
        "base_role": "requirements",
        "prompt": "agents/cloud-workload-requirements-analyst/system.md"
      },
      "cloud-reliability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-platform-architecture:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Cloud Reliability Analyst",
        "description": "Evaluates failure domains, recovery, state, and resilience evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/cloud-reliability-analyst/system.md"
      },
      "cloud-cost-operations-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cloud-platform-architecture:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Cloud Cost and Operations Analyst",
        "description": "Maps cost drivers, operational ownership, and support constraints.",
        "base_role": "delegated-worker",
        "prompt": "agents/cloud-cost-operations-analyst/system.md"
      },
      "cloud-architecture-decision-owner": {
        "capability_refs": [
          "capability:capability_set:package:cloud-platform-architecture:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:architect-base"
        ],
        "label": "Cloud Architecture Decision Owner",
        "description": "Joins requirements, reliability, and operations evidence into one decision record.",
        "base_role": "architect",
        "prompt": "agents/cloud-architecture-decision-owner/system.md"
      }
    },
    "virtual_workflows": {
      "cloud-architecture-decision-pack": {
        "label": "Cloud Architecture Decision Pack",
        "description": "Three independent architecture branches converge into one accountable decision record.",
        "nodes": {
          "cloud-workload-requirements-analyst": {
            "agent_id": "cloud-workload-requirements-analyst",
            "description": "Defines measurable workload requirements.",
            "depends_on": []
          },
          "cloud-reliability-analyst": {
            "agent_id": "cloud-reliability-analyst",
            "description": "Analyzes failure and recovery behavior.",
            "depends_on": []
          },
          "cloud-cost-operations-analyst": {
            "agent_id": "cloud-cost-operations-analyst",
            "description": "Analyzes cost and operational ownership.",
            "depends_on": []
          },
          "cloud-architecture-decision-owner": {
            "agent_id": "cloud-architecture-decision-owner",
            "description": "Joins all branches into the architecture decision pack.",
            "depends_on": [
              "cloud-cost-operations-analyst",
              "cloud-reliability-analyst",
              "cloud-workload-requirements-analyst"
            ]
          }
        }
      }
    }
  }
}
