{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "media-rights-clearance",
  "name": "Media Rights Clearance",
  "label": "Media Rights Clearance",
  "description": "Component provenance, chain-of-title, license and release terms, and intended-use constraints joined into a counsel-ready media-clearance register.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded media-rights evidence and clearance preparation.",
    "selection_guidance": "Select for asset-level chain-of-title, license, release, territory, term, window, platform, edit, credit, fee, privacy, publicity, trademark, and expiry evidence without legal-clearance, contracting, payment, contact, publishing, or takedown authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:media-rights-clearance:media-rights-clearance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:media-rights-clearance:media-rights-clearance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "media-asset-rights-inventory-analyst": {
        "capability_refs": [
          "capability:capability_set:package:media-rights-clearance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Media Asset Rights Inventory Analyst",
        "description": "Versions every component and traces creator, source, claimant, and chain-of-title evidence.",
        "base_role": "explore",
        "prompt": "agents/media-asset-rights-inventory-analyst/system.md"
      },
      "media-license-release-terms-analyst": {
        "capability_refs": [
          "capability:capability_set:package:media-rights-clearance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Media License and Release Terms Analyst",
        "description": "Extracts supplied permissions, prohibitions, duties, constraints, and unresolved interpretation questions.",
        "base_role": "delegated-worker",
        "prompt": "agents/media-license-release-terms-analyst/system.md"
      },
      "media-intended-use-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:media-rights-clearance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Media Intended-Use Risk Analyst",
        "description": "Compares the frozen exploitation plan with documented rights, releases, restrictions, and obligations.",
        "base_role": "delegated-worker",
        "prompt": "agents/media-intended-use-risk-analyst/system.md"
      },
      "media-clearance-register-owner": {
        "capability_refs": [
          "capability:capability_set:package:media-rights-clearance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Media Clearance Register Owner",
        "description": "Joins all branches into a versioned counsel-ready decision and obligation register.",
        "base_role": "delegated-worker",
        "prompt": "agents/media-clearance-register-owner/system.md"
      }
    },
    "virtual_workflows": {
      "media-rights-clearance-pack": {
        "label": "Media Rights Clearance Pack",
        "description": "Three independent evidence branches converge into one counsel-ready clearance register.",
        "nodes": {
          "media-asset-rights-inventory-analyst": {
            "agent_id": "media-asset-rights-inventory-analyst",
            "description": "Versions components and traces creator, source, claimant, and chain-of-title evidence.",
            "depends_on": []
          },
          "media-license-release-terms-analyst": {
            "agent_id": "media-license-release-terms-analyst",
            "description": "Extracts documented permissions, prohibitions, duties, constraints, and questions.",
            "depends_on": []
          },
          "media-intended-use-risk-analyst": {
            "agent_id": "media-intended-use-risk-analyst",
            "description": "Compares intended uses with documented scope, restrictions, and obligations.",
            "depends_on": []
          },
          "media-clearance-register-owner": {
            "agent_id": "media-clearance-register-owner",
            "description": "Joins all branches into one versioned counsel-ready decision pack.",
            "depends_on": [
              "media-asset-rights-inventory-analyst",
              "media-intended-use-risk-analyst",
              "media-license-release-terms-analyst"
            ]
          }
        }
      }
    }
  }
}
