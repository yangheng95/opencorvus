{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "supply-chain-logistics",
  "name": "Supply Chain Logistics",
  "label": "Supply Chain Logistics",
  "description": "Demand, inventory, transport, and disruption evidence joined into an accountable logistics control-tower plan.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed logistics scenario planning.",
    "selection_guidance": "Select for inventory, transport, service, and disruption decision support without transaction or shipment authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:supply-chain-logistics:supply-chain-logistics%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:supply-chain-logistics:supply-chain-logistics%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "logistics-demand-inventory-analyst": {
        "capability_refs": [
          "capability:capability_set:package:supply-chain-logistics:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Demand and Inventory Analyst",
        "description": "Tests demand, forecast, inventory, service, and lead-time assumptions.",
        "base_role": "explore",
        "prompt": "agents/logistics-demand-inventory-analyst/system.md"
      },
      "logistics-transport-constraints-analyst": {
        "capability_refs": [
          "capability:capability_set:package:supply-chain-logistics:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Transport Constraints Analyst",
        "description": "Maps lanes, modes, capacity, handoffs, cost assumptions, and customs dependencies.",
        "base_role": "delegated-worker",
        "prompt": "agents/logistics-transport-constraints-analyst/system.md"
      },
      "logistics-disruption-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:supply-chain-logistics:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Disruption Risk Analyst",
        "description": "Builds evidence-backed disruption scenarios, triggers, and contingencies.",
        "base_role": "delegated-worker",
        "prompt": "agents/logistics-disruption-risk-analyst/system.md"
      },
      "logistics-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:supply-chain-logistics:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Logistics Plan Owner",
        "description": "Joins all branches into an accountable control-tower plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/logistics-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "logistics-control-tower-plan": {
        "label": "Logistics Control-Tower Plan",
        "description": "Three independent logistics branches converge into one plan.",
        "nodes": {
          "logistics-demand-inventory-analyst": {
            "agent_id": "logistics-demand-inventory-analyst",
            "description": "Maps demand and inventory evidence.",
            "depends_on": []
          },
          "logistics-transport-constraints-analyst": {
            "agent_id": "logistics-transport-constraints-analyst",
            "description": "Maps transport constraints.",
            "depends_on": []
          },
          "logistics-disruption-risk-analyst": {
            "agent_id": "logistics-disruption-risk-analyst",
            "description": "Maps disruption scenarios.",
            "depends_on": []
          },
          "logistics-plan-owner": {
            "agent_id": "logistics-plan-owner",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "logistics-demand-inventory-analyst",
              "logistics-disruption-risk-analyst",
              "logistics-transport-constraints-analyst"
            ]
          }
        }
      }
    }
  }
}
