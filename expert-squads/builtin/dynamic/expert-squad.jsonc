{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "dynamic",
  "name": "Dynamic",
  "label": "Dynamic",
  "description": "Lightweight runtime-generated Agent teams and workflow descriptions that immediately execute through reusable Generalist and Builder capability envelopes.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use Dynamic when the Task needs a small team and dependency shape chosen from the current request at runtime rather than a pre-authored specialist workflow.",
    "selection_guidance": "Select Dynamic for bounded work that benefits from an immediately generated team and workflow description. Use a fixed domain Squad when its governed roles, evidence ABI, or repeatable workflow is material; use Generate Expert Squads only when the deliverable is a persistent installable package.",
    "instructions": "selector.md"
  },
  "capability_sets": {},
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:skill:package:dynamic:dynamic%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agents",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:no_action",
        "capability:tool:platform:tool-registry:read_agent_message",
        "capability:tool:platform:tool-registry:read_task_message",
        "capability:tool:platform:tool-registry:skill"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "dynamic-generalist": {
        "capability_refs": [
          "capability:skill:package:dynamic:dynamic%2Fshared%2Fmethod",
          "capability:tool:platform:tool-registry:capability_search",
          "capability:tool:platform:tool-registry:external_code_search",
          "capability:tool:platform:tool-registry:glob",
          "capability:tool:platform:tool-registry:read",
          "capability:tool:platform:tool-registry:request_orchestrator_decision",
          "capability:tool:platform:tool-registry:search_code",
          "capability:tool:platform:tool-registry:send_mailbox_message",
          "capability:tool:platform:tool-registry:skill",
          "capability:tool:platform:tool-registry:webfetch",
          "capability:tool:platform:tool-registry:websearch"
        ],
        "label": "Dynamic Generalist",
        "description": "Runs one generated, bounded planning, investigation, analysis, review, verification, or synthesis responsibility in an independent Session.",
        "base_role": "delegated-worker",
        "prompt": "agents/dynamic-generalist/system.md"
      },
      "dynamic-builder": {
        "capability_refs": [
          "capability:capability_set:platform:tool-registry:build-base",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fcheck",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fclick",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fdiagnostics_get",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fhover",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fnavigate",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fobserve",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fpress_key",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscreenshot",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscroll",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fselect_option",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_create",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_destroy",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Ftype",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Funcheck",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fviewport_set",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_load",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_selector",
          "capability:skill:package:dynamic:dynamic%2Fshared%2Fmethod"
        ],
        "label": "Dynamic Builder",
        "description": "Runs one generated, bounded implementation or concrete-delivery responsibility with the Build runtime's repository and verification contract.",
        "base_role": "build",
        "prompt": "agents/dynamic-builder/system.md"
      }
    },
    "virtual_workflows": {}
  }
}
