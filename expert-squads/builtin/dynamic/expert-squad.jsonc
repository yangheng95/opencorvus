{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "dynamic",
  "name": "Dynamic",
  "label": "Dynamic",
  "description": "Lightweight runtime-generated Agent teams and workflow descriptions that immediately execute through reusable Generalist and Builder capability envelopes.",
  "version": "2026.08.30.3",
  "product_pillars": ["code", "work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use Dynamic when the Task needs a small team and dependency shape chosen from the current request at runtime rather than a pre-authored specialist workflow.",
    "selection_guidance": "Select Dynamic for bounded work that benefits from an immediately generated team and workflow description. Use a fixed domain Squad when its governed roles, evidence ABI, or repeatable workflow is material; use Generate Expert Squads only when the deliverable is a persistent installable package.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": false,
      "built_in_tool_ids": [
        "artifact_search",
        "artifact_read",
        "artifact_select",
        "artifact_snapshot",
        "publish_interactive_artifact",
        "dispatch_agents",
        "manage_task",
        "no_action",
        "read_task_message",
        "read_agent_message",
        "skill"
      ],
      "default_skill_refs": [],
      "package_skill_refs": ["dynamic/shared/method"],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": [],
    },
    "agents": {
      "dynamic-generalist": {
        "label": "Dynamic Generalist",
        "description": "Runs one generated, bounded planning, investigation, analysis, review, verification, or synthesis responsibility in an independent Session.",
        "base_role": "delegated-worker",
        "prompt": "agents/dynamic-generalist/system.md",
        "inherit_base_tools": false,
        "built_in_tool_ids": [
          "capability_search",
          "read",
          "glob",
          "search_code",
          "webfetch",
          "websearch",
          "external_code_search",
          "skill",
          "request_orchestrator_decision",
          "send_mailbox_message",
        ],
        "default_skill_refs": [],
        "package_skill_refs": ["dynamic/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
      "dynamic-builder": {
        "label": "Dynamic Builder",
        "description": "Runs one generated, bounded implementation or concrete-delivery responsibility with the Build runtime's repository and verification contract.",
        "base_role": "build",
        "prompt": "agents/dynamic-builder/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": ["dynamic/shared/method"],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [
          "default/mcp/browser/tool/session_create",
          "default/mcp/browser/tool/session_destroy",
          "default/mcp/browser/tool/viewport_set",
          "default/mcp/browser/tool/navigate",
          "default/mcp/browser/tool/diagnostics_get",
          "default/mcp/browser/tool/screenshot",
          "default/mcp/browser/tool/observe",
          "default/mcp/browser/tool/click",
          "default/mcp/browser/tool/hover",
          "default/mcp/browser/tool/type",
          "default/mcp/browser/tool/press_key",
          "default/mcp/browser/tool/select_option",
          "default/mcp/browser/tool/check",
          "default/mcp/browser/tool/uncheck",
          "default/mcp/browser/tool/scroll",
          "default/mcp/browser/tool/wait_for_selector",
          "default/mcp/browser/tool/wait_for_load",
        ],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": [],
      },
    },
    "virtual_workflows": {},
  },
}
