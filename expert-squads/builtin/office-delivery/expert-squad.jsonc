{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "office-delivery",
  "name": "Office Delivery",
  "label": "Office Delivery",
  "description": "Develops source-backed office artifacts through parallel content and format planning, explicit assembly, and rendered quality review.",
  "version": "2026.08.10.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for editable documents, spreadsheets, presentations, PDFs, or coordinated office packs that require traceable content and visual acceptance.",
    "selection_guidance": "Select Office Delivery when the requested outcome is a decision-ready office artifact rather than analysis alone, and both source correctness and rendered usability must be verified.",
    "instructions": "selector.md",
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
