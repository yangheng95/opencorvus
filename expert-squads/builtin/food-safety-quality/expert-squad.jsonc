{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "food-safety-quality",
  "name": "Food Safety Quality",
  "label": "Food Safety Quality",
  "description": "Evidence-bounded food hazard, control-monitoring, traceability, and recall-readiness review joined without safety, release, recall, or regulatory authority.",
  "version": "2026.08.11.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound food safety-system and traceability evidence preparation.",
    "selection_guidance": "Select for process-flow hazard evidence, HACCP control records, monitoring and verification, lot genealogy, mass balance, or mock-recall readiness. Do not select for food-safety declarations, critical-limit decisions, product disposition, or actual recalls.",
    "instructions": "selector.md",
  },
  "capability_projection": {
