{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "hr-operations",
  "name": "Human Resources & Organization Operations",
  "label": "Human Resources & Organization Operations",
  "description": "Turns aggregate workforce and people-process evidence into parallel workforce and process analyses, an independently audited operating plan, and a canonical Human Resources delivery.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for aggregate workforce and people-process planning that needs evidence curation, parallel organizational analyses, independent review, and an operating plan.",
    "selection_guidance": "Select when the operator supplies aggregate workforce or process evidence, organization scope, time boundary, jurisdiction, and an operational decision. Do not select for individual employment decisions or diagnosis of protected traits.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:hr-operations:hr-operations%2Fshared%2Fmethod",
        "capability:skill:package:hr-operations:hr-operations%2Fshared%2Fworkflow",
        "capability:tool:package:hr-operations:hr-operations%2Fshared%2Fpublish-hr-operations-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:hr-operations:hr-operations%2Fshared%2Fmethod",
        "capability:skill:package:hr-operations:hr-operations%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "human-resources-operations-planner": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Human Resources Operations Planner",
        "description": "Defines the organization question, aggregate-data boundary, jurisdiction, process scope, and stopping conditions.",
        "base_role": "delegated-worker",
        "prompt": "agents/human-resources-operations-planner/system.md"
      },
      "human-resources-evidence-curator": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Human Resources Evidence Curator",
        "description": "Builds the aggregate workforce, policy, process, benchmark, and authority dossier.",
        "base_role": "deep-research",
        "prompt": "agents/human-resources-evidence-curator/system.md"
      },
      "workforce-analyst": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Workforce Analyst",
        "description": "Analyzes aggregate capacity, mix, movement, management span, hiring flow, and workforce risk.",
        "base_role": "delegated-worker",
        "prompt": "agents/workforce-analyst/system.md"
      },
      "people-process-analyst": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "People Process Analyst",
        "description": "Analyzes recruiting, onboarding, performance enablement, learning, policy, and operating cadence.",
        "base_role": "delegated-worker",
        "prompt": "agents/people-process-analyst/system.md"
      },
      "organization-operations-synthesizer": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Organization Operations Synthesizer",
        "description": "Reconciles workforce and process findings into a sequenced aggregate operating-plan draft.",
        "base_role": "delegated-worker",
        "prompt": "agents/organization-operations-synthesizer/system.md"
      },
      "human-resources-fact-checker": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Human Resources Fact Checker",
        "description": "Independently audits the operating-plan draft for evidence, privacy, authority, calculations, and legal boundaries.",
        "base_role": "fact-check",
        "prompt": "agents/human-resources-fact-checker/system.md"
      },
      "human-resources-operating-plan-writer": {
        "capability_refs": [
          "capability:capability_set:package:hr-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Human Resources Operating Plan Writer",
        "description": "Resolves the audit and publishes the canonical Human Resources and organization operating plan.",
        "base_role": "build",
        "prompt": "agents/human-resources-operating-plan-writer/system.md"
      }
    },
    "virtual_workflows": {
      "people-operations-plan": {
        "label": "Audited People Operations Plan",
        "description": "Use when the Task supplies aggregate workforce and people-process evidence with jurisdiction and time boundaries: define the charter, curate the dossier, analyze workforce and processes in parallel, synthesize and audit the operating plan, and publish it.",
        "nodes": {
          "human-resources-operations-planner": {
            "agent_id": "human-resources-operations-planner",
            "description": "Publishes hr-operations/operating-charter.",
            "depends_on": []
          },
          "human-resources-evidence-curator": {
            "agent_id": "human-resources-evidence-curator",
            "description": "Publishes hr-operations/evidence-dossier.",
            "depends_on": [
              "human-resources-operations-planner"
            ]
          },
          "workforce-analyst": {
            "agent_id": "workforce-analyst",
            "description": "Publishes hr-operations/workforce-analysis.",
            "depends_on": [
              "human-resources-evidence-curator"
            ]
          },
          "people-process-analyst": {
            "agent_id": "people-process-analyst",
            "description": "Publishes hr-operations/process-analysis.",
            "depends_on": [
              "human-resources-evidence-curator"
            ]
          },
          "organization-operations-synthesizer": {
            "agent_id": "organization-operations-synthesizer",
            "description": "Publishes hr-operations/operating-plan-draft.",
            "depends_on": [
              "people-process-analyst",
              "workforce-analyst"
            ]
          },
          "human-resources-fact-checker": {
            "agent_id": "human-resources-fact-checker",
            "description": "Publishes hr-operations/audit.",
            "depends_on": [
              "organization-operations-synthesizer"
            ]
          },
          "human-resources-operating-plan-writer": {
            "agent_id": "human-resources-operating-plan-writer",
            "description": "Publishes hr-operations/operating-plan.",
            "depends_on": [
              "human-resources-fact-checker"
            ]
          }
        }
      }
    }
  }
}
