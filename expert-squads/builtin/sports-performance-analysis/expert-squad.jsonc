{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "sports-performance-analysis",
  "name": "Sports Performance Analysis",
  "label": "Sports Performance Analysis",
  "description": "Training exposure and load, performance testing and reliability, and availability and wellbeing evidence joined into an individual-context performance review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded athlete-performance evidence analysis without medical or coaching authority.",
    "selection_guidance": "Select for training and competition exposure, internal/external load, performance-test protocols, measurement reliability, individual longitudinal change, availability, wellbeing, travel, and recovery context. Do not select for diagnosis, individual injury prediction, return-to-play, training prescription, live coaching, supplements, anti-doping decisions, selection, contracts, or discipline.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:sports-performance-analysis:sports-performance-analysis%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:sports-performance-analysis:sports-performance-analysis%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "training-exposure-load-analyst": {
        "capability_refs": [
          "capability:capability_set:package:sports-performance-analysis:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Training Exposure and Load Analyst",
        "description": "Reconciles training and competition exposure with versioned internal and external load measures.",
        "base_role": "explore",
        "prompt": "agents/training-exposure-load-analyst/system.md"
      },
      "performance-testing-analyst": {
        "capability_refs": [
          "capability:capability_set:package:sports-performance-analysis:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Performance Testing and Reliability Analyst",
        "description": "Checks protocol comparability, measurement error, reliability, and defensible individual change.",
        "base_role": "delegated-worker",
        "prompt": "agents/performance-testing-analyst/system.md"
      },
      "availability-wellbeing-analyst": {
        "capability_refs": [
          "capability:capability_set:package:sports-performance-analysis:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Availability and Wellbeing Analyst",
        "description": "Maps availability, self-reported wellbeing, symptoms, travel, and recovery context without diagnosis.",
        "base_role": "delegated-worker",
        "prompt": "agents/availability-wellbeing-analyst/system.md"
      },
      "sports-performance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:sports-performance-analysis:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Sports Performance Review Owner",
        "description": "Joins exposure, testing, and wellbeing evidence into bounded hypotheses and qualified decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/sports-performance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "sports-performance-review": {
        "label": "Sports Performance Review",
        "description": "Three independent athlete-performance evidence branches converge into one review pack.",
        "nodes": {
          "training-exposure-load-analyst": {
            "agent_id": "training-exposure-load-analyst",
            "description": "Reconciles exposure and internal/external load with data-quality evidence.",
            "depends_on": []
          },
          "performance-testing-analyst": {
            "agent_id": "performance-testing-analyst",
            "description": "Checks test protocol comparability, reliability, error, and individual change.",
            "depends_on": []
          },
          "availability-wellbeing-analyst": {
            "agent_id": "availability-wellbeing-analyst",
            "description": "Maps availability and self-reported wellbeing, symptom, travel, and recovery context.",
            "depends_on": []
          },
          "sports-performance-review-owner": {
            "agent_id": "sports-performance-review-owner",
            "description": "Joins all branches into contextualized performance evidence and review gates.",
            "depends_on": [
              "availability-wellbeing-analyst",
              "performance-testing-analyst",
              "training-exposure-load-analyst"
            ]
          }
        }
      }
    }
  }
}
