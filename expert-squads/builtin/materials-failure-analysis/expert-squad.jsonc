{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "materials-failure-analysis",
  "name": "Materials Failure Analysis",
  "label": "Materials Failure Analysis",
  "description": "Physical-component custody, service history, fracture-surface, material-characterization, load, environment, mechanics and competing-hypothesis evidence joined for qualified review.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded physical materials-failure evidence without touching evidence, destructive testing, root-cause, liability, fitness, disposition, recall, or return-to-service authority.",
    "selection_guidance": "Select for failed physical-component identity and custody, as-received condition, service/design/manufacturing history, fracture origin/morphology, metallography/composition/hardness/mechanical-test evidence, loads, environment, fracture-mechanics applicability, and competing failure hypotheses. Do not select for generic manufacturing disposition, laboratory accreditation, vehicle functional-safety HARA, aircraft maintenance release, well-integrity declaration, semiconductor-device failure analysis, evidence handling/cleaning/cutting/etching/testing, root-cause/liability conclusions, fitness-for-service, rework/recall/scrap, or return to service.",
    "instructions": "selector.md"
  },
  "capability_projection": {
