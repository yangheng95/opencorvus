{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "cultural-heritage-preservation",
  "name": "Cultural Heritage Preservation",
  "label": "Cultural Heritage Preservation",
  "description": "Significance, provenance, condition, preventive-risk, digital-preservation, and access evidence joined into a bounded conservation planning pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-led cultural-heritage preservation planning without treatment or rights authority.",
    "selection_guidance": "Select for museum objects, archives, built heritage, sites, collections, significance and provenance records, condition change, agents of deterioration, preventive conservation, digital preservation, or culturally restricted access. Do not select for physical treatment, authentication, title or restitution decisions, excavation, deaccession, or public release.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:cultural-heritage-preservation:cultural-heritage-preservation%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:cultural-heritage-preservation:cultural-heritage-preservation%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "heritage-significance-provenance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cultural-heritage-preservation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Significance and Provenance Analyst",
        "description": "Separates verified records, inference, oral sources, community-held knowledge, custody, and rights restrictions.",
        "base_role": "explore",
        "prompt": "agents/heritage-significance-provenance-analyst/system.md"
      },
      "heritage-condition-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cultural-heritage-preservation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Condition and Risk Analyst",
        "description": "Maps condition change, agents of deterioration, hazards, and preventive-risk evidence without prescribing treatment.",
        "base_role": "delegated-worker",
        "prompt": "agents/heritage-condition-risk-analyst/system.md"
      },
      "heritage-digital-access-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cultural-heritage-preservation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Digital Preservation and Access Analyst",
        "description": "Reviews digital provenance, fixity, format sustainability, access controls, consent, and cultural sensitivity.",
        "base_role": "delegated-worker",
        "prompt": "agents/heritage-digital-access-analyst/system.md"
      },
      "heritage-conservation-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:cultural-heritage-preservation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Conservation Plan Owner",
        "description": "Joins the independent evidence branches into bounded preservation options and qualified decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/heritage-conservation-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "heritage-preservation-plan": {
        "label": "Heritage Preservation Plan",
        "description": "Three independent heritage evidence branches converge into one conservation planning pack.",
        "nodes": {
          "heritage-significance-provenance-analyst": {
            "agent_id": "heritage-significance-provenance-analyst",
            "description": "Maps significance, provenance, custody, evidence class, rights, and community-held knowledge.",
            "depends_on": []
          },
          "heritage-condition-risk-analyst": {
            "agent_id": "heritage-condition-risk-analyst",
            "description": "Maps condition change, deterioration agents, hazard scenarios, and preventive controls.",
            "depends_on": []
          },
          "heritage-digital-access-analyst": {
            "agent_id": "heritage-digital-access-analyst",
            "description": "Maps digital fixity, format, access, consent, and culturally sensitive restrictions.",
            "depends_on": []
          },
          "heritage-conservation-plan-owner": {
            "agent_id": "heritage-conservation-plan-owner",
            "description": "Joins all branches into prioritized preservation options, dependencies, and approval gates.",
            "depends_on": [
              "heritage-condition-risk-analyst",
              "heritage-digital-access-analyst",
              "heritage-significance-provenance-analyst"
            ]
          }
        }
      }
    }
  }
}
