{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "equity-research",
  "name": "Equity Research",
  "label": "Equity Research",
  "description": "Primary-source equity research from a dated evidence dossier through fundamentals, valuation, balanced thesis, numerical audit, and an investor-ready report.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for public-company, industry, peer, valuation, catalyst, risk, and investment-thesis research that requires an auditable report.",
    "selection_guidance": "Select Equity Research when the requested result is a source-backed public-equity report or investment research dossier. The request must name the company or security and may provide an as-of date, investor question, peer set, or source constraints.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
