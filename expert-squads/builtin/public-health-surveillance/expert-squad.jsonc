{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "public-health-surveillance",
  "name": "Public Health Surveillance",
  "label": "Public Health Surveillance",
  "description": "Evidence-bounded surveillance-system, case-definition, data-quality, epidemiologic trend, and multi-indicator review without case classification or public-health action authority.",
  "version": "2026.08.11.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound public-health surveillance evidence and qualified review preparation.",
    "selection_guidance": "Select for surveillance-system scope, case-definition version trace, completeness and timeliness, epidemiologic measures, trends, analytic signals, or laboratory/genomic/syndromic indicator integration. Do not select for diagnosis, case classification, outbreak declaration, reporting, alerts, contact tracing, or public-health orders.",
    "instructions": "selector.md",
  },
