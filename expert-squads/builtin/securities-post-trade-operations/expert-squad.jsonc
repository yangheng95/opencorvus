{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "securities-post-trade-operations",
  "name": "Securities Post-Trade Operations",
  "label": "Securities Post-Trade Operations",
  "description": "Trade capture, clearing, custody, settlement and break evidence joined for qualified post-trade review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded securities post-trade evidence without trading or moving assets.",
    "selection_guidance": "Select for trade capture/allocation/confirmation, clearing/netting, custody/DVP/RVP, settlement and fail/break reconciliation.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:securities-post-trade-operations:securities-post-trade-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:securities-post-trade-operations:securities-post-trade-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "trade-capture-allocation-confirmation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:securities-post-trade-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Trade Capture, Allocation and Confirmation Analyst",
        "description": "Reconciles trade capture, allocation, confirmation and affirmation evidence.",
        "base_role": "explore",
        "prompt": "agents/trade-capture-allocation-confirmation-analyst/system.md"
      },
      "clearing-netting-obligation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:securities-post-trade-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Clearing, Netting and Obligation Analyst",
        "description": "Traces clearing eligibility, matching, netting and resulting obligations.",
        "base_role": "delegated-worker",
        "prompt": "agents/clearing-netting-obligation-analyst/system.md"
      },
      "custody-dvp-settlement-analyst": {
        "capability_refs": [
          "capability:capability_set:package:securities-post-trade-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Custody, DVP and Settlement Analyst",
        "description": "Traces custody instructions, securities/cash legs and settlement evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/custody-dvp-settlement-analyst/system.md"
      },
      "settlement-fail-break-control-analyst": {
        "capability_refs": [
          "capability:capability_set:package:securities-post-trade-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Settlement Fail and Break Control Analyst",
        "description": "Reviews fails, stock/cash breaks, ageing, exceptions and control evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/settlement-fail-break-control-analyst/system.md"
      },
      "securities-post-trade-operations-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:securities-post-trade-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Securities Post-Trade Operations Review Owner",
        "description": "Joins lifecycle evidence without instructing, settling or moving securities or cash.",
        "base_role": "delegated-worker",
        "prompt": "agents/securities-post-trade-operations-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "securities-post-trade-operations-review": {
        "label": "Securities Post-Trade Operations Review",
        "description": "Four independent professional evidence branches converge into Securities Post-Trade Operations Review Owner.",
        "nodes": {
          "trade-capture-allocation-confirmation-analyst": {
            "agent_id": "trade-capture-allocation-confirmation-analyst",
            "description": "Reconciles trade capture, allocation, confirmation and affirmation evidence.",
            "depends_on": []
          },
          "clearing-netting-obligation-analyst": {
            "agent_id": "clearing-netting-obligation-analyst",
            "description": "Traces clearing eligibility, matching, netting and resulting obligations.",
            "depends_on": []
          },
          "custody-dvp-settlement-analyst": {
            "agent_id": "custody-dvp-settlement-analyst",
            "description": "Traces custody instructions, securities/cash legs and settlement evidence.",
            "depends_on": []
          },
          "settlement-fail-break-control-analyst": {
            "agent_id": "settlement-fail-break-control-analyst",
            "description": "Reviews fails, stock/cash breaks, ageing, exceptions and control evidence.",
            "depends_on": []
          },
          "securities-post-trade-operations-review-owner": {
            "agent_id": "securities-post-trade-operations-review-owner",
            "description": "Joins lifecycle evidence without instructing, settling or moving securities or cash.",
            "depends_on": [
              "clearing-netting-obligation-analyst",
              "custody-dvp-settlement-analyst",
              "settlement-fail-break-control-analyst",
              "trade-capture-allocation-confirmation-analyst"
            ]
          }
        }
      }
    }
  }
}
