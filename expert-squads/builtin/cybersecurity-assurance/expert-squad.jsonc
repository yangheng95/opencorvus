  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded security posture, control evidence, and incident-readiness assurance.",
    "selection_guidance": "Select when a decision owner needs a source-grounded security assurance pack without exploitation, credential access, production mutation, or compliance certification.",
    "instructions": "selector.md"
  },
