{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "cybersecurity-assurance",
  "name": "Cybersecurity Assurance",
  "label": "Cybersecurity Assurance",
  "description": "Read-only threat, control, and incident-readiness analysis joined into an evidence-backed security assurance register.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded security posture, control evidence, and incident-readiness assurance.",
    "selection_guidance": "Select when a decision owner needs a source-grounded security assurance pack without exploitation, credential access, production mutation, or compliance certification.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:cybersecurity-assurance:cybersecurity-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:cybersecurity-assurance:cybersecurity-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "security-threat-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cybersecurity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Threat Evidence Analyst",
        "description": "Maps assets, trust boundaries, threat claims, and observed evidence.",
        "base_role": "explore",
        "prompt": "agents/security-threat-evidence-analyst/system.md"
      },
      "security-control-coverage-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cybersecurity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Control Coverage Analyst",
        "description": "Maps claimed controls to evidence, owners, gaps, and verification status.",
        "base_role": "delegated-worker",
        "prompt": "agents/security-control-coverage-analyst/system.md"
      },
      "security-incident-readiness-analyst": {
        "capability_refs": [
          "capability:capability_set:package:cybersecurity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Incident Readiness Analyst",
        "description": "Assesses detection, escalation, containment, recovery, and exercise evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/security-incident-readiness-analyst/system.md"
      },
      "security-assurance-integrator": {
        "capability_refs": [
          "capability:capability_set:package:cybersecurity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Security Assurance Integrator",
        "description": "Joins all security evidence into one reviewable assurance register.",
        "base_role": "delegated-worker",
        "prompt": "agents/security-assurance-integrator/system.md"
      }
    },
    "virtual_workflows": {
      "security-assurance-pack": {
        "label": "Security Assurance Pack",
        "description": "Three independent assurance branches converge into one accountable evidence register.",
        "nodes": {
          "security-threat-evidence-analyst": {
            "agent_id": "security-threat-evidence-analyst",
            "description": "Maps threats and observed evidence.",
            "depends_on": []
          },
          "security-control-coverage-analyst": {
            "agent_id": "security-control-coverage-analyst",
            "description": "Maps control coverage and gaps.",
            "depends_on": []
          },
          "security-incident-readiness-analyst": {
            "agent_id": "security-incident-readiness-analyst",
            "description": "Maps incident readiness evidence.",
            "depends_on": []
          },
          "security-assurance-integrator": {
            "agent_id": "security-assurance-integrator",
            "description": "Joins all branches into the assurance register.",
            "depends_on": [
              "security-control-coverage-analyst",
              "security-incident-readiness-analyst",
              "security-threat-evidence-analyst"
            ]
          }
        }
      }
    }
  }
}
