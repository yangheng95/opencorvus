{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "education-program-design",
  "name": "Education Program Design",
  "label": "Education Program Design",
  "description": "Learner evidence, curriculum structure, assessment, and accessibility analysis joined into a measurable learning-program blueprint.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed curriculum and learning-program design.",
    "selection_guidance": "Select when learner context, curriculum, assessment, and accessibility need independent analysis and an accountable join.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:education-program-design:education-program-design%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:education-program-design:education-program-design%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "education-learner-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:education-program-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Learner Evidence Analyst",
        "description": "Maps learner context, needs, constraints, and evidence quality.",
        "base_role": "explore",
        "prompt": "agents/education-learner-evidence-analyst/system.md"
      },
      "education-curriculum-architect": {
        "capability_refs": [
          "capability:capability_set:package:education-program-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Curriculum Architect",
        "description": "Designs measurable outcomes, prerequisites, sequence, and practice.",
        "base_role": "delegated-worker",
        "prompt": "agents/education-curriculum-architect/system.md"
      },
      "education-assessment-accessibility-analyst": {
        "capability_refs": [
          "capability:capability_set:package:education-program-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Assessment and Accessibility Analyst",
        "description": "Aligns assessment, feedback, accommodations, and accessibility.",
        "base_role": "delegated-worker",
        "prompt": "agents/education-assessment-accessibility-analyst/system.md"
      },
      "education-program-integrator": {
        "capability_refs": [
          "capability:capability_set:package:education-program-design:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Learning Program Integrator",
        "description": "Joins all branches into a reviewable learning-program blueprint.",
        "base_role": "delegated-worker",
        "prompt": "agents/education-program-integrator/system.md"
      }
    },
    "virtual_workflows": {
      "learning-program-blueprint": {
        "label": "Learning Program Blueprint",
        "description": "Three independent education-design branches converge into one blueprint.",
        "nodes": {
          "education-learner-evidence-analyst": {
            "agent_id": "education-learner-evidence-analyst",
            "description": "Maps learner evidence.",
            "depends_on": []
          },
          "education-curriculum-architect": {
            "agent_id": "education-curriculum-architect",
            "description": "Designs curriculum structure.",
            "depends_on": []
          },
          "education-assessment-accessibility-analyst": {
            "agent_id": "education-assessment-accessibility-analyst",
            "description": "Designs assessment and accessibility.",
            "depends_on": []
          },
          "education-program-integrator": {
            "agent_id": "education-program-integrator",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "education-assessment-accessibility-analyst",
              "education-curriculum-architect",
              "education-learner-evidence-analyst"
            ]
          }
        }
      }
    }
  }
}
