{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "pipeline-integrity-management",
  "name": "Pipeline Integrity Management",
  "label": "Pipeline Integrity Management",
  "description": "Source-bound regulated pipeline segment, threat, assessment, anomaly, excavation, repair, and change evidence for qualified review without operating or regulatory authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for regulated pipeline integrity evidence and qualified review preparation.",
    "selection_guidance": "Select for segment/configuration, threat integration, assessment/anomaly correlation, excavation/repair, remediation, or management-of-change evidence. Do not select for live pipeline operation, emergency response, field authorization, engineering disposition, return-to-service, or compliance decisions.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:pipeline-integrity-management:pipeline-integrity-management%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:pipeline-integrity-management:pipeline-integrity-management%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "pipeline-segment-configuration-regulatory-basis-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pipeline-integrity-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Pipeline Segment Configuration Regulatory Basis Analyst",
        "description": "Freezes segment identity, route/stationing, configuration, consequence/class designations, and controlling regulatory/operator basis.",
        "base_role": "explore",
        "prompt": "agents/pipeline-segment-configuration-regulatory-basis-analyst/system.md"
      },
      "pipeline-threat-data-integration-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pipeline-integrity-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Pipeline Threat Data Integration Analyst",
        "description": "Integrates operator-defined threat and condition evidence with coverage, quality, gaps, counterevidence, and interactions.",
        "base_role": "delegated-worker",
        "prompt": "agents/pipeline-threat-data-integration-analyst/system.md"
      },
      "pipeline-assessment-anomaly-remediation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:pipeline-integrity-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Pipeline Assessment Anomaly Remediation Analyst",
        "description": "Traces assessment runs, indications/anomalies, alignment, excavation, repair, remediation, and management-of-change evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/pipeline-assessment-anomaly-remediation-analyst/system.md"
      },
      "pipeline-integrity-management-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:pipeline-integrity-management:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Pipeline Integrity Management Review Owner",
        "description": "Joins segment, threat, assessment, anomaly, remediation, and change evidence while preserving engineering and regulatory decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/pipeline-integrity-management-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "pipeline-integrity-management-review": {
        "label": "Pipeline Integrity Management Review",
        "description": "Three independent regulated pipeline evidence branches converge into one controlled integrity review.",
        "nodes": {
          "pipeline-segment-configuration-regulatory-basis-analyst": {
            "agent_id": "pipeline-segment-configuration-regulatory-basis-analyst",
            "description": "Freezes segment, configuration, spatial reference, and controlling basis.",
            "depends_on": []
          },
          "pipeline-threat-data-integration-analyst": {
            "agent_id": "pipeline-threat-data-integration-analyst",
            "description": "Integrates source-bound operator threat and condition evidence.",
            "depends_on": []
          },
          "pipeline-assessment-anomaly-remediation-analyst": {
            "agent_id": "pipeline-assessment-anomaly-remediation-analyst",
            "description": "Traces assessments, anomaly correlations, excavations, repairs, and changes.",
            "depends_on": []
          },
          "pipeline-integrity-management-review-owner": {
            "agent_id": "pipeline-integrity-management-review-owner",
            "description": "Joins all branches without operational, engineering, emergency, field-work, or regulatory authority.",
            "depends_on": [
              "pipeline-assessment-anomaly-remediation-analyst",
              "pipeline-segment-configuration-regulatory-basis-analyst",
              "pipeline-threat-data-integration-analyst"
            ]
          }
        }
      }
    }
  }
}
