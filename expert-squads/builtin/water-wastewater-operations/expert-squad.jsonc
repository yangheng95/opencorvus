{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "water-wastewater-operations",
  "name": "Water and Wastewater Operations",
  "label": "Water and Wastewater Operations",
  "description": "Treatment-process, flow-quality balance, collection/distribution, asset-reliability, sampling, and permit evidence joined into a bounded operations review pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded water and wastewater operating evidence without process-control, public-health, or compliance authority.",
    "selection_guidance": "Select for drinking-water and wastewater process trains, flow/concentration/mass balances, collection or distribution evidence, sampling and laboratory methods, alarms/work orders, asset reliability, permit-condition traceability, and excursion review. Do not select for chemical dosing, pump/valve/SCADA control, potable-water declaration, discharge/bypass approval, laboratory validation, compliance determination, public notice, maintenance isolation, design approval, or emergency command.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:water-wastewater-operations:water-wastewater-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:water-wastewater-operations:water-wastewater-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "drinking-water-treatment-quality-analyst": {
        "capability_refs": [
          "capability:capability_set:package:water-wastewater-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Drinking Water Treatment and Quality Analyst",
        "description": "Reconciles source-water, treatment-stage, distribution, monitoring, and laboratory-quality evidence.",
        "base_role": "explore",
        "prompt": "agents/drinking-water-treatment-quality-analyst/system.md"
      },
      "wastewater-collection-treatment-analyst": {
        "capability_refs": [
          "capability:capability_set:package:water-wastewater-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Wastewater Collection and Treatment Analyst",
        "description": "Reconciles collection, influent, unit-process, effluent, residuals, overflow, and permit-monitoring evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/wastewater-collection-treatment-analyst/system.md"
      },
      "water-asset-compliance-reliability-analyst": {
        "capability_refs": [
          "capability:capability_set:package:water-wastewater-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Water Asset, Monitoring and Reliability Analyst",
        "description": "Reconciles assets, alarms, work orders, redundancy, monitoring obligations, and response ownership.",
        "base_role": "delegated-worker",
        "prompt": "agents/water-asset-compliance-reliability-analyst/system.md"
      },
      "water-wastewater-operations-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:water-wastewater-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Water and Wastewater Operations Review Owner",
        "description": "Joins process, collection/distribution, asset, monitoring, and permit evidence and routes qualified decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/water-wastewater-operations-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "water-wastewater-operations-review": {
        "label": "Water and Wastewater Operations Review",
        "description": "Three independent treatment, collection/distribution, asset and monitoring branches converge into one bounded review pack.",
        "nodes": {
          "drinking-water-treatment-quality-analyst": {
            "agent_id": "drinking-water-treatment-quality-analyst",
            "description": "Reconciles drinking-water process, flow, quality, sampling and laboratory evidence.",
            "depends_on": []
          },
          "wastewater-collection-treatment-analyst": {
            "agent_id": "wastewater-collection-treatment-analyst",
            "description": "Reconciles wastewater collection, treatment, effluent, residuals and overflow evidence.",
            "depends_on": []
          },
          "water-asset-compliance-reliability-analyst": {
            "agent_id": "water-asset-compliance-reliability-analyst",
            "description": "Reconciles asset, alarm, work-order, redundancy, monitoring and permit-trace evidence.",
            "depends_on": []
          },
          "water-wastewater-operations-review-owner": {
            "agent_id": "water-wastewater-operations-review-owner",
            "description": "Joins all branches, exposes contradictions and unknowns, and routes qualified decisions.",
            "depends_on": [
              "drinking-water-treatment-quality-analyst",
              "wastewater-collection-treatment-analyst",
              "water-asset-compliance-reliability-analyst"
            ]
          }
        }
      }
    }
  }
}
