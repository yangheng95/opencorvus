{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "water-wastewater-operations",
  "name": "Water and Wastewater Operations",
  "label": "Water and Wastewater Operations",
  "description": "Treatment-process, flow-quality balance, collection/distribution, asset-reliability, sampling, and permit evidence joined into a bounded operations review pack.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded water and wastewater operating evidence without process-control, public-health, or compliance authority.",
    "selection_guidance": "Select for drinking-water and wastewater process trains, flow/concentration/mass balances, collection or distribution evidence, sampling and laboratory methods, alarms/work orders, asset reliability, permit-condition traceability, and excursion review. Do not select for chemical dosing, pump/valve/SCADA control, potable-water declaration, discharge/bypass approval, laboratory validation, compliance determination, public notice, maintenance isolation, design approval, or emergency command.",
    "instructions": "selector.md"
  },
