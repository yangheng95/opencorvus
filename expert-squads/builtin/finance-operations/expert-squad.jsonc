  "id": "finance-operations",
  "name": "Finance Operations",
  "label": "Finance Operations",
  "description": "Source-grounded finance operations reconciliation, control review, close planning, and independent review with explicit non-advisory and human-approval boundaries.",
  "version": "2026.08.10.1",
  "product_pillars": ["work"],
  "readme": "README.md",
  "selector": {
    "summary": "Reconcile operational finance evidence and produce a human-reviewed close or control plan.",
    "selection_guidance": "Use for operational reconciliation, management reporting support, close checklists, variance investigation, receivables or payables process review, and finance-control design. This package does not provide financial, investment, accounting, audit, or tax advice and does not approve, file, pay, post, or transact.",
    "instructions": "selector.md",
  },
