{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "identity-access-governance",
  "name": "Identity Access Governance",
  "label": "Identity Access Governance",
  "description": "Identity lifecycle, account-entitlement, access-control and certification evidence joined for qualified governance review.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded identity-governance evidence without provisioning or access decisions.",
    "selection_guidance": "Select for authoritative identity lifecycle, account and entitlement correlation, access request/role/SoD controls, certifications and orphan-account review.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:identity-access-governance:identity-access-governance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:identity-access-governance:identity-access-governance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "authoritative-identity-lifecycle-analyst": {
        "capability_refs": [
          "capability:capability_set:package:identity-access-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Authoritative Identity Lifecycle Analyst",
        "description": "Reconciles authoritative identity populations and Joiner-Mover-Leaver events.",
        "base_role": "explore",
        "prompt": "agents/authoritative-identity-lifecycle-analyst/system.md"
      },
      "account-entitlement-correlation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:identity-access-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Account and Entitlement Correlation Analyst",
        "description": "Correlates identities, accounts, groups, roles and effective entitlements.",
        "base_role": "delegated-worker",
        "prompt": "agents/account-entitlement-correlation-analyst/system.md"
      },
      "access-request-role-sod-control-analyst": {
        "capability_refs": [
          "capability:capability_set:package:identity-access-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Access Request, Role and SoD Control Analyst",
        "description": "Tests access-request, role and segregation-of-duties evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/access-request-role-sod-control-analyst/system.md"
      },
      "access-certification-orphan-review-analyst": {
        "capability_refs": [
          "capability:capability_set:package:identity-access-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Access Certification and Orphan Review Analyst",
        "description": "Reviews certification populations, dormant and orphaned account evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/access-certification-orphan-review-analyst/system.md"
      },
      "identity-access-governance-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:identity-access-governance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Identity Access Governance Review Owner",
        "description": "Joins lifecycle, entitlement, control and certification evidence without deciding access.",
        "base_role": "delegated-worker",
        "prompt": "agents/identity-access-governance-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "identity-access-governance-review": {
        "label": "Identity Access Governance Review",
        "description": "Four independent professional evidence branches converge into Identity Access Governance Review Owner.",
        "nodes": {
          "authoritative-identity-lifecycle-analyst": {
            "agent_id": "authoritative-identity-lifecycle-analyst",
            "description": "Reconciles authoritative identity populations and Joiner-Mover-Leaver events.",
            "depends_on": []
          },
          "account-entitlement-correlation-analyst": {
            "agent_id": "account-entitlement-correlation-analyst",
            "description": "Correlates identities, accounts, groups, roles and effective entitlements.",
            "depends_on": []
          },
          "access-request-role-sod-control-analyst": {
            "agent_id": "access-request-role-sod-control-analyst",
            "description": "Tests access-request, role and segregation-of-duties evidence.",
            "depends_on": []
          },
          "access-certification-orphan-review-analyst": {
            "agent_id": "access-certification-orphan-review-analyst",
            "description": "Reviews certification populations, dormant and orphaned account evidence.",
            "depends_on": []
          },
          "identity-access-governance-review-owner": {
            "agent_id": "identity-access-governance-review-owner",
            "description": "Joins lifecycle, entitlement, control and certification evidence without deciding access.",
            "depends_on": [
              "access-certification-orphan-review-analyst",
              "access-request-role-sod-control-analyst",
              "account-entitlement-correlation-analyst",
              "authoritative-identity-lifecycle-analyst"
            ]
          }
        }
      }
    }
  }
}
