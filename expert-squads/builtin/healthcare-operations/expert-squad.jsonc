{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "healthcare-operations",
  "name": "Healthcare Operations",
  "label": "Healthcare Operations",
  "description": "De-identified service-flow, capacity, access, safety, and privacy analysis joined into an accountable operations-improvement pack.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded healthcare operations improvement analysis.",
    "selection_guidance": "Select for de-identified service-flow, capacity, access, safety, or privacy decision support without clinical advice or patient-specific action.",
    "instructions": "selector.md"
  },
