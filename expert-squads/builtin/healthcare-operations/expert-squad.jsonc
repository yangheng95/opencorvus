{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "healthcare-operations",
  "name": "Healthcare Operations",
  "label": "Healthcare Operations",
  "description": "De-identified service-flow, capacity, access, safety, and privacy analysis joined into an accountable operations-improvement pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded healthcare operations improvement analysis.",
    "selection_guidance": "Select for de-identified service-flow, capacity, access, safety, or privacy decision support without clinical advice or patient-specific action.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:healthcare-operations:healthcare-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:healthcare-operations:healthcare-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "healthcare-service-flow-analyst": {
        "capability_refs": [
          "capability:capability_set:package:healthcare-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Service Flow Analyst",
        "description": "Maps de-identified service flows, handoffs, queues, and bottlenecks.",
        "base_role": "explore",
        "prompt": "agents/healthcare-service-flow-analyst/system.md"
      },
      "healthcare-capacity-access-analyst": {
        "capability_refs": [
          "capability:capability_set:package:healthcare-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Capacity and Access Analyst",
        "description": "Tests demand, capacity, access, and equity assumptions.",
        "base_role": "delegated-worker",
        "prompt": "agents/healthcare-capacity-access-analyst/system.md"
      },
      "healthcare-safety-privacy-analyst": {
        "capability_refs": [
          "capability:capability_set:package:healthcare-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Safety and Privacy Analyst",
        "description": "Maps operational safety and privacy evidence and gaps.",
        "base_role": "delegated-worker",
        "prompt": "agents/healthcare-safety-privacy-analyst/system.md"
      },
      "healthcare-operations-improvement-owner": {
        "capability_refs": [
          "capability:capability_set:package:healthcare-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Operations Improvement Owner",
        "description": "Joins the evidence into an accountable improvement register.",
        "base_role": "delegated-worker",
        "prompt": "agents/healthcare-operations-improvement-owner/system.md"
      }
    },
    "virtual_workflows": {
      "healthcare-operations-improvement-pack": {
        "label": "Healthcare Operations Improvement Pack",
        "description": "Three independent operations branches converge into one accountable register.",
        "nodes": {
          "healthcare-service-flow-analyst": {
            "agent_id": "healthcare-service-flow-analyst",
            "description": "Maps service-flow evidence.",
            "depends_on": []
          },
          "healthcare-capacity-access-analyst": {
            "agent_id": "healthcare-capacity-access-analyst",
            "description": "Maps capacity and access evidence.",
            "depends_on": []
          },
          "healthcare-safety-privacy-analyst": {
            "agent_id": "healthcare-safety-privacy-analyst",
            "description": "Maps safety and privacy evidence.",
            "depends_on": []
          },
          "healthcare-operations-improvement-owner": {
            "agent_id": "healthcare-operations-improvement-owner",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "healthcare-capacity-access-analyst",
              "healthcare-safety-privacy-analyst",
              "healthcare-service-flow-analyst"
            ]
          }
        }
      }
    }
  }
}
