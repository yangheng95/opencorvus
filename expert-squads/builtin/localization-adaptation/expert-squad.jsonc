{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "localization-adaptation",
  "name": "Localization & Adaptation",
  "label": "Localization & Adaptation",
  "description": "Parallel terminology, locale adaptation, and linguistic quality work joined into a source-controlled locale release pack.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for terminology-controlled adaptation to a named language-locale pair with explicit linguistic quality evidence.",
    "selection_guidance": "Select when a fixed source must be adapted for a locale and channel. Keep external publication and certified native approval outside the package unless evidenced.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "localization-adaptation/shared/method"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "localization-terminology-steward": {
        "label": "Localization Terminology Steward",
        "description": "Builds the contextual term register, protected-token inventory, and source ambiguity record.",
        "base_role": "delegated-worker",
        "prompt": "agents/localization-terminology-steward/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "localization-adaptation/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "localization-locale-adapter": {
        "label": "Locale Adaptation Specialist",
        "description": "Adapts stable source content for the named locale, audience, channel, and format constraints.",
        "base_role": "delegated-worker",
        "prompt": "agents/localization-locale-adapter/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "localization-adaptation/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "localization-linguistic-qa": {
        "label": "Linguistic Quality Reviewer",
        "description": "Independently checks accuracy, fluency, terminology, locale conventions, tokens, and review coverage.",
        "base_role": "fact-check",
        "prompt": "agents/localization-linguistic-qa/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "localization-adaptation/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "localization-release-integrator": {
        "label": "Localization Release Integrator",
        "description": "Joins terminology, adaptation, and linguistic quality evidence into the locale release pack.",
        "base_role": "build",
        "prompt": "agents/localization-release-integrator/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "localization-adaptation/shared/method"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      }
    },
    "virtual_workflows": {
      "locale-release-pack": {
        "label": "Locale Release Pack",
        "description": "Run terminology, locale adaptation, and linguistic quality work independently, then join them into one release pack.",
        "nodes": {
          "localization-terminology-steward": {
            "agent_id": "localization-terminology-steward",
            "description": "Publishes the contextual terminology and protected-token register.",
            "depends_on": []
          },
          "localization-locale-adapter": {
            "agent_id": "localization-locale-adapter",
            "description": "Publishes the locale-adapted content and adaptation log.",
            "depends_on": []
          },
          "localization-linguistic-qa": {
            "agent_id": "localization-linguistic-qa",
            "description": "Publishes the independent linguistic quality review or preflight matrix.",
            "depends_on": []
          },
          "localization-release-integrator": {
            "agent_id": "localization-release-integrator",
            "description": "Joins terminology, adaptation, and quality evidence into the final locale release pack.",
            "depends_on": [
              "localization-linguistic-qa",
              "localization-locale-adapter",
              "localization-terminology-steward"
            ]
          }
        }
      }
    }
  }
}
