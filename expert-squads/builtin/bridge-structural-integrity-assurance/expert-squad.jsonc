{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "bridge-structural-integrity-assurance",
  "name": "Bridge Structural Integrity Assurance",
  "label": "Bridge Structural Integrity Assurance",
  "description": "Bridge asset configuration, element inspection, defect, load-rating, scour, fatigue, maintenance-action and independent QC/QA evidence assurance without posting, closure or engineering-release authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for controlled bridge inspection and structural-integrity evidence prepared for qualified owner review.",
    "selection_guidance": "Select for bridge identity/configuration, element condition, inspection findings, load-rating inputs/results, scour, fatigue/fracture evidence, maintenance actions or independent QC/QA. Do not select to rate, post, close, reopen, permit loads, control traffic or approve repair.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:bridge-structural-integrity-assurance:bridge-structural-integrity-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:bridge-structural-integrity-assurance:bridge-structural-integrity-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "bridge-asset-configuration-authority-analyst": {
        "capability_refs": [
          "capability:capability_set:package:bridge-structural-integrity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Bridge Asset Configuration Authority Analyst",
        "description": "Freezes bridge/span/element identity, records, modifications, inspection program and professional authority.",
        "base_role": "explore",
        "prompt": "agents/bridge-asset-configuration-authority-analyst/system.md"
      },
      "bridge-inspection-condition-defect-analyst": {
        "capability_refs": [
          "capability:capability_set:package:bridge-structural-integrity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Bridge Inspection Condition Defect Analyst",
        "description": "Maps material and element observations to reproducible locations, dimensions, evidence and limitations.",
        "base_role": "delegated-worker",
        "prompt": "agents/bridge-inspection-condition-defect-analyst/system.md"
      },
      "bridge-load-rating-scour-fatigue-analyst": {
        "capability_refs": [
          "capability:capability_set:package:bridge-structural-integrity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Bridge Load Rating Scour and Fatigue Analyst",
        "description": "Traces supplied analysis models, loads, scour, fatigue/fracture and controlling evidence without engineering decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/bridge-load-rating-scour-fatigue-analyst/system.md"
      },
      "bridge-maintenance-action-qcqa-analyst": {
        "capability_refs": [
          "capability:capability_set:package:bridge-structural-integrity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Bridge Maintenance Action QC QA Analyst",
        "description": "Traces findings, owner actions, restrictions as supplied, repair evidence, verification and independent QC/QA.",
        "base_role": "delegated-worker",
        "prompt": "agents/bridge-maintenance-action-qcqa-analyst/system.md"
      },
      "bridge-structural-integrity-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:bridge-structural-integrity-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Bridge Structural Integrity Review Owner",
        "description": "Joins asset, inspection, analysis and action/QC-QA evidence into a qualified bridge-owner review pack.",
        "base_role": "delegated-worker",
        "prompt": "agents/bridge-structural-integrity-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "qualified-review": {
        "label": "Bridge Structural Integrity Assurance Qualified Review",
        "description": "Independent professional evidence branches converge into one controlled Bridge Structural Integrity Assurance review.",
        "nodes": {
          "bridge-asset-configuration-authority-analyst": {
            "agent_id": "bridge-asset-configuration-authority-analyst",
            "description": "Freezes bridge/span/element identity, records, modifications, inspection program and professional authority.",
            "depends_on": []
          },
          "bridge-inspection-condition-defect-analyst": {
            "agent_id": "bridge-inspection-condition-defect-analyst",
            "description": "Maps material and element observations to reproducible locations, dimensions, evidence and limitations.",
            "depends_on": []
          },
          "bridge-load-rating-scour-fatigue-analyst": {
            "agent_id": "bridge-load-rating-scour-fatigue-analyst",
            "description": "Traces supplied analysis models, loads, scour, fatigue/fracture and controlling evidence without engineering decisions.",
            "depends_on": []
          },
          "bridge-maintenance-action-qcqa-analyst": {
            "agent_id": "bridge-maintenance-action-qcqa-analyst",
            "description": "Traces findings, owner actions, restrictions as supplied, repair evidence, verification and independent QC/QA.",
            "depends_on": []
          },
          "bridge-structural-integrity-review-owner": {
            "agent_id": "bridge-structural-integrity-review-owner",
            "description": "Joins asset, inspection, analysis and action/QC-QA evidence into a qualified bridge-owner review pack.",
            "depends_on": [
              "bridge-asset-configuration-authority-analyst",
              "bridge-inspection-condition-defect-analyst",
              "bridge-load-rating-scour-fatigue-analyst",
              "bridge-maintenance-action-qcqa-analyst"
            ]
          }
        }
      }
    }
  }
}
