    "virtual_workflows": {
      "delivery": {
        "label": "Planned Parallel Frontend Innovation",
        "description": "One Planner fixes the selected direction and work partition before independent research, design, implementation, workload, and fact workers execute in parallel.",
        "nodes": {
          "frontend-innovate-planner": {
            "agent_id": "frontend-innovate-planner",
            "description": "Publishes the selected direction, evidence boundary, work partition, and acceptance allocation.",
            "depends_on": []
          },
          "frontend-innovate-explorer": {
            "agent_id": "frontend-innovate-explorer",
            "description": "Investigates the target repository and reusable product primitives.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-intent-analyst": {
            "agent_id": "frontend-innovate-intent-analyst",
            "description": "Checks the plan against the user task and convenience outcome.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-experience-designer": {
            "agent_id": "frontend-innovate-experience-designer",
            "description": "Produces the plan-owned design and rendered design evidence.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-source-researcher": {
            "agent_id": "frontend-innovate-source-researcher",
            "description": "Collects applicable source and competitor evidence within the planned boundary.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-deep-researcher": {
            "agent_id": "frontend-innovate-deep-researcher",
            "description": "Collects durable external product evidence within the planned boundary.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-workload-analyst": {
            "agent_id": "frontend-innovate-workload-analyst",
            "description": "Challenges work partition, ownership, and verification cost.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-implementer": {
            "agent_id": "frontend-innovate-implementer",
            "description": "Implements the selected direction and captures its own real rendered proof.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          },
          "frontend-innovate-fact-checker": {
            "agent_id": "frontend-innovate-fact-checker",
            "description": "Independently verifies material claims and declared evidence against the plan.",
            "depends_on": [
              "frontend-innovate-planner"
            ]
          }
        }
      }
    }
