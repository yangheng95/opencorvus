{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "frontend-innovate",
  "name": "Frontend Innovate",
  "label": "Frontend Innovate",
  "description": "Evidence-backed product redesign, visual direction, implementation, and rendered proof through durable catalog facts and visible narrative Turn summaries.",
  "version": "2026.08.07.1",
  "product_pillars": ["code"],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed frontend redesign and product innovation with rendered design proof.",
    "selection_guidance": "Select frontend-innovate when the task requires a new design direction rather than source parity.",
    "instructions": "selector.md",
  },
  "configuration": {
