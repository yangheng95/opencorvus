{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "telecom-network-assurance",
  "name": "Telecom Network Assurance",
  "label": "Telecom Network Assurance",
  "description": "Demand, topology, service-level, capacity, and change-risk evidence joined into a non-operational network assurance plan.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded telecom service-assurance and capacity analysis.",
    "selection_guidance": "Select for telecom demand, topology, service-level indicators, error budgets, incident patterns, capacity, dependency, and change-risk analysis without accessing or changing live networks.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:telecom-network-assurance:telecom-network-assurance%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:telecom-network-assurance:telecom-network-assurance%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "telecom-demand-topology-analyst": {
        "capability_refs": [
          "capability:capability_set:package:telecom-network-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Demand and Topology Analyst",
        "description": "Maps service demand, topology, dependencies, traffic boundaries, and evidence gaps.",
        "base_role": "explore",
        "prompt": "agents/telecom-demand-topology-analyst/system.md"
      },
      "telecom-service-level-analyst": {
        "capability_refs": [
          "capability:capability_set:package:telecom-network-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Service-Level Analyst",
        "description": "Defines sourced service indicators, objectives, error budgets, and incident evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/telecom-service-level-analyst/system.md"
      },
      "telecom-capacity-change-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:telecom-network-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Capacity and Change-Risk Analyst",
        "description": "Maps capacity constraints, maintenance windows, rollout dependencies, and change risk.",
        "base_role": "delegated-worker",
        "prompt": "agents/telecom-capacity-change-risk-analyst/system.md"
      },
      "network-assurance-owner": {
        "capability_refs": [
          "capability:capability_set:package:telecom-network-assurance:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Network Assurance Owner",
        "description": "Joins the branches into a reviewable non-operational assurance plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/network-assurance-owner/system.md"
      }
    },
    "virtual_workflows": {
      "network-assurance-plan": {
        "label": "Network Assurance Plan",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "telecom-demand-topology-analyst": {
            "agent_id": "telecom-demand-topology-analyst",
            "description": "Maps service demand, topology, dependencies, traffic boundaries, and evidence gaps.",
            "depends_on": []
          },
          "telecom-service-level-analyst": {
            "agent_id": "telecom-service-level-analyst",
            "description": "Defines sourced service indicators, objectives, error budgets, and incident evidence.",
            "depends_on": []
          },
          "telecom-capacity-change-risk-analyst": {
            "agent_id": "telecom-capacity-change-risk-analyst",
            "description": "Maps capacity constraints, maintenance windows, rollout dependencies, and change risk.",
            "depends_on": []
          },
          "network-assurance-owner": {
            "agent_id": "network-assurance-owner",
            "description": "Joins the branches into a reviewable non-operational assurance plan.",
            "depends_on": [
              "telecom-capacity-change-risk-analyst",
              "telecom-demand-topology-analyst",
              "telecom-service-level-analyst"
            ]
          }
        }
      }
    }
  }
}
