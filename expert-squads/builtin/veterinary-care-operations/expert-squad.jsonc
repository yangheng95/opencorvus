{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "veterinary-care-operations",
  "name": "Veterinary Care Operations",
  "label": "Veterinary Care Operations",
  "description": "Evidence-bounded veterinary episode, order, medication, procedure, anesthesia, recovery, inventory, biosecurity, and client-follow-up review without clinical authority.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-bound veterinary care-operations evidence and qualified review.",
    "selection_guidance": "Select for patient/episode, signed order, medication/procedure, anesthesia/recovery, inventory/cold-chain, biosecurity, or controlled client-follow-up evidence. Do not select for diagnosis, treatment, dose, live care, reportable-disease, euthanasia, or client-contact decisions.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:veterinary-care-operations:veterinary-care-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:veterinary-care-operations:veterinary-care-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "veterinary-patient-intake-care-pathway-analyst": {
        "capability_refs": [
          "capability:capability_set:package:veterinary-care-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Veterinary Patient Intake Care Pathway Analyst",
        "description": "Reconciles animal, client authorization, episode, observation, veterinarian-supplied pathway, handoff, and disposition evidence.",
        "base_role": "explore",
        "prompt": "agents/veterinary-patient-intake-care-pathway-analyst/system.md"
      },
      "veterinary-order-medication-procedure-trace-analyst": {
        "capability_refs": [
          "capability:capability_set:package:veterinary-care-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Veterinary Order Medication Procedure Trace Analyst",
        "description": "Traces signed diagnostics, medication, dispensing, administration, procedure, specimen, result, and variance evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/veterinary-order-medication-procedure-trace-analyst/system.md"
      },
      "veterinary-anesthesia-monitoring-recovery-analyst": {
        "capability_refs": [
          "capability:capability_set:package:veterinary-care-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Veterinary Anesthesia Monitoring Recovery Analyst",
        "description": "Traces approved-plan, consent, equipment, monitoring, intervention-record, recovery, and handoff evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/veterinary-anesthesia-monitoring-recovery-analyst/system.md"
      },
      "veterinary-inventory-biosecurity-client-followup-analyst": {
        "capability_refs": [
          "capability:capability_set:package:veterinary-care-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Veterinary Inventory Biosecurity Client Followup Analyst",
        "description": "Reconciles inventory, cold-chain, biosecurity, and signed-instruction client-follow-up evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/veterinary-inventory-biosecurity-client-followup-analyst/system.md"
      },
      "veterinary-care-operations-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:veterinary-care-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Veterinary Care Operations Review Owner",
        "description": "Joins four branches into a qualified-review pack while preserving all veterinary and authority decisions.",
        "base_role": "delegated-worker",
        "prompt": "agents/veterinary-care-operations-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "veterinary-care-operations-review": {
        "label": "Veterinary Care Operations Review",
        "description": "Four independent veterinary operations evidence branches converge into one controlled review.",
        "nodes": {
          "veterinary-patient-intake-care-pathway-analyst": {
            "agent_id": "veterinary-patient-intake-care-pathway-analyst",
            "description": "Traces patient, episode, intake, and supplied care-pathway evidence.",
            "depends_on": []
          },
          "veterinary-order-medication-procedure-trace-analyst": {
            "agent_id": "veterinary-order-medication-procedure-trace-analyst",
            "description": "Traces orders, medication, diagnostics, and procedures.",
            "depends_on": []
          },
          "veterinary-anesthesia-monitoring-recovery-analyst": {
            "agent_id": "veterinary-anesthesia-monitoring-recovery-analyst",
            "description": "Traces anesthesia, monitoring, recovery, and handoff.",
            "depends_on": []
          },
          "veterinary-inventory-biosecurity-client-followup-analyst": {
            "agent_id": "veterinary-inventory-biosecurity-client-followup-analyst",
            "description": "Traces inventory, cold-chain, biosecurity, and client follow-up.",
            "depends_on": []
          },
          "veterinary-care-operations-review-owner": {
            "agent_id": "veterinary-care-operations-review-owner",
            "description": "Joins all evidence without diagnosis, treatment, care, authority, inventory, or communication decisions.",
            "depends_on": [
              "veterinary-anesthesia-monitoring-recovery-analyst",
              "veterinary-inventory-biosecurity-client-followup-analyst",
              "veterinary-order-medication-procedure-trace-analyst",
              "veterinary-patient-intake-care-pathway-analyst"
            ]
          }
        }
      }
    }
  }
}
