{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "real-estate-due-diligence",
  "name": "Real Estate Due Diligence",
  "label": "Real Estate Due Diligence",
  "description": "Property documents, market and financial evidence, and physical and regulatory risks joined into a professional-review diligence pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded, source-linked property diligence.",
    "selection_guidance": "Select when property documents, market and financial assumptions, and physical or regulatory evidence need parallel review without transaction advice.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:real-estate-due-diligence:real-estate-due-diligence%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:real-estate-due-diligence:real-estate-due-diligence%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "property-document-analyst": {
        "capability_refs": [
          "capability:capability_set:package:real-estate-due-diligence:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Property Document Analyst",
        "description": "Builds a source-linked document inventory and conflict matrix.",
        "base_role": "explore",
        "prompt": "agents/property-document-analyst/system.md"
      },
      "property-market-financial-analyst": {
        "capability_refs": [
          "capability:capability_set:package:real-estate-due-diligence:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Market and Financial Analyst",
        "description": "Tests supplied market, income, cost, comparable, and sensitivity assumptions.",
        "base_role": "delegated-worker",
        "prompt": "agents/property-market-financial-analyst/system.md"
      },
      "property-physical-regulatory-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:real-estate-due-diligence:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Physical and Regulatory Risk Analyst",
        "description": "Maps condition, environmental, zoning, permit, utility, and insurance evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/property-physical-regulatory-risk-analyst/system.md"
      },
      "property-diligence-pack-owner": {
        "capability_refs": [
          "capability:capability_set:package:real-estate-due-diligence:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Property Diligence Pack Owner",
        "description": "Joins all branches into a professional-review diligence register.",
        "base_role": "delegated-worker",
        "prompt": "agents/property-diligence-pack-owner/system.md"
      }
    },
    "virtual_workflows": {
      "property-due-diligence-pack": {
        "label": "Property Due-Diligence Pack",
        "description": "Three independent diligence branches converge into one register.",
        "nodes": {
          "property-document-analyst": {
            "agent_id": "property-document-analyst",
            "description": "Maps property documents.",
            "depends_on": []
          },
          "property-market-financial-analyst": {
            "agent_id": "property-market-financial-analyst",
            "description": "Tests market and financial assumptions.",
            "depends_on": []
          },
          "property-physical-regulatory-risk-analyst": {
            "agent_id": "property-physical-regulatory-risk-analyst",
            "description": "Maps physical and regulatory risks.",
            "depends_on": []
          },
          "property-diligence-pack-owner": {
            "agent_id": "property-diligence-pack-owner",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "property-document-analyst",
              "property-market-financial-analyst",
              "property-physical-regulatory-risk-analyst"
            ]
          }
        }
      }
    }
  }
}
