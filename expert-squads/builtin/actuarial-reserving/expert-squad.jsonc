{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "actuarial-reserving",
  "name": "Actuarial Reserving",
  "label": "Actuarial Reserving",
  "description": "Unpaid-claim data, method, uncertainty, validation and governance evidence joined for qualified actuarial review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded property and casualty unpaid-claim reserving evidence.",
    "selection_guidance": "Select for source-to-triangle reconciliation, supplied method diagnostics, uncertainty, roll-forward and disclosure evidence without reserve-setting or opinion authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:actuarial-reserving:actuarial-reserving%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:actuarial-reserving:actuarial-reserving%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "reserving-data-triangle-reconciliation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:actuarial-reserving:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Reserving Data and Triangle Reconciliation Analyst",
        "description": "Reconciles controlled source records to incremental and cumulative reserving triangles.",
        "base_role": "explore",
        "prompt": "agents/reserving-data-triangle-reconciliation-analyst/system.md"
      },
      "reserving-method-assumption-diagnostics-analyst": {
        "capability_refs": [
          "capability:capability_set:package:actuarial-reserving:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reserving Method, Assumption and Diagnostics Analyst",
        "description": "Traces supplied development, tail, trend and expected-loss assumptions through comparative diagnostics.",
        "base_role": "delegated-worker",
        "prompt": "agents/reserving-method-assumption-diagnostics-analyst/system.md"
      },
      "reserve-uncertainty-validation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:actuarial-reserving:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reserve Uncertainty and Validation Analyst",
        "description": "Tests actual-versus-expected, backtest, scenario, range and assumption-sensitive evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/reserve-uncertainty-validation-analyst/system.md"
      },
      "reserve-governance-rollforward-disclosure-analyst": {
        "capability_refs": [
          "capability:capability_set:package:actuarial-reserving:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Reserve Governance, Roll-forward and Disclosure Analyst",
        "description": "Traces prior-to-current movements, booked-to-indicated differences, governance and disclosure evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/reserve-governance-rollforward-disclosure-analyst/system.md"
      },
      "actuarial-reserving-evidence-owner": {
        "capability_refs": [
          "capability:capability_set:package:actuarial-reserving:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Actuarial Reserving Evidence Owner",
        "description": "Joins the four independent branches into one reviewable evidence and unresolved-decision register.",
        "base_role": "delegated-worker",
        "prompt": "agents/actuarial-reserving-evidence-owner/system.md"
      }
    },
    "virtual_workflows": {
      "actuarial-reserving-review": {
        "label": "Actuarial Reserving Review",
        "description": "Four zero-dependency reserving evidence branches converge into an explicit qualified-review join.",
        "nodes": {
          "reserving-data-triangle-reconciliation-analyst": {
            "agent_id": "reserving-data-triangle-reconciliation-analyst",
            "description": "Reconciles source and triangle evidence.",
            "depends_on": []
          },
          "reserving-method-assumption-diagnostics-analyst": {
            "agent_id": "reserving-method-assumption-diagnostics-analyst",
            "description": "Traces methods and assumptions.",
            "depends_on": []
          },
          "reserve-uncertainty-validation-analyst": {
            "agent_id": "reserve-uncertainty-validation-analyst",
            "description": "Challenges uncertainty and validation.",
            "depends_on": []
          },
          "reserve-governance-rollforward-disclosure-analyst": {
            "agent_id": "reserve-governance-rollforward-disclosure-analyst",
            "description": "Traces governance and disclosure.",
            "depends_on": []
          },
          "actuarial-reserving-evidence-owner": {
            "agent_id": "actuarial-reserving-evidence-owner",
            "description": "Joins all roots without selecting, booking or opining on reserves.",
            "depends_on": [
              "reserve-governance-rollforward-disclosure-analyst",
              "reserve-uncertainty-validation-analyst",
              "reserving-data-triangle-reconciliation-analyst",
              "reserving-method-assumption-diagnostics-analyst"
            ]
          }
        }
      }
    }
  }
}
