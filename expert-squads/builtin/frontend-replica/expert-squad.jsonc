    "virtual_workflows": {
      "interface-modeling": {
        "label": "Planned Parallel Interface Modeling",
        "description": "One source-bound Planner partitions modeling work before intent, source, and interface-model workers execute in parallel.",
        "nodes": {
          "frontend-replica-planner": {
            "agent_id": "frontend-replica-planner",
            "description": "Publishes source closure, region ownership, modeling contract, and acceptance allocation.",
            "depends_on": []
          },
          "frontend-replica-intent-analyst": {
            "agent_id": "frontend-replica-intent-analyst",
            "description": "Checks target intent and requested fidelity against the planned source closure.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-source-researcher": {
            "agent_id": "frontend-replica-source-researcher",
            "description": "Captures source structure, behavior, states, and assets for its partition.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-interface-modeler": {
            "agent_id": "frontend-replica-interface-modeler",
            "description": "Produces the planned interface model and mapping evidence.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          }
        }
      },
      "source-replica": {
        "label": "Planned Parallel Source Replica",
        "description": "One source-bound Planner partitions the complete replica before repository, source, modeling, workload, implementation, and intent workers execute in parallel.",
        "nodes": {
          "frontend-replica-planner": {
            "agent_id": "frontend-replica-planner",
            "description": "Publishes source closure, target region ownership, implementation contract, and acceptance allocation.",
            "depends_on": []
          },
          "frontend-replica-explorer": {
            "agent_id": "frontend-replica-explorer",
            "description": "Investigates target repository primitives and owned implementation paths.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-intent-analyst": {
            "agent_id": "frontend-replica-intent-analyst",
            "description": "Checks task intent and fidelity boundaries.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-source-researcher": {
            "agent_id": "frontend-replica-source-researcher",
            "description": "Captures exact source evidence for its assigned regions.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-interface-modeler": {
            "agent_id": "frontend-replica-interface-modeler",
            "description": "Produces the planned interface mapping and component contract.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-workload-analyst": {
            "agent_id": "frontend-replica-workload-analyst",
            "description": "Challenges region partition, ownership, and verification workload.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-implementer": {
            "agent_id": "frontend-replica-implementer",
            "description": "Implements assigned regions and captures its own real rendered comparison evidence.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          }
        }
      }
    }
  }
}
