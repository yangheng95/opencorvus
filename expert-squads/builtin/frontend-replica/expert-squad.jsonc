    "virtual_workflows": {
      "interface-modeling": {
        "label": "Explicit Interface Modeling",
        "description": "Focused interface-modeling collaboration using the same unique source-project generator owner as source-replica delivery.",
        "nodes": {
          "frontend-replica-intent-analyst": {
            "agent_id": "frontend-replica-intent-analyst",
            "description": "Classifies source, target, desktop scope, evidence gaps, and parity obligations.",
            "depends_on": [],
          },
          "frontend-replica-source-researcher": {
            "agent_id": "frontend-replica-source-researcher",
            "description": "Captures source-page structure, state, content, interaction, and screenshot evidence.",
            "depends_on": [],
          },
          "frontend-replica-requirements-analyst": {
            "agent_id": "frontend-replica-requirements-analyst",
            "description": "Defines source-bound surface, interaction, content, asset, and rendered-parity requirements.",
