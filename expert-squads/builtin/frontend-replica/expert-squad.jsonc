              "frontend-replica-explorer",
              "frontend-replica-intent-analyst",
              "frontend-replica-source-researcher",
            ],
          },
          "frontend-replica-solution-architect": {
            "agent_id": "frontend-replica-solution-architect",
            "description": "Maps source evidence to target components, contracts, and verification regions.",
            "depends_on": ["frontend-replica-requirements-analyst"],
          },
          "frontend-replica-interface-modeler": {
            "agent_id": "frontend-replica-interface-modeler",
            "description": "Generates the sole source-bound project model and implementation contract consumed by Delivery Slice subjects.",
            "depends_on": ["frontend-replica-solution-architect"],
          },
          "frontend-replica-workload-analyst": {
            "agent_id": "frontend-replica-workload-analyst",
            "description": "Sizes source evidence, surface implementation, interaction, and visual verification work.",
            "depends_on": ["frontend-replica-solution-architect"],
          },
          "frontend-replica-implementer": {
            "agent_id": "frontend-replica-implementer",
            "description": "Implements the same source-bound surface in the target project.",
