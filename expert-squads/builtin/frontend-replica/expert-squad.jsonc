{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "frontend-replica",
  "name": "Frontend Replica",
  "label": "Frontend Replica",
  "description": "Source URL and reference-screenshot replica with a desktop surface ledger, rendered proof, durable catalog facts, and visible narrative Turn summaries.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "code"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source URL or reference-screenshot desktop replica work with evidence-backed parity.",
    "selection_guidance": "Select frontend-replica only when the requested outcome is source-bound interface parity.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:frontend-replica:frontend-replica%2Fshared%2Facceptance"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:frontend-replica:frontend-replica%2Fshared%2Facceptance",
        "capability:tool:platform:tool-registry:bash",
        "capability:tool:platform:tool-registry:browser_preview",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "frontend-replica-explorer": {
        "capability_refs": [
          "capability:capability_set:package:frontend-replica:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Frontend Replica Explorer",
        "description": "Locates target implementation surfaces, assets, primitives, and integration constraints.",
        "base_role": "explore",
        "prompt": "agents/frontend-replica-explorer/system.md"
      },
      "frontend-replica-intent-analyst": {
        "capability_refs": [
          "capability:capability_set:package:frontend-replica:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:intent-analysis-base"
        ],
        "label": "Frontend Replica Intent Analyst",
        "description": "Classifies source, target, desktop scope, evidence gaps, and parity obligations.",
        "base_role": "intent-analysis",
        "prompt": "agents/frontend-replica-intent-analyst/system.md"
      },
      "frontend-replica-interface-modeler": {
        "capability_refs": [
          "capability:capability_set:platform:tool-registry:frontend-design-base",
          "capability:skill:package:frontend-replica:frontend-replica%2Fshared%2Facceptance",
          "capability:tool:package:frontend-replica:frontend-replica%2Ffrontend-replica-interface-modeler%2Fgenerate-source-project",
          "capability:tool:platform:default-tool-registry:default%2Ftool%2Fcreate_visual_region_binding_package",
          "capability:tool:platform:default-tool-registry:default%2Ftool%2Fcreate_visual_region_coordinate_atlas"
        ],
        "label": "Frontend Replica Interface Modeler",
        "description": "Generates the sole task-scoped source-bound interface model and implementation contract.",
        "base_role": "frontend-design",
        "prompt": "agents/frontend-replica-interface-modeler/system.md"
      },
      "frontend-replica-source-researcher": {
        "capability_refs": [
          "capability:capability_set:platform:tool-registry:frontend-research-base",
          "capability:skill:package:frontend-replica:frontend-replica%2Fshared%2Facceptance",
          "capability:tool:package:frontend-replica:frontend-replica%2Ffrontend-replica-source-researcher%2Fprepare-source-context",
          "capability:tool:platform:default-tool-registry:default%2Ftool%2Fwebpage_compile",
          "capability:tool:platform:default-tool-registry:default%2Ftool%2Fwebpage_extract",
          "capability:tool:platform:default-tool-registry:default%2Ftool%2Fwebpage_runtime_state"
        ],
        "label": "Frontend Replica Source Researcher",
        "description": "Captures source-page structure, state, content, interaction, and screenshot evidence.",
        "base_role": "frontend-research",
        "prompt": "agents/frontend-replica-source-researcher/system.md"
      },
      "frontend-replica-workload-analyst": {
        "capability_refs": [
          "capability:capability_set:package:frontend-replica:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:goal-workload-analyst-base"
        ],
        "label": "Frontend Replica Workload Analyst",
        "description": "Sizes source evidence, surface implementation, interaction, and visual verification work.",
        "base_role": "goal-workload-analyst",
        "prompt": "agents/frontend-replica-workload-analyst/system.md"
      },
      "frontend-replica-implementer": {
        "capability_refs": [
          "capability:capability_set:platform:tool-registry:build-base",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fcheck",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fclick",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fdiagnostics_get",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fhover",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fnavigate",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fobserve",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fpress_key",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscreenshot",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fscroll",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fselect_option",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_create",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fsession_destroy",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Ftype",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Funcheck",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fviewport_set",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_load",
          "capability:mcp_tool:project:default-mcp-registry:default%2Fmcp%2Fbrowser%2Ftool%2Fwait_for_selector",
          "capability:skill:package:frontend-replica:frontend-replica%2Fshared%2Facceptance"
        ],
        "label": "Frontend Replica Implementer",
        "description": "Implements the same source-bound surface in the target project.",
        "base_role": "build",
        "prompt": "agents/frontend-replica-implementer/system.md"
      },
      "frontend-replica-planner": {
        "capability_refs": [
          "capability:capability_set:package:frontend-replica:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Frontend Replica Planner",
        "description": "Publishes one source-bound replica plan, region ownership map, and acceptance allocation for parallel specialist execution.",
        "base_role": "delegated-worker",
        "prompt": "agents/frontend-replica-planner/system.md"
      }
    },
    "virtual_workflows": {
      "interface-modeling": {
        "label": "Planned Parallel Interface Modeling",
        "description": "One source-bound Planner partitions modeling work before intent, source, and interface-model workers execute in parallel.",
        "nodes": {
          "frontend-replica-planner": {
            "agent_id": "frontend-replica-planner",
            "description": "Publishes source closure, region ownership, modeling contract, and acceptance allocation.",
            "depends_on": []
          },
          "frontend-replica-intent-analyst": {
            "agent_id": "frontend-replica-intent-analyst",
            "description": "Checks target intent and requested fidelity against the planned source closure.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-source-researcher": {
            "agent_id": "frontend-replica-source-researcher",
            "description": "Captures source structure, behavior, states, and assets for its partition.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-interface-modeler": {
            "agent_id": "frontend-replica-interface-modeler",
            "description": "Produces the planned interface model and mapping evidence.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          }
        }
      },
      "source-replica": {
        "label": "Planned Parallel Source Replica",
        "description": "One source-bound Planner partitions the complete replica before repository, source, modeling, workload, implementation, and intent workers execute in parallel.",
        "nodes": {
          "frontend-replica-planner": {
            "agent_id": "frontend-replica-planner",
            "description": "Publishes source closure, target region ownership, implementation contract, and acceptance allocation.",
            "depends_on": []
          },
          "frontend-replica-explorer": {
            "agent_id": "frontend-replica-explorer",
            "description": "Investigates target repository primitives and owned implementation paths.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-intent-analyst": {
            "agent_id": "frontend-replica-intent-analyst",
            "description": "Checks task intent and fidelity boundaries.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-source-researcher": {
            "agent_id": "frontend-replica-source-researcher",
            "description": "Captures exact source evidence for its assigned regions.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-interface-modeler": {
            "agent_id": "frontend-replica-interface-modeler",
            "description": "Produces the planned interface mapping and component contract.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-workload-analyst": {
            "agent_id": "frontend-replica-workload-analyst",
            "description": "Challenges region partition, ownership, and verification workload.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          },
          "frontend-replica-implementer": {
            "agent_id": "frontend-replica-implementer",
            "description": "Implements assigned regions and captures its own real rendered comparison evidence.",
            "depends_on": [
              "frontend-replica-planner"
            ]
          }
        }
      }
    }
  }
}
