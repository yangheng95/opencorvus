{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "frontend-replica",
  "name": "Frontend Replica",
  "label": "Frontend Replica",
  "description": "Source URL and reference-screenshot replica with a desktop surface ledger, rendered proof, durable catalog facts, and visible narrative Turn summaries.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "code"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source URL or reference-screenshot desktop replica work with evidence-backed parity.",
    "selection_guidance": "Select frontend-replica only when the requested outcome is source-bound interface parity.",
    "instructions": "selector.md"
  },
