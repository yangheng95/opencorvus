{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "ecommerce-merchandising",
  "name": "Ecommerce Merchandising",
  "label": "Ecommerce Merchandising",
  "description": "Catalog, demand and pricing, and experience and operations evidence joined into a reversible merchandising test plan.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for evidence-backed ecommerce merchandising experiments.",
    "selection_guidance": "Select for catalog, assortment, pricing-hypothesis, placement, promotion, or conversion planning without storefront mutation.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:ecommerce-merchandising:ecommerce-merchandising%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:ecommerce-merchandising:ecommerce-merchandising%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "merchandising-catalog-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ecommerce-merchandising:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Catalog Evidence Analyst",
        "description": "Maps catalog quality, taxonomy, attributes, availability, and provenance.",
        "base_role": "explore",
        "prompt": "agents/merchandising-catalog-evidence-analyst/system.md"
      },
      "merchandising-demand-pricing-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ecommerce-merchandising:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Demand and Pricing Analyst",
        "description": "Tests demand, price, promotion, margin, and seasonality assumptions.",
        "base_role": "delegated-worker",
        "prompt": "agents/merchandising-demand-pricing-analyst/system.md"
      },
      "merchandising-experience-operations-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ecommerce-merchandising:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Experience and Operations Analyst",
        "description": "Maps journey, fulfillment, returns, inventory, accessibility, and customer safeguards.",
        "base_role": "delegated-worker",
        "prompt": "agents/merchandising-experience-operations-analyst/system.md"
      },
      "merchandising-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:ecommerce-merchandising:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Merchandising Plan Owner",
        "description": "Joins all branches into a guarded and reversible test plan.",
        "base_role": "delegated-worker",
        "prompt": "agents/merchandising-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "merchandising-test-plan": {
        "label": "Merchandising Test Plan",
        "description": "Three independent merchandising branches converge into one guarded experiment plan.",
        "nodes": {
          "merchandising-catalog-evidence-analyst": {
            "agent_id": "merchandising-catalog-evidence-analyst",
            "description": "Maps catalog evidence.",
            "depends_on": []
          },
          "merchandising-demand-pricing-analyst": {
            "agent_id": "merchandising-demand-pricing-analyst",
            "description": "Tests demand and pricing assumptions.",
            "depends_on": []
          },
          "merchandising-experience-operations-analyst": {
            "agent_id": "merchandising-experience-operations-analyst",
            "description": "Maps experience and operations constraints.",
            "depends_on": []
          },
          "merchandising-plan-owner": {
            "agent_id": "merchandising-plan-owner",
            "description": "Joins the completed branch reports.",
            "depends_on": [
              "merchandising-catalog-evidence-analyst",
              "merchandising-demand-pricing-analyst",
              "merchandising-experience-operations-analyst"
            ]
          }
        }
      }
    }
  }
}
