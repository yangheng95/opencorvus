{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "evolution-lab",
  "name": "Evolution Lab",
  "label": "Evolution Lab",
  "description": "Target-agnostic evidence, candidate, evaluation, integrity review, and recommendation package for explicit Expert Squad evolution campaigns.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use only for an explicit Expert Squad evolution investigation or campaign.",
    "selection_guidance": "Select Evolution Lab only when the user explicitly asks to investigate, construct, evaluate, compare, promote, or restore an Expert Squad revision. Promotion and restoration remain separate user-authorized operations.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
      "package_skill_refs": [
        "evolution-lab/shared/campaign"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "evolution-observer": {
        "label": "Evolution Opportunity Observer",
        "description": "Turns explicitly selected production evidence into a bounded opportunity without dispatching repairs.",
        "base_role": "explore",
        "prompt": "agents/evolution-observer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact",
          "evolution-lab/shared/collect-run-evidence"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-failure-analyst": {
        "label": "Evolution Failure Analyst",
        "description": "Reconstructs the evidence-backed causal chain and assigns proven ownership while preserving unknowns.",
        "base_role": "deep-research",
        "prompt": "agents/evolution-failure-analyst/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-experiment-planner": {
        "label": "Evolution Experiment Planner",
        "description": "Freezes target revision, cases, scorers, environment, arm order, budget, and mutation surface before candidate work.",
        "base_role": "delegated-worker",
        "prompt": "agents/evolution-experiment-planner/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact",
          "evolution-lab/shared/expert-squad-package",
          "evolution-lab/shared/rehydrate-evolution-resources"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-candidate-author": {
        "label": "Evolution Candidate Author",
        "description": "Authors one complete self-contained target package candidate within the frozen mutable text surface.",
        "base_role": "build",
        "prompt": "agents/evolution-candidate-author/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact",
          "evolution-lab/shared/expert-squad-package",
          "evolution-lab/shared/rehydrate-evolution-resources"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-evaluator": {
        "label": "Evolution Evaluator",
        "description": "Collects exact two-arm run evidence and executes only the frozen scorer contract, preserving unavailable results.",
        "base_role": "fact-check",
        "prompt": "agents/evolution-evaluator/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact",
          "evolution-lab/shared/collect-run-evidence",
          "evolution-lab/shared/execute-evolution-metrics",
          "evolution-lab/shared/rehydrate-evolution-resources"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-recommendation-owner": {
        "label": "Evolution Recommendation Owner",
        "description": "Publishes the experiment-scoped comparison and recommendation with unknowns, without installing any revision.",
        "base_role": "delegated-worker",
        "prompt": "agents/evolution-recommendation-owner/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "evolution-safety-auditor": {
        "label": "Evolution Safety Auditor",
        "description": "Publishes the independent integrity review of each exact evaluation result, covering permissions, leakage, reward hacking, evidence lineage, frozen inputs, and experiment drift.",
        "base_role": "delegated-worker",
        "prompt": "agents/evolution-safety-auditor/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
        "default_skill_refs": [],
        "package_skill_refs": [
          "evolution-lab/shared/campaign"
        ],
        "default_tool_refs": [],
        "package_tool_refs": [
          "evolution-lab/shared/publish-evolution-artifact",
          "evolution-lab/shared/expert-squad-package",
          "evolution-lab/shared/rehydrate-evolution-resources"
        ],
        "default_mcp_server_refs": [],
        "package_mcp_server_refs": [],
        "default_mcp_tool_refs": [],
        "package_mcp_tool_refs": [],
        "default_mcp_prompt_refs": [],
        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      }
    },
    "virtual_workflows": {
      "evolution-opportunity-analysis": {
        "label": "Sequential Evolution Opportunity Analysis",
        "description": "Opportunity observation consumes the frozen diagnostic boundary; causal analysis then consumes that exact typed opportunity. Campaign planning remains owned by candidate preparation.",
        "nodes": {
          "evolution-observer": {
            "agent_id": "evolution-observer",
            "description": "Measures incumbent topology, behavior, and evidence lineage.",
            "depends_on": []
          },
          "evolution-failure-analyst": {
            "agent_id": "evolution-failure-analyst",
            "description": "Builds causal attribution and bounded improvement hypotheses from the frozen diagnostic boundary.",
            "depends_on": [
              "evolution-observer"
            ]
          }
        }
      },
      "evolution-candidate-preparation": {
        "label": "Planned Parallel Evolution Candidate Preparation",
        "description": "The Experiment Planner freezes the development campaign before candidate authoring and incumbent-closure validation execute in parallel.",
        "nodes": {
          "evolution-experiment-planner": {
            "agent_id": "evolution-experiment-planner",
            "description": "Publishes the frozen case, development campaign, mutation budget, and acceptance contract.",
            "depends_on": []
          },
          "evolution-candidate-author": {
            "agent_id": "evolution-candidate-author",
            "description": "Materializes, validates, and publishes one immutable uninstalled candidate revision.",
            "depends_on": [
              "evolution-experiment-planner"
            ]
          },
          "evolution-observer": {
            "agent_id": "evolution-observer",
            "description": "Independently validates the incumbent closure and frozen-case binding used by the campaign.",
            "depends_on": [
              "evolution-experiment-planner"
            ]
          }
        }
      },
      "evolution-campaign-evaluation": {
        "label": "Evolution Campaign Evaluation",
        "description": "The Evaluator computes metric evidence from the already frozen imported Campaign and Candidate; the Safety Auditor independently reviews each exact result; the recommendation owner then publishes the deterministic comparison.",
        "nodes": {
          "evolution-evaluator": {
            "agent_id": "evolution-evaluator",
            "description": "Computes the metric evidence for both frozen Trials from the exact imported Campaign and Candidate.",
            "depends_on": []
          },
          "evolution-safety-auditor": {
            "agent_id": "evolution-safety-auditor",
            "description": "Independently reviews each exact evaluation result and publishes its own integrity review of safety, permissions, leakage, lineage, and experiment drift.",
            "depends_on": [
              "evolution-evaluator"
            ]
          },
          "evolution-recommendation-owner": {
            "agent_id": "evolution-recommendation-owner",
            "description": "Publishes the deterministic recommendation only after metric and safety evidence are complete.",
            "depends_on": [
              "evolution-evaluator",
              "evolution-safety-auditor"
            ]
          }
        }
      }
    }
  }
}
