{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "marketing-growth",
  "name": "Marketing & Growth Strategy",
  "label": "Marketing & Growth Strategy",
  "description": "Evidence-led audience, channel, experiment, measurement, and campaign planning without guaranteed growth claims.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Plan an evidence-backed marketing and growth campaign with explicit experiments and measurement.",
    "selection_guidance": "Use for audience strategy, channel planning, campaign design, growth experiments, positioning, and measurement. Do not use to guarantee reach, conversion, or revenue.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 7 projections.",
      "member_refs": [
        "capability:skill:package:marketing-growth:marketing-growth%2Fshared%2Fmethod",
        "capability:skill:package:marketing-growth:marketing-growth%2Fshared%2Fworkflow",
        "capability:tool:package:marketing-growth:marketing-growth%2Fshared%2Fpublish-marketing-growth-artifact"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:marketing-growth:marketing-growth%2Fshared%2Fmethod",
        "capability:skill:package:marketing-growth:marketing-growth%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "marketing-growth-planner": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Marketing Growth Planner",
        "description": "Defines scope, decisions, inputs, baselines, constraints, and the measurement contract.",
        "base_role": "delegated-worker",
        "prompt": "agents/marketing-growth-planner/system.md"
      },
      "marketing-growth-evidence-researcher": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Marketing Evidence Researcher",
        "description": "Builds a dated dossier of market, audience, competitor, channel, and benchmark evidence.",
        "base_role": "deep-research",
        "prompt": "agents/marketing-growth-evidence-researcher/system.md"
      },
      "marketing-growth-audience-analyst": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Audience and Offer Analyst",
        "description": "Analyzes audience problems, buying context, offer fit, positioning, and message hypotheses.",
        "base_role": "delegated-worker",
        "prompt": "agents/marketing-growth-audience-analyst/system.md"
      },
      "marketing-growth-channel-analyst": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Channel and Funnel Analyst",
        "description": "Analyzes channel fit, funnel mechanics, economics, measurement, and experiment candidates.",
        "base_role": "delegated-worker",
        "prompt": "agents/marketing-growth-channel-analyst/system.md"
      },
      "marketing-growth-strategist": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Growth Strategy Synthesizer",
        "description": "Combines both analyses into a prioritized campaign and experiment strategy.",
        "base_role": "delegated-worker",
        "prompt": "agents/marketing-growth-strategist/system.md"
      },
      "marketing-growth-fact-checker": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Marketing Growth Fact Checker",
        "description": "Audits the strategy's claims, calculations, sources, experiment definitions, and delivery closure.",
        "base_role": "fact-check",
        "prompt": "agents/marketing-growth-fact-checker/system.md"
      },
      "marketing-growth-campaign-writer": {
        "capability_refs": [
          "capability:capability_set:package:marketing-growth:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Marketing Campaign Plan Writer",
        "description": "Owns the corrected canonical campaign plan and interactive delivery.",
        "base_role": "build",
        "prompt": "agents/marketing-growth-campaign-writer/system.md"
      }
    },
    "virtual_workflows": {
      "marketing-growth-campaign": {
        "label": "Marketing Growth Campaign",
        "description": "Binding Marketing & Growth Strategy workflow. Every node runs exactly once; independent branches start concurrently and joins wait for every predecessor.",
        "nodes": {
          "marketing-growth-planner": {
            "agent_id": "marketing-growth-planner",
            "description": "Defines scope, decisions, inputs, baselines, constraints, and the measurement contract.",
            "depends_on": []
          },
          "marketing-growth-evidence-researcher": {
            "agent_id": "marketing-growth-evidence-researcher",
            "description": "Builds a dated dossier of market, audience, competitor, channel, and benchmark evidence.",
            "depends_on": [
              "marketing-growth-planner"
            ]
          },
          "marketing-growth-audience-analyst": {
            "agent_id": "marketing-growth-audience-analyst",
            "description": "Analyzes audience problems, buying context, offer fit, positioning, and message hypotheses.",
            "depends_on": [
              "marketing-growth-evidence-researcher"
            ]
          },
          "marketing-growth-channel-analyst": {
            "agent_id": "marketing-growth-channel-analyst",
            "description": "Analyzes channel fit, funnel mechanics, economics, measurement, and experiment candidates.",
            "depends_on": [
              "marketing-growth-evidence-researcher"
            ]
          },
          "marketing-growth-strategist": {
            "agent_id": "marketing-growth-strategist",
            "description": "Combines both analyses into a prioritized campaign and experiment strategy.",
            "depends_on": [
              "marketing-growth-audience-analyst",
              "marketing-growth-channel-analyst"
            ]
          },
          "marketing-growth-fact-checker": {
            "agent_id": "marketing-growth-fact-checker",
            "description": "Audits the strategy's claims, calculations, sources, experiment definitions, and delivery closure.",
            "depends_on": [
              "marketing-growth-strategist"
            ]
          },
          "marketing-growth-campaign-writer": {
            "agent_id": "marketing-growth-campaign-writer",
            "description": "Owns the corrected canonical campaign plan and interactive delivery.",
            "depends_on": [
              "marketing-growth-fact-checker"
            ]
          }
        }
      }
    }
  }
}
