{
  "schema_version": 1,
  "namespace": "builtin",
  "id": "procurement-vendor",
  "name": "Procurement & Vendor Decision",
  "label": "Procurement & Vendor Decision",
  "description": "Parallel commercial comparison, source-grounded vendor diligence, approval-evidence review, and a human-owned procurement decision pack.",
  "version": "2026.08.13.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use to compare vendors, investigate supplier risk, and prepare a reviewable approval record without purchasing or approving.",
    "selection_guidance": "Select for multi-vendor sourcing and diligence decisions. Use legal review for contract redlines and keep final purchase and approval authority with named humans.",
    "instructions": "selector.md"
  },
  "capability_projection": {
    "scheduler": {
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md",
      "inherit_base_tools": true,
      "built_in_tool_ids": [
        "dispatch_agent",
        "manage_task",
        "read"
      ],
      "default_skill_refs": [],
