        "procurement-vendor/shared/method"
      ],
      "default_tool_refs": [],
      "package_tool_refs": [],
      "default_mcp_server_refs": [],
      "package_mcp_server_refs": [],
      "default_mcp_tool_refs": [],
      "package_mcp_tool_refs": [],
      "default_mcp_prompt_refs": [],
      "package_mcp_prompt_refs": [],
      "default_mcp_resource_refs": [],
      "package_mcp_resource_refs": []
    },
    "agents": {
      "procurement-commercial-analyst": {
        "label": "Procurement Commercial Analyst",
        "description": "Builds an objective, normalized commercial and capability comparison with sensitivity analysis.",
        "base_role": "delegated-worker",
