{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "procurement-vendor",
  "name": "Procurement & Vendor Decision",
  "label": "Procurement & Vendor Decision",
  "description": "Parallel commercial comparison, source-grounded vendor diligence, approval-evidence review, and a human-owned procurement decision pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use to compare vendors, investigate supplier risk, and prepare a reviewable approval record without purchasing or approving.",
    "selection_guidance": "Select for multi-vendor sourcing and diligence decisions. Use legal review for contract redlines and keep final purchase and approval authority with named humans.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:procurement-vendor:procurement-vendor%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:procurement-vendor:procurement-vendor%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "procurement-commercial-analyst": {
        "capability_refs": [
          "capability:capability_set:package:procurement-vendor:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Procurement Commercial Analyst",
        "description": "Builds an objective, normalized commercial and capability comparison with sensitivity analysis.",
        "base_role": "delegated-worker",
        "prompt": "agents/procurement-commercial-analyst/system.md"
      },
      "procurement-diligence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:procurement-vendor:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Vendor Diligence Analyst",
        "description": "Investigates vendor identity, resilience, security, financial, legal, and concentration evidence without treating claims as verification.",
        "base_role": "deep-research",
        "prompt": "agents/procurement-diligence-analyst/system.md"
      },
      "procurement-governance-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:procurement-vendor:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Procurement Governance Reviewer",
        "description": "Maps evidence, conflicts, exceptions, and named approval authorities without fabricating approval.",
        "base_role": "fact-check",
        "prompt": "agents/procurement-governance-reviewer/system.md"
      },
      "procurement-decision-integrator": {
        "capability_refs": [
          "capability:capability_set:package:procurement-vendor:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Procurement Decision Integrator",
        "description": "Joins commercial, diligence, and governance evidence into a conditional, reviewable decision pack.",
        "base_role": "build",
        "prompt": "agents/procurement-decision-integrator/system.md"
      }
    },
    "virtual_workflows": {
      "vendor-decision-pack": {
        "label": "Vendor Decision Pack",
        "description": "Run independent commercial, diligence, and approval-evidence reviews in parallel, then join them into a human-owned vendor decision pack.",
        "nodes": {
          "procurement-commercial-analyst": {
            "agent_id": "procurement-commercial-analyst",
            "description": "Publishes the normalized commercial and capability comparison.",
            "depends_on": []
          },
          "procurement-diligence-analyst": {
            "agent_id": "procurement-diligence-analyst",
            "description": "Publishes the source-grounded vendor diligence dossier.",
            "depends_on": []
          },
          "procurement-governance-reviewer": {
            "agent_id": "procurement-governance-reviewer",
            "description": "Publishes the approval-evidence and authority matrix.",
            "depends_on": []
          },
          "procurement-decision-integrator": {
            "agent_id": "procurement-decision-integrator",
            "description": "Joins all three independent reviews into the final decision pack.",
            "depends_on": [
              "procurement-commercial-analyst",
              "procurement-diligence-analyst",
              "procurement-governance-reviewer"
            ]
          }
        }
      }
    }
  }
}
