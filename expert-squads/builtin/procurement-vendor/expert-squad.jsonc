        "package_mcp_prompt_refs": [],
        "default_mcp_resource_refs": [],
        "package_mcp_resource_refs": []
      },
      "procurement-governance-reviewer": {
        "label": "Procurement Governance Reviewer",
        "description": "Maps evidence, conflicts, exceptions, and named approval authorities without fabricating approval.",
        "base_role": "fact-check",
        "prompt": "agents/procurement-governance-reviewer/system.md",
        "inherit_base_tools": true,
        "built_in_tool_ids": [],
