{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "public-sector-service-delivery",
  "name": "Public Sector Service Delivery",
  "label": "Public Sector Service Delivery",
  "description": "Resident needs, process and accessibility evidence, and policy-delivery risks joined into an accountable public-service outcome register.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded public-service delivery design and review.",
    "selection_guidance": "Select for resident journeys, service accessibility, administrative process, delivery metrics, stakeholder coordination, or policy implementation evidence without legal interpretation, eligibility decisions, public commitments, or record changes.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:public-sector-service-delivery:public-sector-service-delivery%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:public-sector-service-delivery:public-sector-service-delivery%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "public-resident-needs-analyst": {
        "capability_refs": [
          "capability:capability_set:package:public-sector-service-delivery:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Resident Needs Analyst",
        "description": "Maps resident needs, journeys, channels, barriers, and evidence gaps.",
        "base_role": "explore",
        "prompt": "agents/public-resident-needs-analyst/system.md"
      },
      "public-process-accessibility-analyst": {
        "capability_refs": [
          "capability:capability_set:package:public-sector-service-delivery:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Process and Accessibility Analyst",
        "description": "Maps service steps, handoffs, waiting, accessibility, and exclusion risks.",
        "base_role": "delegated-worker",
        "prompt": "agents/public-process-accessibility-analyst/system.md"
      },
      "public-policy-delivery-risk-analyst": {
        "capability_refs": [
          "capability:capability_set:package:public-sector-service-delivery:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Policy Delivery Risk Analyst",
        "description": "Maps stated outcomes, dependencies, metrics, governance, and delivery risks.",
        "base_role": "delegated-worker",
        "prompt": "agents/public-policy-delivery-risk-analyst/system.md"
      },
      "public-service-plan-owner": {
        "capability_refs": [
          "capability:capability_set:package:public-sector-service-delivery:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Public Service Plan Owner",
        "description": "Joins the branches into an accountable service-delivery outcome register.",
        "base_role": "delegated-worker",
        "prompt": "agents/public-service-plan-owner/system.md"
      }
    },
    "virtual_workflows": {
      "public-service-delivery-pack": {
        "label": "Public Service Delivery Pack",
        "description": "Three independent evidence branches converge into one accountable review pack.",
        "nodes": {
          "public-resident-needs-analyst": {
            "agent_id": "public-resident-needs-analyst",
            "description": "Maps resident needs, journeys, channels, barriers, and evidence gaps.",
            "depends_on": []
          },
          "public-process-accessibility-analyst": {
            "agent_id": "public-process-accessibility-analyst",
            "description": "Maps service steps, handoffs, waiting, accessibility, and exclusion risks.",
            "depends_on": []
          },
          "public-policy-delivery-risk-analyst": {
            "agent_id": "public-policy-delivery-risk-analyst",
            "description": "Maps stated outcomes, dependencies, metrics, governance, and delivery risks.",
            "depends_on": []
          },
          "public-service-plan-owner": {
            "agent_id": "public-service-plan-owner",
            "description": "Joins the branches into an accountable service-delivery outcome register.",
            "depends_on": [
              "public-policy-delivery-risk-analyst",
              "public-process-accessibility-analyst",
              "public-resident-needs-analyst"
            ]
          }
        }
      }
    }
  }
}
