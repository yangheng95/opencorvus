{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "payments-fraud-risk-operations",
  "name": "Payments Fraud Risk Operations",
  "label": "Payments Fraud Risk Operations",
  "description": "Transaction, authentication, merchant-cohort, fraud-signal, dispute, chargeback, and control evidence joined into a bounded payments-risk review pack.",
  "version": "2026.08.30.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for source-grounded payment-fraud and dispute evidence without transaction, account, merchant, AML, or adjudication authority.",
    "selection_guidance": "Select for payment event lifecycles, authorization/authentication evidence, transaction/device/account signals, merchant cohorts, fraud labels, model outcomes, disputes, chargebacks, reason codes, and evidence timelines. Do not select for approving/declining/blocking transactions, changing rules/models, freezing/closing accounts, accusing fraud, KYC/KYB/AML/SAR decisions, dispute representment/adjudication, refunds, merchant offboarding, moving money, or contacting external parties.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 4 projections.",
      "member_refs": [
        "capability:skill:package:payments-fraud-risk-operations:payments-fraud-risk-operations%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:skill:package:payments-fraud-risk-operations:payments-fraud-risk-operations%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "payment-transaction-authentication-analyst": {
        "capability_refs": [
          "capability:capability_set:package:payments-fraud-risk-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Payment Transaction and Authentication Analyst",
        "description": "Reconstructs payment event lifecycles and transaction, authentication, device, account, and model evidence.",
        "base_role": "explore",
        "prompt": "agents/payment-transaction-authentication-analyst/system.md"
      },
      "payment-merchant-monitoring-analyst": {
        "capability_refs": [
          "capability:capability_set:package:payments-fraud-risk-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Merchant Fraud Monitoring Analyst",
        "description": "Builds comparable merchant cohorts and denominator-aware fraud, dispute, refund, decline, and linkage evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/payment-merchant-monitoring-analyst/system.md"
      },
      "payment-dispute-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:payments-fraud-risk-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Payment Dispute Evidence Analyst",
        "description": "Reconciles dispute/chargeback reason, rule-version, deadline, transaction, authentication, delivery, refund, and communication evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/payment-dispute-evidence-analyst/system.md"
      },
      "payments-fraud-risk-review-owner": {
        "capability_refs": [
          "capability:capability_set:package:payments-fraud-risk-operations:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Payments Fraud Risk Review Owner",
        "description": "Joins independent transaction, merchant, and dispute evidence while retaining human decision gates.",
        "base_role": "delegated-worker",
        "prompt": "agents/payments-fraud-risk-review-owner/system.md"
      }
    },
    "virtual_workflows": {
      "payments-fraud-risk-review": {
        "label": "Payments Fraud Risk Review",
        "description": "Three independent payment evidence branches converge into one bounded fraud-risk review pack.",
        "nodes": {
          "payment-transaction-authentication-analyst": {
            "agent_id": "payment-transaction-authentication-analyst",
            "description": "Reconstructs transaction lifecycle, authentication, signal, label, and model evidence.",
            "depends_on": []
          },
          "payment-merchant-monitoring-analyst": {
            "agent_id": "payment-merchant-monitoring-analyst",
            "description": "Builds comparable merchant cohorts, ratios, trends, link evidence, and unknowns.",
            "depends_on": []
          },
          "payment-dispute-evidence-analyst": {
            "agent_id": "payment-dispute-evidence-analyst",
            "description": "Builds rule-versioned dispute/chargeback evidence timelines without adjudication.",
            "depends_on": []
          },
          "payments-fraud-risk-review-owner": {
            "agent_id": "payments-fraud-risk-review-owner",
            "description": "Joins all branches, preserves conflicts, and routes every action to authorized humans.",
            "depends_on": [
              "payment-dispute-evidence-analyst",
              "payment-merchant-monitoring-analyst",
              "payment-transaction-authentication-analyst"
            ]
          }
        }
      }
    }
  }
}
