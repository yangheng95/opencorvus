  "readme": "README.md",
  "selector": {
    "summary": "Use for radiotherapy physics quality evidence preparation before qualified medical-physics review.",
    "selection_guidance": "Select for equipment and software configuration, acceptance or commissioning evidence, reference dosimetry, periodic machine QA, TPS verification, patient-specific QA records, controlled changes, incident evidence or independent audit readiness. Do not select to prescribe, plan treatment, operate equipment, authorize beam-on or return a system to service.",
    "instructions": "selector.md"
  },
