{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "deep-research",
  "name": "Deep Research",
  "label": "Deep Research",
  "description": "Multi-perspective source discovery, evidence curation, grounded outlining, cited drafting, independent citation review, and polished long-form reporting.",
  "version": "2026.09.02.1",
  "product_pillars": [
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for a broad or contested research question that requires multiple perspectives, deep sourcing, citations, synthesis, and a polished report.",
    "selection_guidance": "Select Deep Research when answering the question requires discovering viewpoints and subquestions before writing. Use direct writing for simple transformations and Equity Research for public-company valuation work.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 6 projections.",
      "member_refs": [
        "capability:skill:package:deep-research:deep-research%2Fshared%2Fmethod",
        "capability:skill:package:deep-research:deep-research%2Fshared%2Fworkflow"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:deep-research:deep-research%2Fshared%2Fmethod",
        "capability:skill:package:deep-research:deep-research%2Fshared%2Fworkflow",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "deep-research-planner": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Deep Research Planner",
        "description": "Defines the research question, audience, perspective map, source policy, deliverable, and stopping conditions.",
        "base_role": "delegated-worker",
        "prompt": "agents/deep-research-planner/system.md"
      },
      "deep-research-knowledge-curator": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:deep-research-base"
        ],
        "label": "Deep Research Knowledge Curator",
        "description": "Discovers distinct perspectives, asks perspective-specific questions, and builds a cited evidence dossier.",
        "base_role": "deep-research",
        "prompt": "agents/deep-research-knowledge-curator/system.md"
      },
      "deep-research-outline-editor": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Deep Research Outline Editor",
        "description": "Transforms selected evidence into a coherent, non-redundant hierarchy with section-level evidence assignments.",
        "base_role": "delegated-worker",
        "prompt": "agents/deep-research-outline-editor/system.md"
      },
      "deep-research-draft-writer": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Deep Research Draft Writer",
        "description": "Writes a complete, source-grounded draft whose inline citations map to the curated source index.",
        "base_role": "delegated-worker",
        "prompt": "agents/deep-research-draft-writer/system.md"
      },
      "deep-research-citation-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:fact-check-base"
        ],
        "label": "Deep Research Citation Reviewer",
        "description": "Independently audits citation entailment, source quality, coverage, placement, synthesis, and uncertainty.",
        "base_role": "fact-check",
        "prompt": "agents/deep-research-citation-reviewer/system.md"
      },
      "deep-research-report-writer": {
        "capability_refs": [
          "capability:capability_set:package:deep-research:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:build-base"
        ],
        "label": "Deep Research Report Writer",
        "description": "Resolves the independent review and publishes canonical Markdown plus the visible final research report.",
        "base_role": "build",
        "prompt": "agents/deep-research-report-writer/system.md"
      }
    },
    "virtual_workflows": {
      "multi-perspective-report": {
        "label": "Multi-perspective Deep Research Report",
        "description": "Bound the question, curate perspective-led evidence, construct a grounded outline, draft with citations, audit citations, and publish a polished report.",
        "nodes": {
          "deep-research-planner": {
            "agent_id": "deep-research-planner",
            "description": "Publishes the bounded research charter and perspective plan.",
            "depends_on": []
          },
          "deep-research-knowledge-curator": {
            "agent_id": "deep-research-knowledge-curator",
            "description": "Publishes the multi-perspective evidence dossier.",
            "depends_on": [
              "deep-research-planner"
            ]
          },
          "deep-research-outline-editor": {
            "agent_id": "deep-research-outline-editor",
            "description": "Publishes the evidence-grounded article outline.",
            "depends_on": [
              "deep-research-knowledge-curator"
            ]
          },
          "deep-research-draft-writer": {
            "agent_id": "deep-research-draft-writer",
            "description": "Publishes the complete cited draft.",
            "depends_on": [
              "deep-research-outline-editor"
            ]
          },
          "deep-research-citation-reviewer": {
            "agent_id": "deep-research-citation-reviewer",
            "description": "Publishes the independent citation and synthesis review.",
            "depends_on": [
              "deep-research-draft-writer"
            ]
          },
          "deep-research-report-writer": {
            "agent_id": "deep-research-report-writer",
            "description": "Publishes canonical Markdown and the visible final report.",
            "depends_on": [
              "deep-research-citation-reviewer"
            ]
          }
        }
      }
    }
  }
}
