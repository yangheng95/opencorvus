{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "robotics-safety-validation",
  "name": "Robotics Safety Validation",
  "label": "Robotics Safety Validation",
  "description": "Integrated robot application requirements, hazards, safety functions and deterministic validation evidence joined for qualified safety review.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded integrated-robot application safety evidence.",
    "selection_guidance": "Select for robot task and mode hazards, safeguards, safety-function traceability and layered verification evidence without commanding equipment or accepting risk.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:robotics-safety-validation:robotics-safety-validation%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:robotics-safety-validation:robotics-safety-validation%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "robot-system-requirement-interface-analyst": {
        "capability_refs": [
          "capability:capability_set:package:robotics-safety-validation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "Robot System Requirement and Interface Analyst",
        "description": "Freeze the integrated robot application boundary and trace requirements across robot, controller, end effector, sensors, energy, communications, workspace, people and external equipment.",
        "base_role": "explore",
        "prompt": "agents/robot-system-requirement-interface-analyst/system.md"
      },
      "robot-task-hazard-risk-reduction-analyst": {
        "capability_refs": [
          "capability:capability_set:package:robotics-safety-validation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Robot Task Hazard and Risk Reduction Analyst",
        "description": "Analyze task, mode and lifecycle hazards and the supplied risk-reduction evidence without accepting residual risk.",
        "base_role": "delegated-worker",
        "prompt": "agents/robot-task-hazard-risk-reduction-analyst/system.md"
      },
      "robot-safety-function-control-validation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:robotics-safety-validation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Robot Safety Function and Control Validation Analyst",
        "description": "Trace safety functions and safety-related parts of control systems to configuration, analysis and test evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/robot-safety-function-control-validation-analyst/system.md"
      },
      "robot-application-test-evidence-analyst": {
        "capability_refs": [
          "capability:capability_set:package:robotics-safety-validation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Robot Application Test Evidence Analyst",
        "description": "Organize deterministic verification and validation evidence across unit, integration, simulation, hardware-in-the-loop and bounded field layers.",
        "base_role": "delegated-worker",
        "prompt": "agents/robot-application-test-evidence-analyst/system.md"
      },
      "robotics-safety-validation-case-owner": {
        "capability_refs": [
          "capability:capability_set:package:robotics-safety-validation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Robotics Safety Validation Case Owner",
        "description": "Join the four independent branches into a contradiction-preserving evidence case for qualified safety review.",
        "base_role": "delegated-worker",
        "prompt": "agents/robotics-safety-validation-case-owner/system.md"
      }
    },
    "virtual_workflows": {
      "robotics-safety-validation-review": {
        "label": "Robotics Safety Validation Review",
        "description": "Four independent evidence branches converge into an explicit qualified-review case owner.",
        "nodes": {
          "robot-system-requirement-interface-analyst": {
            "agent_id": "robot-system-requirement-interface-analyst",
            "description": "Freeze the integrated robot application boundary and trace requirements across robot, controller, end effector, sensors, energy, communications, workspace, people and external equipment.",
            "depends_on": []
          },
          "robot-task-hazard-risk-reduction-analyst": {
            "agent_id": "robot-task-hazard-risk-reduction-analyst",
            "description": "Analyze task, mode and lifecycle hazards and the supplied risk-reduction evidence without accepting residual risk.",
            "depends_on": []
          },
          "robot-safety-function-control-validation-analyst": {
            "agent_id": "robot-safety-function-control-validation-analyst",
            "description": "Trace safety functions and safety-related parts of control systems to configuration, analysis and test evidence.",
            "depends_on": []
          },
          "robot-application-test-evidence-analyst": {
            "agent_id": "robot-application-test-evidence-analyst",
            "description": "Organize deterministic verification and validation evidence across unit, integration, simulation, hardware-in-the-loop and bounded field layers.",
            "depends_on": []
          },
          "robotics-safety-validation-case-owner": {
            "agent_id": "robotics-safety-validation-case-owner",
            "description": "Join the four independent branches into a contradiction-preserving evidence case for qualified safety review.",
            "depends_on": [
              "robot-application-test-evidence-analyst",
              "robot-safety-function-control-validation-analyst",
              "robot-system-requirement-interface-analyst",
              "robot-task-hazard-risk-reduction-analyst"
            ]
          }
        }
      }
    }
  }
}
