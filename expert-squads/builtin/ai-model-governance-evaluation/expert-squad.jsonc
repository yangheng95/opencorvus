{
  "schema_version": 2,
  "namespace": "builtin",
  "id": "ai-model-governance-evaluation",
  "name": "AI Model Governance and Evaluation",
  "label": "AI Model Governance and Evaluation",
  "description": "Use-case risk, provenance, evaluation and independent trustworthiness evidence joined into an accountable AI governance pack.",
  "version": "2026.08.30.2",
  "product_pillars": [
    "code",
    "work"
  ],
  "readme": "README.md",
  "selector": {
    "summary": "Use for bounded AI model governance and evaluation evidence.",
    "selection_guidance": "Select for AI inventory, risk, provenance, evaluation, trustworthiness, drift and decision evidence without deployment, risk-acceptance, eligibility or compliance authority.",
    "instructions": "selector.md"
  },
  "capability_sets": {
    "shared-capabilities-1": {
      "description": "Shared capabilities used by 5 projections.",
      "member_refs": [
        "capability:skill:package:ai-model-governance-evaluation:ai-model-governance-evaluation%2Fshared%2Fmethod"
      ]
    }
  },
  "capability_projection": {
    "scheduler": {
      "capability_refs": [
        "capability:capability_set:platform:tool-registry:orchestrator-base",
        "capability:capability_set:platform:tool-registry:scheduler-transport",
        "capability:skill:package:ai-model-governance-evaluation:ai-model-governance-evaluation%2Fshared%2Fmethod",
        "capability:tool:platform:tool-registry:dispatch_agent",
        "capability:tool:platform:tool-registry:manage_task",
        "capability:tool:platform:tool-registry:read"
      ],
      "base_role": "orchestrator",
      "prompt": "agents/orchestrator/system.md"
    },
    "agents": {
      "ai-use-case-risk-governance-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ai-model-governance-evaluation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:explore-base"
        ],
        "label": "AI Use-Case Risk and Governance Analyst",
        "description": "Maps intended use, affected groups, risk taxonomy, controls, owners and decision authority.",
        "base_role": "explore",
        "prompt": "agents/ai-use-case-risk-governance-analyst/system.md"
      },
      "model-data-provenance-documentation-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ai-model-governance-evaluation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Model and Data Provenance Analyst",
        "description": "Versions model, dataset, prompt, tool, configuration, limitation and documentation evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/model-data-provenance-documentation-analyst/system.md"
      },
      "ai-evaluation-design-results-analyst": {
        "capability_refs": [
          "capability:capability_set:package:ai-model-governance-evaluation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "AI Evaluation Design and Results Analyst",
        "description": "Designs claim-bound protocols and checks row-level, slice, aggregate and reproducibility evidence.",
        "base_role": "delegated-worker",
        "prompt": "agents/ai-evaluation-design-results-analyst/system.md"
      },
      "ai-independent-trustworthiness-reviewer": {
        "capability_refs": [
          "capability:capability_set:package:ai-model-governance-evaluation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "Independent AI Trustworthiness Reviewer",
        "description": "Challenges robustness, bias, privacy, security, human-oversight and evaluation validity claims.",
        "base_role": "delegated-worker",
        "prompt": "agents/ai-independent-trustworthiness-reviewer/system.md"
      },
      "ai-model-governance-evaluation-owner": {
        "capability_refs": [
          "capability:capability_set:package:ai-model-governance-evaluation:shared-capabilities-1",
          "capability:capability_set:platform:tool-registry:delegated-worker-base"
        ],
        "label": "AI Model Governance and Evaluation Owner",
        "description": "Joins four branches into one claim-risk-evidence-decision register.",
        "base_role": "delegated-worker",
        "prompt": "agents/ai-model-governance-evaluation-owner/system.md"
      }
    },
    "virtual_workflows": {
      "ai-model-governance-evaluation-review": {
        "label": "AI Model Governance and Evaluation Review",
        "description": "Four independent AI evidence branches converge into one accountable review pack.",
        "nodes": {
          "ai-use-case-risk-governance-analyst": {
            "agent_id": "ai-use-case-risk-governance-analyst",
            "description": "Maps use-case risk and governance.",
            "depends_on": []
          },
          "model-data-provenance-documentation-analyst": {
            "agent_id": "model-data-provenance-documentation-analyst",
            "description": "Maps model and data provenance.",
            "depends_on": []
          },
          "ai-evaluation-design-results-analyst": {
            "agent_id": "ai-evaluation-design-results-analyst",
            "description": "Maps evaluation protocol and results.",
            "depends_on": []
          },
          "ai-independent-trustworthiness-reviewer": {
            "agent_id": "ai-independent-trustworthiness-reviewer",
            "description": "Challenges trustworthiness evidence.",
            "depends_on": []
          },
          "ai-model-governance-evaluation-owner": {
            "agent_id": "ai-model-governance-evaluation-owner",
            "description": "Joins all roots without accepting risk or deploying a model.",
            "depends_on": [
              "ai-evaluation-design-results-analyst",
              "ai-independent-trustworthiness-reviewer",
              "ai-use-case-risk-governance-analyst",
              "model-data-provenance-documentation-analyst"
            ]
          }
        }
      }
    }
  }
}
